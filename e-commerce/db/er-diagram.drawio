<mxCell id="c299" value='&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Header colour: &lt;font color="#6c8ebf"&gt;&lt;b&gt;blue&lt;/b&gt;&lt;/font&gt; = master (m_), &lt;font color="#82b366"&gt;&lt;b&gt;green&lt;/b&gt;&lt;/font&gt; = transaction (t_), &lt;font color="#9673a6"&gt;&lt;b&gt;purple&lt;/b&gt;&lt;/font&gt; = log (l_), dashed ↗ = table owned by another page (key only).&lt;br&gt;Tags: PK primary key, FK foreign key (blue), UK unique. “?” = nullable. Crow’s foot = many side; bar = exactly one parent; circle+bar = optional parent.&lt;br&gt;Audit columns omitted from every table: created_by, created_at, updated_by, updated_at, row_status.' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="778" width="1172" height="70" as="geometry"/></mxCell>
