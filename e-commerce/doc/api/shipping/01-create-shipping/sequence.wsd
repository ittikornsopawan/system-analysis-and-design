@startuml CreateShipping Sequence

title Create Shipping API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Create Shipping Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_order" as t_order
    database "t_order_item" as t_order_item
    database "t_shop_user" as t_shop_user
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "t_payment" as t_payment
    database "t_shipping_item" as t_shipping_item
    database "t_shipping" as t_shipping
end box

user -> page: Submit the shipping
activate page
    page -> api: POST v1/shop/shipping
    activate api
        api -> app: [**CreateShippingCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body: orderId is a UUID, items has 1 to 100 entries, no orderItemId twice, every quantity is a positive integer
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    note over app, infra
                        - Execution order: validate the request (400) -> existence of the order and of the order items (404) -> permission of the caller (403) -> status of the
                          order and the quantity check (409) -> write the shipping, its items and the order status in one transaction. The order row is locked (`SELECT ...
                          FOR UPDATE`) before any row of `shipping.*` is read for the quantity check or written.
                    end note
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                        app -> infra: QUERY - Lock the order
                        infra -> t_order: QUERY - Lock the order
                        activate t_order
                            note right of t_order
                                SELECT
                                    o.id as order_id,
                                    o.code,
                                    o.shop_id,
                                    o.user_id,
                                    o.status
                                FROM sales.t_order o
                                WHERE o.id = '<sequence.orderId>'
                                AND o.row_status <> 'DELETED'
                                FOR UPDATE -- the order row is locked first in every write of the shipping and payment APIs, so they never wait for each other in a circle
                            end note
                            t_order -> infra: Return query result
                        deactivate t_order
                        infra -> app: Return the locked order or no row
                        alt Order not found or DELETED
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 Order not found.
                            api -> page: Not found
                            page -> user: Display the order is not found
                        else Order found
                            app -> infra: QUERY - Get the order items of the request
                            infra -> t_order_item: QUERY - Get the order items of the request
                            activate t_order_item
                                note right of t_order_item
                                    SELECT
                                        oi.id as order_item_id,
                                        oi.quantity
                                    FROM sales.t_order_item oi
                                    WHERE oi.order_id = '<sequence.orderId>'
                                    AND oi.id IN ('<sequence.orderItemIds>')
                                    AND oi.row_status <> 'DELETED' -- an id that is missing from the result is answered 404 (E10005)
                                end note
                                t_order_item -> infra: Return query result
                            deactivate t_order_item
                            infra -> app: Return the order items that are in the order
                            alt An orderItemId is not an item of the order
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10005 items[i]: Order item not found in the order.
                                api -> page: Not found
                                page -> user: Display which item is not found
                            else Every item is in the order
                                app -> infra: QUERY - Check shop member
                                infra -> t_shop_user: QUERY - Check shop member
                                activate t_shop_user
                                    note right of t_shop_user
                                        SELECT
                                            su.shop_id
                                        FROM shop.t_shop_user su
                                        WHERE su.shop_id = '<sequence.shopId>'
                                        AND su.user_id = '<sequence.userId>'
                                        AND su.role IN ('ADMIN', 'STAFF')
                                        AND su.row_status = 'ACTIVE'
                                    end note
                                    t_shop_user -> infra: Return query result
                                deactivate t_shop_user
                                infra -> app: Return the ACTIVE ADMIN or STAFF row of the caller or no row
                                alt The caller is not an ACTIVE ADMIN or STAFF member of the shop
                                    app -> infra: QUERY - Get the platform administrator role
                                    infra -> m_role: QUERY - Get the platform administrator role
                                    activate m_role
                                        note right of m_role
                                            SELECT
                                                r.id as role_id
                                            FROM author.m_role r
                                            WHERE r.name = 'PLATFORM_ADMIN'
                                            AND r.row_status = 'ACTIVE'
                                        end note
                                        m_role -> infra: Return query result
                                    deactivate m_role
                                    infra -> app: Return the role id
                                    app -> infra: QUERY - Check platform administrator
                                    infra -> t_user_role: QUERY - Check platform administrator
                                    activate t_user_role
                                        note right of t_user_role
                                            SELECT
                                                ur.id as user_role_id
                                            FROM author.t_user_role ur
                                            WHERE ur.user_id = '<sequence.userId>'
                                            AND ur.role_id = '<sequence.roleId>'
                                            AND ur.row_status = 'ACTIVE'
                                        end note
                                        t_user_role -> infra: Return query result
                                    deactivate t_user_role
                                    infra -> app: Return the assignment or no row
                                    alt The caller is not a platform administrator
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 403 E10009 Only a member of the shop of the order or a platform administrator can create a shipping.
                                        api -> page: Forbidden
                                        page -> user: Display no permission
                                    end
                                end
                                alt The order is not PAYMENT_CONFIRMED or PROCESSING
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10006 A shipping can only be created for an order that is PAYMENT_CONFIRMED or PROCESSING, the order is <status>.
                                    api -> page: Conflict
                                    page -> user: Display the order cannot be shipped
                                else The order can be shipped
                                    app -> infra: QUERY - Get the shipping method of the order
                                    infra -> t_payment: QUERY - Get the shipping method of the order
                                    activate t_payment
                                        note right of t_payment
                                            SELECT
                                                p.shipping_method
                                            FROM payment.t_payment p
                                            WHERE p.order_id = '<sequence.orderId>'
                                            AND p.status = 'COMPLETED' -- an order has at most one COMPLETED payment
                                            AND p.row_status <> 'DELETED'
                                        end note
                                        t_payment -> infra: Return query result
                                    deactivate t_payment
                                    infra -> app: Return the shippingMethod of the COMPLETED payment
                                    app -> infra: QUERY - Get the quantity already assigned
                                    infra -> t_shipping_item: QUERY - Get the quantity already assigned
                                    activate t_shipping_item
                                        note right of t_shipping_item
                                            SELECT
                                                si.order_item_id,
                                                COALESCE(SUM(si.quantity), 0) as assigned_quantity
                                            FROM shipping.t_shipping_item si
                                            INNER JOIN shipping.t_shipping s
                                                ON s.id = si.shipping_id
                                            WHERE si.order_item_id IN ('<sequence.orderItemIds>')
                                            AND si.row_status <> 'DELETED'
                                            AND s.row_status <> 'DELETED'
                                            AND s.status IN ('PENDING', 'SHIPPED', 'DELIVERED') -- a CANCELLED or RETURNED parcel frees its quantity
                                            GROUP BY si.order_item_id
                                        end note
                                        t_shipping_item -> infra: Return query result
                                    deactivate t_shipping_item
                                    infra -> app: Return the quantity assigned to PENDING, SHIPPED or DELIVERED shippings
                                    alt quantity + assigned quantity is more than the quantity of an item
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10006 items[i]: Quantity <n> is more than the quantity left to ship (<m>).
                                        api -> page: Conflict
                                        page -> user: Display the quantity left to ship
                                    else The quantities fit the order
                                        app -> infra: INSERT - Create the shipping
                                        infra -> t_shipping: INSERT - Create the shipping
                                        activate t_shipping
                                            note right of t_shipping
                                                INSERT INTO shipping.t_shipping (created_by, order_id, shipping_method, status)
                                                VALUES ('<sequence.userId>', '<sequence.orderId>', '<sequence.shippingMethod>', 'PENDING')
                                                RETURNING id as shipping_id, order_id, shipping_method, status, created_at
                                            end note
                                            t_shipping -> infra: Return inserted result
                                        deactivate t_shipping
                                        infra -> app: Return the shipping id and PENDING
                                        app -> infra: INSERT - Add the items to the shipping
                                        infra -> t_shipping_item: INSERT - Add the items to the shipping
                                        activate t_shipping_item
                                            note right of t_shipping_item
                                                INSERT INTO shipping.t_shipping_item (created_by, shipping_id, order_item_id, quantity)
                                                VALUES ('<sequence.userId>', '<sequence.shippingId>', '<sequence.orderItemId>', '<sequence.quantity>') -- one row per item of the request
                                                RETURNING id as shipping_item_id, order_item_id, quantity
                                            end note
                                            t_shipping_item -> infra: Return inserted result
                                        deactivate t_shipping_item
                                        infra -> app: Return the shipping items
                                        alt The order is PAYMENT_CONFIRMED
                                            app -> infra: UPDATE - Start processing
                                            infra -> t_order: UPDATE - Start processing
                                            activate t_order
                                                note right of t_order
                                                    UPDATE sales.t_order
                                                    SET
                                                        updated_by = '<sequence.userId>',
                                                        updated_at = NOW() AT TIME ZONE 'UTC',
                                                        status = 'PROCESSING'
                                                    WHERE id = '<sequence.orderId>'
                                                    AND status = 'PAYMENT_CONFIRMED' -- the first shipping of the order, an order that is already PROCESSING is not changed
                                                    RETURNING id as order_id, status
                                                end note
                                                t_order -> infra: Return updated result
                                            deactivate t_order
                                            infra -> app: Return the order as PROCESSING
                                        end
                                        app -> infra: COMMIT
                                        app -> api: HTTP 201 S10000 Create Shipping Success
                                        api -> page: Return the new shipping
                                        page -> user: Display the shipping created
                                    end
                                end
                            end
                        end
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
