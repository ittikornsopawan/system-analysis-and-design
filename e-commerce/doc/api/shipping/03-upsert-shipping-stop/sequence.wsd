@startuml UpsertShippingStop Sequence

title Upsert Shipping Stop API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Shipping Stop Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_shipping" as t_shipping
    database "t_order" as t_order
    database "t_shipping_stop" as t_shipping_stop
    database "t_shop_user" as t_shop_user
    database "m_role" as m_role
    database "t_user_role" as t_user_role
end box

user -> page: Submit the shipping stop
activate page
    page -> api: POST v1/shop/shipping/stop/upsert
    activate api
        api -> app: [**UpsertShippingStopCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body: shippingId, stopNumber (integer from 1), stopType (PICKUP, TRANSIT or DROPOFF) and locationName are required, rowStatus is not DELETED when inserting
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                        app -> infra: QUERY - Get the shipping
                        infra -> t_shipping: QUERY - Get the shipping
                        activate t_shipping
                            note right of t_shipping
                                SELECT
                                    s.id as shipping_id,
                                    s.order_id,
                                    s.status,
                                    o.shop_id
                                FROM shipping.t_shipping s
                                INNER JOIN sales.t_order o
                                    ON o.id = s.order_id
                                WHERE s.id = '<sequence.shippingId>'
                                AND s.row_status <> 'DELETED'
                            end note
                            t_shipping -> infra: Return query result
                        deactivate t_shipping
                        infra -> app: Return the shipping and its order (read without a lock only to find the order)
                        alt Shipping not found
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 Shipping not found.
                            api -> page: Not found
                            page -> user: Display the shipping is not found
                        else Shipping found
                            app -> infra: QUERY - Lock the order
                            infra -> t_order: QUERY - Lock the order
                            activate t_order
                                note right of t_order
                                    SELECT
                                        o.id as order_id,
                                        o.code,
                                        o.shop_id,
                                        o.user_id,
                                        o.status
                                    FROM sales.t_order o
                                    WHERE o.id = '<sequence.orderId>'
                                    AND o.row_status <> 'DELETED'
                                    FOR UPDATE -- the order row is locked first in every write of the shipping and payment APIs, so they never wait for each other in a circle
                                end note
                                t_order -> infra: Return query result
                            deactivate t_order
                            infra -> app: Return the locked order
                            alt id is specified
                                app -> infra: QUERY - Check existing stop
                                infra -> t_shipping_stop: QUERY - Check existing stop
                                activate t_shipping_stop
                                    note right of t_shipping_stop
                                        SELECT
                                            ss.id as stop_id,
                                            ss.shipping_id,
                                            ss.row_status
                                        FROM shipping.t_shipping_stop ss
                                        WHERE ss.id = '<sequence.id>'
                                        AND ss.shipping_id = '<sequence.shippingId>'
                                        AND ss.row_status <> 'DELETED' -- a DELETED stop counts as not found
                                    end note
                                    t_shipping_stop -> infra: Return query result
                                deactivate t_shipping_stop
                                infra -> app: Return the stop of the shipping or no row
                                alt Stop not found or DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10004 Shipping stop not found.
                                    api -> page: Not found
                                    page -> user: Display the stop is not found
                                end
                            end
                            app -> infra: QUERY - Check shop member
                            infra -> t_shop_user: QUERY - Check shop member
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.shop_id
                                    FROM shop.t_shop_user su
                                    WHERE su.shop_id = '<sequence.shopId>'
                                    AND su.user_id = '<sequence.userId>'
                                    AND su.role IN ('ADMIN', 'STAFF')
                                    AND su.row_status = 'ACTIVE'
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return the ACTIVE ADMIN or STAFF row of the caller or no row
                            alt The caller is not an ACTIVE ADMIN or STAFF member of the shop
                                app -> infra: QUERY - Get the platform administrator role
                                infra -> m_role: QUERY - Get the platform administrator role
                                activate m_role
                                    note right of m_role
                                        SELECT
                                            r.id as role_id
                                        FROM author.m_role r
                                        WHERE r.name = 'PLATFORM_ADMIN'
                                        AND r.row_status = 'ACTIVE'
                                    end note
                                    m_role -> infra: Return query result
                                deactivate m_role
                                infra -> app: Return the role id
                                app -> infra: QUERY - Check platform administrator
                                infra -> t_user_role: QUERY - Check platform administrator
                                activate t_user_role
                                    note right of t_user_role
                                        SELECT
                                            ur.id as user_role_id
                                        FROM author.t_user_role ur
                                        WHERE ur.user_id = '<sequence.userId>'
                                        AND ur.role_id = '<sequence.roleId>'
                                        AND ur.row_status = 'ACTIVE'
                                    end note
                                    t_user_role -> infra: Return query result
                                deactivate t_user_role
                                infra -> app: Return the assignment or no row
                                alt The caller is not a platform administrator
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 403 E10009 Only a member of the shop of the order or a platform administrator can record a stop.
                                    api -> page: Forbidden
                                    page -> user: Display no permission
                                end
                            end
                            alt The shipping is not PENDING or SHIPPED
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10006 A stop can only be recorded while the shipping is PENDING or SHIPPED, the shipping is <status>.
                                api -> page: Conflict
                                page -> user: Display the shipping is closed
                            else The shipping is PENDING or SHIPPED
                                alt id is specified (update, delete or archive)
                                    alt rowStatus = DELETED (delete)
                                        app -> infra: UPDATE - Update, delete or archive the stop
                                        infra -> t_shipping_stop: UPDATE - Update, delete or archive the stop
                                        activate t_shipping_stop
                                            note right of t_shipping_stop
                                                UPDATE shipping.t_shipping_stop
                                                SET
                                                    updated_by = '<sequence.userId>',
                                                    updated_at = NOW() AT TIME ZONE 'UTC',
                                                    stop_number = '<sequence.stopNumber>',
                                                    stop_type = '<sequence.stopType>',
                                                    location_name = '<sequence.locationName>',
                                                    estimated_arrival = '<sequence.estimatedArrival>',
                                                    arrived_at = '<sequence.arrivedAt>',
                                                    row_status = '<sequence.rowStatus>' -- a delete sets DELETED, an archive sets ARCHIVED
                                                WHERE id = '<sequence.id>'
                                                AND shipping_id = '<sequence.shippingId>'
                                                RETURNING id as stop_id, shipping_id, stop_number, stop_type, location_name, estimated_arrival, arrived_at, row_status
                                            end note
                                            t_shipping_stop -> infra: Return updated result
                                        deactivate t_shipping_stop
                                        infra -> app: Return the deleted stop
                                        app -> infra: COMMIT
                                        app -> api: HTTP 204 No Content; no response body
                                        api -> page: No content
                                        page -> user: Display the stop removed
                                    else rowStatus is ACTIVE, INACTIVE, LOCKED or ARCHIVED (update or archive)
                                        app -> infra: QUERY - Check duplicate stop number
                                        infra -> t_shipping_stop: QUERY - Check duplicate stop number
                                        activate t_shipping_stop
                                            note right of t_shipping_stop
                                                SELECT
                                                    ss.id as stop_id
                                                FROM shipping.t_shipping_stop ss
                                                WHERE ss.shipping_id = '<sequence.shippingId>'
                                                AND ss.stop_number = '<sequence.stopNumber>'
                                                AND ss.row_status <> 'DELETED'
                                                AND ss.id <> '<sequence.id>' -- only when id is specified
                                            end note
                                            t_shipping_stop -> infra: Return query result
                                        deactivate t_shipping_stop
                                        infra -> app: Return the stop that holds the stopNumber or no row
                                        alt Another stop of the shipping holds the stopNumber
                                            app -> infra: ROLLBACK
                                            app -> api: HTTP 409 E10003 Stop Number <n> already exists in the shipping.
                                            api -> page: Conflict
                                            page -> user: Display the stop number exists
                                        else The stopNumber is free
                                            app -> infra: UPDATE - Update, delete or archive the stop
                                            infra -> t_shipping_stop: UPDATE - Update, delete or archive the stop
                                            activate t_shipping_stop
                                                note right of t_shipping_stop
                                                    UPDATE shipping.t_shipping_stop
                                                    SET
                                                        updated_by = '<sequence.userId>',
                                                        updated_at = NOW() AT TIME ZONE 'UTC',
                                                        stop_number = '<sequence.stopNumber>',
                                                        stop_type = '<sequence.stopType>',
                                                        location_name = '<sequence.locationName>',
                                                        estimated_arrival = '<sequence.estimatedArrival>',
                                                        arrived_at = '<sequence.arrivedAt>',
                                                        row_status = '<sequence.rowStatus>' -- a delete sets DELETED, an archive sets ARCHIVED
                                                    WHERE id = '<sequence.id>'
                                                    AND shipping_id = '<sequence.shippingId>'
                                                    RETURNING id as stop_id, shipping_id, stop_number, stop_type, location_name, estimated_arrival, arrived_at, row_status
                                                end note
                                                t_shipping_stop -> infra: Return updated result
                                            deactivate t_shipping_stop
                                            infra -> app: Return the changed stop
                                            app -> infra: COMMIT
                                            app -> api: HTTP 200 S10000 Upsert Shipping Stop Success
                                            api -> page: Return the stop
                                            page -> user: Display the stop saved
                                        end
                                    end
                                else id is not specified (insert)
                                    app -> infra: QUERY - Check duplicate stop number
                                    infra -> t_shipping_stop: QUERY - Check duplicate stop number
                                    activate t_shipping_stop
                                        note right of t_shipping_stop
                                            SELECT
                                                ss.id as stop_id
                                            FROM shipping.t_shipping_stop ss
                                            WHERE ss.shipping_id = '<sequence.shippingId>'
                                            AND ss.stop_number = '<sequence.stopNumber>'
                                            AND ss.row_status <> 'DELETED'
                                            AND ss.id <> '<sequence.id>' -- only when id is specified
                                        end note
                                        t_shipping_stop -> infra: Return query result
                                    deactivate t_shipping_stop
                                    infra -> app: Return the stop that holds the stopNumber or no row
                                    alt The stopNumber is held by a stop that is not DELETED
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10003 Stop Number <n> already exists in the shipping.
                                        api -> page: Conflict
                                        page -> user: Display the stop number exists
                                    else The stopNumber is free
                                        app -> infra: INSERT - Create the stop
                                        infra -> t_shipping_stop: INSERT - Create the stop
                                        activate t_shipping_stop
                                            note right of t_shipping_stop
                                                INSERT INTO shipping.t_shipping_stop (created_by, shipping_id, stop_number, stop_type, location_name, estimated_arrival, arrived_at, row_status)
                                                VALUES ('<sequence.userId>', '<sequence.shippingId>', '<sequence.stopNumber>', '<sequence.stopType>', '<sequence.locationName>', '<sequence.estimatedArrival>', '<sequence.arrivedAt>', '<sequence.rowStatus>')
                                                RETURNING id as stop_id, shipping_id, stop_number, stop_type, location_name, estimated_arrival, arrived_at, row_status
                                            end note
                                            t_shipping_stop -> infra: Return inserted result
                                        deactivate t_shipping_stop
                                        infra -> app: Return the new stop
                                        app -> infra: COMMIT
                                        app -> api: HTTP 201 S10000 Upsert Shipping Stop Success
                                        api -> page: Return the new stop
                                        page -> user: Display the stop saved
                                    end
                                end
                            end
                        end
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
