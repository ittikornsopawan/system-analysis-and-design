@startuml UpdateShippingStatus Sequence

title Update Shipping Status API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Update Shipping Status Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_shipping" as t_shipping
    database "t_order" as t_order
    database "t_shop_user" as t_shop_user
    database "m_role" as m_role
    database "t_user_role" as t_user_role
end box

user -> page: Submit the shipping status
activate page
    page -> api: POST v1/shop/shipping/status
    activate api
        api -> app: [**UpdateShippingStatusCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body: shippingId is a UUID, status is SHIPPED, CANCELLED or RETURNED, carrierName and trackingNumber are required for SHIPPED and not accepted for CANCELLED and RETURNED
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                        app -> infra: QUERY - Get the shipping
                        infra -> t_shipping: QUERY - Get the shipping
                        activate t_shipping
                            note right of t_shipping
                                SELECT
                                    s.id as shipping_id,
                                    s.order_id,
                                    s.status,
                                    s.shipping_method,
                                    s.carrier_name,
                                    s.tracking_number,
                                    s.shipped_at
                                FROM shipping.t_shipping s
                                WHERE s.id = '<sequence.shippingId>'
                                AND s.row_status <> 'DELETED'
                            end note
                            t_shipping -> infra: Return query result
                        deactivate t_shipping
                        infra -> app: Return the shipping and its order (read without a lock only to find the order)
                        alt Shipping not found
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 Shipping not found.
                            api -> page: Not found
                            page -> user: Display the shipping is not found
                        else Shipping found
                            app -> infra: QUERY - Lock the order
                            infra -> t_order: QUERY - Lock the order
                            activate t_order
                                note right of t_order
                                    SELECT
                                        o.id as order_id,
                                        o.code,
                                        o.shop_id,
                                        o.user_id,
                                        o.status
                                    FROM sales.t_order o
                                    WHERE o.id = '<sequence.orderId>'
                                    AND o.row_status <> 'DELETED'
                                    FOR UPDATE -- the order row is locked first in every write of the shipping and payment APIs, so they never wait for each other in a circle
                                end note
                                t_order -> infra: Return query result
                            deactivate t_order
                            infra -> app: Return the locked order
                            app -> infra: QUERY - Lock the shipping
                            infra -> t_shipping: QUERY - Lock the shipping
                            activate t_shipping
                                note right of t_shipping
                                    SELECT
                                        s.id as shipping_id,
                                        s.status
                                    FROM shipping.t_shipping s
                                    WHERE s.id = '<sequence.shippingId>'
                                    AND s.row_status <> 'DELETED'
                                    FOR UPDATE -- read again after the order row is locked, the status step is checked on this row
                                end note
                                t_shipping -> infra: Return query result
                            deactivate t_shipping
                            infra -> app: Return the locked shipping and its status (the status step is checked on this read)
                            app -> infra: QUERY - Check shop member
                            infra -> t_shop_user: QUERY - Check shop member
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.shop_id
                                    FROM shop.t_shop_user su
                                    WHERE su.shop_id = '<sequence.shopId>'
                                    AND su.user_id = '<sequence.userId>'
                                    AND su.role IN ('ADMIN', 'STAFF')
                                    AND su.row_status = 'ACTIVE'
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return the ACTIVE ADMIN or STAFF row of the caller or no row
                            alt The caller is not an ACTIVE ADMIN or STAFF member of the shop
                                app -> infra: QUERY - Get the platform administrator role
                                infra -> m_role: QUERY - Get the platform administrator role
                                activate m_role
                                    note right of m_role
                                        SELECT
                                            r.id as role_id
                                        FROM author.m_role r
                                        WHERE r.name = 'PLATFORM_ADMIN'
                                        AND r.row_status = 'ACTIVE'
                                    end note
                                    m_role -> infra: Return query result
                                deactivate m_role
                                infra -> app: Return the role id
                                app -> infra: QUERY - Check platform administrator
                                infra -> t_user_role: QUERY - Check platform administrator
                                activate t_user_role
                                    note right of t_user_role
                                        SELECT
                                            ur.id as user_role_id
                                        FROM author.t_user_role ur
                                        WHERE ur.user_id = '<sequence.userId>'
                                        AND ur.role_id = '<sequence.roleId>'
                                        AND ur.row_status = 'ACTIVE'
                                    end note
                                    t_user_role -> infra: Return query result
                                deactivate t_user_role
                                infra -> app: Return the assignment or no row
                                alt The caller is not a platform administrator
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 403 E10009 Only a member of the shop of the order or a platform administrator can change a shipping.
                                    api -> page: Forbidden
                                    page -> user: Display no permission
                                end
                            end
                            alt status = SHIPPED and the shipping is PENDING
                                app -> infra: QUERY - Check duplicate tracking number
                                infra -> t_shipping: QUERY - Check duplicate tracking number
                                activate t_shipping
                                    note right of t_shipping
                                        SELECT
                                            s.id as shipping_id
                                        FROM shipping.t_shipping s
                                        WHERE s.carrier_name = '<sequence.carrierName>'
                                        AND s.tracking_number = '<sequence.trackingNumber>'
                                        AND s.row_status <> 'DELETED'
                                        AND s.id <> '<sequence.shippingId>'
                                    end note
                                    t_shipping -> infra: Return query result
                                deactivate t_shipping
                                infra -> app: Return the shipping that has the carrierName and trackingNumber or no row
                                alt The carrierName and trackingNumber pair already exists
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10003 The tracking number <n> already exists for the carrier <c>.
                                    api -> page: Conflict
                                    page -> user: Display the tracking number exists
                                else The pair is free
                                    app -> infra: UPDATE - Mark the shipping as shipped
                                    infra -> t_shipping: UPDATE - Mark the shipping as shipped
                                    activate t_shipping
                                        note right of t_shipping
                                            UPDATE shipping.t_shipping
                                            SET
                                                updated_by = '<sequence.userId>',
                                                updated_at = NOW() AT TIME ZONE 'UTC',
                                                status = 'SHIPPED',
                                                carrier_name = '<sequence.carrierName>',
                                                tracking_number = '<sequence.trackingNumber>',
                                                shipped_at = NOW() AT TIME ZONE 'UTC'
                                            WHERE id = '<sequence.shippingId>'
                                            AND status = 'PENDING' -- no row changed means the status changed in the meantime, answer 409 (E10006)
                                            RETURNING id as shipping_id, status, carrier_name, tracking_number, shipped_at
                                        end note
                                        t_shipping -> infra: Return updated result
                                    deactivate t_shipping
                                    infra -> app: Return the shipped shipping or no row
                                    alt No row changed: the status changed in the meantime
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10006 A shipping cannot change from <status> to SHIPPED.
                                        api -> page: Conflict
                                        page -> user: Display the status cannot change
                                    else Shipping is SHIPPED
                                        app -> infra: COMMIT
                                        app -> api: HTTP 200 S10000 Update Shipping Status Success: orderStatus unchanged
                                        api -> page: Return the shipping and the order status
                                        page -> user: Display the shipping shipped
                                    end
                                end
                            else status = RETURNED and the shipping is SHIPPED
                                app -> infra: UPDATE - Mark the shipping as returned
                                infra -> t_shipping: UPDATE - Mark the shipping as returned
                                activate t_shipping
                                    note right of t_shipping
                                        UPDATE shipping.t_shipping
                                        SET
                                            updated_by = '<sequence.userId>',
                                            updated_at = NOW() AT TIME ZONE 'UTC',
                                            status = 'RETURNED'
                                        WHERE id = '<sequence.shippingId>'
                                        AND status = 'SHIPPED' -- no row changed means the status changed in the meantime, answer 409 (E10006)
                                        RETURNING id as shipping_id, status, carrier_name, tracking_number, shipped_at
                                    end note
                                    t_shipping -> infra: Return updated result
                                deactivate t_shipping
                                infra -> app: Return the returned shipping or no row
                                alt No row changed: the status changed in the meantime
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10006 A shipping cannot change from <status> to RETURNED.
                                    api -> page: Conflict
                                    page -> user: Display the status cannot change
                                else Shipping is RETURNED
                                    app -> infra: QUERY - Count the shippings that are still active
                                    infra -> t_shipping: QUERY - Count the shippings that are still active
                                    activate t_shipping
                                        note right of t_shipping
                                            SELECT
                                                COUNT(s.id) as active_shippings
                                            FROM shipping.t_shipping s
                                            WHERE s.order_id = '<sequence.orderId>'
                                            AND s.row_status <> 'DELETED'
                                            AND s.status IN ('PENDING', 'SHIPPED', 'DELIVERED') -- read after the update, only after a cancel or a return
                                        end note
                                        t_shipping -> infra: Return query result
                                    deactivate t_shipping
                                    infra -> app: Return the number of PENDING, SHIPPED and DELIVERED shippings of the order
                                    alt The order is PROCESSING and no shipping is active any more
                                        app -> infra: UPDATE - Give the order back to PAYMENT_CONFIRMED
                                        infra -> t_order: UPDATE - Give the order back to PAYMENT_CONFIRMED
                                        activate t_order
                                            note right of t_order
                                                UPDATE sales.t_order
                                                SET
                                                    updated_by = '<sequence.userId>',
                                                    updated_at = NOW() AT TIME ZONE 'UTC',
                                                    status = 'PAYMENT_CONFIRMED'
                                                WHERE id = '<sequence.orderId>'
                                                AND status = 'PROCESSING' -- only when no shipping of the order is PENDING, SHIPPED or DELIVERED after a cancel or a return
                                                RETURNING id as order_id, status
                                            end note
                                            t_order -> infra: Return updated result
                                        deactivate t_order
                                        infra -> app: Return the order as PAYMENT_CONFIRMED
                                    end
                                    app -> infra: COMMIT
                                    app -> api: HTTP 200 S10000 Update Shipping Status Success: orderStatus after the request
                                    api -> page: Return the shipping and the order status
                                    page -> user: Display the shipping returned
                                end
                            else status = CANCELLED and the shipping is PENDING
                                app -> infra: UPDATE - Cancel the shipping
                                infra -> t_shipping: UPDATE - Cancel the shipping
                                activate t_shipping
                                    note right of t_shipping
                                        UPDATE shipping.t_shipping
                                        SET
                                            updated_by = '<sequence.userId>',
                                            updated_at = NOW() AT TIME ZONE 'UTC',
                                            status = 'CANCELLED'
                                        WHERE id = '<sequence.shippingId>'
                                        AND status = 'PENDING' -- no row changed means the status changed in the meantime, answer 409 (E10006)
                                        RETURNING id as shipping_id, status, carrier_name, tracking_number, shipped_at
                                    end note
                                    t_shipping -> infra: Return updated result
                                deactivate t_shipping
                                infra -> app: Return the cancelled shipping or no row
                                alt No row changed: the status changed in the meantime
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10006 A shipping cannot change from <status> to CANCELLED.
                                    api -> page: Conflict
                                    page -> user: Display the status cannot change
                                else Shipping is CANCELLED
                                    app -> infra: QUERY - Count the shippings that are still active
                                    infra -> t_shipping: QUERY - Count the shippings that are still active
                                    activate t_shipping
                                        note right of t_shipping
                                            SELECT
                                                COUNT(s.id) as active_shippings
                                            FROM shipping.t_shipping s
                                            WHERE s.order_id = '<sequence.orderId>'
                                            AND s.row_status <> 'DELETED'
                                            AND s.status IN ('PENDING', 'SHIPPED', 'DELIVERED') -- read after the update, only after a cancel or a return
                                        end note
                                        t_shipping -> infra: Return query result
                                    deactivate t_shipping
                                    infra -> app: Return the number of PENDING, SHIPPED and DELIVERED shippings of the order
                                    alt The order is PROCESSING and no shipping is active any more
                                        app -> infra: UPDATE - Give the order back to PAYMENT_CONFIRMED
                                        infra -> t_order: UPDATE - Give the order back to PAYMENT_CONFIRMED
                                        activate t_order
                                            note right of t_order
                                                UPDATE sales.t_order
                                                SET
                                                    updated_by = '<sequence.userId>',
                                                    updated_at = NOW() AT TIME ZONE 'UTC',
                                                    status = 'PAYMENT_CONFIRMED'
                                                WHERE id = '<sequence.orderId>'
                                                AND status = 'PROCESSING' -- only when no shipping of the order is PENDING, SHIPPED or DELIVERED after a cancel or a return
                                                RETURNING id as order_id, status
                                            end note
                                            t_order -> infra: Return updated result
                                        deactivate t_order
                                        infra -> app: Return the order as PAYMENT_CONFIRMED
                                    end
                                    app -> infra: COMMIT
                                    app -> api: HTTP 200 S10000 Update Shipping Status Success: orderStatus after the request
                                    api -> page: Return the shipping and the order status
                                    page -> user: Display the shipping cancelled
                                end
                            else Any other step of the status (DELIVERED is not set here; DELIVERED, CANCELLED and RETURNED are final)
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10006 A shipping cannot change from <status> to <status>.
                                api -> page: Conflict
                                page -> user: Display the status cannot change
                            end
                        end
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
