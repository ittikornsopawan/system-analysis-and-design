@startuml InquiryStorefrontShopProduct Sequence

title Inquiry Storefront Shop Product API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Storefront Shop Product Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_shop" as m_shop
    database "m_shop_type" as m_shop_type
    database "m_shop_image" as m_shop_image
    database "m_product_category" as m_product_category
    database "t_shop_product" as t_shop_product
    database "m_product_image" as m_product_image
end box

user -> page: Request Inquiry Storefront Shop Product
activate page
    page -> api: GET v1/storefront/shop/product
    activate api
        api -> app: [**InquiryStorefrontShopProductQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> infra: Execute database operations
                activate infra
                    app -> infra: QUERY - Get shop
                    infra -> m_shop: QUERY - Get shop
                    activate m_shop
                        note right of m_shop
                            SELECT
                                s.id as shop_id,
                                s.type_id,
                                s.name,
                                s.description
                            FROM shop.m_shop s
                            WHERE s.id = '<sequence.shopId>'
                            AND s.row_status = 'ACTIVE' -- a shop that is not ACTIVE has no page
                        end note
                        m_shop -> infra: Return query result
                    deactivate m_shop
                    infra -> app: Return result of Get shop
                deactivate infra
                alt The shop is not ACTIVE
                    app -> api: HTTP 404 E10004
                    api -> page: Not found
                    page -> user: Display not found error
                else The shop is ACTIVE
                    app -> infra: Execute database operations
                    activate infra
                        app -> infra: QUERY - Get shop type name
                        infra -> m_shop_type: QUERY - Get shop type name
                        activate m_shop_type
                            note right of m_shop_type
                                SELECT
                                    st.name as type_name
                                FROM shop.m_shop_type st
                                WHERE st.id = '<sequence.typeId>'
                            end note
                            m_shop_type -> infra: Return query result
                        deactivate m_shop_type
                        infra -> app: Return result of Get shop type name
                        app -> infra: QUERY - Get shop images
                        infra -> m_shop_image: QUERY - Get shop images
                        activate m_shop_image
                            note right of m_shop_image
                                SELECT
                                    si.id as image_id,
                                    si.type,
                                    si.image_path
                                FROM shop.m_shop_image si
                                WHERE si.shop_id = '<sequence.shopId>'
                                AND si.row_status = 'ACTIVE'
                                ORDER BY si.type, si.seq, si.created_at, si.id
                            end note
                            m_shop_image -> infra: Return query result
                        deactivate m_shop_image
                        infra -> app: Return result of Get shop images
                        app -> infra: QUERY - Get the category and its sub categories
                        infra -> m_product_category: QUERY - Get the category and its sub categories
                        activate m_product_category
                            note right of m_product_category
                                WITH RECURSIVE categories AS (
                                    SELECT pc.id
                                    FROM product.m_product_category pc
                                    WHERE pc.id = '<sequence.categoryId>' -- only when categoryId is specified
                                    AND pc.row_status <> 'DELETED'
                                    UNION ALL
                                    SELECT pc.id
                                    FROM product.m_product_category pc
                                    INNER JOIN categories c
                                        ON pc.parent_id = c.id
                                    WHERE pc.row_status <> 'DELETED'
                                )
                                SELECT
                                    c.id as category_id
                                FROM categories c
                            end note
                            m_product_category -> infra: Return query result
                        deactivate m_product_category
                        infra -> app: Return result of Get the category and its sub categories
                        app -> infra: QUERY - Get products of the shop
                        infra -> t_shop_product: QUERY - Get products of the shop
                        activate t_shop_product
                            note right of t_shop_product
                                WITH visible AS (
                                    SELECT
                                        sp.id as shop_product_id,
                                        sp.product_id,
                                        sp.created_at as listed_at,
                                        MIN(l.selling_price) as price_from,
                                        MAX(l.selling_price) as price_to
                                    FROM shop.t_shop_product sp
                                    INNER JOIN shop.t_shop_product_sku ssk
                                        ON ssk.shop_product_id = sp.id
                                        AND ssk.row_status = 'ACTIVE'
                                    INNER JOIN product.m_product_sku ps
                                        ON ps.id = ssk.sku_id
                                        AND ps.row_status = 'ACTIVE'
                                    LEFT JOIN shop.t_shop_product_sku_lot l
                                        ON l.shop_product_sku_id = ssk.id
                                        AND l.is_on_sale = TRUE
                                        AND l.row_status = 'ACTIVE'
                                        AND l.quantity > 0
                                    WHERE sp.shop_id = '<sequence.shopId>'
                                    AND sp.row_status = 'ACTIVE'
                                    GROUP BY sp.id, sp.product_id, sp.created_at
                                )
                                SELECT
                                    p.id as product_id,
                                    p.name,
                                    p.slug,
                                    v.price_from,
                                    v.price_to,
                                    CASE WHEN v.price_from IS NULL THEN 'OUT_OF_STOCK' ELSE 'IN_STOCK' END as stock_status
                                FROM visible v
                                INNER JOIN product.m_product p
                                    ON p.id = v.product_id
                                WHERE p.row_status = 'ACTIVE'
                                AND p.category_id IN ('<sequence.categoryIds>') -- only when categoryId is specified
                                AND (p.name ILIKE '%<sequence.search>%' OR p.description ILIKE '%<sequence.search>%') -- only when search is specified
                                AND v.price_from IS NOT NULL -- only when inStock is true
                                ORDER BY v.listed_at DESC, p.id -- sort NEWEST (default)
                                -- ORDER BY (v.price_from IS NULL), v.price_from, p.id (sort PRICE_ASC, the products out of stock last)
                                -- ORDER BY (v.price_from IS NULL), v.price_from DESC, p.id (sort PRICE_DESC, the products out of stock last)
                                -- ORDER BY p.name, p.id (sort NAME_ASC)
                                LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                            end note
                            t_shop_product -> infra: Return query result
                        deactivate t_shop_product
                        infra -> app: Return result of Get products of the shop
                        app -> infra: QUERY - Get total items
                        infra -> t_shop_product: QUERY - Get total items
                        activate t_shop_product
                            note right of t_shop_product
                                WITH visible AS (
                                    SELECT
                                        sp.id as shop_product_id,
                                        sp.product_id,
                                        MIN(l.selling_price) as price_from
                                    FROM shop.t_shop_product sp
                                    INNER JOIN shop.t_shop_product_sku ssk
                                        ON ssk.shop_product_id = sp.id
                                        AND ssk.row_status = 'ACTIVE'
                                    INNER JOIN product.m_product_sku ps
                                        ON ps.id = ssk.sku_id
                                        AND ps.row_status = 'ACTIVE'
                                    LEFT JOIN shop.t_shop_product_sku_lot l
                                        ON l.shop_product_sku_id = ssk.id
                                        AND l.is_on_sale = TRUE
                                        AND l.row_status = 'ACTIVE'
                                        AND l.quantity > 0
                                    WHERE sp.shop_id = '<sequence.shopId>'
                                    AND sp.row_status = 'ACTIVE'
                                    GROUP BY sp.id, sp.product_id, sp.created_at
                                )
                                SELECT
                                    COUNT(p.id) as total_items
                                FROM visible v
                                INNER JOIN product.m_product p
                                    ON p.id = v.product_id
                                WHERE p.row_status = 'ACTIVE'
                                AND p.category_id IN ('<sequence.categoryIds>') -- only when categoryId is specified
                                AND (p.name ILIKE '%<sequence.search>%' OR p.description ILIKE '%<sequence.search>%') -- only when search is specified
                                AND v.price_from IS NOT NULL -- only when inStock is true
                            end note
                            t_shop_product -> infra: Return query result
                        deactivate t_shop_product
                        infra -> app: Return result of Get total items
                    deactivate infra
                    alt The shop has no product to show
                        app -> domain: Prepare the response with the shop and empty items
                        activate domain
                            domain -> app: Return response data
                        deactivate domain
                        app -> api: HTTP 200 S10000
                        api -> page: Return success response
                        page -> user: Display success result
                    else Products found
                        app -> infra: Execute database operations
                        activate infra
                            app -> infra: QUERY - Get the first image of each product
                            infra -> m_product_image: QUERY - Get the first image of each product
                            activate m_product_image
                                note right of m_product_image
                                    SELECT DISTINCT ON (pi.product_id)
                                        pi.product_id,
                                        pi.image_path
                                    FROM product.m_product_image pi
                                    WHERE pi.product_id IN ('<sequence.productIds>')
                                    AND pi.option_value_id IS NULL
                                    AND pi.row_status = 'ACTIVE'
                                    ORDER BY pi.product_id, pi.created_at, pi.id
                                end note
                                m_product_image -> infra: Return query result
                            deactivate m_product_image
                            infra -> app: Return result of Get the first image of each product
                        deactivate infra
                        alt Processing times out
                            app -> api: HTTP 408 E90001
                            api -> page: Request timeout
                            page -> user: Display timeout error
                        else Processing completes in time
                            app -> domain: Apply domain rules and prepare response
                            activate domain
                                domain -> app: Return response data
                            deactivate domain
                            app -> api: HTTP 200 S10000
                            api -> page: Return success response
                            page -> user: Display success result
                        end
                    end
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
