@startuml UpsertShopUser Sequence

title Upsert Shop User API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Shop User Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_shop" as m_shop
    database "m_user" as m_user
    database "t_shop_user" as t_shop_user
    database "m_role" as m_role
    database "t_user_role" as t_user_role
end box

user -> page: Submit Upsert Shop User
activate page
    page -> api: POST v1/shop/user/upsert
    activate api
        api -> app: [**UpsertShopUserCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature/issuer/audience/exp/UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Display authentication error
                else Verified JWT
                    app -> app: userId = verified sub
                    note over app, infra
                        - Concurrency: when the service checks the rule of the last ADMIN it must lock the row of the shop (`shop.m_shop`, for example with `SELECT ... FOR
                          UPDATE`) in the same transaction, so that two requests that leave the shop at the same time cannot leave it without an ADMIN. The lock is part of
                          the service, no SQL of it is written in this document.
                        - Execution order: validate the request (400) -> existence checks (404) -> permission (403) -> duplicate member check (409, E10003) -> write -> ADMIN
                          rule on the result (409, E10006, the request is rolled back).
                    end note
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                            app -> infra: QUERY - Check shop
                            infra -> m_shop: QUERY - Check shop
                            activate m_shop
                                note right of m_shop
                                    SELECT
                                        s.id as shop_id
                                    FROM shop.m_shop s
                                    WHERE s.id = '<sequence.shopId>'
                                    AND s.row_status = 'ACTIVE'
                                end note
                                m_shop -> infra: Return query result
                            deactivate m_shop
                            infra -> app: Return result of Check shop
                            alt shop not found or not ACTIVE
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10005 Shop not found.
                                api -> page: Not found
                                page -> user: Display error message
                            end
                            app -> infra: QUERY - Check user
                            infra -> m_user: QUERY - Check user
                            activate m_user
                                note right of m_user
                                    SELECT
                                        u.id as user_id
                                    FROM authen.m_user u
                                    WHERE u.id = '<sequence.userId>'
                                    AND u.row_status = 'ACTIVE'
                                end note
                                m_user -> infra: Return query result
                            deactivate m_user
                            infra -> app: Return result of Check user
                            alt user not found or not ACTIVE
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10005 User not found.
                                api -> page: Not found
                                page -> user: Display error message
                            end
                            alt id is specified
                                app -> infra: QUERY - Check existing shop user
                                infra -> t_shop_user: QUERY - Check existing shop user
                                activate t_shop_user
                                    note right of t_shop_user
                                        SELECT
                                            su.id as shop_user_id,
                                            su.shop_id,
                                            su.user_id,
                                            su.role
                                        FROM shop.t_shop_user su
                                        WHERE su.id = '<sequence.id>'
                                        AND su.row_status <> 'DELETED' -- the id of a DELETED shop user counts as not found
                                    end note
                                    t_shop_user -> infra: Return query result
                                deactivate t_shop_user
                                infra -> app: Return result of Check existing shop user
                                alt shop user not found or DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10004 Shop user not found.
                                    api -> page: Not found
                                    page -> user: Display error message
                                end
                            end
                            app -> infra: QUERY - Check shop administrator
                            infra -> t_shop_user: QUERY - Check shop administrator
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.id as shop_user_id
                                    FROM shop.t_shop_user su
                                    WHERE su.shop_id = '<sequence.shopId>'
                                    AND su.user_id = '<sequence.userId>'
                                    AND su.role = 'ADMIN'
                                    AND su.row_status = 'ACTIVE'
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return result of Check shop administrator
                            app -> infra: QUERY - Check shop member
                            infra -> t_shop_user: QUERY - Check shop member
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.id as shop_user_id
                                    FROM shop.t_shop_user su
                                    WHERE su.shop_id = '<sequence.shopId>'
                                    AND su.user_id = '<sequence.userId>'
                                    AND su.role IN ('ADMIN', 'STAFF')
                                    AND su.row_status = 'ACTIVE'
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return result of Check shop member
                            app -> infra: QUERY - Get the platform administrator role
                            infra -> m_role: QUERY - Get the platform administrator role
                            activate m_role
                                note right of m_role
                                    SELECT
                                        r.id as role_id
                                    FROM author.m_role r
                                    WHERE r.name = 'PLATFORM_ADMIN'
                                    AND r.row_status = 'ACTIVE'
                                end note
                                m_role -> infra: Return query result
                            deactivate m_role
                            infra -> app: Return result of Get the platform administrator role
                            app -> infra: QUERY - Check platform administrator
                            infra -> t_user_role: QUERY - Check platform administrator
                            activate t_user_role
                                note right of t_user_role
                                    SELECT
                                        ur.id as user_role_id
                                    FROM author.t_user_role ur
                                    WHERE ur.user_id = '<sequence.userId>'
                                    AND ur.role_id = '<sequence.roleId>'
                                    AND ur.row_status = 'ACTIVE'
                                end note
                                t_user_role -> infra: Return query result
                            deactivate t_user_role
                            infra -> app: Return result of Check platform administrator
                            alt caller is not an ADMIN of the shop, not a platform administrator and not a STAFF member leaving their own membership
                                app -> infra: ROLLBACK
                                app -> api: HTTP 403 E10009 You do not have permission to manage the members of the shop.
                                api -> page: Forbidden
                                page -> user: Display error message
                            end
                            app -> infra: QUERY - Check duplicate member
                            infra -> t_shop_user: QUERY - Check duplicate member
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.id as shop_user_id
                                    FROM shop.t_shop_user su
                                    WHERE su.shop_id = '<sequence.shopId>'
                                    AND su.user_id = '<sequence.userId>'
                                    AND su.row_status <> 'DELETED'
                                    AND su.id <> '<sequence.id>' -- only when id is specified
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return result of Check duplicate member
                            alt the user already has a member row in the shop
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10003 The user is already a member of the shop.
                                api -> page: Conflict
                                page -> user: Display error message
                            end
                            alt id is not specified (insert)
                                app -> infra: INSERT - Create shop user
                                infra -> t_shop_user: INSERT - Create shop user
                                activate t_shop_user
                                    note right of t_shop_user
                                        INSERT INTO shop.t_shop_user (
                                            created_by,
                                            row_status,
                                            shop_id,
                                            user_id,
                                            role
                                        )
                                        VALUES (
                                            &#39;<sequence.createdBy>',
                                            &#39;<sequence.rowStatus>',
                                            &#39;<sequence.shopId>',
                                            &#39;<sequence.userId>',
                                            &#39;<sequence.role>' -- STAFF when not specified
                                        )
                                        RETURNING id as shop_user_id
                                    end note
                                    t_shop_user -> infra: Return inserted result
                                deactivate t_shop_user
                                infra -> app: Return result of Create shop user
                            else id is specified (update, delete or archive)
                                app -> infra: UPDATE - Update, archive or delete shop user
                                infra -> t_shop_user: UPDATE - Update, archive or delete shop user
                                activate t_shop_user
                                    note right of t_shop_user
                                        UPDATE shop.t_shop_user
                                        SET
                                            updated_by = '<sequence.updatedBy>',
                                            updated_at = NOW() AT TIME ZONE 'UTC',
                                            row_status = '<sequence.rowStatus>',
                                            role = '<sequence.role>' -- only when role is specified
                                        WHERE id = '<sequence.id>'
                                        AND shop_id = '<sequence.shopId>'
                                        AND user_id = '<sequence.userId>'
                                        RETURNING id as shop_user_id
                                    end note
                                    t_shop_user -> infra: Return updated result
                                deactivate t_shop_user
                                infra -> app: Return result of Update, archive or delete shop user
                            end
                            app -> infra: QUERY - Count the ADMIN members of the shop after the write
                            infra -> t_shop_user: QUERY - Count the ADMIN members of the shop after the write
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        COUNT(su.id) as admin_count
                                    FROM shop.t_shop_user su
                                    WHERE su.shop_id = '<sequence.shopId>'
                                    AND su.role = 'ADMIN'
                                    AND su.row_status = 'ACTIVE' -- the request is rolled back when the count is 0
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return result of Count the ADMIN members of the shop after the write
                            alt the shop would have no ACTIVE ADMIN member left; the whole request is rolled back
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10006 The shop must keep at least one ADMIN.
                                api -> page: Conflict
                                page -> user: Display error message
                            end
                            app -> infra: COMMIT
                            alt id is not specified (insert)
                                app -> api: HTTP 201 S10000
                                api -> page: Return committed result
                                page -> user: Display success result
                            else rowStatus is DELETED (delete)
                                app -> api: HTTP 204 No Content, no response body
                                api -> page: Return committed result
                                page -> user: Display success result
                            else update or archive
                                app -> api: HTTP 200 S10000
                                api -> page: Return committed result
                                page -> user: Display success result
                            end
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
