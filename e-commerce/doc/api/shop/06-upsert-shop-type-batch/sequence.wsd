@startuml UpsertShopTypeBatch Sequence

title Upsert Shop Type Batch API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Shop Type Batch Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "m_shop_type" as m_shop_type
    database "m_shop" as m_shop
end box

user -> page: Submit Upsert Shop Type Batch
activate page
    page -> api: POST v1/shop/type/upsert/batch
    activate api
        api -> app: [**UpsertShopTypeBatchCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub and the roles claim as unique non-empty strings (an empty array is valid)
                alt Missing, malformed or invalid JWT or roles claim
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Display authentication error
                else Verified JWT
                    app -> app: callerUserId = verified sub; accessTokenHash = SHA-256 of the exact JWT; createdBy/updatedBy = caller UUID string
                    note over app, infra
                        - Order of checks: validate the request (400) -> verify the JWT and its roles claim (401) -> BEGIN -> lock the caller user (FOR UPDATE) -> current credential and user (401) ->
                          lock and existence checks in ascending id order (FOR UPDATE, 404) -> permission from the roles claim (403, E10009, once for the request) so the 403 message has no item position -> duplicate, in-use and other
                          conflicts (409) -> write -> COMMIT; the author tables are never queried.
                    end note
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                            app -> infra: QUERY - Lock the caller user
                            infra -> m_user: QUERY - Lock the caller user
                            activate m_user
                                note right of m_user
                                    SELECT
                                        u.id as user_id
                                    FROM authen.m_user u
                                    WHERE u.id = '<sequence.callerUserId>'
                                    FOR UPDATE
                                end note
                                m_user -> infra: Return locked caller user or no row
                            deactivate m_user
                            infra -> app: Return locked caller user or no row
                            alt Caller user missing
                                break Reject this request
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                                    api -> page: Show failure; no successful shop type action
                                    page -> user: Display failure; keep unsaved input
                                end break
                            else Check passed
                            end
                            app -> app: Capture fresh server UTC now after the caller lock; recheck JWT exp
                            alt JWT expired while waiting for the caller lock
                                break Reject this request
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                                    api -> page: Show failure; no successful shop type action
                                    page -> user: Display failure; keep unsaved input
                                end break
                            else Check passed
                            end
                            app -> infra: QUERY - Check current credential and user
                            infra -> t_user_access_token: QUERY - Check current credential and user
                            activate t_user_access_token
                                note right of t_user_access_token
                                    SELECT
                                        at.id as access_token_id
                                    FROM authen.t_user_access_token at
                                    JOIN authen.m_user u ON u.id = at.user_id
                                    WHERE at.token = '<sequence.accessTokenHash>'
                                    AND at.user_id = '<sequence.callerUserId>'
                                    AND at.row_status = 'ACTIVE'
                                    AND at.expired_at > '<sequence.now>'
                                    AND u.row_status = 'ACTIVE'
                                end note
                                t_user_access_token -> infra: Return ACTIVE matching unexpired token/user or no row
                            deactivate t_user_access_token
                            infra -> app: Return ACTIVE matching unexpired token/user or no row
                            alt Current token/user missing/inactive/revoked/expired/mismatched
                                break Reject this request
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                                    api -> page: Show failure; no successful shop type action
                                    page -> user: Display failure; keep unsaved input
                                end break
                            else Check passed
                            end
                            loop For each item with an id, in ascending id order (lock order)
                                alt id is specified
                                    app -> infra: QUERY - Check existing shop type
                                    infra -> m_shop_type: QUERY - Check existing shop type
                                    activate m_shop_type
                                        note right of m_shop_type
                                            SELECT
                                                st.id as shop_type_id
                                            FROM shop.m_shop_type st
                                            WHERE st.id = '<sequence.shopTypes.id>'
                                            AND st.row_status <> 'DELETED' -- the id of a DELETED shop type counts as not found
                                            FOR UPDATE
                                        end note
                                        m_shop_type -> infra: Return query result
                                    deactivate m_shop_type
                                    infra -> app: Return result of Check existing shop type
                                    alt items[i]: shop type not found or DELETED
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 404 E10004 items[i]: Shop type not found.
                                        api -> page: Not found
                                        page -> user: Display error message
                                    end
                                end
                            end
                            app -> app: Authorize once using only exact case-sensitive PLATFORM_ADMIN in the verified JWT roles; never reload live grants
                            alt The verified roles claim has no PLATFORM_ADMIN
                                app -> infra: ROLLBACK
                                app -> api: HTTP 403 E10009 You do not have permission to manage shop types.
                                api -> page: Forbidden
                                page -> user: Display error message
                            end
                            loop For each item (request order, one transaction)
                                app -> infra: QUERY - Check duplicate name
                                infra -> m_shop_type: QUERY - Check duplicate name
                                activate m_shop_type
                                    note right of m_shop_type
                                        SELECT
                                            st.id as shop_type_id
                                        FROM shop.m_shop_type st
                                        WHERE st.name = '<sequence.shopTypes.name>'
                                        AND st.row_status <> 'DELETED'
                                        AND st.id <> '<sequence.shopTypes.id>' -- only when id is specified
                                    end note
                                    m_shop_type -> infra: Return query result
                                deactivate m_shop_type
                                infra -> app: Return result of Check duplicate name
                                alt items[i]: name is held by another shop type that is not DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10003 items[i]: Shop type name already exists.
                                    api -> page: Conflict
                                    page -> user: Display error message
                                end
                                alt rowStatus is DELETED or ARCHIVED
                                    app -> infra: QUERY - Check shop in use
                                    infra -> m_shop: QUERY - Check shop in use
                                    activate m_shop
                                        note right of m_shop
                                            SELECT
                                                s.id as shop_id
                                            FROM shop.m_shop s
                                            WHERE s.type_id = '<sequence.shopTypes.id>' -- only when rowStatus is DELETED or ARCHIVED
                                            AND s.row_status <> 'DELETED'
                                        end note
                                        m_shop -> infra: Return query result
                                    deactivate m_shop
                                    infra -> app: Return result of Check shop in use
                                    alt items[i]: a shop that is not DELETED uses the shop type
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10006 items[i]: Shop type is used by shops.
                                        api -> page: Conflict
                                        page -> user: Display error message
                                    end
                                end
                                alt id is not specified (insert)
                                    app -> infra: INSERT - Create shop type
                                    infra -> m_shop_type: INSERT - Create shop type
                                    activate m_shop_type
                                        note right of m_shop_type
                                            INSERT INTO shop.m_shop_type (
                                                created_by,
                                                row_status,
                                                name,
                                                description
                                            )
                                            VALUES (
                                                &#39;<sequence.createdBy>',
                                                &#39;<sequence.shopTypes.rowStatus>',
                                                &#39;<sequence.shopTypes.name>',
                                                &#39;<sequence.shopTypes.description>'
                                            )
                                            RETURNING id as shop_type_id
                                        end note
                                        m_shop_type -> infra: Return inserted result
                                    deactivate m_shop_type
                                    infra -> app: Return result of Create shop type
                                else id is specified (update, delete or archive)
                                    app -> infra: UPDATE - Update or delete shop type
                                    infra -> m_shop_type: UPDATE - Update or delete shop type
                                    activate m_shop_type
                                        note right of m_shop_type
                                            UPDATE shop.m_shop_type
                                            SET
                                                updated_by = '<sequence.updatedBy>',
                                                updated_at = NOW() AT TIME ZONE 'UTC',
                                                row_status = '<sequence.shopTypes.rowStatus>',
                                                name = '<sequence.shopTypes.name>',
                                                description = '<sequence.shopTypes.description>'
                                            WHERE id = '<sequence.shopTypes.id>'
                                            RETURNING id as shop_type_id
                                        end note
                                        m_shop_type -> infra: Return updated result
                                    deactivate m_shop_type
                                    infra -> app: Return result of Update or delete shop type
                                end
                            end
                            app -> infra: COMMIT
                            app -> api: HTTP 200 S10000 with the result of every item
                            api -> page: Return committed result
                            page -> user: Display success result
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
