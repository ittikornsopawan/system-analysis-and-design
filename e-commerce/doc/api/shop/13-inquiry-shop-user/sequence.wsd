@startuml InquiryShopUser Sequence

title Inquiry Shop User API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Shop User Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_user_access_token" as t_user_access_token
    database "t_shop_user" as t_shop_user
end box

user -> page: Request Inquiry Shop User
activate page
    page -> api: GET v1/shop/user
    activate api
        api -> app: [**InquiryShopUserQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub and the roles claim as unique non-empty strings (an empty array is valid)
                alt Missing, malformed or invalid JWT or roles claim
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Unauthorized
                    page -> user: Display unauthorized error
                else Access token is valid
                    app -> app: callerUserId = verified sub; accessTokenHash = SHA-256 of the exact JWT; isPlatformAdmin = roles contains PLATFORM_ADMIN (no database query)
                    note over app, infra
                        - Execution order: validate the request (400) -> verify the JWT and its roles claim (401) -> BEGIN READ ONLY -> fresh now and expiry recheck (401) -> current credential and user (401) ->
                          shop member check -> permission (403: a member of the shop, or PLATFORM_ADMIN in the verified roles claim) -> page -> total -> COMMIT -> 200. The caller user is not locked: a read-only
                          transaction takes no lock. The author tables are never queried; the membership of the shop is not a token claim and is still read from shop.t_shop_user. Every rejection after BEGIN rolls back.
                    end note
                    app -> infra: BEGIN REPEATABLE READ READ ONLY
                    activate infra
                    alt Work completes before commit
                        app -> app: Capture fresh server UTC now; recheck JWT exp
                        alt JWT expired
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 401 E10002 Invalid or expired access token.
                                api -> page: Show failure; no successful shop user list action
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                        app -> infra: QUERY - Check current credential and user
                        infra -> t_user_access_token: QUERY - Check current credential and user
                        activate t_user_access_token
                            note right of t_user_access_token
                                SELECT
                                    at.id as access_token_id
                                FROM authen.t_user_access_token at
                                JOIN authen.m_user u ON u.id = at.user_id
                                WHERE at.token = '<sequence.accessTokenHash>'
                                AND at.user_id = '<sequence.callerUserId>'
                                AND at.row_status = 'ACTIVE'
                                AND at.expired_at > '<sequence.now>'
                                AND u.row_status = 'ACTIVE'
                            end note
                            t_user_access_token -> infra: Return ACTIVE matching unexpired token/user or no row
                        deactivate t_user_access_token
                        infra -> app: Return ACTIVE matching unexpired token/user or no row
                        alt Current token/user missing/inactive/revoked/expired/mismatched
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 401 E10002 Invalid or expired access token.
                                api -> page: Show failure; no successful shop user list action
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                        app -> infra: QUERY - Check shop member
                        infra -> t_shop_user: QUERY - Check shop member
                        activate t_shop_user
                            note right of t_shop_user
                                SELECT
                                    su.id as shop_user_id
                                FROM shop.t_shop_user su
                                WHERE su.shop_id = '<sequence.shopId>' -- only when shopId is specified
                                AND su.user_id = '<sequence.callerUserId>'
                                AND su.role IN ('ADMIN', 'STAFF')
                                AND su.row_status = 'ACTIVE'
                            end note
                            t_shop_user -> infra: Return query result
                        deactivate t_shop_user
                        infra -> app: Return result of Check shop member
                    alt shopId is given and the caller is not a member of the shop, or userId is not the caller and the verified roles claim has no PLATFORM_ADMIN
                        app -> infra: ROLLBACK
                        app -> api: HTTP 403 E10009 You do not have permission to view the members of this shop.
                        api -> page: Forbidden
                        page -> user: Display error message
                    else The caller may read
                            app -> infra: QUERY - Get shop users
                            infra -> t_shop_user: QUERY - Get shop users
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.id as shop_user_id,
                                        su.shop_id,
                                        s.name as shop_name,
                                        su.user_id,
                                        u.display_name,
                                        u.profile_picture_path,
                                        su.role,
                                        su.row_status
                                    FROM shop.t_shop_user su
                                    INNER JOIN shop.m_shop s
                                        ON s.id = su.shop_id
                                    INNER JOIN authen.m_user u
                                        ON u.id = su.user_id
                                    WHERE su.row_status <> 'DELETED'
                                    AND s.row_status <> 'DELETED'
                                    AND su.id = '<sequence.id>' -- only when id is specified
                                    AND su.shop_id = '<sequence.shopId>' -- only when shopId is specified
                                    AND su.user_id = '<sequence.userId>' -- only when userId is specified
                                    AND su.role = '<sequence.role>' -- only when role is specified
                                    AND su.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                                    AND u.display_name ILIKE '%<sequence.search>%' -- only when search is specified
                                    ORDER BY su.created_at DESC, su.id
                                    LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return result of Get shop users
                            app -> infra: QUERY - Get total items
                            infra -> t_shop_user: QUERY - Get total items
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        COUNT(su.id) as total_items
                                    FROM shop.t_shop_user su
                                    INNER JOIN shop.m_shop s
                                        ON s.id = su.shop_id
                                    INNER JOIN authen.m_user u
                                        ON u.id = su.user_id
                                    WHERE su.row_status <> 'DELETED'
                                    AND s.row_status <> 'DELETED'
                                    AND su.id = '<sequence.id>' -- only when id is specified
                                    AND su.shop_id = '<sequence.shopId>' -- only when shopId is specified
                                    AND su.user_id = '<sequence.userId>' -- only when userId is specified
                                    AND su.role = '<sequence.role>' -- only when role is specified
                                    AND su.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                                    AND u.display_name ILIKE '%<sequence.search>%' -- only when search is specified
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return result of Get total items
                        alt Processing times out
                            app -> infra: ROLLBACK
                            app -> api: HTTP 408 E90001
                            api -> page: Request timeout
                            page -> user: Display timeout error
                        else Processing completes in time
                            app -> infra: COMMIT
                            infra -> app: Return committed read
                            app -> domain: Apply domain rules and prepare response
                            activate domain
                                domain -> app: Return response data
                            deactivate domain
                            app -> api: HTTP 200 S10000
                            api -> page: Return success response
                            page -> user: Display success result
                        end
                    end
                    else Unexpected SQL/result/mapping failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 Internal Server Error; omit bizCode
                        api -> page: Internal server error
                        page -> user: Display the outcome
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
