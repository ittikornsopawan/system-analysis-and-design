@startuml InquiryShopUser Sequence

title Inquiry Shop User API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Shop User Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_shop_user" as t_shop_user
    database "m_role" as m_role
    database "t_user_role" as t_user_role
end box

user -> page: Request Inquiry Shop User
activate page
    page -> api: GET v1/shop/user
    activate api
        api -> app: [**InquiryShopUserQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify the access token (signature and expiry)
                alt Access token is missing, invalid or expired
                    app -> api: HTTP 401 E10002
                    api -> page: Unauthorized
                    page -> user: Display unauthorized error
                else Access token is valid
                    app -> infra: Execute database operations
                    activate infra
                        app -> infra: QUERY - Check shop member
                        infra -> t_shop_user: QUERY - Check shop member
                        activate t_shop_user
                            note right of t_shop_user
                                SELECT
                                    su.id as shop_user_id
                                FROM shop.t_shop_user su
                                WHERE su.shop_id = '<sequence.shopId>' -- only when shopId is specified
                                AND su.user_id = '<sequence.callerUserId>'
                                AND su.role IN ('ADMIN', 'STAFF')
                                AND su.row_status = 'ACTIVE'
                            end note
                            t_shop_user -> infra: Return query result
                        deactivate t_shop_user
                        infra -> app: Return result of Check shop member
                        app -> infra: QUERY - Get the platform administrator role
                        infra -> m_role: QUERY - Get the platform administrator role
                        activate m_role
                            note right of m_role
                                SELECT
                                    r.id as role_id
                                FROM author.m_role r
                                WHERE r.name = 'PLATFORM_ADMIN'
                                AND r.row_status = 'ACTIVE'
                            end note
                            m_role -> infra: Return query result
                        deactivate m_role
                        infra -> app: Return result of Get the platform administrator role
                        app -> infra: QUERY - Check platform administrator
                        infra -> t_user_role: QUERY - Check platform administrator
                        activate t_user_role
                            note right of t_user_role
                                SELECT
                                    ur.id as user_role_id
                                FROM author.t_user_role ur
                                WHERE ur.user_id = '<sequence.callerUserId>'
                                AND ur.role_id = '<sequence.roleId>'
                                AND ur.row_status = 'ACTIVE'
                            end note
                            t_user_role -> infra: Return query result
                        deactivate t_user_role
                        infra -> app: Return result of Check platform administrator
                    deactivate infra
                    alt shopId is given and the caller is not a member of the shop, or userId is not the caller and the caller is not a platform administrator
                        app -> api: HTTP 403 E10009
                        api -> page: Forbidden
                        page -> user: Display error message
                    else The caller may read
                        app -> infra: Execute database operations
                        activate infra
                            app -> infra: QUERY - Get shop users
                            infra -> t_shop_user: QUERY - Get shop users
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.id as shop_user_id,
                                        su.shop_id,
                                        s.name as shop_name,
                                        su.user_id,
                                        u.display_name,
                                        u.profile_picture_path,
                                        su.role,
                                        su.row_status
                                    FROM shop.t_shop_user su
                                    INNER JOIN shop.m_shop s
                                        ON s.id = su.shop_id
                                    INNER JOIN authen.m_user u
                                        ON u.id = su.user_id
                                    WHERE su.row_status <> 'DELETED'
                                    AND s.row_status <> 'DELETED'
                                    AND su.id = '<sequence.id>' -- only when id is specified
                                    AND su.shop_id = '<sequence.shopId>' -- only when shopId is specified
                                    AND su.user_id = '<sequence.userId>' -- only when userId is specified
                                    AND su.role = '<sequence.role>' -- only when role is specified
                                    AND su.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                                    AND u.display_name ILIKE '%<sequence.search>%' -- only when search is specified
                                    ORDER BY su.created_at DESC, su.id
                                    LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return result of Get shop users
                            app -> infra: QUERY - Get total items
                            infra -> t_shop_user: QUERY - Get total items
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        COUNT(su.id) as total_items
                                    FROM shop.t_shop_user su
                                    INNER JOIN shop.m_shop s
                                        ON s.id = su.shop_id
                                    INNER JOIN authen.m_user u
                                        ON u.id = su.user_id
                                    WHERE su.row_status <> 'DELETED'
                                    AND s.row_status <> 'DELETED'
                                    AND su.id = '<sequence.id>' -- only when id is specified
                                    AND su.shop_id = '<sequence.shopId>' -- only when shopId is specified
                                    AND su.user_id = '<sequence.userId>' -- only when userId is specified
                                    AND su.role = '<sequence.role>' -- only when role is specified
                                    AND su.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                                    AND u.display_name ILIKE '%<sequence.search>%' -- only when search is specified
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return result of Get total items
                        deactivate infra
                        alt Processing times out
                            app -> api: HTTP 408 E90001
                            api -> page: Request timeout
                            page -> user: Display timeout error
                        else Processing completes in time
                            app -> domain: Apply domain rules and prepare response
                            activate domain
                                domain -> app: Return response data
                            deactivate domain
                            app -> api: HTTP 200 S10000
                            api -> page: Return success response
                            page -> user: Display success result
                        end
                    end
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
