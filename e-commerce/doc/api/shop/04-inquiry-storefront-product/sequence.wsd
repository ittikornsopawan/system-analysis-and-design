@startuml InquiryStorefrontProduct Sequence

title Inquiry Storefront Product API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Storefront Product Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_shop_product" as t_shop_product
    database "m_product" as m_product
    database "m_product_sku" as m_product_sku
    database "m_product_image" as m_product_image
    database "m_product_option" as m_product_option
    database "m_product_option_value" as m_product_option_value
    database "m_product_sku_option_value" as m_product_sku_option_value
    database "t_shop_product_sku_lot" as t_shop_product_sku_lot
end box

user -> page: Request Inquiry Storefront Product
activate page
    page -> api: GET v1/storefront/product
    activate api
        api -> app: [**InquiryStorefrontProductQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> infra: Execute database operations
                activate infra
                    app -> infra: QUERY - Get shop product
                    infra -> t_shop_product: QUERY - Get shop product
                    activate t_shop_product
                        note right of t_shop_product
                            SELECT
                                sp.id as shop_product_id,
                                sp.shop_id,
                                sp.product_id
                            FROM shop.t_shop_product sp
                            INNER JOIN shop.m_shop s
                                ON s.id = sp.shop_id
                                AND s.row_status = 'ACTIVE' -- a shop that is not ACTIVE has no page
                            WHERE sp.shop_id = '<sequence.shopId>'
                            AND sp.product_id = '<sequence.productId>'
                            AND sp.row_status = 'ACTIVE'
                        end note
                        t_shop_product -> infra: Return query result
                    deactivate t_shop_product
                    infra -> app: Return result of Get shop product
                deactivate infra
                alt The shop is not ACTIVE or does not list the product
                    app -> api: HTTP 404 E10004
                    api -> page: Not found
                    page -> user: Display not found error
                else The shop lists the product
                    app -> infra: Execute database operations
                    activate infra
                        app -> infra: QUERY - Get product
                        infra -> m_product: QUERY - Get product
                        activate m_product
                            note right of m_product
                                SELECT
                                    p.id as product_id,
                                    p.name,
                                    p.slug,
                                    p.description,
                                    p.body
                                FROM product.m_product p
                                WHERE p.id = '<sequence.productId>'
                                AND p.row_status = 'ACTIVE'
                            end note
                            m_product -> infra: Return query result
                        deactivate m_product
                        infra -> app: Return result of Get product
                    deactivate infra
                    alt The product is not ACTIVE
                        app -> api: HTTP 404 E10004
                        api -> page: Not found
                        page -> user: Display not found error
                    else The product is ACTIVE
                        app -> infra: Execute database operations
                        activate infra
                            app -> infra: QUERY - Get SKUs of the product that the shop sells
                            infra -> m_product_sku: QUERY - Get SKUs of the product that the shop sells
                            activate m_product_sku
                                note right of m_product_sku
                                    SELECT
                                        ps.id as sku_id,
                                        ssk.id as shop_product_sku_id,
                                        ps.name,
                                        ps.combination_key
                                    FROM product.m_product_sku ps
                                    INNER JOIN shop.t_shop_product_sku ssk
                                        ON ssk.sku_id = ps.id
                                        AND ssk.shop_product_id = '<sequence.shopProductId>'
                                        AND ssk.row_status = 'ACTIVE'
                                    WHERE ps.product_id = '<sequence.productId>'
                                    AND ps.row_status = 'ACTIVE'
                                end note
                                m_product_sku -> infra: Return query result
                            deactivate m_product_sku
                            infra -> app: Return result of Get SKUs of the product that the shop sells
                        deactivate infra
                        alt The shop sells no ACTIVE SKU of the product
                            app -> api: HTTP 404 E10004
                            api -> page: Not found
                            page -> user: Display not found error
                        else The shop sells SKUs of the product
                            app -> infra: Execute database operations
                            activate infra
                                app -> infra: QUERY - Get product level images
                                infra -> m_product_image: QUERY - Get product level images
                                activate m_product_image
                                    note right of m_product_image
                                        SELECT
                                            pi.id as image_id,
                                            pi.image_path
                                        FROM product.m_product_image pi
                                        WHERE pi.product_id = '<sequence.productId>'
                                        AND pi.option_value_id IS NULL
                                        AND pi.row_status = 'ACTIVE'
                                        ORDER BY pi.created_at
                                    end note
                                    m_product_image -> infra: Return query result
                                deactivate m_product_image
                                infra -> app: Return result of Get product level images
                                app -> infra: QUERY - Get options
                                infra -> m_product_option: QUERY - Get options
                                activate m_product_option
                                    note right of m_product_option
                                        SELECT
                                            po.id as option_id,
                                            po.name,
                                            po.level_no
                                        FROM product.m_product_option po
                                        WHERE po.product_id = '<sequence.productId>'
                                        AND po.row_status = 'ACTIVE'
                                        ORDER BY po.level_no
                                    end note
                                    m_product_option -> infra: Return query result
                                deactivate m_product_option
                                infra -> app: Return result of Get options
                                app -> infra: QUERY - Get ACTIVE option values
                                infra -> m_product_option_value: QUERY - Get ACTIVE option values
                                activate m_product_option_value
                                    note right of m_product_option_value
                                        SELECT
                                            pov.id as value_id,
                                            pov.option_id,
                                            pov.value,
                                            pov.sort_order
                                        FROM product.m_product_option_value pov
                                        WHERE pov.option_id IN ('<sequence.optionIds>')
                                        AND pov.row_status = 'ACTIVE'
                                        ORDER BY pov.sort_order
                                    end note
                                    m_product_option_value -> infra: Return query result
                                deactivate m_product_option_value
                                infra -> app: Return result of Get ACTIVE option values
                                app -> infra: QUERY - Get option value images
                                infra -> m_product_image: QUERY - Get option value images
                                activate m_product_image
                                    note right of m_product_image
                                        SELECT
                                            pi.id as image_id,
                                            pi.option_value_id,
                                            pi.image_path
                                        FROM product.m_product_image pi
                                        WHERE pi.option_value_id IN ('<sequence.optionValueIds>')
                                        AND pi.row_status = 'ACTIVE'
                                        ORDER BY pi.created_at
                                    end note
                                    m_product_image -> infra: Return query result
                                deactivate m_product_image
                                infra -> app: Return result of Get option value images
                                app -> infra: QUERY - Get option values of the SKUs
                                infra -> m_product_sku_option_value: QUERY - Get option values of the SKUs
                                activate m_product_sku_option_value
                                    note right of m_product_sku_option_value
                                        SELECT
                                            psov.sku_id,
                                            psov.option_value_id
                                        FROM product.m_product_sku_option_value psov
                                        INNER JOIN product.m_product_option_value pov
                                            ON pov.id = psov.option_value_id
                                        INNER JOIN product.m_product_option po
                                            ON po.id = pov.option_id
                                        WHERE psov.sku_id IN ('<sequence.skuIds>')
                                        AND psov.row_status <> 'DELETED'
                                        ORDER BY psov.sku_id, po.level_no
                                    end note
                                    m_product_sku_option_value -> infra: Return query result
                                deactivate m_product_sku_option_value
                                infra -> app: Return result of Get option values of the SKUs
                                app -> infra: QUERY - Get the lot that is on sale of each shop product SKU
                                infra -> t_shop_product_sku_lot: QUERY - Get the lot that is on sale of each shop product SKU
                                activate t_shop_product_sku_lot
                                    note right of t_shop_product_sku_lot
                                        SELECT
                                            l.shop_product_sku_id,
                                            l.selling_price,
                                            l.quantity
                                        FROM shop.t_shop_product_sku_lot l
                                        WHERE l.shop_product_sku_id IN ('<sequence.shopProductSkuIds>')
                                        AND l.is_on_sale = TRUE
                                        AND l.row_status = 'ACTIVE'
                                    end note
                                    t_shop_product_sku_lot -> infra: Return query result
                                deactivate t_shop_product_sku_lot
                                infra -> app: Return result of Get the lot that is on sale of each shop product SKU
                            deactivate infra
                            alt Processing times out
                                app -> api: HTTP 408 E90001
                                api -> page: Request timeout
                                page -> user: Display timeout error
                            else Processing completes in time
                                app -> domain: Apply domain rules and prepare response
                                activate domain
                                    domain -> app: Return response data
                                deactivate domain
                                app -> api: HTTP 200 S10000
                                api -> page: Return success response
                                page -> user: Display success result
                            end
                        end
                    end
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
