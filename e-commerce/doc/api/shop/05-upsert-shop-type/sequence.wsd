@startuml UpsertShopType Sequence

title Upsert Shop Type API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Shop Type Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_shop_type" as m_shop_type
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "m_shop" as m_shop
end box

user -> page: Submit Upsert Shop Type
activate page
    page -> api: POST v1/shop/type/upsert
    activate api
        api -> app: [**UpsertShopTypeCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature/issuer/audience/exp/UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Display authentication error
                else Verified JWT
                    app -> app: userId = verified sub
                    note over app, infra
                        - Execution order: validate the request (400) -> existence check (404) -> permission (403, E10009) -> duplicate name check (409, E10003) -> in-use check
                          (409, E10006, only when `rowStatus` is DELETED or ARCHIVED) -> write.
                    end note
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                            alt id is specified
                                app -> infra: QUERY - Check existing shop type
                                infra -> m_shop_type: QUERY - Check existing shop type
                                activate m_shop_type
                                    note right of m_shop_type
                                        SELECT
                                            st.id as shop_type_id
                                        FROM shop.m_shop_type st
                                        WHERE st.id = '<sequence.id>'
                                        AND st.row_status <> 'DELETED' -- the id of a DELETED shop type counts as not found
                                    end note
                                    m_shop_type -> infra: Return query result
                                deactivate m_shop_type
                                infra -> app: Return result of Check existing shop type
                                alt shop type not found or DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10004 Shop type not found.
                                    api -> page: Not found
                                    page -> user: Display error message
                                end
                            end
                            app -> infra: QUERY - Get the platform administrator role
                            infra -> m_role: QUERY - Get the platform administrator role
                            activate m_role
                                note right of m_role
                                    SELECT
                                        r.id as role_id
                                    FROM author.m_role r
                                    WHERE r.name = 'PLATFORM_ADMIN'
                                    AND r.row_status = 'ACTIVE'
                                end note
                                m_role -> infra: Return query result
                            deactivate m_role
                            infra -> app: Return result of Get the platform administrator role
                            app -> infra: QUERY - Check platform administrator
                            infra -> t_user_role: QUERY - Check platform administrator
                            activate t_user_role
                                note right of t_user_role
                                    SELECT
                                        ur.id as user_role_id
                                    FROM author.t_user_role ur
                                    WHERE ur.user_id = '<sequence.userId>'
                                    AND ur.role_id = '<sequence.roleId>'
                                    AND ur.row_status = 'ACTIVE'
                                end note
                                t_user_role -> infra: Return query result
                            deactivate t_user_role
                            infra -> app: Return result of Check platform administrator
                            alt No ACTIVE PLATFORM_ADMIN role or the caller does not hold it
                                app -> infra: ROLLBACK
                                app -> api: HTTP 403 E10009 You do not have permission to manage shop types.
                                api -> page: Forbidden
                                page -> user: Display error message
                            end
                            app -> infra: QUERY - Check duplicate name
                            infra -> m_shop_type: QUERY - Check duplicate name
                            activate m_shop_type
                                note right of m_shop_type
                                    SELECT
                                        st.id as shop_type_id
                                    FROM shop.m_shop_type st
                                    WHERE st.name = '<sequence.name>'
                                    AND st.row_status <> 'DELETED'
                                    AND st.id <> '<sequence.id>' -- only when id is specified
                                end note
                                m_shop_type -> infra: Return query result
                            deactivate m_shop_type
                            infra -> app: Return result of Check duplicate name
                            alt name is held by another shop type that is not DELETED
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10003 Shop type name already exists.
                                api -> page: Conflict
                                page -> user: Display error message
                            end
                            alt rowStatus is DELETED or ARCHIVED
                                app -> infra: QUERY - Check shop in use
                                infra -> m_shop: QUERY - Check shop in use
                                activate m_shop
                                    note right of m_shop
                                        SELECT
                                            s.id as shop_id
                                        FROM shop.m_shop s
                                        WHERE s.type_id = '<sequence.id>' -- only when rowStatus is DELETED or ARCHIVED
                                        AND s.row_status <> 'DELETED'
                                    end note
                                    m_shop -> infra: Return query result
                                deactivate m_shop
                                infra -> app: Return result of Check shop in use
                                alt a shop that is not DELETED uses the shop type
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10006 Shop type is used by shops.
                                    api -> page: Conflict
                                    page -> user: Display error message
                                end
                            end
                            alt id is not specified (insert)
                                app -> infra: INSERT - Create shop type
                                infra -> m_shop_type: INSERT - Create shop type
                                activate m_shop_type
                                    note right of m_shop_type
                                        INSERT INTO shop.m_shop_type (
                                            created_by,
                                            row_status,
                                            name,
                                            description
                                        )
                                        VALUES (
                                            &#39;<sequence.createdBy>',
                                            &#39;<sequence.rowStatus>',
                                            &#39;<sequence.name>',
                                            &#39;<sequence.description>'
                                        )
                                        RETURNING id as shop_type_id
                                    end note
                                    m_shop_type -> infra: Return inserted result
                                deactivate m_shop_type
                                infra -> app: Return result of Create shop type
                            else id is specified (update, delete or archive)
                                app -> infra: UPDATE - Update or delete shop type
                                infra -> m_shop_type: UPDATE - Update or delete shop type
                                activate m_shop_type
                                    note right of m_shop_type
                                        UPDATE shop.m_shop_type
                                        SET
                                            updated_by = '<sequence.updatedBy>',
                                            updated_at = NOW() AT TIME ZONE 'UTC',
                                            row_status = '<sequence.rowStatus>',
                                            name = '<sequence.name>',
                                            description = '<sequence.description>'
                                        WHERE id = '<sequence.id>'
                                        RETURNING id as shop_type_id
                                    end note
                                    m_shop_type -> infra: Return updated result
                                deactivate m_shop_type
                                infra -> app: Return result of Update or delete shop type
                            end
                            app -> infra: COMMIT
                            alt id is not specified (insert)
                                app -> api: HTTP 201 S10000
                                api -> page: Return committed result
                                page -> user: Display success result
                            else rowStatus is DELETED (delete)
                                app -> api: HTTP 204 No Content, no response body
                                api -> page: Return committed result
                                page -> user: Display success result
                            else update or archive
                                app -> api: HTTP 200 S10000
                                api -> page: Return committed result
                                page -> user: Display success result
                            end
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
