@startuml UpsertShop Sequence

title Upsert Shop API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Shop Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_shop_type" as m_shop_type
    database "m_shop" as m_shop
    database "m_shop_image" as m_shop_image
    database "t_shop_user" as t_shop_user
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "t_shop_product" as t_shop_product
    database "t_order" as t_order
    database "t_campaign_shop" as t_campaign_shop
end box

user -> page: Submit Upsert Shop
activate page
    page -> api: POST v1/shop/upsert
    activate api
        api -> app: [**UpsertShopCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature/issuer/audience/exp/UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Display authentication error
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                            alt typeId is new or changed
                                app -> infra: QUERY - Check shop type
                                infra -> m_shop_type: QUERY - Check shop type
                                activate m_shop_type
                                    note right of m_shop_type
                                        SELECT
                                            st.id as type_id
                                        FROM shop.m_shop_type st
                                        WHERE st.id = '<sequence.typeId>' -- only when the shop is inserted or typeId changes
                                        AND st.row_status = 'ACTIVE'
                                    end note
                                    m_shop_type -> infra: Return query result
                                deactivate m_shop_type
                                infra -> app: Return result of Check shop type
                                alt shop type not found or not ACTIVE
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10005 Shop type not found.
                                    api -> page: Not found
                                    page -> user: Display error message
                                end
                            end
                            alt id is specified
                                app -> infra: QUERY - Check existing shop
                                infra -> m_shop: QUERY - Check existing shop
                                activate m_shop
                                    note right of m_shop
                                        SELECT
                                            s.id as shop_id,
                                            s.type_id,
                                            s.platform_margin_rate,
                                            s.shop_margin_rate
                                        FROM shop.m_shop s
                                        WHERE s.id = '<sequence.id>'
                                        AND s.row_status <> 'DELETED' -- the id of a DELETED shop counts as not found
                                    end note
                                    m_shop -> infra: Return query result
                                deactivate m_shop
                                infra -> app: Return result of Check existing shop
                                alt shop not found or DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10004 Shop not found.
                                    api -> page: Not found
                                    page -> user: Display error message
                                end
                            end
                            alt images with id are specified
                                app -> infra: QUERY - Check existing shop images
                                infra -> m_shop_image: QUERY - Check existing shop images
                                activate m_shop_image
                                    note right of m_shop_image
                                        SELECT
                                            si.id as image_id
                                        FROM shop.m_shop_image si
                                        WHERE si.id IN ('<sequence.images.ids>')
                                        AND si.shop_id = '<sequence.id>'
                                        AND si.row_status <> 'DELETED'
                                    end note
                                    m_shop_image -> infra: Return query result
                                deactivate m_shop_image
                                infra -> app: Return result of Check existing shop images
                                alt image does not belong to the shop or is DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10004 Shop image not found.
                                    api -> page: Not found
                                    page -> user: Display error message
                                end
                            end
                            alt id is specified (update, delete or archive)
                                app -> infra: QUERY - Check shop administrator
                                infra -> t_shop_user: QUERY - Check shop administrator
                                activate t_shop_user
                                    note right of t_shop_user
                                        SELECT
                                            su.id as shop_user_id
                                        FROM shop.t_shop_user su
                                        WHERE su.shop_id = '<sequence.id>'
                                        AND su.user_id = '<sequence.userId>'
                                        AND su.role = 'ADMIN'
                                        AND su.row_status = 'ACTIVE'
                                    end note
                                    t_shop_user -> infra: Return query result
                                deactivate t_shop_user
                                infra -> app: Return result of Check shop administrator
                            end
                            app -> infra: QUERY - Get the platform administrator role
                            infra -> m_role: QUERY - Get the platform administrator role
                            activate m_role
                                note right of m_role
                                    SELECT
                                        r.id as role_id
                                    FROM author.m_role r
                                    WHERE r.name = 'PLATFORM_ADMIN'
                                    AND r.row_status = 'ACTIVE'
                                end note
                                m_role -> infra: Return query result
                            deactivate m_role
                            infra -> app: Return result of Get the platform administrator role
                            app -> infra: QUERY - Check platform administrator
                            infra -> t_user_role: QUERY - Check platform administrator
                            activate t_user_role
                                note right of t_user_role
                                    SELECT
                                        ur.id as user_role_id
                                    FROM author.t_user_role ur
                                    WHERE ur.user_id = '<sequence.userId>'
                                    AND ur.role_id = '<sequence.roleId>'
                                    AND ur.row_status = 'ACTIVE'
                                end note
                                t_user_role -> infra: Return query result
                            deactivate t_user_role
                            infra -> app: Return result of Check platform administrator
                            alt update, delete or archive by a caller who is neither an ADMIN of the shop nor a platform administrator
                                app -> infra: ROLLBACK
                                app -> api: HTTP 403 E10009 You do not have permission to manage this shop.
                                api -> page: Forbidden
                                page -> user: Display error message
                            end
                            alt platformMarginRate differs from the current one and the caller is not a platform administrator
                                app -> infra: ROLLBACK
                                app -> api: HTTP 403 E10009 Only a platform administrator can change the platform margin rate.
                                api -> page: Forbidden
                                page -> user: Display error message
                            end
                            app -> infra: QUERY - Check duplicate name
                            infra -> m_shop: QUERY - Check duplicate name
                            activate m_shop
                                note right of m_shop
                                    SELECT
                                        s.id as shop_id
                                    FROM shop.m_shop s
                                    WHERE s.name = '<sequence.name>'
                                    AND s.row_status <> 'DELETED'
                                    AND s.id <> '<sequence.id>' -- only when id is specified
                                end note
                                m_shop -> infra: Return query result
                            deactivate m_shop
                            infra -> app: Return result of Check duplicate name
                            alt name is held by another shop that is not DELETED
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10003 Shop name already exists.
                                api -> page: Conflict
                                page -> user: Display error message
                            end
                            alt rowStatus is DELETED
                                app -> infra: QUERY - Check shop products in use
                                infra -> t_shop_product: QUERY - Check shop products in use
                                activate t_shop_product
                                    note right of t_shop_product
                                        SELECT
                                            sp.id as shop_product_id
                                        FROM shop.t_shop_product sp
                                        WHERE sp.shop_id = '<sequence.id>' -- only when rowStatus is DELETED
                                        AND sp.row_status <> 'DELETED'
                                    end note
                                    t_shop_product -> infra: Return query result
                                deactivate t_shop_product
                                infra -> app: Return result of Check shop products in use
                                alt the shop has a product that is not DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10006 Shop is used by products or orders.
                                    api -> page: Conflict
                                    page -> user: Display error message
                                end
                                app -> infra: QUERY - Check shop orders in use
                                infra -> t_order: QUERY - Check shop orders in use
                                activate t_order
                                    note right of t_order
                                        SELECT
                                            o.id as order_id
                                        FROM sales.t_order o
                                        WHERE o.shop_id = '<sequence.id>' -- only when rowStatus is DELETED
                                        AND o.row_status <> 'DELETED'
                                    end note
                                    t_order -> infra: Return query result
                                deactivate t_order
                                infra -> app: Return result of Check shop orders in use
                                alt the shop has an order that is not DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10006 Shop is used by products or orders.
                                    api -> page: Conflict
                                    page -> user: Display error message
                                end
                                app -> infra: QUERY - Check shop campaigns in use
                                infra -> t_campaign_shop: QUERY - Check shop campaigns in use
                                activate t_campaign_shop
                                    note right of t_campaign_shop
                                        SELECT
                                            cs.id as campaign_shop_id,
                                            c.name
                                        FROM campaign.t_campaign_shop cs
                                        INNER JOIN campaign.m_campaign c
                                            ON c.id = cs.campaign_id
                                        WHERE cs.shop_id = '<sequence.id>'
                                        AND cs.row_status <> 'DELETED'
                                        AND c.row_status <> 'DELETED'
                                        AND c.end_at > NOW() AT TIME ZONE 'UTC' -- a campaign that ended or was deleted does not block, answer 409 (E10006) when a row is found
                                        LIMIT 1
                                    end note
                                    t_campaign_shop -> infra: Return query result
                                deactivate t_campaign_shop
                                infra -> app: Return result of Check shop campaigns in use
                                alt the shop is in a campaign that has not ended
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10006 The shop is in a campaign that has not ended and cannot be deleted.
                                    api -> page: Conflict
                                    page -> user: Display error message
                                end
                            end
                            alt images are specified
                                app -> infra: QUERY - Count the images of the shop that are not in the request
                                infra -> m_shop_image: QUERY - Count the images of the shop that are not in the request
                                activate m_shop_image
                                    note right of m_shop_image
                                        SELECT
                                            si.type,
                                            COUNT(si.id) as image_count
                                        FROM shop.m_shop_image si
                                        WHERE si.shop_id = '<sequence.id>'
                                        AND si.row_status <> 'DELETED'
                                        AND si.id NOT IN ('<sequence.images.ids>') -- only when images are specified
                                        GROUP BY si.type
                                    end note
                                    m_shop_image -> infra: Return query result
                                deactivate m_shop_image
                                infra -> app: Return result of Count the images of the shop that are not in the request
                                alt the shop would have a second LOGO or WALLPAPER image
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10003 The shop already has an image of this type.
                                    api -> page: Conflict
                                    page -> user: Display error message
                                end
                            end
                            alt id is not specified (insert)
                                app -> infra: INSERT - Create shop
                                infra -> m_shop: INSERT - Create shop
                                activate m_shop
                                    note right of m_shop
                                        INSERT INTO shop.m_shop (
                                            created_by,
                                            row_status,
                                            type_id,
                                            name,
                                            description,
                                            platform_margin_rate,
                                            shop_margin_rate
                                        )
                                        VALUES (
                                            &#39;<sequence.createdBy>',
                                            &#39;<sequence.rowStatus>',
                                            &#39;<sequence.typeId>',
                                            &#39;<sequence.name>',
                                            &#39;<sequence.description>',
                                            &#39;<sequence.platformMarginRate>', -- 0.00 when not specified
                                            &#39;<sequence.shopMarginRate>' -- 0.00 when not specified
                                        )
                                        RETURNING id as shop_id
                                    end note
                                    m_shop -> infra: Return inserted result
                                deactivate m_shop
                                infra -> app: Return result of Create shop
                                app -> infra: INSERT - Add the caller as ADMIN of the new shop
                                infra -> t_shop_user: INSERT - Add the caller as ADMIN of the new shop
                                activate t_shop_user
                                    note right of t_shop_user
                                        INSERT INTO shop.t_shop_user (
                                            created_by,
                                            shop_id,
                                            user_id,
                                            role
                                        )
                                        VALUES (
                                            &#39;<sequence.createdBy>',
                                            &#39;<sequence.shopId>',
                                            &#39;<sequence.userId>',
                                            &#39;ADMIN'
                                        )
                                        RETURNING id as shop_user_id
                                    end note
                                    t_shop_user -> infra: Return inserted result
                                deactivate t_shop_user
                                infra -> app: Return result of Add the caller as ADMIN of the new shop
                            else id is specified (update, delete or archive)
                                app -> infra: UPDATE - Update, archive or delete shop
                                infra -> m_shop: UPDATE - Update, archive or delete shop
                                activate m_shop
                                    note right of m_shop
                                        UPDATE shop.m_shop
                                        SET
                                            updated_by = '<sequence.updatedBy>',
                                            updated_at = NOW() AT TIME ZONE 'UTC',
                                            row_status = '<sequence.rowStatus>',
                                            type_id = '<sequence.typeId>',
                                            name = '<sequence.name>',
                                            description = '<sequence.description>',
                                            platform_margin_rate = '<sequence.platformMarginRate>', -- only when platformMarginRate is specified
                                            shop_margin_rate = '<sequence.shopMarginRate>' -- only when shopMarginRate is specified
                                        WHERE id = '<sequence.id>'
                                        RETURNING id as shop_id
                                    end note
                                    m_shop -> infra: Return updated result
                                deactivate m_shop
                                infra -> app: Return result of Update, archive or delete shop
                            end
                            alt images are specified
                                app -> infra: QUERY - Get next seq of the image type
                                infra -> m_shop_image: QUERY - Get next seq of the image type
                                activate m_shop_image
                                    note right of m_shop_image
                                        SELECT
                                            COALESCE(MAX(si.seq) + 1, 0) as next_seq
                                        FROM shop.m_shop_image si
                                        WHERE si.shop_id = '<sequence.id>'
                                        AND si.type = '<sequence.images.type>'
                                        AND si.row_status <> 'DELETED'
                                    end note
                                    m_shop_image -> infra: Return query result
                                deactivate m_shop_image
                                infra -> app: Return result of Get next seq of the image type
                                app -> infra: INSERT - Create shop image
                                infra -> m_shop_image: INSERT - Create shop image
                                activate m_shop_image
                                    note right of m_shop_image
                                        INSERT INTO shop.m_shop_image (
                                            created_by,
                                            row_status,
                                            shop_id,
                                            type,
                                            seq,
                                            image_path
                                        )
                                        VALUES (
                                            &#39;<sequence.createdBy>',
                                            &#39;<sequence.images.rowStatus>',
                                            &#39;<sequence.shopId>',
                                            &#39;<sequence.images.type>',
                                            &#39;<sequence.images.seq>', -- next seq of the image type when not specified
                                            &#39;<sequence.images.imagePath>'
                                        )
                                        RETURNING id as image_id
                                    end note
                                    m_shop_image -> infra: Return inserted result
                                deactivate m_shop_image
                                infra -> app: Return result of Create shop image
                                app -> infra: UPDATE - Update or delete shop image
                                infra -> m_shop_image: UPDATE - Update or delete shop image
                                activate m_shop_image
                                    note right of m_shop_image
                                        UPDATE shop.m_shop_image
                                        SET
                                            updated_by = '<sequence.updatedBy>',
                                            updated_at = NOW() AT TIME ZONE 'UTC',
                                            row_status = '<sequence.images.rowStatus>',
                                            type = '<sequence.images.type>',
                                            seq = '<sequence.images.seq>', -- only when seq is specified
                                            image_path = '<sequence.images.imagePath>'
                                        WHERE id = '<sequence.images.id>'
                                        AND shop_id = '<sequence.shopId>'
                                        RETURNING id as image_id
                                    end note
                                    m_shop_image -> infra: Return updated result
                                deactivate m_shop_image
                                infra -> app: Return result of Update or delete shop image
                            end
                            alt rowStatus is DELETED
                                app -> infra: UPDATE - Delete the images of a deleted shop
                                infra -> m_shop_image: UPDATE - Delete the images of a deleted shop
                                activate m_shop_image
                                    note right of m_shop_image
                                        UPDATE shop.m_shop_image
                                        SET
                                            updated_by = '<sequence.updatedBy>',
                                            updated_at = NOW() AT TIME ZONE 'UTC',
                                            row_status = 'DELETED'
                                        WHERE shop_id = '<sequence.id>' -- only when rowStatus is DELETED
                                        AND row_status <> 'DELETED'
                                    end note
                                    m_shop_image -> infra: Return updated result
                                deactivate m_shop_image
                                infra -> app: Return result of Delete the images of a deleted shop
                            end
                            app -> infra: COMMIT
                            alt id is not specified (insert)
                                app -> api: HTTP 201 S10000
                                api -> page: Return committed result
                                page -> user: Display success result
                            else rowStatus is DELETED (delete)
                                app -> api: HTTP 204 No Content, no response body
                                api -> page: Return committed result
                                page -> user: Display success result
                            else update or archive
                                app -> api: HTTP 200 S10000
                                api -> page: Return committed result
                                page -> user: Display success result
                            end
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
