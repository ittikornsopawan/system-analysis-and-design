@startuml InquiryStorefrontProductReview Sequence

title Inquiry Storefront Product Review API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Storefront Product Review Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_shop_product" as t_shop_product
    database "t_shop_product_review" as t_shop_product_review
end box

user -> page: Request Inquiry Storefront Product Review
activate page
    page -> api: GET v1/storefront/product-review
    activate api
        api -> app: [**InquiryStorefrontProductReviewQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> infra: Execute database operations
                activate infra
                    app -> infra: QUERY - Get the shop product that has a product page
                    infra -> t_shop_product: QUERY - Get the shop product that has a product page
                    activate t_shop_product
                        note right of t_shop_product
                            SELECT
                                sp.id as shop_product_id
                            FROM shop.t_shop_product sp
                            INNER JOIN shop.m_shop s
                                ON s.id = sp.shop_id
                                AND s.row_status = 'ACTIVE'
                            INNER JOIN product.m_product p
                                ON p.id = sp.product_id
                                AND p.row_status = 'ACTIVE'
                            INNER JOIN shop.t_shop_product_sku ssk
                                ON ssk.shop_product_id = sp.id
                                AND ssk.row_status = 'ACTIVE'
                            INNER JOIN product.m_product_sku ps
                                ON ps.id = ssk.sku_id
                                AND ps.row_status = 'ACTIVE'
                            WHERE sp.shop_id = '<sequence.shopId>'
                            AND sp.product_id = '<sequence.productId>'
                            AND sp.row_status = 'ACTIVE'
                            LIMIT 1
                        end note
                        t_shop_product -> infra: Return query result
                    deactivate t_shop_product
                    infra -> app: Return result of Get the shop product that has a product page
                deactivate infra
                alt The product has no product page in the shop
                    app -> api: HTTP 404 E10004
                    api -> page: Not found
                    page -> user: Display not found error
                else The product page exists
                    app -> infra: Execute database operations
                    activate infra
                        app -> infra: QUERY - Get the summary of the reviews
                        infra -> t_shop_product_review: QUERY - Get the summary of the reviews
                        activate t_shop_product_review
                            note right of t_shop_product_review
                                SELECT
                                    COUNT(r.id) as rating_count,
                                    ROUND(AVG(r.rating), 2) as average_rating
                                FROM shop.t_shop_product_review r
                                WHERE r.shop_product_id = '<sequence.shopProductId>'
                                AND r.row_status = 'ACTIVE'
                            end note
                            t_shop_product_review -> infra: Return query result
                        deactivate t_shop_product_review
                        infra -> app: Return result of Get the summary of the reviews
                        app -> infra: QUERY - Get the number of reviews of each rating
                        infra -> t_shop_product_review: QUERY - Get the number of reviews of each rating
                        activate t_shop_product_review
                            note right of t_shop_product_review
                                SELECT
                                    r.rating,
                                    COUNT(r.id) as rating_count
                                FROM shop.t_shop_product_review r
                                WHERE r.shop_product_id = '<sequence.shopProductId>'
                                AND r.row_status = 'ACTIVE'
                                GROUP BY r.rating
                                ORDER BY r.rating DESC
                            end note
                            t_shop_product_review -> infra: Return query result
                        deactivate t_shop_product_review
                        infra -> app: Return result of Get the number of reviews of each rating
                        app -> infra: QUERY - Get reviews
                        infra -> t_shop_product_review: QUERY - Get reviews
                        activate t_shop_product_review
                            note right of t_shop_product_review
                                SELECT
                                    r.id as review_id,
                                    r.rating,
                                    r.comment,
                                    u.display_name,
                                    u.profile_picture_path,
                                    r.created_at,
                                    r.updated_at
                                FROM shop.t_shop_product_review r
                                INNER JOIN authen.m_user u
                                    ON u.id = r.user_id
                                WHERE r.shop_product_id = '<sequence.shopProductId>'
                                AND r.row_status = 'ACTIVE'
                                AND r.rating = '<sequence.rating>' -- only when rating is specified
                                ORDER BY r.created_at DESC, r.id -- sort NEWEST (default)
                                -- ORDER BY r.rating DESC, r.id -- sort HIGHEST
                                -- ORDER BY r.rating, r.id -- sort LOWEST
                                LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                            end note
                            t_shop_product_review -> infra: Return query result
                        deactivate t_shop_product_review
                        infra -> app: Return result of Get reviews
                        app -> infra: QUERY - Get total items
                        infra -> t_shop_product_review: QUERY - Get total items
                        activate t_shop_product_review
                            note right of t_shop_product_review
                                SELECT
                                    COUNT(r.id) as total_items
                                FROM shop.t_shop_product_review r
                                WHERE r.shop_product_id = '<sequence.shopProductId>'
                                AND r.row_status = 'ACTIVE'
                                AND r.rating = '<sequence.rating>' -- only when rating is specified
                            end note
                            t_shop_product_review -> infra: Return query result
                        deactivate t_shop_product_review
                        infra -> app: Return result of Get total items
                    deactivate infra
                    alt Processing times out
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Display timeout error
                    else Processing completes in time
                        app -> domain: Apply domain rules and prepare response
                        activate domain
                            domain -> app: Return response data
                        deactivate domain
                        app -> api: HTTP 200 S10000
                        api -> page: Return success response
                        page -> user: Display success result
                    end
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
