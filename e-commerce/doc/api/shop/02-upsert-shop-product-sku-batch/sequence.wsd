@startuml UpsertShopProductSKUBatch Sequence

title Upsert Shop Product SKU Batch API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Shop Product SKU Batch Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_shop" as m_shop
    database "m_product_sku" as m_product_sku
    database "t_shop_product" as t_shop_product
    database "t_shop_product_sku" as t_shop_product_sku
    database "t_shop_product_sku_lot" as t_shop_product_sku_lot
    database "t_shop_user" as t_shop_user
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "t_order_item" as t_order_item
end box

user -> page: Submit Upsert Shop Product SKU Batch
activate page
    page -> api: POST v1/shop/product-sku/upsert/batch
    activate api
        api -> app: [**UpsertShopProductSKUBatchCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature/issuer/audience/exp/UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Display authentication error
                else Verified JWT
                    app -> app: userId = verified sub
                    note over app, infra
                        - Execution order: validate the request (400) -> existence checks (404) -> permission (403) -> conflict and in-use checks (409) -> write the shop
                          product, the shop product SKU, close the lot on sale when a lot is put on sale, then write the lots. The whole request is one transaction.
                    end note
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                            loop For each SKU (request order)
                                app -> infra: QUERY - Check shop
                                infra -> m_shop: QUERY - Check shop
                                activate m_shop
                                    note right of m_shop
                                        SELECT
                                            s.id as shop_id
                                        FROM shop.m_shop s
                                        WHERE s.id IN ('<sequence.skus.shopIds>')
                                        AND s.row_status = 'ACTIVE'
                                    end note
                                    m_shop -> infra: Return query result
                                deactivate m_shop
                                infra -> app: Return result of Check shop
                                alt skus[i]: shop not found or not ACTIVE
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10005 skus[i]: Shop not found.
                                    api -> page: Not found
                                    page -> user: Display error message
                                end
                                app -> infra: QUERY - Check product SKU of the product
                                infra -> m_product_sku: QUERY - Check product SKU of the product
                                activate m_product_sku
                                    note right of m_product_sku
                                        SELECT
                                            ps.id as sku_id,
                                            ps.product_id,
                                            ps.name,
                                            ps.description
                                        FROM product.m_product_sku ps
                                        INNER JOIN product.m_product p
                                            ON p.id = ps.product_id
                                            AND p.row_status = 'ACTIVE'
                                        WHERE ps.id IN ('<sequence.skus.skuIds>')
                                        AND ps.product_id IN ('<sequence.skus.productIds>')
                                        AND ps.row_status = 'ACTIVE'
                                    end note
                                    m_product_sku -> infra: Return query result
                                deactivate m_product_sku
                                infra -> app: Return result of Check product SKU of the product
                                alt skus[i]: product or SKU not found or not ACTIVE
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10005 skus[i]: Product or SKU not found.
                                    api -> page: Not found
                                    page -> user: Display error message
                                end
                                app -> infra: QUERY - Get shop product
                                infra -> t_shop_product: QUERY - Get shop product
                                activate t_shop_product
                                    note right of t_shop_product
                                        SELECT
                                            sp.id as shop_product_id
                                        FROM shop.t_shop_product sp
                                        WHERE sp.shop_id = '<sequence.skus.shopId>'
                                        AND sp.product_id = '<sequence.skus.productId>'
                                        AND sp.row_status <> 'DELETED' -- a DELETED shop product is never reused, a new one is created
                                    end note
                                    t_shop_product -> infra: Return query result
                                deactivate t_shop_product
                                infra -> app: Return result of Get shop product
                                alt id is specified
                                    app -> infra: QUERY - Check existing shop product SKU
                                    infra -> t_shop_product_sku: QUERY - Check existing shop product SKU
                                    activate t_shop_product_sku
                                        note right of t_shop_product_sku
                                            SELECT
                                                ssk.id as shop_product_sku_id,
                                                ssk.shop_product_id,
                                                ssk.sku_id
                                            FROM shop.t_shop_product_sku ssk
                                            WHERE ssk.id = '<sequence.skus.id>'
                                        end note
                                        t_shop_product_sku -> infra: Return query result
                                    deactivate t_shop_product_sku
                                    infra -> app: Return result of Check existing shop product SKU
                                    alt skus[i]: shop product SKU not found or DELETED
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 404 E10004 skus[i]: Shop product SKU not found.
                                        api -> page: Not found
                                        page -> user: Display error message
                                    end
                                end
                                alt lots with id are specified
                                    app -> infra: QUERY - Check existing lots
                                    infra -> t_shop_product_sku_lot: QUERY - Check existing lots
                                    activate t_shop_product_sku_lot
                                        note right of t_shop_product_sku_lot
                                            SELECT
                                                l.id as lot_id,
                                                l.is_on_sale,
                                                l.row_status
                                            FROM shop.t_shop_product_sku_lot l
                                            WHERE l.id IN ('<sequence.skus.lots.ids>')
                                            AND l.shop_product_sku_id = '<sequence.shopProductSkuId>'
                                        end note
                                        t_shop_product_sku_lot -> infra: Return query result
                                    deactivate t_shop_product_sku_lot
                                    infra -> app: Return result of Check existing lots
                                    alt skus[i]: lot not found or DELETED
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 404 E10004 skus[i]: Lot not found.
                                        api -> page: Not found
                                        page -> user: Display error message
                                    end
                                end
                            end
                            app -> infra: QUERY - Check shop members
                            infra -> t_shop_user: QUERY - Check shop members
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.shop_id
                                    FROM shop.t_shop_user su
                                    WHERE su.shop_id IN ('<sequence.skus.shopIds>')
                                    AND su.user_id = '<sequence.userId>'
                                    AND su.role IN ('ADMIN', 'STAFF')
                                    AND su.row_status = 'ACTIVE'
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return result of Check shop members
                            app -> infra: QUERY - Get the platform administrator role
                            infra -> m_role: QUERY - Get the platform administrator role
                            activate m_role
                                note right of m_role
                                    SELECT
                                        r.id as role_id
                                    FROM author.m_role r
                                    WHERE r.name = 'PLATFORM_ADMIN'
                                    AND r.row_status = 'ACTIVE'
                                end note
                                m_role -> infra: Return query result
                            deactivate m_role
                            infra -> app: Return result of Get the platform administrator role
                            app -> infra: QUERY - Check platform administrator
                            infra -> t_user_role: QUERY - Check platform administrator
                            activate t_user_role
                                note right of t_user_role
                                    SELECT
                                        ur.id as user_role_id
                                    FROM author.t_user_role ur
                                    WHERE ur.user_id = '<sequence.userId>'
                                    AND ur.role_id = '<sequence.roleId>'
                                    AND ur.row_status = 'ACTIVE'
                                end note
                                t_user_role -> infra: Return query result
                            deactivate t_user_role
                            infra -> app: Return result of Check platform administrator
                            alt A shop of the request has no ACTIVE member row for the caller and the caller is not a platform administrator
                                app -> infra: ROLLBACK
                                app -> api: HTTP 403 E10009 skus[i]: You do not have permission to manage SKUs and lots of the shop.
                                api -> page: Forbidden
                                page -> user: Display error message
                            end
                            loop For each SKU (request order, one transaction)
                                alt id is not specified
                                    app -> infra: QUERY - Check duplicate shop product SKU
                                    infra -> t_shop_product_sku: QUERY - Check duplicate shop product SKU
                                    activate t_shop_product_sku
                                        note right of t_shop_product_sku
                                            SELECT
                                                ssk.id as shop_product_sku_id
                                            FROM shop.t_shop_product_sku ssk
                                            WHERE ssk.shop_product_id = '<sequence.shopProductId>'
                                            AND ssk.sku_id = '<sequence.skus.skuId>'
                                            AND ssk.id <> '<sequence.skus.id>' -- only when id is specified
                                        end note
                                        t_shop_product_sku -> infra: Return query result
                                    deactivate t_shop_product_sku
                                    infra -> app: Return result of Check duplicate shop product SKU
                                    alt skus[i]: the shop already has this SKU
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10003 skus[i]: Shop product SKU already exists.
                                        api -> page: Conflict
                                        page -> user: Display error message
                                    end
                                end
                                alt lots are specified
                                    app -> infra: QUERY - Check duplicate lot number
                                    infra -> t_shop_product_sku_lot: QUERY - Check duplicate lot number
                                    activate t_shop_product_sku_lot
                                        note right of t_shop_product_sku_lot
                                            SELECT
                                                l.id as lot_id
                                            FROM shop.t_shop_product_sku_lot l
                                            WHERE l.shop_product_sku_id = '<sequence.shopProductSkuId>'
                                            AND l.lot_no = '<sequence.skus.lots.lotNo>'
                                            AND l.id <> '<sequence.skus.lots.id>' -- only when id is specified
                                            AND l.row_status <> 'DELETED'
                                        end note
                                        t_shop_product_sku_lot -> infra: Return query result
                                    deactivate t_shop_product_sku_lot
                                    infra -> app: Return result of Check duplicate lot number
                                    alt skus[i]: lot number is held by another lot of the shop product SKU
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10003 skus[i]: Lot number already exists.
                                        api -> page: Conflict
                                        page -> user: Display error message
                                    end
                                end
                                alt a lot or the SKU is deleted or archived
                                    app -> infra: QUERY - Check lots in use
                                    infra -> t_order_item: QUERY - Check lots in use
                                    activate t_order_item
                                        note right of t_order_item
                                            SELECT
                                                oi.lot_id
                                            FROM sales.t_order_item oi
                                            WHERE oi.lot_id IN ('<sequence.skus.lots.ids>') -- lots to delete
                                            OR oi.lot_id IN (
                                                SELECT l.id
                                                FROM shop.t_shop_product_sku_lot l
                                                WHERE l.shop_product_sku_id = '<sequence.skus.id>' -- shop product SKU to delete
                                            )
                                        end note
                                        t_order_item -> infra: Return query result
                                    deactivate t_order_item
                                    infra -> app: Return result of Check lots in use
                                    alt skus[i]: the lot is on sale or is used by an order item
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10006 skus[i]: Lot is on sale or used by orders.
                                        api -> page: Conflict
                                        page -> user: Display error message
                                    end
                                end
                                alt the shop product does not exist yet
                                    app -> infra: INSERT - Create shop product when it does not exist
                                    infra -> t_shop_product: INSERT - Create shop product when it does not exist
                                    activate t_shop_product
                                        note right of t_shop_product
                                            INSERT INTO shop.t_shop_product (
                                                created_by,
                                                shop_id,
                                                product_id
                                            )
                                            VALUES (
                                                &#39;<sequence.createdBy>',
                                                &#39;<sequence.skus.shopId>',
                                                &#39;<sequence.skus.productId>'
                                            )
                                            RETURNING id as shop_product_id
                                        end note
                                        t_shop_product -> infra: Return inserted result
                                    deactivate t_shop_product
                                    infra -> app: Return result of Create shop product when it does not exist
                                end
                                alt id is not specified (insert)
                                    app -> infra: INSERT - Create shop product SKU
                                    infra -> t_shop_product_sku: INSERT - Create shop product SKU
                                    activate t_shop_product_sku
                                        note right of t_shop_product_sku
                                            INSERT INTO shop.t_shop_product_sku (
                                                created_by,
                                                row_status,
                                                shop_product_id,
                                                sku_id,
                                                code,
                                                name,
                                                description
                                            )
                                            VALUES (
                                                &#39;<sequence.createdBy>',
                                                &#39;<sequence.skus.rowStatus>',
                                                &#39;<sequence.shopProductId>',
                                                &#39;<sequence.skus.skuId>',
                                                &#39;<sequence.skus.code>',
                                                &#39;<sequence.skus.name>', -- defaults to product SKU name when not specified
                                                &#39;<sequence.skus.description>' -- defaults to product SKU description when not specified
                                            )
                                            RETURNING id as shop_product_sku_id
                                        end note
                                        t_shop_product_sku -> infra: Return inserted result
                                    deactivate t_shop_product_sku
                                    infra -> app: Return result of Create shop product SKU
                                else id is specified (update, delete or archive)
                                    app -> infra: UPDATE - Update, delete or archive shop product SKU
                                    infra -> t_shop_product_sku: UPDATE - Update, delete or archive shop product SKU
                                    activate t_shop_product_sku
                                        note right of t_shop_product_sku
                                            UPDATE shop.t_shop_product_sku
                                            SET
                                                updated_by = '<sequence.updatedBy>',
                                                updated_at = NOW() AT TIME ZONE 'UTC',
                                                row_status = '<sequence.skus.rowStatus>',
                                                code = '<sequence.skus.code>',
                                                name = '<sequence.skus.name>', -- only when name is specified
                                                description = '<sequence.skus.description>' -- only when description is specified
                                            WHERE id = '<sequence.skus.id>'
                                            RETURNING id as shop_product_sku_id
                                        end note
                                        t_shop_product_sku -> infra: Return updated result
                                    deactivate t_shop_product_sku
                                    infra -> app: Return result of Update, delete or archive shop product SKU
                                end
                                alt a lot is put on sale
                                    app -> infra: UPDATE - Close the lot that is on sale before another lot is put on sale
                                    infra -> t_shop_product_sku_lot: UPDATE - Close the lot that is on sale before another lot is put on sale
                                    activate t_shop_product_sku_lot
                                        note right of t_shop_product_sku_lot
                                            UPDATE shop.t_shop_product_sku_lot
                                            SET
                                                updated_by = '<sequence.updatedBy>',
                                                updated_at = NOW() AT TIME ZONE 'UTC',
                                                is_on_sale = FALSE
                                            WHERE shop_product_sku_id = '<sequence.shopProductSkuId>'
                                            AND is_on_sale = TRUE
                                            AND id <> '<sequence.skus.lots.id>' -- only when id is specified
                                        end note
                                        t_shop_product_sku_lot -> infra: Return updated result
                                    deactivate t_shop_product_sku_lot
                                    infra -> app: Return result of Close the lot that is on sale before another lot is put on sale
                                end
                                alt lots are specified
                                    alt lot id is not specified
                                        app -> infra: INSERT - Create lot
                                        infra -> t_shop_product_sku_lot: INSERT - Create lot
                                        activate t_shop_product_sku_lot
                                            note right of t_shop_product_sku_lot
                                                INSERT INTO shop.t_shop_product_sku_lot (
                                                    created_by,
                                                    row_status,
                                                    shop_product_sku_id,
                                                    lot_no,
                                                    cost_price,
                                                    selling_price,
                                                    gross_margin,
                                                    share_margin,
                                                    platform_margin,
                                                    quantity,
                                                    is_on_sale
                                                )
                                                VALUES (
                                                    &#39;<sequence.createdBy>',
                                                    &#39;<sequence.skus.lots.rowStatus>',
                                                    &#39;<sequence.shopProductSkuId>',
                                                    &#39;<sequence.skus.lots.lotNo>',
                                                    &#39;<sequence.skus.lots.costPrice>',
                                                    &#39;<sequence.skus.lots.sellingPrice>',
                                                    &#39;<sequence.grossMargin>', -- calculated by the system
                                                    &#39;<sequence.shareMargin>', -- calculated by the system
                                                    &#39;<sequence.platformMargin>', -- calculated by the system
                                                    &#39;<sequence.skus.lots.quantity>',
                                                    &#39;<sequence.skus.lots.isOnSale>' -- TRUE only when the lot is ACTIVE and quantity > 0
                                                )
                                                RETURNING id as lot_id
                                            end note
                                            t_shop_product_sku_lot -> infra: Return inserted result
                                        deactivate t_shop_product_sku_lot
                                        infra -> app: Return result of Create lot
                                    else lot id is specified
                                        app -> infra: UPDATE - Update, delete or archive lot
                                        infra -> t_shop_product_sku_lot: UPDATE - Update, delete or archive lot
                                        activate t_shop_product_sku_lot
                                            note right of t_shop_product_sku_lot
                                                UPDATE shop.t_shop_product_sku_lot
                                                SET
                                                    updated_by = '<sequence.updatedBy>',
                                                    updated_at = NOW() AT TIME ZONE 'UTC',
                                                    row_status = '<sequence.skus.lots.rowStatus>',
                                                    lot_no = '<sequence.skus.lots.lotNo>',
                                                    cost_price = '<sequence.skus.lots.costPrice>',
                                                    selling_price = '<sequence.skus.lots.sellingPrice>',
                                                    gross_margin = '<sequence.grossMargin>', -- calculated by the system
                                                    share_margin = '<sequence.shareMargin>', -- calculated by the system
                                                    platform_margin = '<sequence.platformMargin>', -- calculated by the system
                                                    quantity = '<sequence.skus.lots.quantity>',
                                                    is_on_sale = '<sequence.skus.lots.isOnSale>' -- FALSE when the lot is not ACTIVE
                                                WHERE id = '<sequence.skus.lots.id>'
                                                AND shop_product_sku_id = '<sequence.shopProductSkuId>'
                                                RETURNING id as lot_id
                                            end note
                                            t_shop_product_sku_lot -> infra: Return updated result
                                        deactivate t_shop_product_sku_lot
                                        infra -> app: Return result of Update, delete or archive lot
                                    end
                                end
                                alt rowStatus of the SKU is DELETED
                                    app -> infra: UPDATE - Delete the lots of a deleted shop product SKU
                                    infra -> t_shop_product_sku_lot: UPDATE - Delete the lots of a deleted shop product SKU
                                    activate t_shop_product_sku_lot
                                        note right of t_shop_product_sku_lot
                                            UPDATE shop.t_shop_product_sku_lot
                                            SET
                                                updated_by = '<sequence.updatedBy>',
                                                updated_at = NOW() AT TIME ZONE 'UTC',
                                                row_status = 'DELETED',
                                                is_on_sale = FALSE
                                            WHERE shop_product_sku_id = '<sequence.skus.id>'
                                            AND row_status <> 'DELETED'
                                        end note
                                        t_shop_product_sku_lot -> infra: Return updated result
                                    deactivate t_shop_product_sku_lot
                                    infra -> app: Return result of Delete the lots of a deleted shop product SKU
                                end
                            end
                            app -> infra: COMMIT
                            app -> api: HTTP 200 S10000 with the result of every item
                            api -> page: Return committed result
                            page -> user: Display success result
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
