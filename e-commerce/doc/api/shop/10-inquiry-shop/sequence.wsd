@startuml InquiryShop Sequence

title Inquiry Shop API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Shop Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_user_access_token" as t_user_access_token
    database "m_shop" as m_shop
    database "m_shop_type" as m_shop_type
    database "t_shop_user" as t_shop_user
    database "m_shop_image" as m_shop_image
end box

user -> page: Request Inquiry Shop
activate page
    page -> api: GET v1/shop
    activate api
        api -> app: [**InquiryShopQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub and the roles claim as unique non-empty strings (an empty array is valid)
                alt Missing, malformed or invalid JWT or roles claim
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Unauthorized
                    page -> user: Display unauthorized error
                else Access token is valid
                    app -> app: userId = callerUserId = verified sub; accessTokenHash = SHA-256 of the exact JWT; isPlatformAdmin = roles contains PLATFORM_ADMIN (no database query)
                    note over app, infra
                        - Execution order: validate the request (400) -> verify the JWT and its roles claim (401) -> BEGIN READ ONLY -> fresh now and expiry recheck (401) -> current credential and user (401) -> page -> total -> type names,
                          shop members and images -> COMMIT -> 200. The caller user is not locked: a read-only transaction takes no lock. The author tables are never queried, the platform administrator comes from the verified roles claim;
                          the membership of the shops is not a token claim and is still read from shop.t_shop_user. Every rejection after BEGIN rolls back.
                    end note
                    app -> infra: BEGIN REPEATABLE READ READ ONLY
                    activate infra
                    alt Work completes before commit
                        app -> app: Capture fresh server UTC now; recheck JWT exp
                        alt JWT expired
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 401 E10002 Invalid or expired access token.
                                api -> page: Show failure; no successful shop list action
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                        app -> infra: QUERY - Check current credential and user
                        infra -> t_user_access_token: QUERY - Check current credential and user
                        activate t_user_access_token
                            note right of t_user_access_token
                                SELECT
                                    at.id as access_token_id
                                FROM authen.t_user_access_token at
                                JOIN authen.m_user u ON u.id = at.user_id
                                WHERE at.token = '<sequence.accessTokenHash>'
                                AND at.user_id = '<sequence.callerUserId>'
                                AND at.row_status = 'ACTIVE'
                                AND at.expired_at > '<sequence.now>'
                                AND u.row_status = 'ACTIVE'
                            end note
                            t_user_access_token -> infra: Return ACTIVE matching unexpired token/user or no row
                        deactivate t_user_access_token
                        infra -> app: Return ACTIVE matching unexpired token/user or no row
                        alt Current token/user missing/inactive/revoked/expired/mismatched
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 401 E10002 Invalid or expired access token.
                                api -> page: Show failure; no successful shop list action
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                        app -> infra: QUERY - Get shops
                        infra -> m_shop: QUERY - Get shops
                        activate m_shop
                            note right of m_shop
                                SELECT
                                    s.id as shop_id,
                                    s.type_id,
                                    s.name,
                                    s.description,
                                    s.platform_margin_rate,
                                    s.shop_margin_rate,
                                    s.row_status
                                FROM shop.m_shop s
                                WHERE s.row_status <> 'DELETED'
                                AND s.id = '<sequence.id>' -- only when id is specified
                                AND s.type_id = '<sequence.typeId>' -- only when typeId is specified
                                AND (s.name ILIKE '%<sequence.search>%' OR s.description ILIKE '%<sequence.search>%') -- only when search is specified
                                AND s.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                                ORDER BY s.created_at DESC
                                LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                            end note
                            m_shop -> infra: Return query result
                        deactivate m_shop
                        infra -> app: Return result of Get shops
                        app -> infra: QUERY - Get total items
                        infra -> m_shop: QUERY - Get total items
                        activate m_shop
                            note right of m_shop
                                SELECT
                                    COUNT(s.id) as total_items
                                FROM shop.m_shop s
                                WHERE s.row_status <> 'DELETED'
                                AND s.id = '<sequence.id>' -- only when id is specified
                                AND s.type_id = '<sequence.typeId>' -- only when typeId is specified
                                AND (s.name ILIKE '%<sequence.search>%' OR s.description ILIKE '%<sequence.search>%') -- only when search is specified
                                AND s.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                            end note
                            m_shop -> infra: Return query result
                        deactivate m_shop
                        infra -> app: Return result of Get total items
                    alt No shop matches the filters
                        app -> infra: COMMIT
                        infra -> app: Return committed read
                        app -> domain: Prepare the response with empty items
                        activate domain
                            domain -> app: Return response data
                        deactivate domain
                        app -> api: HTTP 200 S10000
                        api -> page: Return success response
                        page -> user: Display success result
                    else Shops found
                            app -> infra: QUERY - Get shop type names
                            infra -> m_shop_type: QUERY - Get shop type names
                            activate m_shop_type
                                note right of m_shop_type
                                    SELECT
                                        st.id as type_id,
                                        st.name as type_name
                                    FROM shop.m_shop_type st
                                    WHERE st.id IN ('<sequence.typeIds>')
                                end note
                                m_shop_type -> infra: Return query result
                            deactivate m_shop_type
                            infra -> app: Return result of Get shop type names
                            app -> infra: QUERY - Check shop members
                            infra -> t_shop_user: QUERY - Check shop members
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.shop_id
                                    FROM shop.t_shop_user su
                                    WHERE su.shop_id IN ('<sequence.shopIds>')
                                    AND su.user_id = '<sequence.userId>'
                                    AND su.role IN ('OWNER', 'ADMIN', 'STAFF')
                                    AND su.row_status = 'ACTIVE'
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return result of Check shop members
                            app -> app: Show platformMarginRate and shopMarginRate of a shop only when the caller has an ACTIVE member row of that shop or isPlatformAdmin; null otherwise
                            app -> infra: QUERY - Get shop images
                            infra -> m_shop_image: QUERY - Get shop images
                            activate m_shop_image
                                note right of m_shop_image
                                    SELECT
                                        si.id as image_id,
                                        si.shop_id,
                                        si.type,
                                        si.seq,
                                        si.image_path,
                                        si.row_status
                                    FROM shop.m_shop_image si
                                    WHERE si.shop_id IN ('<sequence.shopIds>')
                                    AND si.row_status <> 'DELETED'
                                    ORDER BY si.type, si.seq, si.created_at, si.id
                                end note
                                m_shop_image -> infra: Return query result
                            deactivate m_shop_image
                            infra -> app: Return result of Get shop images
                        alt Processing times out
                            app -> infra: ROLLBACK
                            app -> api: HTTP 408 E90001
                            api -> page: Request timeout
                            page -> user: Display timeout error
                        else Processing completes in time
                            app -> infra: COMMIT
                            infra -> app: Return committed read
                            app -> domain: Apply domain rules and prepare response
                            activate domain
                                domain -> app: Return response data
                            deactivate domain
                            app -> api: HTTP 200 S10000
                            api -> page: Return success response
                            page -> user: Display success result
                        end
                    end
                    else Unexpected SQL/result/mapping failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 Internal Server Error; omit bizCode
                        api -> page: Internal server error
                        page -> user: Display the outcome
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
