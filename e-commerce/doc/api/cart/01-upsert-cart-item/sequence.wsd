@startuml UpsertCartItem Sequence

title Upsert Cart Item API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Cart Item Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_cart" as t_cart
    database "t_shop_product_sku" as t_shop_product_sku
end box

user -> page: Submit the cart line
activate page
    page -> api: POST v1/cart/item/upsert
    activate api
        api -> app: [**UpsertCartItemCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    note over app, infra
                        Order: 400 -> verify JWT (401) -> BEGIN and lock the ACTIVE row of the user (401 when missing or not ACTIVE)
                        -> existence checks (404) -> stock checks (409, E10007) -> write the line -> line limit (409, E10008, ROLLBACK).
                        Two requests of the same user run one after the other, so the merge, the stock rule and the limit of 100 lines are exact.
                        An add is one INSERT ... ON CONFLICT on the partial unique index, so a line that was deleted is outside the index.
                    end note
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                        app -> infra: QUERY - Lock the user
                        infra -> m_user: QUERY - Lock the user
                        activate m_user
                            note right of m_user
                                SELECT
                                    u.id as user_id
                                FROM authen.m_user u
                                WHERE u.id = '<sequence.userId>'
                                AND u.row_status = 'ACTIVE'
                                FOR UPDATE -- every authen API locks the user row first
                            end note
                            m_user -> infra: Return the locked user or no row
                        deactivate m_user
                        infra -> app: Return the locked user or no row
                        alt User not found or not ACTIVE
                            app -> infra: ROLLBACK
                            app -> api: HTTP 401 E10002 Invalid or expired access token.
                            api -> page: Unauthorized
                            page -> user: Display authentication error
                        end
                        alt rowStatus = DELETED (delete the line)
                            app -> infra: QUERY - Check the line of the user
                            infra -> t_cart: QUERY - Check the line of the user
                            activate t_cart
                                note right of t_cart
                                    SELECT
                                        c.id as cart_id,
                                        c.sku_id,
                                        c.quantity
                                    FROM cart.t_cart c
                                    WHERE c.id = '<sequence.id>'
                                    AND c.user_id = '<sequence.userId>'
                                    AND c.row_status = 'ACTIVE'
                                end note
                                t_cart -> infra: Return query result
                            deactivate t_cart
                            infra -> app: Return the line or no row
                            alt Line not found for this user (another user's line or a deleted line)
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 Cart item not found.
                                api -> page: Not found
                                page -> user: Display the cart item is not found
                            else Line found
                                app -> infra: UPDATE - Update or delete a line
                                infra -> t_cart: UPDATE - Update or delete a line
                                activate t_cart
                                    note right of t_cart
                                        UPDATE cart.t_cart
                                        SET
                                            updated_by = '<sequence.userId>',
                                            updated_at = NOW() AT TIME ZONE 'UTC',
                                            row_status = '<sequence.rowStatus>',
                                            quantity = '<sequence.newQuantity>' -- quantity when updating, not changed when deleting
                                        WHERE id = '<sequence.cartId>'
                                        AND user_id = '<sequence.userId>'
                                        RETURNING id as cart_id, quantity
                                    end note
                                    t_cart -> infra: Return updated result
                                deactivate t_cart
                                infra -> app: Return the deleted line
                                app -> infra: COMMIT
                                app -> api: HTTP 204 No Content; no response body
                                api -> page: No content
                                page -> user: Display the item removed
                            end
                        else rowStatus = ACTIVE and id is specified (update the line)
                            app -> infra: QUERY - Check the line of the user
                            infra -> t_cart: QUERY - Check the line of the user
                            activate t_cart
                                note right of t_cart
                                    SELECT
                                        c.id as cart_id,
                                        c.sku_id,
                                        c.quantity
                                    FROM cart.t_cart c
                                    WHERE c.id = '<sequence.id>'
                                    AND c.user_id = '<sequence.userId>'
                                    AND c.row_status = 'ACTIVE'
                                end note
                                t_cart -> infra: Return query result
                            deactivate t_cart
                            infra -> app: Return the line or no row
                            alt Line not found for this user (another user's line or a deleted line)
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 Cart item not found.
                                api -> page: Not found
                                page -> user: Display the cart item is not found
                            else Line found
                                app -> infra: QUERY - Get the SKU that is on sale
                                infra -> t_shop_product_sku: QUERY - Get the SKU that is on sale
                                activate t_shop_product_sku
                                    note right of t_shop_product_sku
                                        SELECT
                                            ssk.id as shop_product_sku_id,
                                            sp.shop_id,
                                            sp.product_id,
                                            ssk.sku_id,
                                            l.quantity as max_order_quantity
                                        FROM shop.t_shop_product_sku ssk
                                        INNER JOIN shop.t_shop_product sp
                                            ON sp.id = ssk.shop_product_id
                                            AND sp.row_status = 'ACTIVE'
                                        INNER JOIN shop.m_shop s
                                            ON s.id = sp.shop_id
                                            AND s.row_status = 'ACTIVE'
                                        INNER JOIN product.m_product p
                                            ON p.id = sp.product_id
                                            AND p.row_status = 'ACTIVE'
                                        INNER JOIN product.m_product_sku ps
                                            ON ps.id = ssk.sku_id
                                            AND ps.row_status = 'ACTIVE'
                                        LEFT JOIN shop.t_shop_product_sku_lot l
                                            ON l.shop_product_sku_id = ssk.id
                                            AND l.is_on_sale = TRUE
                                            AND l.row_status = 'ACTIVE'
                                        WHERE ssk.id = '<sequence.shopProductSkuId>'
                                        AND ssk.row_status = 'ACTIVE'
                                    end note
                                    t_shop_product_sku -> infra: Return query result
                                deactivate t_shop_product_sku
                                infra -> app: Return the SKU, shop_id, product_id, sku_id and max_order_quantity or no row
                                alt SKU not found or not active
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10005 Shop product SKU not found.
                                    api -> page: Not found
                                    page -> user: Display the SKU is not available
                                else SKU found
                                    alt No lot on sale or the lot has no stock
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10007 The SKU is out of stock.
                                        api -> page: Conflict
                                        page -> user: Display out of stock
                                    else quantity > max_order_quantity
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10007 Quantity exceeds the available stock; the SKU can be bought up to max_order_quantity.
                                        api -> page: Conflict
                                        page -> user: Display the quantity that can be bought
                                    else Stock is enough
                                        app -> infra: UPDATE - Update or delete a line
                                        infra -> t_cart: UPDATE - Update or delete a line
                                        activate t_cart
                                            note right of t_cart
                                                UPDATE cart.t_cart
                                                SET
                                                    updated_by = '<sequence.userId>',
                                                    updated_at = NOW() AT TIME ZONE 'UTC',
                                                    row_status = '<sequence.rowStatus>',
                                                    quantity = '<sequence.newQuantity>' -- quantity when updating, not changed when deleting
                                                WHERE id = '<sequence.cartId>'
                                                AND user_id = '<sequence.userId>'
                                                RETURNING id as cart_id, quantity
                                            end note
                                            t_cart -> infra: Return updated result
                                        deactivate t_cart
                                        infra -> app: Return the updated line
                                        app -> infra: COMMIT
                                        app -> api: HTTP 200 S10000 Update Cart Item Success
                                        api -> page: Return committed result
                                        page -> user: Display success result
                                    end
                                end
                            end
                        else rowStatus = ACTIVE and id is not specified (add the SKU)
                            app -> infra: QUERY - Get the SKU that is on sale
                            infra -> t_shop_product_sku: QUERY - Get the SKU that is on sale
                            activate t_shop_product_sku
                                note right of t_shop_product_sku
                                    SELECT
                                        ssk.id as shop_product_sku_id,
                                        sp.shop_id,
                                        sp.product_id,
                                        ssk.sku_id,
                                        l.quantity as max_order_quantity
                                    FROM shop.t_shop_product_sku ssk
                                    INNER JOIN shop.t_shop_product sp
                                        ON sp.id = ssk.shop_product_id
                                        AND sp.row_status = 'ACTIVE'
                                    INNER JOIN shop.m_shop s
                                        ON s.id = sp.shop_id
                                        AND s.row_status = 'ACTIVE'
                                    INNER JOIN product.m_product p
                                        ON p.id = sp.product_id
                                        AND p.row_status = 'ACTIVE'
                                    INNER JOIN product.m_product_sku ps
                                        ON ps.id = ssk.sku_id
                                        AND ps.row_status = 'ACTIVE'
                                    LEFT JOIN shop.t_shop_product_sku_lot l
                                        ON l.shop_product_sku_id = ssk.id
                                        AND l.is_on_sale = TRUE
                                        AND l.row_status = 'ACTIVE'
                                    WHERE ssk.id = '<sequence.shopProductSkuId>'
                                    AND ssk.row_status = 'ACTIVE'
                                end note
                                t_shop_product_sku -> infra: Return query result
                            deactivate t_shop_product_sku
                            infra -> app: Return the SKU, shop_id, product_id, sku_id and max_order_quantity or no row
                            alt SKU not found or not active
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10005 Shop product SKU not found.
                                api -> page: Not found
                                page -> user: Display the SKU is not available
                            else SKU found
                                alt No lot on sale or the lot has no stock
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10007 The SKU is out of stock.
                                    api -> page: Conflict
                                    page -> user: Display out of stock
                                else quantity > max_order_quantity
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10007 Quantity exceeds the available stock; the SKU can be bought up to max_order_quantity.
                                    api -> page: Conflict
                                    page -> user: Display the quantity that can be bought
                                else Stock is enough
                                    app -> infra: INSERT - Add a line
                                    infra -> t_cart: INSERT - Add a line
                                    activate t_cart
                                        note right of t_cart
                                            INSERT INTO cart.t_cart (
                                                created_by,
                                                user_id,
                                                shop_id,
                                                product_id,
                                                sku_id,
                                                quantity
                                            )
                                            VALUES (
                                                &#39;<sequence.userId>',
                                                &#39;<sequence.userId>',
                                                &#39;<sequence.shopId>',
                                                &#39;<sequence.productId>',
                                                &#39;<sequence.skuId>',
                                                &#39;<sequence.quantity>'
                                            )
                                            ON CONFLICT (user_id, shop_id, product_id, sku_id) WHERE row_status <> 'DELETED' -- the partial unique index uq_t_cart_user_id_shop_id_product_id_sku_id
                                            DO UPDATE SET
                                                updated_by = '<sequence.userId>',
                                                updated_at = NOW() AT TIME ZONE 'UTC',
                                                quantity = cart.t_cart.quantity + EXCLUDED.quantity
                                            WHERE cart.t_cart.quantity + EXCLUDED.quantity <= '<sequence.maxOrderQuantity>' -- the stock rule of a merge, no row is returned when the merged quantity is over the stock
                                            RETURNING id as cart_id, quantity, (xmax = 0) as is_insert -- is_insert is true for a new line and false for a merge
                                        end note
                                        t_cart -> infra: Return inserted result
                                    deactivate t_cart
                                    infra -> app: Return the written line (is_insert) or no row
                                    alt No row returned (the line of the same SKU exists and the merged quantity is over the stock)
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10007 Quantity exceeds the available stock; the SKU can be bought up to max_order_quantity.
                                        api -> page: Conflict
                                        page -> user: Display the quantity that can be bought
                                    else The line is written (inserted or merged)
                                        app -> infra: QUERY - Count the lines of the user
                                        infra -> t_cart: QUERY - Count the lines of the user
                                        activate t_cart
                                            note right of t_cart
                                                SELECT
                                                    COUNT(c.id) as line_count
                                                FROM cart.t_cart c
                                                WHERE c.user_id = '<sequence.userId>'
                                                AND c.row_status = 'ACTIVE'
                                            end note
                                            t_cart -> infra: Return query result
                                        deactivate t_cart
                                        infra -> app: Return line_count
                                        alt line_count > 100 (the limit is a config)
                                            app -> infra: ROLLBACK
                                            app -> api: HTTP 409 E10008 The cart can hold at most 100 items.
                                            api -> page: Conflict
                                            page -> user: Display the cart is full
                                        else The cart is within the limit
                                            app -> infra: COMMIT
                                            alt is_insert = true (a new line)
                                                app -> api: HTTP 201 S10000 Add Cart Item Success
                                                api -> page: Return committed result
                                                page -> user: Display success result
                                            else is_insert = false (merged into the existing line)
                                                app -> api: HTTP 200 S10000 Merge Cart Item Success
                                                api -> page: Return committed result
                                                page -> user: Display success result
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
