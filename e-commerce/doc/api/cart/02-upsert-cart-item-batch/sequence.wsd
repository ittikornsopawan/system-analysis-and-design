@startuml UpsertCartItemBatch Sequence

title Upsert Cart Item Batch API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Cart Item Batch Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_cart" as t_cart
    database "t_shop_product_sku" as t_shop_product_sku
end box

user -> page: Submit the cart lines
activate page
    page -> api: POST v1/cart/item/upsert/batch
    activate api
        api -> api: Verify the access token; the userId is the user of the token
        alt Invalid or expired access token
            api -> page: HTTP 401 E10002
            page -> user: Ask the user to sign in again
        else Valid access token
            api -> app: [**UpsertCartItemBatchCommandHandler**] Process request
            activate app
                app -> app: Create request context; generate requestId when omitted
                app -> app: Validate headers and body: 1 to 100 items, no duplicated id, no duplicated shopProductSkuId among items without id, every item as in the single upsert
                alt Invalid input
                    app -> api: HTTP 400 E10001 items[i]: the first invalid item or the item count
                    api -> page: Bad request
                    page -> user: Display validation error
                else Valid input
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                        loop Pass 1 (404): every item in the request order
                            alt The item has an id
                                app -> infra: QUERY - Check the line of the user
                                infra -> t_cart: QUERY - Check the line of the user
                                activate t_cart
                                    note right of t_cart
                                        SELECT
                                            c.id as cart_id,
                                            c.sku_id,
                                            c.quantity
                                        FROM cart.t_cart c
                                        WHERE c.id = '<sequence.items.id>'
                                        AND c.user_id = '<sequence.userId>'
                                        AND c.row_status = 'ACTIVE'
                                    end note
                                    t_cart -> infra: Return query result
                                deactivate t_cart
                                infra -> app: Return the line or no row
                                alt Line not found for this user
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10004 items[i]: Cart item not found.
                                    api -> page: Not found
                                    page -> user: Display which item is not found
                                end
                            end
                            alt rowStatus is not DELETED
                                app -> infra: QUERY - Get the SKU that is on sale
                                infra -> t_shop_product_sku: QUERY - Get the SKU that is on sale
                                activate t_shop_product_sku
                                    note right of t_shop_product_sku
                                        SELECT
                                            ssk.id as shop_product_sku_id,
                                            sp.shop_id,
                                            sp.product_id,
                                            ssk.sku_id,
                                            l.quantity as max_order_quantity
                                        FROM shop.t_shop_product_sku ssk
                                        INNER JOIN shop.t_shop_product sp
                                            ON sp.id = ssk.shop_product_id
                                            AND sp.row_status = 'ACTIVE'
                                        INNER JOIN shop.m_shop s
                                            ON s.id = sp.shop_id
                                            AND s.row_status = 'ACTIVE'
                                        INNER JOIN product.m_product p
                                            ON p.id = sp.product_id
                                            AND p.row_status = 'ACTIVE'
                                        INNER JOIN product.m_product_sku ps
                                            ON ps.id = ssk.sku_id
                                            AND ps.row_status = 'ACTIVE'
                                        LEFT JOIN shop.t_shop_product_sku_lot l
                                            ON l.shop_product_sku_id = ssk.id
                                            AND l.is_on_sale = TRUE
                                            AND l.row_status = 'ACTIVE'
                                        WHERE ssk.id = '<sequence.items.shopProductSkuId>'
                                        AND ssk.row_status = 'ACTIVE'
                                    end note
                                    t_shop_product_sku -> infra: Return query result
                                deactivate t_shop_product_sku
                                infra -> app: Return the SKU, shop_id, product_id, sku_id and max_order_quantity or no row
                                alt SKU not found or not active
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10005 items[i]: Shop product SKU not found.
                                    api -> page: Not found
                                    page -> user: Display which SKU is not available
                                end
                            end
                        end
                        loop Pass 2 (409): every item in the request order
                            alt The item has no id (add)
                                app -> infra: QUERY - Get the line of the same SKU for merging
                                infra -> t_cart: QUERY - Get the line of the same SKU for merging
                                activate t_cart
                                    note right of t_cart
                                        SELECT
                                            c.id as cart_id,
                                            c.quantity
                                        FROM cart.t_cart c
                                        WHERE c.user_id = '<sequence.userId>'
                                        AND c.shop_id = '<sequence.shopId>'
                                        AND c.product_id = '<sequence.productId>'
                                        AND c.sku_id = '<sequence.skuId>'
                                        AND c.row_status = 'ACTIVE'
                                    end note
                                    t_cart -> infra: Return query result
                                deactivate t_cart
                                infra -> app: Return the line of the same SKU or no row
                            end
                            alt rowStatus is not DELETED
                                alt No lot on sale or the lot has no stock
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10007 items[i]: The SKU is out of stock or no longer on sale.
                                    api -> page: Conflict
                                    page -> user: Display which item is out of stock
                                else Quantity after the request > max_order_quantity
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10007 items[i]: Quantity exceeds the available stock; the SKU can be bought up to max_order_quantity.
                                    api -> page: Conflict
                                    page -> user: Display the quantity that can be bought
                                end
                            end
                        end
                        loop Pass 3 (write): every item in the request order
                            alt Add and the user has no line of the SKU (insert)
                                app -> infra: INSERT - Add a line
                                infra -> t_cart: INSERT - Add a line
                                activate t_cart
                                    note right of t_cart
                                        INSERT INTO cart.t_cart (
                                            created_by,
                                            user_id,
                                            shop_id,
                                            product_id,
                                            sku_id,
                                            quantity
                                        )
                                        VALUES (
                                            &#39;<sequence.userId>',
                                            &#39;<sequence.userId>',
                                            &#39;<sequence.shopId>',
                                            &#39;<sequence.productId>',
                                            &#39;<sequence.skuId>',
                                            &#39;<sequence.items.quantity>'
                                        )
                                        RETURNING id as cart_id, quantity
                                    end note
                                    t_cart -> infra: Return inserted result
                                deactivate t_cart
                                infra -> app: Return the new line
                            else Merge, update or delete
                                app -> infra: UPDATE - Merge, update or delete a line
                                infra -> t_cart: UPDATE - Merge, update or delete a line
                                activate t_cart
                                    note right of t_cart
                                        UPDATE cart.t_cart
                                        SET
                                            updated_by = '<sequence.userId>',
                                            updated_at = NOW() AT TIME ZONE 'UTC',
                                            row_status = '<sequence.items.rowStatus>',
                                            quantity = '<sequence.newQuantity>' -- existing quantity + quantity when merging, quantity when updating, not changed when deleting
                                        WHERE id = '<sequence.cartId>'
                                        AND user_id = '<sequence.userId>'
                                        RETURNING id as cart_id, quantity
                                    end note
                                    t_cart -> infra: Return updated result
                                deactivate t_cart
                                infra -> app: Return the changed line
                            end
                        end
                        app -> infra: QUERY - Count the lines of the user
                        infra -> t_cart: QUERY - Count the lines of the user
                        activate t_cart
                            note right of t_cart
                                SELECT
                                    COUNT(c.id) as line_count
                                FROM cart.t_cart c
                                WHERE c.user_id = '<sequence.userId>'
                                AND c.row_status = 'ACTIVE'
                            end note
                            t_cart -> infra: Return query result
                        deactivate t_cart
                        infra -> app: Return line_count after all items are applied
                        alt line_count > 100 (the limit is a config)
                            app -> infra: ROLLBACK
                            app -> api: HTTP 409 E10008 The cart can hold at most 100 items.
                            api -> page: Conflict
                            page -> user: Display the cart is full
                        else The cart is within the limit
                            app -> infra: COMMIT
                            app -> api: HTTP 200 S10000 Batch Upsert Cart Item Success: data.items[] with index, cartId, action and quantity
                            api -> page: Return the result of every item
                            page -> user: Display success result
                        end
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            deactivate app
        end
    deactivate api
deactivate page

@enduml
