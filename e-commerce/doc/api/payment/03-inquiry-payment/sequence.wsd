@startuml InquiryPayment Sequence

title Inquiry Payment API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Payment Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_payment" as t_payment
end box

user -> page: Request the payments
activate page
    page -> api: GET v1/payment
    activate api
        api -> app: [**InquiryPaymentQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters: pageSize 1 to 100, id and orderId are UUIDs, status is a payment status
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: Execute database operations
                    activate infra
                    alt Work completes
                        app -> infra: QUERY - Get the payments of the user
                        infra -> t_payment: QUERY - Get the payments of the user
                        activate t_payment
                            note right of t_payment
                                SELECT
                                    p.id as payment_id,
                                    p.order_id,
                                    o.code as order_code,
                                    p.status,
                                    p.payment_method,
                                    p.payment_name,
                                    p.amount,
                                    p.currency,
                                    p.shipping_method,
                                    p.shipping_fee,
                                    p.transaction_at,
                                    p.failure_code,
                                    p.failure_message,
                                    p.refunded_at,
                                    p.refund_reason,
                                    p.created_at
                                FROM payment.t_payment p
                                INNER JOIN sales.t_order o
                                    ON o.id = p.order_id
                                WHERE o.user_id = '<sequence.userId>'
                                AND p.row_status <> 'DELETED'
                                AND p.id = '<sequence.id>' -- only when id is specified
                                AND p.order_id = '<sequence.orderId>' -- only when orderId is specified
                                AND p.status = '<sequence.status>' -- only when status is specified
                                AND o.code ILIKE '%<sequence.search>%' -- only when search is specified
                                ORDER BY p.created_at DESC, p.id
                                LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                            end note
                            t_payment -> infra: Return query result
                        deactivate t_payment
                        infra -> app: Return the page of payments of the orders of the user
                        app -> infra: QUERY - Count the payments of the user
                        infra -> t_payment: QUERY - Count the payments of the user
                        activate t_payment
                            note right of t_payment
                                SELECT
                                    COUNT(p.id) as total_items
                                FROM payment.t_payment p
                                INNER JOIN sales.t_order o
                                    ON o.id = p.order_id
                                WHERE o.user_id = '<sequence.userId>'
                                AND p.row_status <> 'DELETED'
                                AND p.id = '<sequence.id>' -- only when id is specified
                                AND p.order_id = '<sequence.orderId>' -- only when orderId is specified
                                AND p.status = '<sequence.status>' -- only when status is specified
                                AND o.code ILIKE '%<sequence.search>%' -- only when search is specified
                            end note
                            t_payment -> infra: Return query result
                        deactivate t_payment
                        infra -> app: Return total_items
                        app -> domain: Build the page: never providerPaymentId, providerRefundId, transactionCode or clientSecret; failure, refund and transaction fields only for their status
                        activate domain
                        domain -> app: Return the payments and the paging
                        deactivate domain
                        alt No payment matches
                            app -> api: HTTP 200 S10000
                            api -> page: Return an empty list
                            page -> user: Display no payment
                        else Payments found
                            app -> api: HTTP 200 S10000
                            api -> page: Return the payments
                            page -> user: Display the payments
                        end
                    else Timeout
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
