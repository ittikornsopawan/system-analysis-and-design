@startuml RefundPayment Sequence

title Refund Payment API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Refund Payment Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "t_payment" as t_payment
    database "t_order" as t_order
    database "t_shop_user" as t_shop_user
    database "t_order_item" as t_order_item
    database "t_shop_product_sku_lot" as t_shop_product_sku_lot
    database "m_campaign_budget_ledger" as m_campaign_budget_ledger
    database "m_campaign_budget" as m_campaign_budget
end box

user -> page: Refund the payment
activate page
    page -> api: POST v1/shop/payment/refund
    activate api
        api -> app: [**RefundPaymentCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body: the timestamp header is a mandatory UTC timestamp, paymentId is a UUID, reason is required and at most 256 characters
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp, UUID sub and the roles claim (an array of roleId and name)
                alt Missing, malformed or invalid JWT or roles claim
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub; accessTokenHash = SHA-256 of the exact JWT; isPlatformAdmin = roles contains PLATFORM_ADMIN (no database query)
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                        app -> infra: QUERY - Lock the caller user
                        infra -> m_user: QUERY - Lock the caller user
                        activate m_user
                            note right of m_user
                                SELECT
                                    u.id as user_id
                                FROM authen.m_user u
                                WHERE u.id = '<sequence.userId>'
                                FOR UPDATE -- the caller user is locked first, before any other row of the request
                            end note
                            m_user -> infra: Return query result
                        deactivate m_user
                        infra -> app: Return the locked caller user
                        app -> app: Capture the fresh UTC now after the lock; recheck the JWT exp at now
                        app -> infra: QUERY - Check current credential and user
                        infra -> t_user_access_token: QUERY - Check current credential and user
                        activate t_user_access_token
                            note right of t_user_access_token
                                SELECT
                                    at.id as access_token_id
                                FROM authen.t_user_access_token at
                                JOIN authen.m_user u ON u.id = at.user_id
                                WHERE at.token = '<sequence.accessTokenHash>'
                                AND at.user_id = '<sequence.userId>'
                                AND at.row_status = 'ACTIVE'
                                AND at.expired_at > '<sequence.now>'
                                AND u.row_status = 'ACTIVE'
                            end note
                            t_user_access_token -> infra: Return query result
                        deactivate t_user_access_token
                        infra -> app: Return the credential row or no row
                        alt No ACTIVE stored token for this hash and user, or the user is not ACTIVE
                            app -> infra: ROLLBACK
                            app -> api: HTTP 401 E10002 Invalid or expired access token.
                            api -> page: Authentication error
                            page -> user: Ask the user to sign in again
                        else Current credential
                            app -> infra: QUERY - Get the payment
                            infra -> t_payment: QUERY - Get the payment
                            activate t_payment
                                note right of t_payment
                                    SELECT
                                        p.id as payment_id,
                                        p.order_id,
                                        p.provider_payment_id,
                                        p.amount,
                                        p.status
                                    FROM payment.t_payment p
                                    WHERE p.id = '<sequence.paymentId>'
                                    AND p.row_status <> 'DELETED'
                                end note
                                t_payment -> infra: Return query result
                            deactivate t_payment
                            infra -> app: Return the payment and its order (read without a lock only to find the order)
                            alt Payment not found or DELETED
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 Payment not found.
                                api -> page: Not found
                                page -> user: Display the payment is not found
                            else Payment found
                                app -> infra: QUERY - Get the order of the payment and lock it
                                infra -> t_order: QUERY - Get the order of the payment and lock it
                                activate t_order
                                    note right of t_order
                                        SELECT
                                            o.id as order_id,
                                            o.shop_id,
                                            o.status
                                        FROM sales.t_order o
                                        WHERE o.id = '<sequence.orderId>'
                                        AND o.row_status <> 'DELETED'
                                        FOR UPDATE -- taken before the payment is changed, the shipping API locks the same row when it creates or cancels a shipment
                                    end note
                                    t_order -> infra: Return query result
                                deactivate t_order
                                infra -> app: Return the locked order
                                app -> infra: QUERY - Check shop member
                                infra -> t_shop_user: QUERY - Check shop member
                                activate t_shop_user
                                    note right of t_shop_user
                                        SELECT
                                            su.shop_id
                                        FROM shop.t_shop_user su
                                        WHERE su.shop_id = '<sequence.shopId>'
                                        AND su.user_id = '<sequence.userId>'
                                        AND su.role IN ('ADMIN', 'STAFF')
                                        AND su.row_status = 'ACTIVE'
                                    end note
                                    t_shop_user -> infra: Return query result
                                deactivate t_shop_user
                                infra -> app: Return the ACTIVE ADMIN or STAFF row of the caller or no row
                                alt The caller is not a member of the shop and the roles claim has no PLATFORM_ADMIN
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 403 E10009 You do not have permission to refund the payments of this shop.
                                    api -> page: Forbidden
                                    page -> user: Display no permission
                                end
                                alt The payment is not COMPLETED or the order is not PAYMENT_CONFIRMED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10006 Only a completed payment of an order that is PAYMENT_CONFIRMED can be refunded, the order is <status>.
                                    api -> page: Conflict
                                    page -> user: Display the payment cannot be refunded
                                else The payment can be refunded
                                    app -> infra: Ask Stripe for the full refund of the PaymentIntent (Idempotency-Key = refund-<paymentId>)
                                    alt Stripe does not answer or refuses the request
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 408 E90001
                                        api -> page: Request timeout
                                        page -> user: Retry if needed
                                    else Refund created
                                        infra -> app: Return providerRefundId
                                        app -> infra: UPDATE - Refund the payment
                                        infra -> t_payment: UPDATE - Refund the payment
                                        activate t_payment
                                            note right of t_payment
                                                UPDATE payment.t_payment
                                                SET
                                                    updated_by = '<sequence.userId>',
                                                    updated_at = NOW() AT TIME ZONE 'UTC',
                                                    status = 'REFUNDED',
                                                    provider_refund_id = '<sequence.refundId>', -- id of the refund that Stripe returned
                                                    refunded_at = NOW() AT TIME ZONE 'UTC',
                                                    refund_reason = '<sequence.reason>'
                                                WHERE id = '<sequence.paymentId>'
                                                AND status = 'COMPLETED' -- no row changed means the status changed in the meantime, answer 409 (E10006)
                                                RETURNING id as payment_id, status, amount, currency, refunded_at
                                            end note
                                            t_payment -> infra: Return updated result
                                        deactivate t_payment
                                        infra -> app: Return the refunded payment or no row
                                        alt No row changed: the payment moved on in the meantime
                                            app -> infra: ROLLBACK
                                            app -> api: HTTP 409 E10006 The payment changed in the meantime.
                                            api -> page: Conflict
                                            page -> user: Display the payment changed
                                        else Payment refunded
                                            app -> infra: UPDATE - Refund the order
                                            infra -> t_order: UPDATE - Refund the order
                                            activate t_order
                                                note right of t_order
                                                    UPDATE sales.t_order
                                                    SET
                                                        updated_by = '<sequence.userId>',
                                                        updated_at = NOW() AT TIME ZONE 'UTC',
                                                        status = 'REFUNDED'
                                                    WHERE id = '<sequence.orderId>'
                                                    AND status = 'PAYMENT_CONFIRMED' -- no row changed means the order has started to ship, answer 409 (E10006)
                                                    RETURNING id as order_id, status
                                                end note
                                                t_order -> infra: Return updated result
                                            deactivate t_order
                                            infra -> app: Return the refunded order or no row
                                            alt No row changed: the order is no longer PAYMENT_CONFIRMED
                                                app -> infra: ROLLBACK
                                                app -> api: HTTP 409 E10006 The order status changed in the meantime.
                                                api -> page: Conflict
                                                page -> user: Display the payment cannot be refunded
                                            else Order refunded
                                                app -> infra: QUERY - Get the items of the order
                                                infra -> t_order_item: QUERY - Get the items of the order
                                                activate t_order_item
                                                    note right of t_order_item
                                                        SELECT
                                                            oi.id as order_item_id,
                                                            oi.lot_id,
                                                            oi.quantity
                                                        FROM sales.t_order_item oi
                                                        WHERE oi.order_id = '<sequence.orderId>'
                                                        AND oi.row_status <> 'DELETED'
                                                        ORDER BY oi.lot_id -- the lots are locked in id order, the same as the checkout
                                                    end note
                                                    t_order_item -> infra: Return query result
                                                deactivate t_order_item
                                                infra -> app: Return the items with their lots and quantities
                                                loop For every item in lot id order
                                                    app -> infra: UPDATE - Give the quantity back to the lot
                                                    infra -> t_shop_product_sku_lot: UPDATE - Give the quantity back to the lot
                                                    activate t_shop_product_sku_lot
                                                        note right of t_shop_product_sku_lot
                                                            UPDATE shop.t_shop_product_sku_lot
                                                            SET
                                                                updated_by = '<sequence.userId>',
                                                                updated_at = NOW() AT TIME ZONE 'UTC',
                                                                quantity = quantity + '<sequence.quantity>' -- the lot may be DELETED or ARCHIVED, it still gets the quantity back
                                                            WHERE id = '<sequence.lotId>'
                                                            RETURNING id as lot_id, quantity
                                                        end note
                                                        t_shop_product_sku_lot -> infra: Return updated result
                                                    deactivate t_shop_product_sku_lot
                                                    infra -> app: Return the lot and its quantity
                                                end
                                                app -> infra: QUERY - Get the budget that the order took
                                                infra -> m_campaign_budget_ledger: QUERY - Get the budget that the order took
                                                activate m_campaign_budget_ledger
                                                    note right of m_campaign_budget_ledger
                                                        SELECT
                                                            l.campaign_budget_id,
                                                            l.campaign_id,
                                                            l.usage,
                                                            l.reference
                                                        FROM campaign.m_campaign_budget_ledger l
                                                        WHERE l.order_id = '<sequence.orderId>'
                                                        AND l.entry_type = 'RESERVE'
                                                        AND NOT EXISTS (
                                                            SELECT 1
                                                            FROM campaign.m_campaign_budget_ledger r
                                                            WHERE r.order_id = l.order_id
                                                            AND r.campaign_budget_id = l.campaign_budget_id
                                                            AND r.entry_type = 'RELEASE'
                                                        ) -- a budget that was already given back is skipped, so nothing goes back twice
                                                        ORDER BY l.campaign_budget_id
                                                    end note
                                                    m_campaign_budget_ledger -> infra: Return query result
                                                deactivate m_campaign_budget_ledger
                                                infra -> app: Return the RESERVE rows that are not released yet
                                                loop For every budget in budget id order
                                                    app -> infra: INSERT - Write the release in the ledger
                                                    infra -> m_campaign_budget_ledger: INSERT - Write the release in the ledger
                                                    activate m_campaign_budget_ledger
                                                        note right of m_campaign_budget_ledger
                                                            INSERT INTO campaign.m_campaign_budget_ledger (created_by, campaign_budget_id, campaign_id, order_id, entry_type, reference, usage, remaining)
                                                            VALUES ('<sequence.userId>', '<sequence.campaignBudgetId>', '<sequence.campaignId>', '<sequence.orderId>', 'RELEASE', '<sequence.reference>', '<sequence.usage>', '<sequence.remaining>')
                                                            RETURNING id as ledger_id
                                                        end note
                                                        m_campaign_budget_ledger -> infra: Return inserted result
                                                    deactivate m_campaign_budget_ledger
                                                    infra -> app: Return ledger_id
                                                    app -> infra: UPDATE - Give the budget back
                                                    infra -> m_campaign_budget: UPDATE - Give the budget back
                                                    activate m_campaign_budget
                                                        note right of m_campaign_budget
                                                            UPDATE campaign.m_campaign_budget
                                                            SET
                                                                updated_by = '<sequence.userId>',
                                                                updated_at = NOW() AT TIME ZONE 'UTC',
                                                                remaining = remaining + '<sequence.usage>' -- the budget may be INACTIVE, LOCKED or ARCHIVED by now, it still gets the amount back
                                                            WHERE id = '<sequence.campaignBudgetId>'
                                                            RETURNING id as budget_id, remaining
                                                        end note
                                                        m_campaign_budget -> infra: Return updated result
                                                    deactivate m_campaign_budget
                                                    infra -> app: Return the budget and what is left
                                                end
                                                app -> infra: COMMIT
                                                app -> api: HTTP 200 S10000 Refund Payment Success
                                                api -> page: Return the refunded payment
                                                page -> user: Display the payment refunded
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
