@startuml InquiryShopPayment Sequence

title Inquiry Shop Payment API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Shop Payment Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_shop" as m_shop
    database "t_shop_user" as t_shop_user
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "t_payment" as t_payment
end box

user -> page: Request the payments of the shop
activate page
    page -> api: GET v1/shop/payment
    activate api
        api -> app: [**InquiryShopPaymentQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters: shopId is a required UUID, pageSize 1 to 100, status is a payment status
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: Execute database operations
                    activate infra
                    alt Work completes
                        app -> infra: QUERY - Check the shop
                        infra -> m_shop: QUERY - Check the shop
                        activate m_shop
                            note right of m_shop
                                SELECT
                                    s.id as shop_id
                                FROM shop.m_shop s
                                WHERE s.id = '<sequence.shopId>'
                                AND s.row_status <> 'DELETED'
                            end note
                            m_shop -> infra: Return query result
                        deactivate m_shop
                        infra -> app: Return the shop or no row
                        alt Shop not found or DELETED
                            app -> api: HTTP 404 E10005 Shop not found.
                            api -> page: Not found
                            page -> user: Display the shop is not found
                        else Shop found
                            app -> infra: QUERY - Check shop member
                            infra -> t_shop_user: QUERY - Check shop member
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.shop_id
                                    FROM shop.t_shop_user su
                                    WHERE su.shop_id = '<sequence.shopId>'
                                    AND su.user_id = '<sequence.userId>'
                                    AND su.role IN ('ADMIN', 'STAFF')
                                    AND su.row_status = 'ACTIVE'
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return the ACTIVE ADMIN or STAFF row of the caller or no row
                            app -> infra: QUERY - Get the platform administrator role
                            infra -> m_role: QUERY - Get the platform administrator role
                            activate m_role
                                note right of m_role
                                    SELECT
                                        r.id as role_id
                                    FROM author.m_role r
                                    WHERE r.name = 'PLATFORM_ADMIN'
                                    AND r.row_status = 'ACTIVE'
                                end note
                                m_role -> infra: Return query result
                            deactivate m_role
                            infra -> app: Return the role id
                            app -> infra: QUERY - Check platform administrator
                            infra -> t_user_role: QUERY - Check platform administrator
                            activate t_user_role
                                note right of t_user_role
                                    SELECT
                                        ur.id as user_role_id
                                    FROM author.t_user_role ur
                                    WHERE ur.user_id = '<sequence.userId>'
                                    AND ur.role_id = '<sequence.roleId>'
                                    AND ur.row_status = 'ACTIVE'
                                end note
                                t_user_role -> infra: Return query result
                            deactivate t_user_role
                            infra -> app: Return the assignment or no row
                            alt The caller is neither a member of the shop nor a platform administrator
                                app -> api: HTTP 403 E10009 You do not have permission to read the payments of this shop.
                                api -> page: Forbidden
                                page -> user: Display no permission
                            end
                            app -> infra: QUERY - Get the payments of the shop
                            infra -> t_payment: QUERY - Get the payments of the shop
                            activate t_payment
                                note right of t_payment
                                    SELECT
                                        p.id as payment_id,
                                        p.order_id,
                                        o.code as order_code,
                                        p.status,
                                        p.payment_method,
                                        p.payment_name,
                                        p.amount,
                                        p.currency,
                                        p.shipping_method,
                                        p.shipping_fee,
                                        p.transaction_at,
                                        p.transaction_code,
                                        p.provider_payment_id, -- returned only to a platform administrator, null for the members of the shop
                                        p.provider_refund_id, -- returned only to a platform administrator, null for the members of the shop
                                        p.failure_code,
                                        p.failure_message,
                                        p.refunded_at,
                                        p.refund_reason,
                                        p.created_at
                                    FROM payment.t_payment p
                                    INNER JOIN sales.t_order o
                                        ON o.id = p.order_id
                                    WHERE o.shop_id = '<sequence.shopId>'
                                    AND p.row_status <> 'DELETED'
                                    AND p.id = '<sequence.id>' -- only when id is specified
                                    AND p.order_id = '<sequence.orderId>' -- only when orderId is specified
                                    AND p.status = '<sequence.status>' -- only when status is specified
                                    AND o.code ILIKE '%<sequence.search>%' -- only when search is specified
                                    ORDER BY p.created_at DESC, p.id
                                    LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                                end note
                                t_payment -> infra: Return query result
                            deactivate t_payment
                            infra -> app: Return the page of payments of the orders of the shop
                            app -> infra: QUERY - Count the payments of the shop
                            infra -> t_payment: QUERY - Count the payments of the shop
                            activate t_payment
                                note right of t_payment
                                    SELECT
                                        COUNT(p.id) as total_items
                                    FROM payment.t_payment p
                                    INNER JOIN sales.t_order o
                                        ON o.id = p.order_id
                                    WHERE o.shop_id = '<sequence.shopId>'
                                    AND p.row_status <> 'DELETED'
                                    AND p.id = '<sequence.id>' -- only when id is specified
                                    AND p.order_id = '<sequence.orderId>' -- only when orderId is specified
                                    AND p.status = '<sequence.status>' -- only when status is specified
                                    AND o.code ILIKE '%<sequence.search>%' -- only when search is specified
                                end note
                                t_payment -> infra: Return query result
                            deactivate t_payment
                            infra -> app: Return total_items
                            app -> domain: Build the page: transactionCode for the members, providerPaymentId and providerRefundId only for a platform administrator (null for a member)
                            activate domain
                            domain -> app: Return the payments and the paging
                            deactivate domain
                            alt No payment matches
                                app -> api: HTTP 200 S10000
                                api -> page: Return an empty list
                                page -> user: Display no payment
                            else Payments found
                                app -> api: HTTP 200 S10000
                                api -> page: Return the payments
                                page -> user: Display the payments
                            end
                        end
                    else Timeout
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
