@startuml CreateNewPassword

title Create New Password API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Create New Password Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_user_reset_password" as t_user_reset_password
    database "m_user" as m_user
    database "m_user_password" as m_user_password
    database "t_user_access_token" as t_user_access_token
    database "t_user_refresh_token" as t_user_refresh_token
end box

user -> page: Submit reset token and new password over TLS
activate page
page -> api: POST v1/auth/create-new-password (timestamp, resetToken, newPassword)
activate api
api -> app: [**CreateNewPasswordCommandHandler**] Process request
activate app
app -> app: Generate requestId if omitted; validate UTC timestamp, body strings and password policy
alt Invalid fields, timestamp or password policy
    app -> api: HTTP 400 E10001
    api -> page: Display failure; no durable changes
else Valid input
    app -> app: resetTokenHash = SHA-256 exact resetToken; capture server UTC lookupNow
    alt Routing lookup timeout before BEGIN
        app -> api: HTTP 408 E90001
        api -> page: Display failure; no durable changes
    else Routing lookup failure before BEGIN
        app -> api: HTTP 500 Internal Server Error; omit bizCode
        api -> page: Display failure; no durable changes
    else Routing lookup completes
        app -> infra: QUERY - Find the reset token
        infra -> t_user_reset_password: QUERY - Find the reset token
        activate t_user_reset_password
            note right of t_user_reset_password
                SELECT
                    rp.id as reset_id,
                    rp.user_id
                FROM authen.t_user_reset_password rp
                WHERE rp.reset_token = '<sequence.resetTokenHash>' -- SHA-256 of resetToken
                AND rp.row_status = 'ACTIVE'
                AND rp.expired_at > '<sequence.lookupNow>'
            end note
            t_user_reset_password -> infra: Return resetId/userId routing hint or no row
        deactivate t_user_reset_password
        infra -> app: Return resetId/userId routing hint or no row
        alt Reset routing row missing
            app -> api: HTTP 400 E10001 Reset token is invalid or expired.
            api -> page: Display failure; no durable changes
        else Reset routing row returned
            app -> app: resetId/userId = returned row; never request userId
            app -> infra: BEGIN READ COMMITTED
            alt Transaction work completes
                app -> infra: QUERY - Lock the user
                infra -> m_user: QUERY - Lock the user
                activate m_user
                    note right of m_user
                        SELECT
                            u.id as user_id
                        FROM authen.m_user u
                        WHERE u.id = '<sequence.userId>'
                        AND u.row_status = 'ACTIVE'
                        FOR UPDATE -- every authen API locks the user row first
                    end note
                    m_user -> infra: Return ACTIVE user row or no row
                deactivate m_user
                infra -> app: Return ACTIVE user row or no row
                alt ACTIVE user row returned
                    app -> app: Capture fresh server UTC now after user lock; do not reuse lookupNow
                    app -> infra: UPDATE - Use the reset token once
                    infra -> t_user_reset_password: UPDATE - Use the reset token once
                    activate t_user_reset_password
                        note right of t_user_reset_password
                            UPDATE authen.t_user_reset_password
                            SET
                                updated_by = '<sequence.userId>',
                                updated_at = '<sequence.now>',
                                row_status = 'INACTIVE'
                            WHERE id = '<sequence.resetId>'
                            AND user_id = '<sequence.userId>'
                            AND reset_token = '<sequence.resetTokenHash>'
                            AND row_status = 'ACTIVE'
                            AND expired_at > '<sequence.now>'
                            RETURNING id as reset_id -- no row means the answer is 400
                        end note
                        t_user_reset_password -> infra: Return consumed reset_id or no row
                    deactivate t_user_reset_password
                    infra -> app: Return consumed reset_id or no row
                    alt Exactly one reset_id returned
                        app -> infra: QUERY - Get current password
                        infra -> m_user_password: QUERY - Get current password
                        activate m_user_password
                            note right of m_user_password
                                SELECT
                                    up.id as password_id,
                                    up.password,
                                    up.password_salt
                                FROM authen.m_user_password up
                                WHERE up.user_id = '<sequence.userId>'
                                AND up.row_type = 'PASSWORD'
                                AND up.row_status = 'ACTIVE'
                            end note
                            m_user_password -> infra: Return passwordId/passwordBytes/passwordSaltBytes or no row
                        deactivate m_user_password
                        infra -> app: Return passwordId/passwordBytes/passwordSaltBytes or no row
                        alt Exactly one ACTIVE PASSWORD returned
                            app -> app: passwordId = returned password_id; candidate = PBKDF2-HMAC-SHA256(newPassword, stored salt, 600000); constant-time compare
                            alt Candidate differs from current password
                                app -> app: Generate fresh cryptographically random 16-byte passwordSaltBytes; derive passwordBytes with PBKDF2-HMAC-SHA256 600000
                                app -> infra: UPDATE - Make the current password INACTIVE
                                infra -> m_user_password: UPDATE - Make the current password INACTIVE
                                activate m_user_password
                                    note right of m_user_password
                                        UPDATE authen.m_user_password
                                        SET
                                            updated_by = '<sequence.userId>',
                                            updated_at = '<sequence.now>',
                                            row_status = 'INACTIVE'
                                        WHERE id = '<sequence.passwordId>'
                                        AND user_id = '<sequence.userId>'
                                        AND row_type = 'PASSWORD'
                                        AND row_status = 'ACTIVE'
                                        RETURNING id as password_id
                                    end note
                                    m_user_password -> infra: Return closed password_id or no row
                                deactivate m_user_password
                                infra -> app: Return closed password_id or no row
                                alt Exactly one password_id returned
                                    app -> infra: INSERT - Create password
                                    infra -> m_user_password: INSERT - Create password
                                    activate m_user_password
                                        note right of m_user_password
                                            INSERT INTO authen.m_user_password (
                                                created_by,
                                                row_type,
                                                user_id,
                                                password,
                                                password_salt
                                            )
                                            VALUES (
                                                &#39;<sequence.userId>',
                                                &#39;PASSWORD',
                                                &#39;<sequence.userId>',
                                                &#39;<sequence.passwordBytes>', -- PBKDF2-HMAC-SHA256, 600,000 iterations
                                                &#39;<sequence.passwordSaltBytes>'
                                            )
                                        end note
                                        m_user_password -> infra: Return inserted PASSWORD row count
                                    deactivate m_user_password
                                    infra -> app: Return inserted PASSWORD row count
                                    app -> infra: UPDATE - Close the access tokens of the user
                                    infra -> t_user_access_token: UPDATE - Close the access tokens of the user
                                    activate t_user_access_token
                                        note right of t_user_access_token
                                            UPDATE authen.t_user_access_token
                                            SET
                                                updated_by = '<sequence.userId>',
                                                updated_at = '<sequence.now>',
                                                row_status = 'INACTIVE'
                                            WHERE user_id = '<sequence.userId>'
                                            AND row_status = 'ACTIVE'
                                        end note
                                        t_user_access_token -> infra: Return accessClosedCount for every session
                                    deactivate t_user_access_token
                                    infra -> app: Return accessClosedCount for every session
                                    app -> infra: UPDATE - Close the refresh tokens of the user
                                    infra -> t_user_refresh_token: UPDATE - Close the refresh tokens of the user
                                    activate t_user_refresh_token
                                        note right of t_user_refresh_token
                                            UPDATE authen.t_user_refresh_token
                                            SET
                                                updated_by = '<sequence.userId>',
                                                updated_at = '<sequence.now>',
                                                row_status = 'INACTIVE'
                                            WHERE user_id = '<sequence.userId>'
                                            AND row_status = 'ACTIVE'
                                        end note
                                        t_user_refresh_token -> infra: Return refreshClosedCount for every session
                                    deactivate t_user_refresh_token
                                    infra -> app: Return refreshClosedCount for every session
                                    app -> app: accessClosedCount and refreshClosedCount may be zero; all changes remain atomic
                                    app -> infra: COMMIT
                                    infra -> app: Return committed password replacement and all-session revocation
                                    app -> api: HTTP 200 S10000 Create New Password Success; status only, no data
                                    api -> page: Password reset completed
                                    page -> user: Show login page; no automatic login
                                else Unexpected zero old-password update
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 500 Internal Server Error; omit bizCode
                                    api -> page: Display failure; no durable changes
                                end
                            else Candidate equals current password
                                app -> infra: ROLLBACK
                                app -> api: HTTP 400 E10001 New password must be different from the current password.
                                api -> page: Display failure; no durable changes
                            end
                        else Missing current PASSWORD
                            app -> infra: ROLLBACK
                            app -> api: HTTP 500 Internal Server Error; omit bizCode
                            api -> page: Display failure; no durable changes
                        end
                    else Reset consumed, replaced, mismatched or expired during wait
                        app -> infra: ROLLBACK
                        app -> api: HTTP 400 E10001 Reset token is invalid or expired.
                        api -> page: Display failure; no durable changes
                    end
                else User missing or not ACTIVE
                    app -> infra: ROLLBACK
                    app -> api: HTTP 400 E10001 Reset token is invalid or expired.
                    api -> page: Display failure; no durable changes
                end
            else Timeout before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 408 E90001
                api -> page: Display failure; no durable changes
            else Unexpected pre-commit failure
                app -> infra: ROLLBACK
                app -> api: HTTP 500 Internal Server Error; omit bizCode
                api -> page: Display failure; no durable changes
            end
        end
    end
end
deactivate app
deactivate api
deactivate page
@enduml
