@startuml InquiryUserAddress

title Inquiry User Address API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry User Address Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_user_access_token" as t_user_access_token
    database "t_user_address" as t_user_address
end box

user -> page: Read own addresses with optional filters/page
activate page
page -> api: GET v1/user/address (Bearer JWT, UTC timestamp, query filters; no body)
activate api
api -> app: [**InquiryUserAddressQueryHandler**] Process request
activate app
app -> app: Generate requestId; validate timestamp/known single query keys/no body, UUID, positive signed 64-bit integers/pageSize <= 100 and ACTIVE/INACTIVE filter
app -> app: Default omitted pageIndex/pageSize to 1/10; checked offset = (pageIndex - 1) * pageSize; reject BIGINT overflow
alt Invalid input or pagination overflow
    app -> api: HTTP 400 E10001
    api -> page: Display failure; no partial address list
else Valid input
    app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub
    alt Missing or invalid JWT
        app -> api: HTTP 401 E10002 Invalid or expired access token.
        api -> page: Display failure; no partial address list
    else Verified JWT
        app -> app: userId = verified sub; accessTokenHash = SHA-256 exact JWT
        app -> app: Bind omitted id/rowStatus/searchPattern as typed SQL NULL; searchPattern = percent + supplied search + percent, preserve ILIKE wildcards
        app -> infra: BEGIN REPEATABLE READ READ ONLY
        alt Read and mapping work completes
            app -> app: Capture fresh server UTC now immediately before credential read; recheck JWT exp
            alt JWT still unexpired at fresh now
                app -> infra: QUERY - Check current credential and user
                infra -> t_user_access_token: QUERY - Check current credential and user
                activate t_user_access_token
                    note right of t_user_access_token
                        SELECT
                            at.id as access_token_id
                        FROM authen.t_user_access_token at
                        JOIN authen.m_user u ON u.id = at.user_id
                        WHERE at.token = '<sequence.accessTokenHash>'
                        AND at.user_id = '<sequence.userId>'
                        AND at.row_status = 'ACTIVE'
                        AND at.expired_at > '<sequence.now>'
                        AND u.row_status = 'ACTIVE'
                    end note
                    t_user_access_token -> infra: Return ACTIVE matching unexpired token/user or no row
                deactivate t_user_access_token
                infra -> app: Return ACTIVE matching unexpired token/user or no row
                alt Exactly one valid current credential/user returned
                    app -> infra: QUERY - Get total items
                    infra -> t_user_address: QUERY - Get total items
                    activate t_user_address
                        note right of t_user_address
                            SELECT
                                COUNT(ua.id) as total_items
                            FROM authen.t_user_address ua
                            WHERE ua.user_id = '<sequence.userId>'
                            AND ua.row_status <> 'DELETED'
                            AND ('<sequence.id>' IS NULL OR ua.id = '<sequence.id>') -- only when id is specified
                            AND ('<sequence.searchPattern>' IS NULL OR ua.title ILIKE '<sequence.searchPattern>') -- only when search is specified
                            AND ('<sequence.rowStatus>' IS NULL OR ua.row_status = '<sequence.rowStatus>') -- only when rowStatus is specified
                        end note
                        t_user_address -> infra: Return totalItems from caller and all identical optional filters
                    deactivate t_user_address
                    infra -> app: Return totalItems from caller and all identical optional filters
                    app -> app: totalPages = 0 if totalItems = 0 else ceiling(totalItems / pageSize); use checked integer arithmetic
                    alt totalItems = 0
                        app -> app: items = []; skip page query
                    else totalItems > 0
                        app -> infra: QUERY - Get user addresses
                        infra -> t_user_address: QUERY - Get user addresses
                        activate t_user_address
                            note right of t_user_address
                                SELECT
                                    ua.id as user_address_id,
                                    ua.title,
                                    ua.is_default,
                                    ua.address,
                                    ua.city,
                                    ua.state,
                                    ua.postal_code,
                                    ua.country,
                                    ua.row_status
                                FROM authen.t_user_address ua
                                WHERE ua.user_id = '<sequence.userId>'
                                AND ua.row_status <> 'DELETED'
                                AND ('<sequence.id>' IS NULL OR ua.id = '<sequence.id>') -- only when id is specified
                                AND ('<sequence.searchPattern>' IS NULL OR ua.title ILIKE '<sequence.searchPattern>') -- only when search is specified
                                AND ('<sequence.rowStatus>' IS NULL OR ua.row_status = '<sequence.rowStatus>') -- only when rowStatus is specified
                                ORDER BY ua.is_default DESC, ua.created_at DESC, ua.id
                                LIMIT '<sequence.pageSize>' OFFSET '<sequence.offset>'
                            end note
                            t_user_address -> infra: Return ordered rows from same filters/snapshot and checked offset
                        deactivate t_user_address
                        infra -> app: Return ordered rows from same filters/snapshot and checked offset
                        app -> app: Require returned row count = min(pageSize, max(0, totalItems - offset)); mismatch is internal failure
                        alt Page returned rows
                            app -> app: Map each row to exactly userAddressId/title/isDefault/address/city/state/postalCode/country/rowStatus; decrypt five sensitive fields
                        else Page beyond range returned no rows
                            app -> app: items = []; preserve positive totalItems/totalPages; do not return 404
                        end
                    end
                    app -> app: data = items/pageIndex/pageSize/totalItems/totalPages; explicit empty array; exclude userId/token/hash/audit
                    app -> infra: COMMIT
                    infra -> app: Return committed consistent read-only page
                    app -> api: HTTP 200 S10000 Inquiry User Address Success; all five pagination keys
                    api -> page: Show own address page and totals
                    page -> user: Display addresses or empty page
                else Current token/user missing/inactive/revoked/expired/mismatched
                    app -> infra: ROLLBACK
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Display failure; no partial address list
                end
            else JWT expired before credential read
                app -> infra: ROLLBACK
                app -> api: HTTP 401 E10002 Invalid or expired access token.
                api -> page: Display failure; no partial address list
            end
        else Timeout before COMMIT
            app -> infra: ROLLBACK
            app -> api: HTTP 408 E90001
            api -> page: Display failure; no partial address list
        else Unexpected SQL/decryption/mapping failure before COMMIT
            app -> infra: ROLLBACK
            app -> api: HTTP 500 Internal Server Error; omit bizCode
            api -> page: Display failure; no partial address list
        end
    end
end
deactivate app
deactivate api
deactivate page
@enduml
