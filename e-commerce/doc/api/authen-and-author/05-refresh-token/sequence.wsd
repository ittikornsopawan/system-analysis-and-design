@startuml RefreshToken Sequence

title Refresh Token API Sequence

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox


actor "User" as user

box "Frontend" #F8FAFC
    participant "Refresh Token Page" as page
end box

box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box

box "Database" #F8FAFC
    database "t_user_refresh_token" as t_user_refresh_token
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
end box

user -> page: Submit Refresh Token

activate page
    page -> api: Call POST v1/auth/refresh-token
    activate api
        api -> app: [**RefreshTokenCommandHandler**] Process request
        activate app
            app -> app: Validate request parameters and business rules
            alt If request is invalid
                app -> api: Return error response
                api -> page: Return error response
                page -> user: Display error message
            else If request is valid
                app -> infra: Execute database operations
                activate infra
                    infra -> t_user_refresh_token: QUERY - Find the refresh token
                    activate t_user_refresh_token
                        note right of t_user_refresh_token
                            SELECT
                                rt.id as refresh_token_id,
                                rt.user_id,
                                rt.session_id,
                                rt.row_status,
                                rt.updated_at
                            FROM authen.t_user_refresh_token rt
                            WHERE rt.token = '<sequence.refreshTokenHash>' -- SHA-256 of refreshAccessToken
                            AND rt.expired_at > NOW() AT TIME ZONE 'UTC'
                        end note
                        t_user_refresh_token -> infra: Return query result
                    deactivate t_user_refresh_token

                    infra -> t_user_refresh_token: UPDATE - Use the refresh token once
                    activate t_user_refresh_token
                        note right of t_user_refresh_token
                            UPDATE authen.t_user_refresh_token
                            SET
                                updated_by = '<sequence.userId>',
                                updated_at = NOW() AT TIME ZONE 'UTC',
                                row_status = 'INACTIVE'
                            WHERE id = '<sequence.refreshTokenId>'
                            AND row_status = 'ACTIVE'
                            AND expired_at > NOW() AT TIME ZONE 'UTC'
                            RETURNING session_id -- no row means the answer is 401
                        end note
                        t_user_refresh_token -> infra: Return updated result
                    deactivate t_user_refresh_token

                    infra -> t_user_refresh_token: UPDATE - Close the refresh tokens of the session (reuse)
                    activate t_user_refresh_token
                        note right of t_user_refresh_token
                            UPDATE authen.t_user_refresh_token
                            SET
                                updated_by = '<sequence.userId>',
                                updated_at = NOW() AT TIME ZONE 'UTC',
                                row_status = 'INACTIVE'
                            WHERE session_id = '<sequence.sessionId>'
                            AND row_status = 'ACTIVE' -- only when the used token became INACTIVE more than 10 seconds ago
                        end note
                        t_user_refresh_token -> infra: Return updated result
                    deactivate t_user_refresh_token

                    infra -> t_user_refresh_token: INSERT - Create refresh token
                    activate t_user_refresh_token
                        note right of t_user_refresh_token
                            INSERT INTO authen.t_user_refresh_token (
                                created_by,
                                user_id,
                                session_id,
                                token,
                                expired_at
                            )
                            VALUES (
                                '<sequence.userId>',
                                '<sequence.userId>',
                                '<sequence.sessionId>',
                                '<sequence.refreshTokenHash>',
                                '<sequence.refreshExpiredAt>' -- now plus 14 days (configurable)
                            )
                        end note
                        t_user_refresh_token -> infra: Return inserted result
                    deactivate t_user_refresh_token

                    infra -> m_user: QUERY - Lock the user
                    activate m_user
                        note right of m_user
                            SELECT
                                u.id as user_id
                            FROM authen.m_user u
                            WHERE u.id = '<sequence.userId>'
                            AND u.row_status = 'ACTIVE'
                            FOR UPDATE -- every authen API locks the user row first
                        end note
                        m_user -> infra: Return query result
                    deactivate m_user

                    infra -> t_user_access_token: UPDATE - Close the access tokens of the session (reuse)
                    activate t_user_access_token
                        note right of t_user_access_token
                            UPDATE authen.t_user_access_token
                            SET
                                updated_by = '<sequence.userId>',
                                updated_at = NOW() AT TIME ZONE 'UTC',
                                row_status = 'INACTIVE'
                            WHERE session_id = '<sequence.sessionId>'
                            AND row_status = 'ACTIVE' -- only when the used token became INACTIVE more than 10 seconds ago
                        end note
                        t_user_access_token -> infra: Return updated result
                    deactivate t_user_access_token

                    infra -> t_user_access_token: INSERT - Create access token
                    activate t_user_access_token
                        note right of t_user_access_token
                            INSERT INTO authen.t_user_access_token (
                                created_by,
                                user_id,
                                session_id,
                                token,
                                expired_at
                            )
                            VALUES (
                                '<sequence.userId>',
                                '<sequence.userId>',
                                '<sequence.sessionId>',
                                '<sequence.accessTokenHash>', -- SHA-256 of the JWT
                                '<sequence.accessExpiredAt>' -- now plus 15 minutes (configurable)
                            )
                        end note
                        t_user_access_token -> infra: Return inserted result
                    deactivate t_user_access_token

                    infra -> app: Return database result
                deactivate infra

                app -> domain: Apply domain rules and prepare response
                activate domain
                    domain -> app: Return response data
                deactivate domain

                app -> api: Return success response
                api -> page: Return success response
                page -> user: Display success result
            end alt
        deactivate app
    deactivate api
deactivate page

@enduml
