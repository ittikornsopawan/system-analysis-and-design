@startuml Logout

title Logout API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox
actor "User" as user
box "Frontend" #F8FAFC
    participant "Logout Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "t_user_refresh_token" as t_user_refresh_token
end box
user -> page: Log out of this session
activate page
page -> api: POST v1/auth/logout (Bearer JWT, timestamp; no body)
activate api
api -> app: [**LogoutCommandHandler**] Process request
activate app
app -> app: Generate requestId if omitted; validate UTC timestamp and empty body
alt Invalid timestamp or non-empty body
    app -> api: HTTP 400 E10001
    api -> page: Validation failure
else Valid input
    app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub
    alt Missing, malformed or invalid JWT
        app -> api: HTTP 401 E10002 Invalid or expired access token.
        api -> page: Authentication failure
    else Verified JWT
        app -> app: userId = verified sub; accessTokenHash = SHA-256 exact JWT
        app -> infra: BEGIN READ COMMITTED
        alt Transaction work completes
            app -> infra: QUERY - Lock the user
            infra -> m_user: QUERY - Lock the user
            activate m_user
                note right of m_user
                    SELECT
                        u.id as user_id
                    FROM authen.m_user u
                    WHERE u.id = '<sequence.userId>'
                    AND u.row_status = 'ACTIVE'
                    FOR UPDATE -- every authen API locks the user row first
                end note
                m_user -> infra: Return ACTIVE user row or no row
            deactivate m_user
            infra -> app: Return ACTIVE user row or no row
            alt ACTIVE user row returned
                app -> app: Capture fresh server UTC now after user lock; recheck JWT exp
                app -> infra: QUERY - Get the session of the access token
                infra -> t_user_access_token: QUERY - Get the session of the access token
                activate t_user_access_token
                    note right of t_user_access_token
                        SELECT
                            at.session_id
                        FROM authen.t_user_access_token at
                        WHERE at.token = '<sequence.accessTokenHash>' -- SHA-256 of the JWT
                        AND at.user_id = '<sequence.userId>'
                        AND at.row_status = 'ACTIVE'
                        AND at.expired_at > '<sequence.now>'
                    end note
                    t_user_access_token -> infra: Return stored sessionId or no row
                deactivate t_user_access_token
                infra -> app: Return stored sessionId or no row
                alt Stored token ACTIVE, owned and unexpired; JWT still unexpired
                    app -> app: sessionId = returned stored session_id; never request/JWT session input
                    app -> infra: UPDATE - Close the access tokens of the session
                    infra -> t_user_access_token: UPDATE - Close the access tokens of the session
                    activate t_user_access_token
                        note right of t_user_access_token
                            UPDATE authen.t_user_access_token
                            SET
                                updated_by = '<sequence.userId>',
                                updated_at = '<sequence.now>',
                                row_status = 'INACTIVE'
                            WHERE session_id = '<sequence.sessionId>'
                            AND user_id = '<sequence.userId>'
                            AND row_status = 'ACTIVE'
                        end note
                        t_user_access_token -> infra: Return accessClosedCount
                    deactivate t_user_access_token
                    infra -> app: Return accessClosedCount
                    alt accessClosedCount > 0
                        app -> infra: UPDATE - Close the refresh tokens of the session
                        infra -> t_user_refresh_token: UPDATE - Close the refresh tokens of the session
                        activate t_user_refresh_token
                            note right of t_user_refresh_token
                                UPDATE authen.t_user_refresh_token
                                SET
                                    updated_by = '<sequence.userId>',
                                    updated_at = '<sequence.now>',
                                    row_status = 'INACTIVE'
                                WHERE session_id = '<sequence.sessionId>'
                                AND user_id = '<sequence.userId>'
                                AND row_status = 'ACTIVE'
                            end note
                            t_user_refresh_token -> infra: Return refreshClosedCount
                        deactivate t_user_refresh_token
                        infra -> app: Return refreshClosedCount
                        app -> app: refreshClosedCount may be zero; both table changes remain atomic
                        app -> infra: COMMIT
                        infra -> app: Return committed full-session revocation
                        app -> api: HTTP 200 S10000 Logout Success; status only, no data
                        api -> page: Session logged out
                        page -> user: Show signed-out state
                    else Unexpected accessClosedCount = 0
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 Internal Server Error; omit bizCode
                        api -> page: Revocation failed; no partial changes
                    end
                else Token missing, revoked, expired, mismatched or JWT expired during wait
                    app -> infra: ROLLBACK
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication failure; no changes
                end
            else User missing or not ACTIVE
                app -> infra: ROLLBACK
                app -> api: HTTP 401 E10002 Invalid or expired access token.
                api -> page: Authentication failure; no changes
            end
        else Timeout before COMMIT
            app -> infra: ROLLBACK
            app -> api: HTTP 408 E90001
            api -> page: Logout timed out; no partial changes
        else Unexpected pre-commit failure
            app -> infra: ROLLBACK
            app -> api: HTTP 500 Internal Server Error; omit bizCode
            api -> page: Logout failed; no partial changes
        end
    end
end
deactivate app
deactivate api
deactivate page
@enduml
