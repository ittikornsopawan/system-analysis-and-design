@startuml InquiryUserProfile Sequence

title Inquiry User Profile API Sequence

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox


actor "User" as user

box "Frontend" #F8FAFC
    participant "Inquiry User Profile Page" as page
end box

box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box

box "Database" #F8FAFC
    database "m_user" as m_user
    database "m_user_information" as m_user_information
end box

user -> page: Request Inquiry User Profile

activate page
    page -> api: Call GET v1/user/profile
    activate api
        api -> app: [**InquiryUserProfileQueryHandler**] Process request
        activate app
            app -> app: Validate request parameters and business rules
            alt If request is invalid
                app -> api: Return error response
                api -> page: Return error response
                page -> user: Display error message
            else If request is valid
                app -> infra: Execute database operations
                activate infra
                    infra -> m_user: QUERY - Get user
                    activate m_user
                        note right of m_user
                            SELECT
                                u.id as user_id,
                                u.email_address,
                                u.first_name,
                                u.last_name,
                                u.display_name,
                                u.profile_picture_path
                            FROM authen.m_user u
                            WHERE u.id = '<sequence.userId>'
                            AND u.row_status = 'ACTIVE'
                        end note
                        m_user -> infra: Return query result
                    deactivate m_user

                    infra -> m_user_information: QUERY - Get information
                    activate m_user_information
                        note right of m_user_information
                            SELECT
                                ui.phone_number,
                                ui.address,
                                ui.date_of_birth,
                                ui.gender
                            FROM authen.m_user_information ui
                            WHERE ui.user_id = '<sequence.userId>'
                            AND ui.row_status <> 'DELETED'
                        end note
                        m_user_information -> infra: Return query result
                    deactivate m_user_information

                    infra -> app: Return database result
                deactivate infra

                app -> domain: Apply domain rules and prepare response
                activate domain
                    domain -> app: Return response data
                deactivate domain

                app -> api: Return success response
                api -> page: Return success response
                page -> user: Display success result
            end alt
        deactivate app
    deactivate api
deactivate page

@enduml
