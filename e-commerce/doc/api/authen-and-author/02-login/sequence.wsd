@startuml Login Sequence

title Login API Sequence

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox


actor "User" as user

box "Frontend" #F8FAFC
    participant "Login Page" as page
end box

box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box

box "Database" #F8FAFC
    database "m_user" as m_user
    database "m_user_password" as m_user_password
    database "l_user_login_attempt" as l_user_login_attempt
    database "t_user_role" as t_user_role
    database "m_role" as m_role
    database "t_role_permission" as t_role_permission
    database "t_role_permission_scope" as t_role_permission_scope
    database "t_user_permission" as t_user_permission
    database "t_permission_scope" as t_permission_scope
    database "m_permission" as m_permission
    database "m_scope" as m_scope
    database "t_user_access_token" as t_user_access_token
    database "t_user_refresh_token" as t_user_refresh_token
end box

user -> page: Submit Login

activate page
    page -> api: Call POST v1/auth/login
    activate api
        api -> app: [**LoginCommandHandler**] Process request
        activate app
            app -> app: Validate request parameters and business rules
            alt If request is invalid
                app -> api: Return error response
                api -> page: Return error response
                page -> user: Display error message
            else If request is valid
                app -> infra: Execute database operations
                activate infra
                    infra -> m_user: QUERY
                    activate m_user
                        note right of m_user
                            SELECT
                                u.id as user_id
                            FROM authen.m_user u
                            WHERE (u.username = '<sequence.usernameBytes>' OR u.email_address = '<sequence.usernameBytes>')
                            AND u.row_status = 'ACTIVE'
                        end note
                        m_user -> infra: Return query result
                    deactivate m_user

                    infra -> m_user_password: QUERY - Get current password
                    activate m_user_password
                        note right of m_user_password
                            SELECT
                                up.user_id,
                                up.password_salt
                            FROM authen.m_user u
                            INNER JOIN authen.m_user_password up
                                ON u.id = up.user_id
                                    AND up.row_type = 'PASSWORD'
                                    AND up.row_status = 'ACTIVE'
                            WHERE (u.username = '<sequence.usernameBytes>' OR u.email_address = '<sequence.usernameBytes>')
                            AND u.row_status = 'ACTIVE'
                        end note
                        m_user_password -> infra: Return query result
                    deactivate m_user_password

                    infra -> m_user_password: QUERY - Get matching user_id and password
                    activate m_user_password
                        note right of m_user_password
                            SELECT
                                up.user_id
                            FROM authen.m_user u
                            INNER JOIN authen.m_user_password up
                                ON u.id = up.user_id
                            WHERE (u.username = '<sequence.usernameBytes>' OR u.email_address = '<sequence.usernameBytes>')
                            AND u.row_status = 'ACTIVE'
                            AND up.row_type = 'PASSWORD'
                            AND up.row_status = 'ACTIVE'
                            AND up.password = '<sequence.passwordBytes>'
                        end note
                        m_user_password -> infra: Return query result
                    deactivate m_user_password

                    infra -> l_user_login_attempt: QUERY - Count failed attempts
                    activate l_user_login_attempt
                        note right of l_user_login_attempt
                            SELECT
                                COUNT(la.id) as failed_attempts
                            FROM authen.l_user_login_attempt la
                            WHERE la.identifier_hash = '<sequence.identifierHash>' -- SHA-256 of the username that was sent
                            AND la.result = 'FAILED' -- refused attempts are never counted
                            AND la.created_at > '<sequence.windowStart>' -- now minus 15 minutes (configurable)
                        end note
                        l_user_login_attempt -> infra: Return query result
                    deactivate l_user_login_attempt

                    infra -> l_user_login_attempt: INSERT - Record attempt
                    activate l_user_login_attempt
                        note right of l_user_login_attempt
                            INSERT INTO authen.l_user_login_attempt (
                                created_by,
                                identifier_hash,
                                user_id,
                                result
                            )
                            VALUES (
                                'system',
                                '<sequence.identifierHash>',
                                '<sequence.userId>', -- NULL when the username does not exist
                                '<sequence.result>' -- SUCCESS, FAILED or REFUSED
                            )
                        end note
                        l_user_login_attempt -> infra: Return inserted result
                    deactivate l_user_login_attempt

                    infra -> m_user: QUERY - Lock the user
                    activate m_user
                        note right of m_user
                            SELECT
                                u.id as user_id
                            FROM authen.m_user u
                            WHERE u.id = '<sequence.userId>'
                            AND u.row_status = 'ACTIVE'
                            FOR UPDATE -- every authen API locks the user row first
                        end note
                        m_user -> infra: Return query result
                    deactivate m_user

                    infra -> t_user_role: QUERY - Get active role ids
                    activate t_user_role
                        note right of t_user_role
                            SELECT
                                ur.role_id
                            FROM author.t_user_role ur
                            WHERE ur.user_id = '<sequence.userId>'
                            AND ur.row_status = 'ACTIVE'
                        end note
                        t_user_role -> infra: Return query result
                    deactivate t_user_role

                    infra -> m_role: QUERY - Get active roles
                    activate m_role
                        note right of m_role
                            SELECT
                                r.id AS role_id,
                                r.name AS role_name
                            FROM author.m_role r
                            WHERE r.id IN (<sequence.roleIds>)
                            AND r.row_status = 'ACTIVE'
                        end note
                        m_role -> infra: Return query result
                    deactivate m_role

                    infra -> t_role_permission: QUERY - Get active role permissions
                    activate t_role_permission
                        note right of t_role_permission
                            SELECT
                                rp.id AS role_permission_id,
                                rp.permission_id
                            FROM author.t_role_permission rp
                            WHERE rp.role_id IN (<sequence.roleIds>)
                            AND rp.row_status = 'ACTIVE'
                        end note
                        t_role_permission -> infra: Return query result
                    deactivate t_role_permission

                    infra -> t_role_permission_scope: QUERY - Get active role permission scopes
                    activate t_role_permission_scope
                        note right of t_role_permission_scope
                            SELECT
                                rps.permission_scope_id AS scope_id
                            FROM author.t_role_permission_scope rps
                            WHERE rps.role_permission_id IN (<sequence.rolePermissionIds>)
                            AND rps.row_status = 'ACTIVE'
                        end note
                        t_role_permission_scope -> infra: Return query result
                    deactivate t_role_permission_scope

                    infra -> t_user_permission: QUERY - Get active direct permissions
                    activate t_user_permission
                        note right of t_user_permission
                            SELECT
                                up.permission_id
                            FROM author.t_user_permission up
                            WHERE up.user_id = '<sequence.userId>'
                            AND up.row_status = 'ACTIVE'
                        end note
                        t_user_permission -> infra: Return query result
                    deactivate t_user_permission

                    infra -> t_permission_scope: QUERY - Get active direct permission scopes
                    activate t_permission_scope
                        note right of t_permission_scope
                            SELECT
                                ps.scope_id
                            FROM author.t_permission_scope ps
                            WHERE ps.permission_id IN (<sequence.directPermissionIds>)
                            AND ps.row_status = 'ACTIVE'
                        end note
                        t_permission_scope -> infra: Return query result
                    deactivate t_permission_scope

                    infra -> m_permission: QUERY - Get active permissions
                    activate m_permission
                        note right of m_permission
                            SELECT
                                p.id AS permission_id,
                                p.name AS permission_name
                            FROM author.m_permission p
                            WHERE p.id IN (<sequence.permissionIds>)
                            AND p.row_status = 'ACTIVE'
                        end note
                        m_permission -> infra: Return query result
                    deactivate m_permission

                    infra -> m_scope: QUERY - Get active scopes
                    activate m_scope
                        note right of m_scope
                            SELECT
                                s.id AS scope_id,
                                s.scope
                            FROM author.m_scope s
                            WHERE s.id IN (<sequence.scopeIds>)
                            AND s.row_status = 'ACTIVE'
                        end note
                        m_scope -> infra: Return query result
                    deactivate m_scope

                    infra -> t_user_access_token: INSERT - Create access token
                    activate t_user_access_token
                        note right of t_user_access_token
                            INSERT INTO authen.t_user_access_token (
                                created_by,
                                user_id,
                                session_id,
                                token,
                                expired_at
                            )
                            VALUES (
                                '<sequence.userId>',
                                '<sequence.userId>',
                                '<sequence.sessionId>', -- a new session id for every login
                                '<sequence.accessTokenHash>', -- SHA-256 of the JWT
                                '<sequence.accessExpiredAt>' -- now plus 15 minutes (configurable)
                            )
                        end note
                        t_user_access_token -> infra: Return inserted result
                    deactivate t_user_access_token

                    infra -> t_user_refresh_token: INSERT - Create refresh token
                    activate t_user_refresh_token
                        note right of t_user_refresh_token
                            INSERT INTO authen.t_user_refresh_token (
                                created_by,
                                user_id,
                                session_id,
                                token,
                                expired_at
                            )
                            VALUES (
                                '<sequence.userId>',
                                '<sequence.userId>',
                                '<sequence.sessionId>',
                                '<sequence.refreshTokenHash>', -- SHA-256 of the refresh token
                                '<sequence.refreshExpiredAt>' -- now plus 14 days (configurable)
                            )
                        end note
                        t_user_refresh_token -> infra: Return inserted result
                    deactivate t_user_refresh_token

                    infra -> app: Return database result
                deactivate infra

                app -> domain: Apply domain rules and prepare response
                activate domain
                    domain -> app: Return response data
                deactivate domain

                app -> api: Return success response
                api -> page: Return success response
                page -> user: Display success result
            end alt
        deactivate app
    deactivate api
deactivate page

@enduml
