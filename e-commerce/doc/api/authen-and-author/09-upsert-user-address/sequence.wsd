@startuml UpsertUserAddress

title Upsert User Address API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert User Address Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "t_user_address" as t_user_address
end box

user -> page: Insert, update or delete own address
activate page
page -> api: POST v1/user/address/upsert (Bearer JWT, UTC timestamp, full address object)
activate api
api -> app: [**UpsertUserAddressCommandHandler**] Process request
activate app
app -> app: Generate requestId; validate mandatory strings/title, id UUID, rowStatus/default booleans, known fields and UTC timestamp
app -> app: Q21 reject explicit isDefault=true for INACTIVE or DELETED; reject insert DELETED
alt Invalid request including Q21
    app -> api: HTTP 400 E10001
    api -> page: Display failure; no address/default changes
else Valid input
    app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub
    alt Missing or invalid JWT
        app -> api: HTTP 401 E10002 Invalid or expired access token.
        api -> page: Display failure; no address/default changes
    else Verified JWT
        app -> app: userId = verified sub; accessTokenHash = SHA-256 exact JWT
        app -> app: Encrypt accepted address/city/state/postalCode/country as register; preserve plain title
        app -> app: id = supplied UUID or server SQL NULL for insert; omitted rowStatus = ACTIVE; preserve requestedTrue separately
        app -> infra: BEGIN READ COMMITTED
        alt Transaction work completes
            app -> infra: QUERY - Lock the user
            infra -> m_user: QUERY - Lock the user
            activate m_user
                note right of m_user
                    SELECT
                        u.id as user_id
                    FROM authen.m_user u
                    WHERE u.id = '<sequence.userId>'
                    AND u.row_status = 'ACTIVE'
                    FOR UPDATE -- every authen API locks the user row first
                end note
                m_user -> infra: Return ACTIVE user row or no row
            deactivate m_user
            infra -> app: Return ACTIVE user row or no row
            alt ACTIVE user row returned
                app -> app: Capture fresh server UTC now after user lock; recheck JWT exp
                app -> infra: QUERY - Check the current access token
                infra -> t_user_access_token: QUERY - Check the current access token
                activate t_user_access_token
                    note right of t_user_access_token
                        SELECT
                            at.id as access_token_id
                        FROM authen.t_user_access_token at
                        WHERE at.token = '<sequence.accessTokenHash>'
                        AND at.user_id = '<sequence.userId>'
                        AND at.row_status = 'ACTIVE'
                        AND at.expired_at > '<sequence.now>'
                    end note
                    t_user_access_token -> infra: Return ACTIVE matching unexpired token or no row
                deactivate t_user_access_token
                infra -> app: Return ACTIVE matching unexpired token or no row
                alt Current stored token valid and JWT still unexpired
                    app -> infra: QUERY - Check existing address
                    infra -> t_user_address: QUERY - Check existing address
                    activate t_user_address
                        note right of t_user_address
                            SELECT
                                ua.id as user_address_id,
                                ua.is_default
                            FROM authen.t_user_address ua
                            WHERE ua.id = '<sequence.id>'
                            AND ua.user_id = '<sequence.userId>'
                            AND ua.row_status <> 'DELETED' -- an address of another user or a DELETED address counts as not found
                        end note
                        t_user_address -> infra: Return owned non-DELETED user_address_id/is_default or no row
                    deactivate t_user_address
                    infra -> app: Return owned non-DELETED user_address_id/is_default or no row
                    alt Supplied id and no owned non-DELETED target
                        break Abort transaction and interaction
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 User address not found.
                            api -> page: Display failure; no address/default changes
                        end break
                    else Owned target found or insert id absent
                        app -> app: wasDefault = returned is_default or false for insert
                    end
                    app -> infra: QUERY - Count addresses
                    infra -> t_user_address: QUERY - Count addresses
                    activate t_user_address
                        note right of t_user_address
                            SELECT
                                COUNT(ua.id) as addresses
                            FROM authen.t_user_address ua
                            WHERE ua.user_id = '<sequence.userId>'
                            AND ua.row_status <> 'DELETED' -- only when inserting
                            AND '<sequence.id>' IS NULL
                        end note
                        t_user_address -> infra: Return addresses count; meaningful only when id is SQL NULL
                    deactivate t_user_address
                    infra -> app: Return addresses count; meaningful only when id is SQL NULL
                    alt Insert id absent and addresses >= 10
                        break Abort transaction and interaction
                            app -> infra: ROLLBACK
                            app -> api: HTTP 400 E10001 A user can have at most 10 addresses.
                            api -> page: Display failure; no address/default changes
                        end break
                    else Insert below quota or existing id operation
                        app -> app: Quota accepted under common user lock
                    end
                    app -> infra: QUERY - Check an ACTIVE address exists
                    infra -> t_user_address: QUERY - Check an ACTIVE address exists
                    activate t_user_address
                        note right of t_user_address
                            SELECT
                                ua.id as user_address_id
                            FROM authen.t_user_address ua
                            WHERE ua.user_id = '<sequence.userId>'
                            AND ua.row_status = 'ACTIVE'
                            AND ('<sequence.id>' IS NULL OR ua.id <> '<sequence.id>') -- only when id is specified
                            AND '<sequence.rowStatus>' = 'ACTIVE'
                        end note
                        t_user_address -> infra: Return other ACTIVE address ids or no row
                    deactivate t_user_address
                    infra -> app: Return other ACTIVE address ids or no row
                    app -> app: otherActiveExists = returned rows not empty
                    app -> app: isDefault = rowStatus ACTIVE AND (requestedTrue OR wasDefault OR NOT otherActiveExists)
                    app -> app: shouldPromote = wasDefault AND rowStatus not ACTIVE; flags are server-derived, never caller flags
                    app -> infra: UPDATE - Clear the old default
                    infra -> t_user_address: UPDATE - Clear the old default
                    activate t_user_address
                        note right of t_user_address
                            UPDATE authen.t_user_address
                            SET
                                updated_by = '<sequence.userId>',
                                updated_at = '<sequence.now>',
                                is_default = FALSE
                            WHERE user_id = '<sequence.userId>'
                            AND is_default
                            AND row_status <> 'DELETED'
                            AND ('<sequence.id>' IS NULL OR id <> '<sequence.id>') -- only when id is specified
                            AND '<sequence.isDefault>'
                        end note
                        t_user_address -> infra: Return cleared default count; zero allowed; false isDefault guard changes nothing
                    deactivate t_user_address
                    infra -> app: Return cleared default count; zero allowed; false isDefault guard changes nothing
                    alt Insert with id absent
                        app -> infra: INSERT - Create user address
                        infra -> t_user_address: INSERT - Create user address
                        activate t_user_address
                            note right of t_user_address
                                INSERT INTO authen.t_user_address (
                                    created_by,
                                    created_at,
                                    row_status,
                                    user_id,
                                    title,
                                    is_default,
                                    address,
                                    city,
                                    state,
                                    postal_code,
                                    country
                                )
                                VALUES (
                                    &#39;<sequence.userId>',
                                    &#39;<sequence.now>',
                                    &#39;<sequence.rowStatus>',
                                    &#39;<sequence.userId>',
                                    &#39;<sequence.title>',
                                    &#39;<sequence.isDefault>', -- TRUE when it is the first ACTIVE address of the user
                                    &#39;<sequence.addressBytes>',
                                    &#39;<sequence.cityBytes>',
                                    &#39;<sequence.stateBytes>',
                                    &#39;<sequence.postalCodeBytes>',
                                    &#39;<sequence.countryBytes>'
                                )
                                RETURNING id as user_address_id
                            end note
                            t_user_address -> infra: Return inserted user_address_id or unexpected no row
                        deactivate t_user_address
                        infra -> app: Return inserted user_address_id or unexpected no row
                        alt Exactly one inserted address id
                            app -> app: userAddressId = returned user_address_id
                            app -> infra: COMMIT
                            infra -> app: Return committed target/default changes
                            app -> api: HTTP 201 S10000 Insert User Address Success; data.userAddressId only
                            api -> page: Address operation completed
                            page -> user: Refresh own address list
                        else Unexpected zero INSERT result
                            app -> infra: ROLLBACK
                            app -> api: HTTP 500 Internal Server Error; omit bizCode
                            api -> page: Display failure; no address/default changes
                        end
                    else Delete existing id with rowStatus DELETED
                        app -> infra: UPDATE - Update or delete user address
                        infra -> t_user_address: UPDATE - Update or delete user address
                        activate t_user_address
                            note right of t_user_address
                                UPDATE authen.t_user_address
                                SET
                                    updated_by = '<sequence.userId>',
                                    updated_at = '<sequence.now>',
                                    row_status = '<sequence.rowStatus>',
                                    title = '<sequence.title>',
                                    is_default = '<sequence.isDefault>', -- FALSE when rowStatus is INACTIVE or DELETED
                                    address = '<sequence.addressBytes>',
                                    city = '<sequence.cityBytes>',
                                    state = '<sequence.stateBytes>',
                                    postal_code = '<sequence.postalCodeBytes>',
                                    country = '<sequence.countryBytes>'
                                WHERE id = '<sequence.id>'
                                AND user_id = '<sequence.userId>'
                                AND row_status <> 'DELETED'
                                RETURNING id as user_address_id
                            end note
                            t_user_address -> infra: Return updated user_address_id or no row
                        deactivate t_user_address
                        infra -> app: Return updated user_address_id or no row
                        alt Exactly one updated address id
                            app -> app: userAddressId = returned user_address_id
                            app -> infra: UPDATE - Promote another default address
                            infra -> t_user_address: UPDATE - Promote another default address
                            activate t_user_address
                                note right of t_user_address
                                    UPDATE authen.t_user_address
                                    SET
                                        updated_by = '<sequence.userId>',
                                        updated_at = '<sequence.now>',
                                        is_default = TRUE
                                    WHERE id = (
                                        SELECT ua.id
                                        FROM authen.t_user_address ua
                                        WHERE ua.user_id = '<sequence.userId>'
                                        AND ua.row_status = 'ACTIVE'
                                        ORDER BY COALESCE(ua.updated_at, ua.created_at) DESC, ua.id
                                        LIMIT 1
                                    ) -- only when the default address was deleted or deactivated
                                    AND user_id = '<sequence.userId>'
                                    AND row_status = 'ACTIVE'
                                    AND '<sequence.shouldPromote>'
                                    RETURNING id as user_address_id
                                end note
                                t_user_address -> infra: Return promoted address id or zero rows; false shouldPromote guard changes nothing
                            deactivate t_user_address
                            infra -> app: Return promoted address id or zero rows; false shouldPromote guard changes nothing
                            app -> infra: COMMIT
                            infra -> app: Return committed target/default changes
                            app -> api: HTTP 204 No Content; no response body
                            api -> page: Address operation completed
                            page -> user: Refresh own address list
                        else Guarded target no longer found
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 User address not found.
                            api -> page: Display failure; no address/default changes
                        end
                    else Update existing id with rowStatus ACTIVE or INACTIVE
                        app -> infra: UPDATE - Update or delete user address
                        infra -> t_user_address: UPDATE - Update or delete user address
                        activate t_user_address
                            note right of t_user_address
                                UPDATE authen.t_user_address
                                SET
                                    updated_by = '<sequence.userId>',
                                    updated_at = '<sequence.now>',
                                    row_status = '<sequence.rowStatus>',
                                    title = '<sequence.title>',
                                    is_default = '<sequence.isDefault>', -- FALSE when rowStatus is INACTIVE or DELETED
                                    address = '<sequence.addressBytes>',
                                    city = '<sequence.cityBytes>',
                                    state = '<sequence.stateBytes>',
                                    postal_code = '<sequence.postalCodeBytes>',
                                    country = '<sequence.countryBytes>'
                                WHERE id = '<sequence.id>'
                                AND user_id = '<sequence.userId>'
                                AND row_status <> 'DELETED'
                                RETURNING id as user_address_id
                            end note
                            t_user_address -> infra: Return updated user_address_id or no row
                        deactivate t_user_address
                        infra -> app: Return updated user_address_id or no row
                        alt Exactly one updated address id
                            app -> app: userAddressId = returned user_address_id
                            app -> infra: UPDATE - Promote another default address
                            infra -> t_user_address: UPDATE - Promote another default address
                            activate t_user_address
                                note right of t_user_address
                                    UPDATE authen.t_user_address
                                    SET
                                        updated_by = '<sequence.userId>',
                                        updated_at = '<sequence.now>',
                                        is_default = TRUE
                                    WHERE id = (
                                        SELECT ua.id
                                        FROM authen.t_user_address ua
                                        WHERE ua.user_id = '<sequence.userId>'
                                        AND ua.row_status = 'ACTIVE'
                                        ORDER BY COALESCE(ua.updated_at, ua.created_at) DESC, ua.id
                                        LIMIT 1
                                    ) -- only when the default address was deleted or deactivated
                                    AND user_id = '<sequence.userId>'
                                    AND row_status = 'ACTIVE'
                                    AND '<sequence.shouldPromote>'
                                    RETURNING id as user_address_id
                                end note
                                t_user_address -> infra: Return promoted address id or zero rows; false shouldPromote guard changes nothing
                            deactivate t_user_address
                            infra -> app: Return promoted address id or zero rows; false shouldPromote guard changes nothing
                            app -> infra: COMMIT
                            infra -> app: Return committed target/default changes
                            app -> api: HTTP 200 S10000 Update User Address Success; data.userAddressId only
                            api -> page: Address operation completed
                            page -> user: Refresh own address list
                        else Guarded target no longer found
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 User address not found.
                            api -> page: Display failure; no address/default changes
                        end
                    end
                else Stored token revoked/expired/mismatched or JWT expired during wait
                    app -> infra: ROLLBACK
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Display failure; no address/default changes
                end
            else User missing or not ACTIVE
                app -> infra: ROLLBACK
                app -> api: HTTP 401 E10002 Invalid or expired access token.
                api -> page: Display failure; no address/default changes
            end
        else Timeout before COMMIT
            app -> infra: ROLLBACK
            app -> api: HTTP 408 E90001
            api -> page: Display failure; no address/default changes
        else Unexpected pre-commit failure
            app -> infra: ROLLBACK
            app -> api: HTTP 500 Internal Server Error; omit bizCode
            api -> page: Display failure; no address/default changes
        end
    end
end
deactivate app
deactivate api
deactivate page
@enduml
