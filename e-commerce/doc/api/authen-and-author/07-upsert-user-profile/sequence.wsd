@startuml UpsertUserProfile

title Upsert User Profile API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert User Profile Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "m_user_information" as m_user_information
end box

user -> page: Save own profile fields
activate page
page -> api: POST v1/user/profile/upsert (Bearer JWT, timestamp, partial object)
activate api
api -> app: [**UpsertUserProfileCommandHandler**] Process request
activate app
app -> app: Generate requestId; validate UTC timestamp/object/known fields/types/lengths/phone/date/gender; null allowed
alt Invalid input, fixed field or unknown field
    app -> api: HTTP 400 E10001
    api -> page: Display failure; no profile changes
else Valid input including empty object
    app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub
    alt Missing or invalid JWT
        app -> api: HTTP 401 E10002 Invalid or expired access token.
        api -> page: Display failure; no profile changes
    else Verified JWT
        app -> app: userId = verified sub; accessTokenHash = SHA-256 exact JWT
        app -> app: Derive eight hasField flags from JSON key presence; userFieldsPresent/informationFieldsPresent from their groups
        app -> app: Encrypt supplied non-null sensitive values as register; explicit null = SQL NULL; omit preserves; typed text/date/boolean parameters
        app -> infra: BEGIN READ COMMITTED
        alt Transaction work completes
            app -> infra: QUERY - Lock the user
            infra -> m_user: QUERY - Lock the user
            activate m_user
                note right of m_user
                    SELECT
                        u.id as user_id
                    FROM authen.m_user u
                    WHERE u.id = '<sequence.userId>'
                    AND u.row_status = 'ACTIVE'
                    FOR UPDATE -- every authen API locks the user row first
                end note
                m_user -> infra: Return ACTIVE user row or no row
            deactivate m_user
            infra -> app: Return ACTIVE user row or no row
            alt ACTIVE user row returned
                app -> app: Capture fresh server UTC now after user lock; recheck JWT exp
                app -> infra: QUERY - Check the current access token
                infra -> t_user_access_token: QUERY - Check the current access token
                activate t_user_access_token
                    note right of t_user_access_token
                        SELECT
                            at.id as access_token_id
                        FROM authen.t_user_access_token at
                        WHERE at.token = '<sequence.accessTokenHash>'
                        AND at.user_id = '<sequence.userId>'
                        AND at.row_status = 'ACTIVE'
                        AND at.expired_at > '<sequence.now>'
                    end note
                    t_user_access_token -> infra: Return ACTIVE matching unexpired token or no row
                deactivate t_user_access_token
                infra -> app: Return ACTIVE matching unexpired token or no row
                alt Current stored token valid and JWT still unexpired
                    alt userFieldsPresent
                        app -> infra: UPDATE - Update user
                        infra -> m_user: UPDATE - Update user
                        activate m_user
                            note right of m_user
                                UPDATE authen.m_user
                                SET
                                    updated_by = '<sequence.userId>',
                                    updated_at = '<sequence.now>',
                                    first_name = CASE WHEN '<sequence.hasFirstName>' THEN '<sequence.firstNameBytes>' ELSE first_name END, -- only when firstName is specified (null clears it)
                                    last_name = CASE WHEN '<sequence.hasLastName>' THEN '<sequence.lastNameBytes>' ELSE last_name END, -- only when lastName is specified (null clears it)
                                    display_name = CASE WHEN '<sequence.hasDisplayName>' THEN '<sequence.displayName>' ELSE display_name END, -- only when displayName is specified (null clears it)
                                    profile_picture_path = CASE WHEN '<sequence.hasProfilePicturePath>' THEN '<sequence.profilePicturePath>' ELSE profile_picture_path END -- only when profilePicturePath is specified (null clears it)
                                WHERE id = '<sequence.userId>'
                                AND row_status = 'ACTIVE'
                                RETURNING id as user_id
                            end note
                            m_user -> infra: Return updated user_id or unexpected no row
                        deactivate m_user
                        infra -> app: Return updated user_id or unexpected no row
                        alt Exactly one user_id returned
                            app -> app: User fields saved for verified caller
                        else Unexpected zero user update
                            break Abort transaction and interaction
                                app -> infra: ROLLBACK
                                app -> api: HTTP 500 Internal Server Error; omit bizCode
                                api -> page: Display failure; no profile changes
                            end break
                        end
                    else No user fields supplied
                        app -> app: Skip m_user UPDATE and preserve user audit timestamps
                    end
                    alt informationFieldsPresent
                        app -> infra: QUERY - Check existing information
                        infra -> m_user_information: QUERY - Check existing information
                        activate m_user_information
                            note right of m_user_information
                                SELECT
                                    ui.id as information_id
                                FROM authen.m_user_information ui
                                WHERE ui.user_id = '<sequence.userId>'
                                AND ui.row_status <> 'DELETED'
                            end note
                            m_user_information -> infra: Return non-DELETED informationId or no row
                        deactivate m_user_information
                        infra -> app: Return non-DELETED informationId or no row
                        alt No non-DELETED information row
                            app -> app: Bind omitted information columns to SQL NULL on first insert
                            app -> infra: INSERT - Create information
                            infra -> m_user_information: INSERT - Create information
                            activate m_user_information
                                note right of m_user_information
                                    INSERT INTO authen.m_user_information (
                                        created_by,
                                        user_id,
                                        phone_number,
                                        address,
                                        date_of_birth,
                                        gender
                                    )
                                    VALUES (
                                        &#39;<sequence.userId>',
                                        &#39;<sequence.userId>',
                                        &#39;<sequence.phoneNumberBytes>',
                                        &#39;<sequence.addressBytes>',
                                        &#39;<sequence.dateOfBirth>',
                                        &#39;<sequence.gender>'
                                    )
                                    RETURNING id as information_id
                                end note
                                m_user_information -> infra: Return inserted information_id or unexpected no row
                            deactivate m_user_information
                            infra -> app: Return inserted information_id or unexpected no row
                            alt Exactly one inserted information_id
                                app -> app: First information row saved
                            else Unexpected zero information insert
                                break Abort transaction and interaction
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 500 Internal Server Error; omit bizCode
                                    api -> page: Display failure; no profile changes
                                end break
                            end
                        else Existing non-DELETED information row
                            app -> app: informationId = returned information_id; preserve row_status
                            app -> infra: UPDATE - Update information
                            infra -> m_user_information: UPDATE - Update information
                            activate m_user_information
                                note right of m_user_information
                                    UPDATE authen.m_user_information
                                    SET
                                        updated_by = '<sequence.userId>',
                                        updated_at = '<sequence.now>',
                                        phone_number = CASE WHEN '<sequence.hasPhoneNumber>' THEN '<sequence.phoneNumberBytes>' ELSE phone_number END, -- only when phoneNumber is specified (null clears it)
                                        address = CASE WHEN '<sequence.hasAddress>' THEN '<sequence.addressBytes>' ELSE address END, -- only when address is specified (null clears it)
                                        date_of_birth = CASE WHEN '<sequence.hasDateOfBirth>' THEN '<sequence.dateOfBirth>' ELSE date_of_birth END, -- only when dateOfBirth is specified (null clears it)
                                        gender = CASE WHEN '<sequence.hasGender>' THEN '<sequence.gender>' ELSE gender END -- only when gender is specified (null clears it)
                                    WHERE id = '<sequence.informationId>'
                                    AND user_id = '<sequence.userId>'
                                    AND row_status <> 'DELETED'
                                    RETURNING id as information_id
                                end note
                                m_user_information -> infra: Return updated information_id or unexpected no row
                            deactivate m_user_information
                            infra -> app: Return updated information_id or unexpected no row
                            alt Exactly one updated information_id
                                app -> app: Existing information fields saved
                            else Unexpected zero information update
                                break Abort transaction and interaction
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 500 Internal Server Error; omit bizCode
                                    api -> page: Display failure; no profile changes
                                end break
                            end
                        end
                    else No information fields supplied
                        app -> app: Skip information lookup/INSERT/UPDATE; preserve absence and audit timestamps
                    end
                    app -> infra: COMMIT
                    infra -> app: Return committed own-user profile or authenticated no-op
                    app -> app: data.userId = verified sub; response contains no other profile/secret fields
                    app -> api: HTTP 200 S10000 Upsert User Profile Success; data.userId only
                    api -> page: Profile saved
                    page -> user: Display saved state
                else Stored token revoked/expired/mismatched or JWT expired during wait
                    app -> infra: ROLLBACK
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Display failure; no profile changes
                end
            else User missing or not ACTIVE
                app -> infra: ROLLBACK
                app -> api: HTTP 401 E10002 Invalid or expired access token.
                api -> page: Display failure; no profile changes
            end
        else Timeout before COMMIT
            app -> infra: ROLLBACK
            app -> api: HTTP 408 E90001
            api -> page: Display failure; no profile changes
        else Unexpected pre-commit failure
            app -> infra: ROLLBACK
            app -> api: HTTP 500 Internal Server Error; omit bizCode
            api -> page: Display failure; no profile changes
        end
    end
end
deactivate app
deactivate api
deactivate page
@enduml
