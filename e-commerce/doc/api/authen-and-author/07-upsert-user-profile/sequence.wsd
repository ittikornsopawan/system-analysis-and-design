@startuml UpsertUserProfile Sequence

title Upsert User Profile API Sequence

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox


actor "User" as user

box "Frontend" #F8FAFC
    participant "Upsert User Profile Page" as page
end box

box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box

box "Database" #F8FAFC
    database "m_user" as m_user
    database "m_user_information" as m_user_information
end box

user -> page: Submit Upsert User Profile

activate page
    page -> api: Call POST v1/user/profile/upsert
    activate api
        api -> app: [**UpsertUserProfileCommandHandler**] Process request
        activate app
            app -> app: Validate request parameters and business rules
            alt If request is invalid
                app -> api: Return error response
                api -> page: Return error response
                page -> user: Display error message
            else If request is valid
                app -> infra: Execute database operations
                activate infra
                    infra -> m_user: QUERY - Lock the user
                    activate m_user
                        note right of m_user
                            SELECT
                                u.id as user_id
                            FROM authen.m_user u
                            WHERE u.id = '<sequence.userId>'
                            AND u.row_status = 'ACTIVE'
                            FOR UPDATE -- every authen API locks the user row first
                        end note
                        m_user -> infra: Return query result
                    deactivate m_user

                    infra -> m_user: UPDATE - Update user
                    activate m_user
                        note right of m_user
                            UPDATE authen.m_user
                            SET
                                updated_by = '<sequence.userId>',
                                updated_at = NOW() AT TIME ZONE 'UTC',
                                first_name = '<sequence.firstNameBytes>', -- only when firstName is specified (null clears it)
                                last_name = '<sequence.lastNameBytes>', -- only when lastName is specified (null clears it)
                                display_name = '<sequence.displayName>', -- only when displayName is specified (null clears it)
                                profile_picture_path = '<sequence.profilePicturePath>' -- only when profilePicturePath is specified (null clears it)
                            WHERE id = '<sequence.userId>'
                            RETURNING id as user_id
                        end note
                        m_user -> infra: Return updated result
                    deactivate m_user

                    infra -> m_user_information: QUERY - Check existing information
                    activate m_user_information
                        note right of m_user_information
                            SELECT
                                ui.id as information_id
                            FROM authen.m_user_information ui
                            WHERE ui.user_id = '<sequence.userId>'
                            AND ui.row_status <> 'DELETED'
                        end note
                        m_user_information -> infra: Return query result
                    deactivate m_user_information

                    infra -> m_user_information: INSERT - Create information
                    activate m_user_information
                        note right of m_user_information
                            INSERT INTO authen.m_user_information (
                                created_by,
                                user_id,
                                phone_number,
                                address,
                                date_of_birth,
                                gender
                            )
                            VALUES (
                                '<sequence.userId>',
                                '<sequence.userId>',
                                '<sequence.phoneNumberBytes>',
                                '<sequence.addressBytes>',
                                '<sequence.dateOfBirth>',
                                '<sequence.gender>'
                            )
                        end note
                        m_user_information -> infra: Return inserted result
                    deactivate m_user_information

                    infra -> m_user_information: UPDATE - Update information
                    activate m_user_information
                        note right of m_user_information
                            UPDATE authen.m_user_information
                            SET
                                updated_by = '<sequence.userId>',
                                updated_at = NOW() AT TIME ZONE 'UTC',
                                phone_number = '<sequence.phoneNumberBytes>', -- only when phoneNumber is specified (null clears it)
                                address = '<sequence.addressBytes>', -- only when address is specified (null clears it)
                                date_of_birth = '<sequence.dateOfBirth>', -- only when dateOfBirth is specified (null clears it)
                                gender = '<sequence.gender>' -- only when gender is specified (null clears it)
                            WHERE id = '<sequence.informationId>'
                        end note
                        m_user_information -> infra: Return updated result
                    deactivate m_user_information

                    infra -> app: Return database result
                deactivate infra

                app -> domain: Apply domain rules and prepare response
                activate domain
                    domain -> app: Return response data
                deactivate domain

                app -> api: Return success response
                api -> page: Return success response
                page -> user: Display success result
            end alt
        deactivate app
    deactivate api
deactivate page

@enduml
