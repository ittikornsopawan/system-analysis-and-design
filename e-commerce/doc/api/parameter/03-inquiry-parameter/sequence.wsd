@startuml InquiryParameter Sequence

title Inquiry Parameter API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Parameter Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_parameter" as m_parameter
end box

user -> page: Request Inquiry Parameter
activate page
    page -> api: GET v1/parameter
    activate api
        api -> app: [**InquiryParameterQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters (UUIDs, booleans, rowStatus, pageIndex from 1, pageSize 1 to 100)
            alt Invalid input or rootOnly is true together with parentId
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                note over app, infra
                    Public API: no access token, no transaction. Only ACTIVE parameters are read; another rowStatus filter returns an empty list.
                    Only the parameters effective at now unless includeNotEffective is true. Sort: key, then id.
                end note
                app -> app: Bind now = server UTC time of the request
                alt Reads complete in time
                    app -> infra: Execute database operations
                    activate infra
                        app -> infra: QUERY - Get parameters
                        infra -> m_parameter: QUERY - Get parameters
                        activate m_parameter
                            note right of m_parameter
                                SELECT
                                    p.id as parameter_id,
                                    p.parent_id,
                                    p.key,
                                    p.value,
                                    p.title,
                                    p.display,
                                    p.metadata,
                                    p.effective_at,
                                    p.expired_at,
                                    p.row_status
                                FROM public.m_parameter p
                                WHERE p.row_status = 'ACTIVE' -- a public caller sees only ACTIVE parameters
                                AND p.id = '<sequence.id>' -- only when id is specified
                                AND p.parent_id = '<sequence.parentId>' -- only when parentId is specified
                                AND p.parent_id IS NULL -- only when rootOnly is true
                                AND p.key = '<sequence.key>' -- only when key is specified
                                AND (p.key ILIKE '%<sequence.search>%' ESCAPE '\' OR EXISTS (SELECT 1 FROM jsonb_each_text(p.value) v WHERE v.value ILIKE '%<sequence.search>%' ESCAPE '\')) -- only when search is specified
                                AND p.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                                AND p.effective_at <= '<sequence.now>' -- unless includeNotEffective is true
                                AND (p.expired_at IS NULL OR p.expired_at > '<sequence.now>') -- unless includeNotEffective is true
                                ORDER BY p.key, p.id
                                LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                            end note
                            m_parameter -> infra: Return items (id, parent_id, key, value, title, display, metadata, effective_at, expired_at, row_status)
                        deactivate m_parameter
                        infra -> app: Return result of Get parameters
                        app -> infra: QUERY - Get total items
                        infra -> m_parameter: QUERY - Get total items
                        activate m_parameter
                            note right of m_parameter
                                SELECT
                                    COUNT(p.id) as total_items
                                FROM public.m_parameter p
                                WHERE p.row_status = 'ACTIVE' -- a public caller sees only ACTIVE parameters
                                AND p.id = '<sequence.id>' -- only when id is specified
                                AND p.parent_id = '<sequence.parentId>' -- only when parentId is specified
                                AND p.parent_id IS NULL -- only when rootOnly is true
                                AND p.key = '<sequence.key>' -- only when key is specified
                                AND (p.key ILIKE '%<sequence.search>%' ESCAPE '\' OR EXISTS (SELECT 1 FROM jsonb_each_text(p.value) v WHERE v.value ILIKE '%<sequence.search>%' ESCAPE '\')) -- only when search is specified
                                AND p.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                                AND p.effective_at <= '<sequence.now>' -- unless includeNotEffective is true
                                AND (p.expired_at IS NULL OR p.expired_at > '<sequence.now>') -- unless includeNotEffective is true
                            end note
                            m_parameter -> infra: Return total_items
                        deactivate m_parameter
                        infra -> app: Return result of Get total items
                    deactivate infra
                    app -> domain: Build the page (items, pageIndex, pageSize, totalItems, totalPages)
                    activate domain
                        domain -> app: Return response data
                    deactivate domain
                    app -> api: HTTP 200 S10000 with data.items (an empty list is valid)
                    api -> page: Return success response
                    page -> user: Display success result
                    else Processing times out
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Display timeout error
                    else Unexpected failure
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
