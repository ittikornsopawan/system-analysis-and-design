@startuml UpsertScopeBatch

title Upsert Scope Batch API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Scope Batch Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "m_scope" as m_scope
    database "t_permission_scope" as t_permission_scope
end box

user -> page: Submit the ordered scope batch
activate page
    page -> api: POST v1/author/scope/upsert/batch (JSON, Bearer JWT, UTC timestamp)
    activate api
        api -> app: [**UpsertScopeBatchCommandHandler**] Process request
        activate app
            app -> app: Generate requestId; validate whole JSON envelope/no query/known unique keys, UTC timestamp, scopes array 1..100, every item type/required fields/code/status/defaults; reject insert-DELETED
            app -> app: Validate all items in input order; canonical duplicate ids and exact duplicate non-DELETED scope codes are 400 before SQL
            alt Invalid envelope/header/item/count/duplicate ids or scope codes
                break Reject this whole request
                    app -> api: HTTP 400 E10001 item errors use scopes[i]; request-level errors have no invented position
                    api -> page: Reject the whole batch; no partial results
                    page -> user: Display failure; no scope action is reported as successful
                end break
            else Check passed
            end
            app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub and structured unique roleIds/name array
            alt Missing/invalid JWT or malformed roles
                break Reject this whole request
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Reject the whole batch; no partial results
                    page -> user: Display failure; no scope action is reported as successful
                end break
            else Check passed
            end
            app -> app: callerUserId = verified sub; accessTokenHash = SHA-256 exact JWT; createdBy/updatedBy = caller UUID string
            app -> app: targetScopeIds = typed UUID[] of supplied canonical ids, empty for all inserts; omitted per-item id = typed SQL NULL
            app -> infra: BEGIN READ COMMITTED
            activate infra
            alt Work completes before commit
                note over app, infra
                    Unique-index collision, timeout or unexpected failure may interrupt a SQL/domain step, including a later item.
                    All earlier writes are provisional until the one final COMMIT; any failure rolls back every item.
                end note
                app -> infra: QUERY - Lock the caller user
                infra -> m_user: QUERY - Lock the caller user
                activate m_user
                    note right of m_user
                        SELECT
                            u.id as user_id
                        FROM authen.m_user u
                        WHERE u.id = '<sequence.callerUserId>'
                        FOR UPDATE
                    end note
                    m_user -> infra: Return locked caller user or no row
                deactivate m_user
                infra -> app: Return locked caller user or no row
                alt Caller user is missing
                    break Reject this whole request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Reject the whole batch; no partial results
                        page -> user: Display failure; no scope action is reported as successful
                    end break
                else Check passed
                end
                app -> app: Capture fresh server UTC now after caller lock; recheck JWT exp
                alt JWT expired while waiting for caller lock
                    break Reject this whole request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Reject the whole batch; no partial results
                        page -> user: Display failure; no scope action is reported as successful
                    end break
                else Check passed
                end
                app -> infra: QUERY - Check current credential and user
                infra -> t_user_access_token: QUERY - Check current credential and user
                activate t_user_access_token
                    note right of t_user_access_token
                        SELECT
                            at.id as access_token_id
                        FROM authen.t_user_access_token at
                        JOIN authen.m_user u ON u.id = at.user_id
                        WHERE at.token = '<sequence.accessTokenHash>'
                        AND at.user_id = '<sequence.callerUserId>'
                        AND at.row_status = 'ACTIVE'
                        AND at.expired_at > '<sequence.now>'
                        AND u.row_status = 'ACTIVE'
                    end note
                    t_user_access_token -> infra: Return ACTIVE matching unexpired token/user or no row
                deactivate t_user_access_token
                infra -> app: Return ACTIVE matching unexpired token/user or no row
                alt Current token/user missing/inactive/revoked/expired/mismatched
                    break Reject this whole request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Reject the whole batch; no partial results
                        page -> user: Display failure; no scope action is reported as successful
                    end break
                else Check passed
                end
                app -> infra: QUERY - Lock existing scopes
                infra -> m_scope: QUERY - Lock existing scopes
                activate m_scope
                    note right of m_scope
                        SELECT
                            s.id as scope_id
                        FROM author.m_scope s
                        WHERE s.id = ANY ('<sequence.targetScopeIds>'::UUID[])
                        AND s.row_status <> 'DELETED' -- the id of a DELETED scope counts as not found
                        ORDER BY s.id
                        FOR UPDATE
                    end note
                    m_scope -> infra: Return all non-DELETED target scope_id rows locked in ascending id order
                deactivate m_scope
                infra -> app: Return all non-DELETED target scope_id rows locked in ascending id order
                app -> app: Map locked scopes by id; check all supplied target ids in original input order; choose first missing index i (empty target set is valid)
                alt Any supplied target id missing or DELETED after lock wait
                    break Reject this whole request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 404 E10004 scopes[i]: Scope not found.
                        api -> page: Reject the whole batch; no partial results
                        page -> user: Display failure; no scope action is reported as successful
                    end break
                else Check passed
                end
                app -> app: Authorize once using only exact case-sensitive PLATFORM_ADMIN in verified JWT roles; never reload live grants
                alt No exact PLATFORM_ADMIN role claim
                    break Reject this whole request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 403 E10009 You do not have permission to manage scopes. (no item position)
                        api -> page: Reject the whole batch; no partial results
                        page -> user: Display failure; no scope action is reported as successful
                    end break
                else Check passed
                end
                loop For every scopes[i] in original request order; all writes remain provisional
                    app -> app: currentIndex = i; bind this item fields and server audit/now; prior item writes are visible
                    alt This item id omitted (INSERT, including ARCHIVED)
                        app -> infra: QUERY - Check duplicate scope
                        infra -> m_scope: QUERY - Check duplicate scope
                        activate m_scope
                            note right of m_scope
                                SELECT
                                    s.id as scope_id
                                FROM author.m_scope s
                                WHERE s.scope = '<sequence.scopes.scope>'
                                AND s.row_status <> 'DELETED'
                                AND ('<sequence.scopes.id>' IS NULL OR s.id <> '<sequence.scopes.id>') -- omitted insert id is typed SQL NULL
                            end note
                            m_scope -> infra: Return same-code non-DELETED scope after preceding item writes, excluding optional current id
                        deactivate m_scope
                        infra -> app: Return same-code non-DELETED scope after preceding item writes, excluding optional current id
                        alt Another non-DELETED scope holds this scope code
                            break Reject this whole request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10003 scopes[i]: Scope scope already exists.
                                api -> page: Reject the whole batch; no partial results
                                page -> user: Display failure; no scope action is reported as successful
                            end break
                        else Check passed
                        end
                        app -> infra: INSERT - Create scope
                        infra -> m_scope: INSERT - Create scope
                        activate m_scope
                            note right of m_scope
                                INSERT INTO author.m_scope (
                                    created_by,
                                    created_at,
                                    row_status,
                                    scope,
                                    name,
                                    description
                                )
                                VALUES (
                                    &#39;<sequence.createdBy>',
                                    &#39;<sequence.now>',
                                    &#39;<sequence.scopes.rowStatus>',
                                    &#39;<sequence.scopes.scope>',
                                    &#39;<sequence.scopes.name>',
                                    &#39;<sequence.scopes.description>'
                                )
                                RETURNING id as scope_id
                            end note
                            m_scope -> infra: Return inserted scope_id
                        deactivate m_scope
                        infra -> app: Return inserted scope_id
                        app -> app: Require exactly one inserted scope_id; missing/malformed result is internal failure; action = INSERT
                    else This item id supplied (UPDATE, DELETE or ARCHIVE)
                        app -> infra: QUERY - Check duplicate scope
                        infra -> m_scope: QUERY - Check duplicate scope
                        activate m_scope
                            note right of m_scope
                                SELECT
                                    s.id as scope_id
                                FROM author.m_scope s
                                WHERE s.scope = '<sequence.scopes.scope>'
                                AND s.row_status <> 'DELETED'
                                AND ('<sequence.scopes.id>' IS NULL OR s.id <> '<sequence.scopes.id>') -- omitted insert id is typed SQL NULL
                            end note
                            m_scope -> infra: Return same-code non-DELETED scope after preceding item writes, excluding optional current id
                        deactivate m_scope
                        infra -> app: Return same-code non-DELETED scope after preceding item writes, excluding optional current id
                        alt Another non-DELETED scope holds this scope code
                            break Reject this whole request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10003 scopes[i]: Scope scope already exists.
                                api -> page: Reject the whole batch; no partial results
                                page -> user: Display failure; no scope action is reported as successful
                            end break
                        else Check passed
                        end
                        alt Requested item rowStatus is DELETED or ARCHIVED
                            app -> infra: QUERY - Check permission scope in use
                            infra -> t_permission_scope: QUERY - Check permission scope in use
                            activate t_permission_scope
                                note right of t_permission_scope
                                    SELECT
                                        ps.id as permission_scope_id
                                    FROM author.t_permission_scope ps
                                    WHERE ps.scope_id = '<sequence.scopes.id>' -- only when rowStatus is DELETED or ARCHIVED
                                    AND ps.row_status <> 'DELETED'
                                end note
                                t_permission_scope -> infra: Return non-DELETED permission-scope definition or no row
                            deactivate t_permission_scope
                            infra -> app: Return non-DELETED permission-scope definition or no row
                            alt A non-DELETED permission-scope definition exists
                                break Reject this whole request
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10006 scopes[i]: Scope is used by permissions.
                                    api -> page: Reject the whole batch; no partial results
                                    page -> user: Display failure; no scope action is reported as successful
                                end break
                            else Check passed
                            end
                        else Requested item rowStatus is ACTIVE, INACTIVE or LOCKED
                            app -> app: Preserve existing permission-scope definitions; no in-use rejection for this status
                        end
                        app -> infra: UPDATE - Update or delete scope
                        infra -> m_scope: UPDATE - Update or delete scope
                        activate m_scope
                            note right of m_scope
                                UPDATE author.m_scope
                                SET
                                    updated_by = '<sequence.updatedBy>',
                                    updated_at = '<sequence.now>',
                                    row_status = '<sequence.scopes.rowStatus>',
                                    scope = '<sequence.scopes.scope>',
                                    name = '<sequence.scopes.name>',
                                    description = '<sequence.scopes.description>'
                                WHERE id = '<sequence.scopes.id>'
                                AND row_status <> 'DELETED'
                                RETURNING id as scope_id
                            end note
                            m_scope -> infra: Return guarded returned scope_id or no row
                        deactivate m_scope
                        infra -> app: Return guarded returned scope_id or no row
                        alt Guarded UPDATE returned zero rows
                            break Reject this whole request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 scopes[i]: Scope not found.
                                api -> page: Reject the whole batch; no partial results
                                page -> user: Display failure; no scope action is reported as successful
                            end break
                        else Check passed
                        end
                        app -> app: Require exactly one returned scope_id equal to this input id; mismatch is internal failure
                        app -> app: action = DELETE for DELETED, ARCHIVE for ARCHIVED, otherwise UPDATE
                    end
                    app -> app: Append exactly index=i, scopeId from RETURNING and action to ordered results; do not emit per-item HTTP
                end
                app -> app: Require results count equals input count, original index order and unique returned scopeIds; data = exactly scopes array of index/scopeId/action; map all before COMMIT
                app -> infra: COMMIT
                infra -> app: Return committed whole batch
                app -> api: HTTP 200 S10000 Batch Upsert Scope Success; all ordered scopes results including DELETE
                api -> page: Show all committed indexed actions
                page -> user: Display the entire saved batch
            else SQLSTATE 23505 from uq_m_scope_scope at currentIndex (concurrent collision)
                app -> infra: ROLLBACK
                app -> api: HTTP 409 E10003 scopes[i]: Scope scope already exists. (i = currentIndex)
                api -> page: Reject the whole batch; no partial results
                page -> user: Display failure; no scope action is reported as successful
            else Timeout before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 408 E90001
                api -> page: Reject the whole batch; no partial results
                page -> user: Display failure; no scope action is reported as successful
            else Unexpected SQL/result/mapping failure before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 500 Internal Server Error; omit bizCode
                api -> page: Reject the whole batch; no partial results
                page -> user: Display failure; no scope action is reported as successful
            end
            deactivate infra
        deactivate app
    deactivate api
deactivate page
@enduml
