@startuml UpsertRole

title Upsert Role API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Role Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "t_role_permission" as t_role_permission
end box

user -> page: Submit one role action
activate page
    page -> api: POST v1/author/role/upsert (JSON, Bearer JWT, UTC timestamp)
    activate api
        api -> app: [**UpsertRoleCommandHandler**] Process request
        activate app
            note over app, infra
                Execution order: validate the request (400) -> verify JWT (401) -> begin transaction (READ COMMITTED) ->
                caller user lock -> fresh current credential check (401) -> locked target existence check (404, only for id)
                -> permission (403, E10009) -> system role check (409, E10006) -> duplicate check (409, E10003) -> in-use
                check (409, E10006, only for existing id with DELETED or ARCHIVED) -> guarded write -> map returned roleId
                -> COMMIT -> response. Insert skips target/system/in-use checks; every post-BEGIN rejection rolls back.
                Lock order is caller user -> target role -> binding checks/write. Reference/assignment writers must lock and
                recheck their target role before creating/reopening a binding, with target users first and role locks
                ordered by id; a soft lifecycle flag is not protected by a foreign key alone. The matching reference-writer
                migration is delivered in its own API PR; these SQL tests must not be presented as certification of an
                unmigrated cross-API writer. This contract does not add role grants or rewrite existing bindings.
            end note
            app -> app: Generate requestId; validate one JSON object/known unique keys/no query, UTC timestamp, UUID id, required name/description lengths and role code, rowStatus/default ACTIVE; reject insert-DELETED
            note over app, infra
                HTTP status of the single upsert: Insert 201 Created, Update 200 Ok, Delete 204 No Content (no response
                body), Archive 200 Ok.
                Validate one JSON object with only id/name/description/rowStatus, reject repeated keys, wrong content type,
                unknown query/body fields and invalid UTC timestamp before SQL (400 E10001). id is optional only by
                omission; if present it must be a non-empty UUID, not null. name/description are non-null, nonblank strings,
                at most 64/256 characters, and name matches ^[A-Z][A-Z0-9_]{0,63}$. Do not trim or case-normalize either
                field. rowStatus defaults to ACTIVE only when omitted and otherwise is
                ACTIVE/INACTIVE/DELETED/LOCKED/ARCHIVED; insert-DELETED is 400. All required fields remain mandatory even on
                delete/archive. Generate requestId if omitted.
                Bind all values; createdBy/updatedBy are the verified caller UUID string and now is the fresh server value,
                never request fields or the supplied timestamp. INSERT explicitly sets created_at and must return exactly
                one role_id; missing insert result is internal 500. UPDATE is guarded by id, non-DELETED status and stored
                name <> PLATFORM_ADMIN; zero returned rows is 404 E10004 with rollback. One returned id must equal the
                requested id; an unexpected result/mapping failure is internal 500. Do not change creation audit fields on
                update.
            end note
            alt Invalid input
                break Reject this request
                    app -> api: HTTP 400 E10001
                    api -> page: Display failure; no successful role mutation
                    page -> user: Display failure; keep unsaved input and show no successful action
                end break
            else Check passed
            end
            app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub and the roles claim as unique non-empty strings
            alt Missing/invalid JWT or malformed roles
                break Reject this request
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Display failure; no successful role mutation
                    page -> user: Display failure; keep unsaved input and show no successful action
                end break
            else Check passed
            end
            app -> app: callerUserId = verified sub; accessTokenHash = SHA-256 exact JWT; createdBy/updatedBy = caller UUID string; omitted id = typed SQL NULL
            app -> infra: BEGIN READ COMMITTED
            note over app, infra
                BEGIN READ COMMITTED and lock the caller's authen.m_user first. A missing user is 401 with rollback. Capture
                fresh server UTC now after that lock, recheck JWT exp, then require the matching ACTIVE token/hash/caller,
                strict expired_at > now and ACTIVE user from a joined current credential read. This query does not reload
                grants. A revoked/expired token or non-ACTIVE user is 401 before any target-role lookup. Logout/reset share
                the user-first lock; a request that waits for them must see their committed revocation. Grant withdrawal
                alone does not invalidate an otherwise-current old PLATFORM_ADMIN claim (Q4); refresh constructs a newer
                snapshot.
                For an existing id, lock the non-DELETED target role FOR UPDATE before the 404/403/conflict checks;
                concurrent deletion cannot be followed by resurrection. Use typed SQL NULL for omitted id on insert, never
                the string NULL. Duplicate name exclusion is null-safe and applies to all non-DELETED statuses; the current
                row may retain its name. Protect the system role by its stored target name before duplicate checking, not by
                the proposed request name. A new role named PLATFORM_ADMIN conflicts with the seeded role as 409 E10003.
                Reversible-status changes leave binding rows unchanged.
                The partial unique index uq_m_role_name is the final concurrent duplicate guard. SQLSTATE 23505 from that
                constraint rolls back the whole transaction and returns 409 E10003, including races after the pre-check;
                other constraints/unexpected SQL/mapping failures roll back and return generic 500 with no bizCode. Timeout
                before COMMIT rolls back and returns 408 E90001. Never commit a partial write or return success before
                commit. No retry is promised after an unknown commit result.
            end note
            activate infra
            alt Work completes before commit
                note over app, infra
                    A unique-name collision, timeout or unexpected failure can interrupt any following SQL/domain step.
                    Rollback cancels the whole transaction; success requires a successful COMMIT.
                end note
                app -> infra: QUERY - Lock the caller user
                infra -> m_user: QUERY - Lock the caller user
                activate m_user
                    note right of m_user
                        SELECT
                            u.id as user_id
                        FROM authen.m_user u
                        WHERE u.id = '<sequence.callerUserId>'
                        FOR UPDATE
                    end note
                    m_user -> infra: Return locked caller user or no row
                deactivate m_user
                infra -> app: Return locked caller user or no row
                alt Caller user is missing
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Display failure; no successful role mutation
                        page -> user: Display failure; keep unsaved input and show no successful action
                    end break
                else Check passed
                end
                app -> app: Capture fresh server UTC now after caller lock; recheck JWT exp
                alt JWT expired while waiting for caller lock
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Display failure; no successful role mutation
                        page -> user: Display failure; keep unsaved input and show no successful action
                    end break
                else Check passed
                end
                app -> infra: QUERY - Check current credential and user
                infra -> t_user_access_token: QUERY - Check current credential and user
                activate t_user_access_token
                    note right of t_user_access_token
                        SELECT
                            at.id as access_token_id
                        FROM authen.t_user_access_token at
                        JOIN authen.m_user u ON u.id = at.user_id
                        WHERE at.token = '<sequence.accessTokenHash>'
                        AND at.user_id = '<sequence.callerUserId>'
                        AND at.row_status = 'ACTIVE'
                        AND at.expired_at > '<sequence.now>'
                        AND u.row_status = 'ACTIVE'
                    end note
                    t_user_access_token -> infra: Return ACTIVE matching unexpired token/user or no row
                deactivate t_user_access_token
                infra -> app: Return ACTIVE matching unexpired token/user or no row
                alt Current token/user missing/inactive/revoked/expired/mismatched
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Display failure; no successful role mutation
                        page -> user: Display failure; keep unsaved input and show no successful action
                    end break
                else Check passed
                end
                alt id omitted (insert, including ARCHIVED)
                    app -> app: Authorize only exact case-sensitive PLATFORM_ADMIN in verified JWT roles; never reload live grants
                    alt No exact PLATFORM_ADMIN role claim
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 403 E10009 You do not have permission to manage roles.
                            api -> page: Display failure; no successful role mutation
                            page -> user: Display failure; keep unsaved input and show no successful action
                        end break
                    else Check passed
                    end
                    app -> infra: QUERY - Check duplicate name
                    infra -> m_role: QUERY - Check duplicate name
                    activate m_role
                        note right of m_role
                            SELECT
                                r.id as role_id
                            FROM author.m_role r
                            WHERE r.name = '<sequence.name>'
                            AND r.row_status <> 'DELETED'
                            AND ('<sequence.id>' IS NULL OR r.id <> '<sequence.id>') -- omitted insert id is typed SQL NULL
                        end note
                        m_role -> infra: Return non-DELETED same-name role excluding optional target, or no row
                    deactivate m_role
                    infra -> app: Return non-DELETED same-name role excluding optional target, or no row
                    alt A different non-DELETED role already has the name
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 409 E10003 Role name already exists.
                            api -> page: Display failure; no successful role mutation
                            page -> user: Display failure; keep unsaved input and show no successful action
                        end break
                    else Check passed
                    end
                    app -> infra: INSERT - Create role
                    infra -> m_role: INSERT - Create role
                    activate m_role
                        note right of m_role
                            INSERT INTO author.m_role (
                                created_by,
                                created_at,
                                row_status,
                                name,
                                description
                            )
                            VALUES (
                                &#39;<sequence.createdBy>',
                                &#39;<sequence.now>',
                                &#39;<sequence.rowStatus>',
                                &#39;<sequence.name>',
                                &#39;<sequence.description>'
                            )
                            RETURNING id as role_id
                        end note
                        m_role -> infra: Return inserted role_id
                    deactivate m_role
                    infra -> app: Return inserted role_id
                    app -> app: Require exactly one inserted role_id; missing or malformed result is internal failure
                    app -> app: data = exactly roleId from RETURNING; exclude caller/token/audit/grants
                    app -> infra: COMMIT
                    infra -> app: Return committed role mutation
                    note over app, infra
                        This detailed revision remains in-review; no backend/schema change is included.
                        The comparison is exact and a value held by an INACTIVE, LOCKED or ARCHIVED role is still taken (409,
                        E10003). The value of a DELETED role can be used again.
                        Every field that is not optional is required in every request, including a delete and an archive.
                        INACTIVE, LOCKED and ARCHIVED are reversible: an update with `rowStatus` ACTIVE opens the role again.
                        `rowStatus` DELETED is rejected with 400 (E10001) when the request inserts a role. A role that is not ACTIVE
                        is excluded when resolving new login/refresh claims; an already-issued token keeps its role snapshot until
                        expiry (owner Q4/Q7).
                        INACTIVE and LOCKED are allowed, the rows that use it are not changed.
                        **`PLATFORM_ADMIN` is the system role.** It cannot be renamed, changed, deleted, archived, locked or set
                        INACTIVE through this API: any request that names it by `id` is rejected with 409 (E10006) `System role
                        cannot be changed.` Giving another role the name `PLATFORM_ADMIN` is a duplicate name (409, E10003). The
                        role is created by the seed, see `e-commerce/db/seed/author.seed.sql`.
                        Permission: only a platform administrator from the verified JWT roles claim can call this API; require an
                        exact case-sensitive role name PLATFORM_ADMIN. Empty roles or other valid role names give 403 E10009 after
                        the existence check and before conflicts. Never authorize from live author.t_user_role/author.m_role
                        assignment queries, request flags, permission names or a separate isPlatformAdmin claim. Approved by the
                        product owner (Q2/Q4/Q10/Q13, 2026-11-07); this supersedes the earlier live-assignment guard.
                        Verify Bearer JWT signature/issuer/audience/expiry/UUID sub and the roles claim before BEGIN. roles must be an array of unique non-empty role names (JWT payload of 2026-11-13), including [].
                        Malformed/missing roles is 401, not an empty-list fallback; verify before BEGIN. Compute callerUserId from
                        verified sub and accessTokenHash as SHA-256 of the exact JWT. Missing/invalid credentials use generic 401
                        E10002 `Invalid or expired access token.`
                        Check non-DELETED t_user_role and t_role_permission only for an existing target requested DELETED/ARCHIVED;
                        either result is 409 E10006, including inactive/locked/archived bindings. Insert-ARCHIVED is allowed (201
                        insert); it has no prior bindings. INACTIVE/LOCKED updates may keep bindings. These are business-invariant
                        reads, not caller authorization.
                        Map response data to exactly roleId from RETURNING, then COMMIT before success. Insert returns 201 S10000
                        Insert Role Success (also insert-ARCHIVED), existing delete returns 204 with no body/status/data, existing
                        archive 200 S10000 Archive Role Success, other updates 200 S10000 Update Role Success. No token, caller id,
                        row, audit fields or grants are returned.
                    end note
                    app -> api: HTTP 201 S10000 Insert Role Success; exactly roleId
                    api -> page: Display completed role action
                    page -> user: Display the committed role action
                else id supplied (existing target)
                    app -> infra: QUERY - Check existing role
                    infra -> m_role: QUERY - Check existing role
                    activate m_role
                        note right of m_role
                            SELECT
                                r.id as role_id,
                                r.name
                            FROM author.m_role r
                            WHERE r.id = '<sequence.id>'
                            AND r.row_status <> 'DELETED' -- the id of a DELETED role counts as not found
                            FOR UPDATE
                        end note
                        m_role -> infra: Return locked non-DELETED target role_id/name or no row
                    deactivate m_role
                    infra -> app: Return locked non-DELETED target role_id/name or no row
                    alt Target role missing or DELETED
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 Role not found.
                            api -> page: Display failure; no successful role mutation
                            page -> user: Display failure; keep unsaved input and show no successful action
                        end break
                    else Check passed
                    end
                    app -> app: Authorize only exact case-sensitive PLATFORM_ADMIN in verified JWT roles; never reload live grants
                    alt No exact PLATFORM_ADMIN role claim
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 403 E10009 You do not have permission to manage roles.
                            api -> page: Display failure; no successful role mutation
                            page -> user: Display failure; keep unsaved input and show no successful action
                        end break
                    else Check passed
                    end
                    app -> infra: QUERY - Check system role
                    infra -> m_role: QUERY - Check system role
                    activate m_role
                        note right of m_role
                            SELECT
                                r.id as role_id
                            FROM author.m_role r
                            WHERE r.id = '<sequence.id>'
                            AND r.name = 'PLATFORM_ADMIN' -- the request is rejected (409) when a row is found, only when id is specified
                        end note
                        m_role -> infra: Return stored system-role target or no row
                    deactivate m_role
                    infra -> app: Return stored system-role target or no row
                    alt Stored target is PLATFORM_ADMIN
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 409 E10006 System role cannot be changed.
                            api -> page: Display failure; no successful role mutation
                            page -> user: Display failure; keep unsaved input and show no successful action
                        end break
                    else Check passed
                    end
                    app -> infra: QUERY - Check duplicate name
                    infra -> m_role: QUERY - Check duplicate name
                    activate m_role
                        note right of m_role
                            SELECT
                                r.id as role_id
                            FROM author.m_role r
                            WHERE r.name = '<sequence.name>'
                            AND r.row_status <> 'DELETED'
                            AND ('<sequence.id>' IS NULL OR r.id <> '<sequence.id>') -- omitted insert id is typed SQL NULL
                        end note
                        m_role -> infra: Return non-DELETED same-name role excluding optional target, or no row
                    deactivate m_role
                    infra -> app: Return non-DELETED same-name role excluding optional target, or no row
                    alt A different non-DELETED role already has the name
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 409 E10003 Role name already exists.
                            api -> page: Display failure; no successful role mutation
                            page -> user: Display failure; keep unsaved input and show no successful action
                        end break
                    else Check passed
                    end
                    alt Requested rowStatus is DELETED or ARCHIVED
                        app -> infra: QUERY - Check user in use
                        infra -> t_user_role: QUERY - Check user in use
                        activate t_user_role
                            note right of t_user_role
                                SELECT
                                    ur.id as user_role_id
                                FROM author.t_user_role ur
                                WHERE ur.role_id = '<sequence.id>' -- only when rowStatus is DELETED or ARCHIVED
                                AND ur.row_status <> 'DELETED'
                            end note
                            t_user_role -> infra: Return non-DELETED user binding or no row
                        deactivate t_user_role
                        infra -> app: Return non-DELETED user binding or no row
                        app -> infra: QUERY - Check role permission in use
                        infra -> t_role_permission: QUERY - Check role permission in use
                        activate t_role_permission
                            note right of t_role_permission
                                SELECT
                                    rp.id as role_permission_id
                                FROM author.t_role_permission rp
                                WHERE rp.role_id = '<sequence.id>' -- only when rowStatus is DELETED or ARCHIVED
                                AND rp.row_status <> 'DELETED'
                            end note
                            t_role_permission -> infra: Return non-DELETED permission binding or no row
                        deactivate t_role_permission
                        infra -> app: Return non-DELETED permission binding or no row
                        alt Either non-DELETED binding exists
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10006 Role is assigned to users or has permissions.
                                api -> page: Display failure; no successful role mutation
                                page -> user: Display failure; keep unsaved input and show no successful action
                            end break
                        else Check passed
                        end
                        app -> infra: UPDATE - Update or delete role
                        infra -> m_role: UPDATE - Update or delete role
                        activate m_role
                            note right of m_role
                                UPDATE author.m_role
                                SET
                                    updated_by = '<sequence.updatedBy>',
                                    updated_at = '<sequence.now>',
                                    row_status = '<sequence.rowStatus>',
                                    name = '<sequence.name>',
                                    description = '<sequence.description>'
                                WHERE id = '<sequence.id>'
                                AND row_status <> 'DELETED'
                                AND name <> 'PLATFORM_ADMIN'
                                RETURNING id as role_id
                            end note
                            m_role -> infra: Return guarded returned role_id or no row
                        deactivate m_role
                        infra -> app: Return guarded returned role_id or no row
                        alt Guarded UPDATE returned zero rows
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 Role not found.
                                api -> page: Display failure; no successful role mutation
                                page -> user: Display failure; keep unsaved input and show no successful action
                            end break
                        else Check passed
                        end
                        app -> app: Require exactly one returned role_id equal to requested id; mismatch is internal failure
                        alt Requested rowStatus is DELETED
                            app -> app: Suppress response body/status/data for 204
                            app -> infra: COMMIT
                            infra -> app: Return committed role mutation
                            app -> api: HTTP 204 No Content; no response body
                            api -> page: Display completed role action
                            page -> user: Display the committed role action
                        else Requested rowStatus is ARCHIVED
                            app -> app: data = exactly roleId from RETURNING; exclude caller/token/audit/grants
                            app -> infra: COMMIT
                            infra -> app: Return committed role mutation
                            app -> api: HTTP 200 S10000 Archive Role Success; exactly roleId
                            api -> page: Display completed role action
                            page -> user: Display the committed role action
                        end
                    else Requested rowStatus is ACTIVE, INACTIVE or LOCKED
                        app -> infra: UPDATE - Update or delete role
                        infra -> m_role: UPDATE - Update or delete role
                        activate m_role
                            note right of m_role
                                UPDATE author.m_role
                                SET
                                    updated_by = '<sequence.updatedBy>',
                                    updated_at = '<sequence.now>',
                                    row_status = '<sequence.rowStatus>',
                                    name = '<sequence.name>',
                                    description = '<sequence.description>'
                                WHERE id = '<sequence.id>'
                                AND row_status <> 'DELETED'
                                AND name <> 'PLATFORM_ADMIN'
                                RETURNING id as role_id
                            end note
                            m_role -> infra: Return guarded returned role_id or no row
                        deactivate m_role
                        infra -> app: Return guarded returned role_id or no row
                        alt Guarded UPDATE returned zero rows
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 Role not found.
                                api -> page: Display failure; no successful role mutation
                                page -> user: Display failure; keep unsaved input and show no successful action
                            end break
                        else Check passed
                        end
                        app -> app: Require exactly one returned role_id equal to requested id; mismatch is internal failure
                        app -> app: data = exactly roleId from RETURNING; exclude caller/token/audit/grants
                        app -> infra: COMMIT
                        infra -> app: Return committed role mutation
                        app -> api: HTTP 200 S10000 Update Role Success; exactly roleId
                        api -> page: Display completed role action
                        page -> user: Display the committed role action
                    end
                end
            else SQLSTATE 23505 from uq_m_role_name (concurrent name collision)
                app -> infra: ROLLBACK
                app -> api: HTTP 409 E10003 Role name already exists.
                api -> page: Display failure; no successful role mutation
                page -> user: Display failure; keep unsaved input and show no successful action
            else Timeout before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 408 E90001
                api -> page: Display failure; no successful role mutation
                page -> user: Display failure; keep unsaved input and show no successful action
            else Unexpected SQL/result/mapping failure before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 500 Internal Server Error; omit bizCode
                api -> page: Display failure; no successful role mutation
                page -> user: Display failure; keep unsaved input and show no successful action
            end
            deactivate infra
        deactivate app
    deactivate api
deactivate page
@enduml
