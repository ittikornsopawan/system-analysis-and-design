@startuml UpsertRole Sequence

title Upsert Role API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Role Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "t_role_permission" as t_role_permission
end box

user -> page: Submit the role
activate page
    page -> api: POST v1/author/role/upsert
    activate api
        api -> app: [**UpsertRoleCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body: name is a role code (capital letters, digits and _, starting with a letter, at most 64 characters) and description is required, rowStatus is not DELETED when inserting
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                        alt id is specified (update, delete or archive)
                            app -> infra: QUERY - Check existing role
                            infra -> m_role: QUERY - Check existing role
                            activate m_role
                                note right of m_role
                                    SELECT
                                        r.id as role_id
                                    FROM author.m_role r
                                    WHERE r.id = '<sequence.id>'
                                    AND r.row_status <> 'DELETED' -- the id of a DELETED role counts as not found
                                end note
                                m_role -> infra: Return query result
                            deactivate m_role
                            infra -> app: Return the role or no row
                            alt Role not found or DELETED
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 Role not found.
                                api -> page: Not found
                                page -> user: Display what is not found
                            end
                        end
                        app -> infra: QUERY - Get the platform administrator role
                        infra -> m_role: QUERY - Get the platform administrator role
                        activate m_role
                            note right of m_role
                                SELECT
                                    r.id as role_id
                                FROM author.m_role r
                                WHERE r.name = 'PLATFORM_ADMIN'
                                AND r.row_status = 'ACTIVE'
                            end note
                            m_role -> infra: Return query result
                        deactivate m_role
                        infra -> app: Return the role id
                        app -> infra: QUERY - Check platform administrator
                        infra -> t_user_role: QUERY - Check platform administrator
                        activate t_user_role
                            note right of t_user_role
                                SELECT
                                    ur.id as user_role_id
                                FROM author.t_user_role ur
                                WHERE ur.user_id = '<sequence.userId>'
                                AND ur.role_id = '<sequence.roleId>'
                                AND ur.row_status = 'ACTIVE'
                            end note
                            t_user_role -> infra: Return query result
                        deactivate t_user_role
                        infra -> app: Return the assignment or no row
                        alt The caller is not a platform administrator
                            app -> infra: ROLLBACK
                            app -> api: HTTP 403 E10009 You do not have permission to manage roles.
                            api -> page: Forbidden
                            page -> user: Display no permission
                        end
                        alt id is specified
                            app -> infra: QUERY - Check system role
                            infra -> m_role: QUERY - Check system role
                            activate m_role
                                note right of m_role
                                    SELECT
                                        r.id as role_id
                                    FROM author.m_role r
                                    WHERE r.id = '<sequence.id>'
                                    AND r.name = 'PLATFORM_ADMIN' -- the request is rejected (409) when a row is found, only when id is specified
                                end note
                                m_role -> infra: Return query result
                            deactivate m_role
                            infra -> app: Return whether the role is PLATFORM_ADMIN
                            alt The role is PLATFORM_ADMIN (system role)
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10006 System role cannot be changed.
                                api -> page: Conflict
                                page -> user: Display the system role cannot change
                            end
                        end
                        app -> infra: QUERY - Check duplicate name
                        infra -> m_role: QUERY - Check duplicate name
                        activate m_role
                            note right of m_role
                                SELECT
                                    r.id as role_id
                                FROM author.m_role r
                                WHERE r.name = '<sequence.name>'
                                AND r.row_status <> 'DELETED'
                                AND r.id <> '<sequence.id>' -- only when id is specified
                            end note
                            m_role -> infra: Return query result
                        deactivate m_role
                        infra -> app: Return the role that holds the name or no row
                        alt Another role that is not DELETED holds the name
                            app -> infra: ROLLBACK
                            app -> api: HTTP 409 E10003 Role name already exists.
                            api -> page: Conflict
                            page -> user: Display the role exists
                        end
                        alt rowStatus is DELETED or ARCHIVED
                            app -> infra: QUERY - Check user in use
                            infra -> t_user_role: QUERY - Check user in use
                            activate t_user_role
                                note right of t_user_role
                                    SELECT
                                        ur.id as user_role_id
                                    FROM author.t_user_role ur
                                    WHERE ur.role_id = '<sequence.id>' -- only when rowStatus is DELETED or ARCHIVED
                                    AND ur.row_status <> 'DELETED'
                                end note
                                t_user_role -> infra: Return query result
                            deactivate t_user_role
                            infra -> app: Return a user that has the role or no row
                            app -> infra: QUERY - Check role permission in use
                            infra -> t_role_permission: QUERY - Check role permission in use
                            activate t_role_permission
                                note right of t_role_permission
                                    SELECT
                                        rp.id as role_permission_id
                                    FROM author.t_role_permission rp
                                    WHERE rp.role_id = '<sequence.id>' -- only when rowStatus is DELETED or ARCHIVED
                                    AND rp.row_status <> 'DELETED'
                                end note
                                t_role_permission -> infra: Return query result
                            deactivate t_role_permission
                            infra -> app: Return a permission of the role or no row
                            alt A user or a permission still uses the role
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10006 Role is assigned to users or has permissions.
                                api -> page: Conflict
                                page -> user: Display the role is in use
                            end
                        end
                        alt id is not specified (insert)
                            app -> infra: INSERT - Create role
                            infra -> m_role: INSERT - Create role
                            activate m_role
                                note right of m_role
                                    INSERT INTO author.m_role (
                                        created_by,
                                        row_status,
                                        name,
                                        description
                                    )
                                    VALUES (
                                        &#39;<sequence.createdBy>',
                                        &#39;<sequence.rowStatus>',
                                        &#39;<sequence.name>',
                                        &#39;<sequence.description>'
                                    )
                                    RETURNING id as role_id
                                end note
                                m_role -> infra: Return inserted result
                            deactivate m_role
                            infra -> app: Return the new role
                        else id is specified (update, delete or archive)
                            app -> infra: UPDATE - Update or delete role
                            infra -> m_role: UPDATE - Update or delete role
                            activate m_role
                                note right of m_role
                                    UPDATE author.m_role
                                    SET
                                        updated_by = '<sequence.updatedBy>',
                                        updated_at = NOW() AT TIME ZONE 'UTC',
                                        row_status = '<sequence.rowStatus>',
                                        name = '<sequence.name>',
                                        description = '<sequence.description>'
                                    WHERE id = '<sequence.id>'
                                    RETURNING id as role_id
                                end note
                                m_role -> infra: Return updated result
                            deactivate m_role
                            infra -> app: Return the changed role
                        end
                        alt Insert
                            app -> infra: COMMIT
                            app -> api: HTTP 201 S10000 Insert Role Success
                            api -> page: Return the role
                            page -> user: Display the role saved
                        else rowStatus = DELETED (delete)
                            app -> infra: COMMIT
                            app -> api: HTTP 204 No Content; no response body
                            api -> page: No content
                            page -> user: Display the role removed
                        else rowStatus = ARCHIVED (archive)
                            app -> infra: COMMIT
                            app -> api: HTTP 200 S10000 Archive Role Success
                            api -> page: Return the role
                            page -> user: Display the role saved
                        else Update
                            app -> infra: COMMIT
                            app -> api: HTTP 200 S10000 Update Role Success
                            api -> page: Return the role
                            page -> user: Display the role saved
                        end
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
