@startuml UpsertScope Sequence

title Upsert Scope API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Scope Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_scope" as m_scope
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "t_permission_scope" as t_permission_scope
end box

user -> page: Submit the scope
activate page
    page -> api: POST v1/author/scope/upsert
    activate api
        api -> app: [**UpsertScopeCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body: scope is a scope code (capital letters, digits and _, starting with a letter, at most 64 characters), rowStatus is not DELETED when inserting
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                        alt id is specified (update, delete or archive)
                            app -> infra: QUERY - Check existing scope
                            infra -> m_scope: QUERY - Check existing scope
                            activate m_scope
                                note right of m_scope
                                    SELECT
                                        s.id as scope_id
                                    FROM author.m_scope s
                                    WHERE s.id = '<sequence.id>'
                                    AND s.row_status <> 'DELETED' -- the id of a DELETED scope counts as not found
                                end note
                                m_scope -> infra: Return query result
                            deactivate m_scope
                            infra -> app: Return the scope or no row
                            alt Scope not found or DELETED
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 Scope not found.
                                api -> page: Not found
                                page -> user: Display what is not found
                            end
                        end
                        app -> infra: QUERY - Get the platform administrator role
                        infra -> m_role: QUERY - Get the platform administrator role
                        activate m_role
                            note right of m_role
                                SELECT
                                    r.id as role_id
                                FROM author.m_role r
                                WHERE r.name = 'PLATFORM_ADMIN'
                                AND r.row_status = 'ACTIVE'
                            end note
                            m_role -> infra: Return query result
                        deactivate m_role
                        infra -> app: Return the role id
                        app -> infra: QUERY - Check platform administrator
                        infra -> t_user_role: QUERY - Check platform administrator
                        activate t_user_role
                            note right of t_user_role
                                SELECT
                                    ur.id as user_role_id
                                FROM author.t_user_role ur
                                WHERE ur.user_id = '<sequence.userId>'
                                AND ur.role_id = '<sequence.roleId>'
                                AND ur.row_status = 'ACTIVE'
                            end note
                            t_user_role -> infra: Return query result
                        deactivate t_user_role
                        infra -> app: Return the assignment or no row
                        alt The caller is not a platform administrator
                            app -> infra: ROLLBACK
                            app -> api: HTTP 403 E10009 You do not have permission to manage scopes.
                            api -> page: Forbidden
                            page -> user: Display no permission
                        end
                        app -> infra: QUERY - Check duplicate scope
                        infra -> m_scope: QUERY - Check duplicate scope
                        activate m_scope
                            note right of m_scope
                                SELECT
                                    s.id as scope_id
                                FROM author.m_scope s
                                WHERE s.scope = '<sequence.scope>'
                                AND s.row_status <> 'DELETED'
                                AND s.id <> '<sequence.id>' -- only when id is specified
                            end note
                            m_scope -> infra: Return query result
                        deactivate m_scope
                        infra -> app: Return the scope that holds the scope or no row
                        alt Another scope that is not DELETED holds the scope
                            app -> infra: ROLLBACK
                            app -> api: HTTP 409 E10003 Scope scope already exists.
                            api -> page: Conflict
                            page -> user: Display the scope exists
                        end
                        alt rowStatus is DELETED or ARCHIVED
                            app -> infra: QUERY - Check permission scope in use
                            infra -> t_permission_scope: QUERY - Check permission scope in use
                            activate t_permission_scope
                                note right of t_permission_scope
                                    SELECT
                                        ps.id as permission_scope_id
                                    FROM author.t_permission_scope ps
                                    WHERE ps.scope_id = '<sequence.id>' -- only when rowStatus is DELETED or ARCHIVED
                                    AND ps.row_status <> 'DELETED'
                                end note
                                t_permission_scope -> infra: Return query result
                            deactivate t_permission_scope
                            infra -> app: Return a permission that uses the scope or no row
                            alt A permission still uses the scope
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10006 Scope is assigned to permissions.
                                api -> page: Conflict
                                page -> user: Display the scope is in use
                            end
                        end
                        alt id is not specified (insert)
                            app -> infra: INSERT - Create scope
                            infra -> m_scope: INSERT - Create scope
                            activate m_scope
                                note right of m_scope
                                    INSERT INTO author.m_scope (
                                        created_by,
                                        row_status,
                                        scope,
                                        name,
                                        description
                                    )
                                    VALUES (
                                        &#39;<sequence.createdBy>',
                                        &#39;<sequence.rowStatus>',
                                        &#39;<sequence.scope>',
                                        &#39;<sequence.name>',
                                        &#39;<sequence.description>'
                                    )
                                    RETURNING id as scope_id
                                end note
                                m_scope -> infra: Return inserted result
                            deactivate m_scope
                            infra -> app: Return the new scope
                        else id is specified (update, delete or archive)
                            app -> infra: UPDATE - Update or delete scope
                            infra -> m_scope: UPDATE - Update or delete scope
                            activate m_scope
                                note right of m_scope
                                    UPDATE author.m_scope
                                    SET
                                        updated_by = '<sequence.updatedBy>',
                                        updated_at = NOW() AT TIME ZONE 'UTC',
                                        row_status = '<sequence.rowStatus>',
                                        scope = '<sequence.scope>',
                                        name = '<sequence.name>',
                                        description = '<sequence.description>'
                                    WHERE id = '<sequence.id>'
                                    RETURNING id as scope_id
                                end note
                                m_scope -> infra: Return updated result
                            deactivate m_scope
                            infra -> app: Return the changed scope
                        end
                        alt Insert
                            app -> infra: COMMIT
                            app -> api: HTTP 201 S10000 Insert Scope Success
                            api -> page: Return the scope
                            page -> user: Display the scope saved
                        else rowStatus = DELETED (delete)
                            app -> infra: COMMIT
                            app -> api: HTTP 204 No Content; no response body
                            api -> page: No content
                            page -> user: Display the scope removed
                        else rowStatus = ARCHIVED (archive)
                            app -> infra: COMMIT
                            app -> api: HTTP 200 S10000 Archive Scope Success
                            api -> page: Return the scope
                            page -> user: Display the scope saved
                        else Update
                            app -> infra: COMMIT
                            app -> api: HTTP 200 S10000 Update Scope Success
                            api -> page: Return the scope
                            page -> user: Display the scope saved
                        end
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
