@startuml UpsertScope

title Upsert Scope API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Scope Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "m_scope" as m_scope
    database "t_permission_scope" as t_permission_scope
end box

user -> page: Submit scope code, label, description and lifecycle status
activate page
    page -> api: POST v1/author/scope/upsert (JSON, Bearer JWT, UTC timestamp)
    activate api
        api -> app: [**UpsertScopeCommandHandler**] Process request
        activate app
            note over app, infra
                Execution order: validate the request (400) -> verify JWT (401) -> begin transaction (READ COMMITTED) ->
                caller user lock -> fresh current credentials (401) -> locked target existence (404, only when id supplied)
                -> permission (403, E10009) -> duplicate check (409 E10003) -> existing-target in-use check for
                DELETED/ARCHIVED (409 E10006) -> guarded write -> complete mapping -> COMMIT -> response. Every post-BEGIN
                rejection rolls back.
                Lock order is caller user -> target scope -> usage reads/write. Reference writers adding/retaining an ACTIVE
                permission-scope definition must lock/recheck their permission parents and then scope masters ordered by id
                before link mutation, as in the separately delivered permission APIs. A soft master status is not protected
                by a foreign key alone. Q23 withdrawal may skip master ACTIVE validation and only reduces usage; it does not
                authorize creating a link to a closed master. These reference SQL tests do not certify unmigrated writers or
                backend implementations.
            end note
            app -> app: Generate requestId; validate JSON object/known unique keys/no query, UTC timestamp, optional non-null UUID id, scope code ^[A-Z][A-Z0-9_]{0,63}$, nonblank name/description and 64/64/256 limits; preserve text
            note over app, infra
                HTTP status of the single upsert: Insert 201 Created, Update 200 Ok, Delete 204 No Content (no response
                body), Archive 200 Ok.
                Validate one JSON object allowing only id/scope/name/description/rowStatus, no repeated/unknown body/query
                keys, JSON content type and mandatory UTC timestamp before SQL. id is optional only by omission and is a
                non-null UUID when supplied. Required scope/name/description are non-null nonblank strings, maximum
                64/64/256 characters; scope matches ^[A-Z][A-Z0-9_]{0,63}$. Preserve supplied text without
                trimming/case-normalization. Parent status defaults to ACTIVE only when omitted and otherwise is
                ACTIVE/INACTIVE/DELETED/LOCKED/ARCHIVED; insert-DELETED is 400 E10001. All required fields remain mandatory
                on delete/archive. Generate requestId when omitted.
                Map exactly data.scopeId from RETURNING before COMMIT. Insert is 201 S10000 Insert Scope Success, existing
                delete is 204 with no body/status/data, existing archive is 200 S10000 Archive Scope Success, and other
                existing updates are 200 S10000 Update Scope Success. Exclude caller/token/audit/definition/grant rows. No
                partial result or success before commit.
            end note
            app -> app: Default status ACTIVE only when omitted; reject invalid/null status and insert-DELETED; all required fields remain required on delete/archive
            alt Invalid input/header
                break Reject this request
                    app -> api: HTTP 400 E10001
                    api -> page: Show failure; no successful scope action
                    page -> user: Display failure; keep unsaved input
                end break
            else Check passed
            end
            app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub and structured unique roleIds/name array
            alt Missing/invalid JWT or malformed roles
                break Reject this request
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Show failure; no successful scope action
                    page -> user: Display failure; keep unsaved input
                end break
            else Check passed
            end
            app -> app: callerUserId = verified sub; accessTokenHash = SHA-256 exact JWT; createdBy/updatedBy = caller UUID string; omitted id = typed SQL NULL
            app -> infra: BEGIN READ COMMITTED
            note over app, infra
                Verify JWT signature/issuer/audience/expiry/UUID sub and structured unique roles before BEGIN. roles must be
                an array including [], each role has UUID roleId/non-empty name and roleIds are unique. Malformed/missing
                roles is generic 401 E10002, never [] or live-grant fallback. callerUserId = verified sub; accessTokenHash =
                SHA-256 exact JWT. createdBy/updatedBy are the caller UUID string and now is fresh server UTC, never request
                audit values or timestamp.
                Begin READ COMMITTED and lock caller user first. Missing caller is 401 with rollback. Capture fresh server
                UTC now after caller lock and recheck JWT exp; require matching hash/caller, ACTIVE token/user and strict
                expired_at > now. Revoked/inactive/expired/mismatched credentials are generic 401 before any target scope
                lookup. Logout/reset share this user-first lock. Grant withdrawal alone does not revoke current old claims;
                refresh resolves latest rights.
                For supplied id lock the non-DELETED scope FOR UPDATE, then reject missing/DELETED as 404 E10004 before
                permission. Do not reopen a deleted target. Authorize only exact PLATFORM_ADMIN in verified JWT roles after
                current credentials/optional target existence. [] or any other valid role name gives 403 E10009 You do not
                have permission to manage scopes.; do not query live caller role grants or infer authority from scope code.
            end note
            activate infra
            alt Work completes before commit
                note over app, infra
                    Any SQL/result/mapping step may fail, including after a provisional scope write.
                    Roll back the whole transaction on failure; no success before a successful COMMIT.
                end note
                app -> infra: QUERY - Lock the caller user
                infra -> m_user: QUERY - Lock the caller user
                activate m_user
                    note right of m_user
                        SELECT
                            u.id as user_id
                        FROM authen.m_user u
                        WHERE u.id = '<sequence.callerUserId>'
                        FOR UPDATE
                    end note
                    m_user -> infra: Return locked caller user or no row
                deactivate m_user
                infra -> app: Return locked caller user or no row
                alt Caller user missing
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Show failure; no successful scope action
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                app -> app: Capture fresh server UTC now after caller lock; recheck JWT exp
                alt JWT expired while waiting for caller lock
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Show failure; no successful scope action
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                app -> infra: QUERY - Check current credential and user
                infra -> t_user_access_token: QUERY - Check current credential and user
                activate t_user_access_token
                    note right of t_user_access_token
                        SELECT
                            at.id as access_token_id
                        FROM authen.t_user_access_token at
                        JOIN authen.m_user u ON u.id = at.user_id
                        WHERE at.token = '<sequence.accessTokenHash>'
                        AND at.user_id = '<sequence.callerUserId>'
                        AND at.row_status = 'ACTIVE'
                        AND at.expired_at > '<sequence.now>'
                        AND u.row_status = 'ACTIVE'
                    end note
                    t_user_access_token -> infra: Return ACTIVE matching unexpired token/user or no row
                deactivate t_user_access_token
                infra -> app: Return ACTIVE matching unexpired token/user or no row
                alt Current token/user missing/inactive/revoked/expired/mismatched
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Show failure; no successful scope action
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                alt Scope id supplied (existing update/delete/archive)
                    app -> infra: QUERY - Check existing scope
                    infra -> m_scope: QUERY - Check existing scope
                    activate m_scope
                        note right of m_scope
                            SELECT
                                s.id as scope_id
                            FROM author.m_scope s
                            WHERE s.id = '<sequence.id>'
                            AND s.row_status <> 'DELETED' -- the id of a DELETED scope counts as not found
                            FOR UPDATE
                        end note
                        m_scope -> infra: Return locked non-DELETED target scope or no row
                    deactivate m_scope
                    infra -> app: Return locked non-DELETED target scope or no row
                    alt Scope missing or DELETED
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 Scope not found.
                            api -> page: Show failure; no successful scope action
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                    app -> app: Authorize only exact case-sensitive PLATFORM_ADMIN in verified JWT roles; never reload live grants
                    alt No exact PLATFORM_ADMIN role claim
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 403 E10009 You do not have permission to manage scopes.
                            api -> page: Show failure; no successful scope action
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                    app -> infra: QUERY - Check duplicate scope
                    infra -> m_scope: QUERY - Check duplicate scope
                    activate m_scope
                        note right of m_scope
                            SELECT
                                s.id as scope_id
                            FROM author.m_scope s
                            WHERE s.scope = '<sequence.scope>'
                            AND s.row_status <> 'DELETED'
                            AND ('<sequence.id>' IS NULL OR s.id <> '<sequence.id>') -- omitted insert id is typed SQL NULL
                        end note
                        m_scope -> infra: Return non-DELETED same-code scope excluding optional target or no row
                    deactivate m_scope
                    infra -> app: Return non-DELETED same-code scope excluding optional target or no row
                    alt Another non-DELETED scope holds the code
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 409 E10003 Scope scope already exists.
                            api -> page: Show failure; no successful scope action
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                    alt Existing target requested DELETED or ARCHIVED
                        app -> infra: QUERY - Check permission scope in use
                        infra -> t_permission_scope: QUERY - Check permission scope in use
                        activate t_permission_scope
                            note right of t_permission_scope
                                SELECT
                                    ps.id as permission_scope_id
                                FROM author.t_permission_scope ps
                                WHERE ps.scope_id = '<sequence.id>' -- only when rowStatus is DELETED or ARCHIVED
                                AND ps.row_status <> 'DELETED'
                            end note
                            t_permission_scope -> infra: Return any non-DELETED permission-scope definition, irrespective of parent permission status
                        deactivate t_permission_scope
                        infra -> app: Return any non-DELETED permission-scope definition, irrespective of parent permission status
                        alt Any non-DELETED definition still references this scope
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10006 Scope is used by permissions.
                                api -> page: Show failure; no successful scope action
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                        app -> infra: UPDATE - Update or delete scope
                        infra -> m_scope: UPDATE - Update or delete scope
                        activate m_scope
                            note right of m_scope
                                UPDATE author.m_scope
                                SET
                                    updated_by = '<sequence.updatedBy>',
                                    updated_at = '<sequence.now>',
                                    row_status = '<sequence.rowStatus>',
                                    scope = '<sequence.scope>',
                                    name = '<sequence.name>',
                                    description = '<sequence.description>'
                                WHERE id = '<sequence.id>'
                                AND row_status <> 'DELETED'
                                RETURNING id as scope_id
                            end note
                            m_scope -> infra: Return guarded returned scope_id or no row
                        deactivate m_scope
                        infra -> app: Return guarded returned scope_id or no row
                        alt Guarded UPDATE returned zero rows
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 Scope not found.
                                api -> page: Show failure; no successful scope action
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                        app -> app: Require exactly one returned scope_id equal to requested id; missing/malformed/mismatched result is internal failure
                        alt Existing status DELETED
                            app -> app: Suppress response body/status/data for 204
                            app -> infra: COMMIT
                            infra -> app: Return committed scope action
                            app -> api: HTTP 204 No Content; no response body
                            api -> page: Show committed scope action
                            page -> user: Display the committed scope action
                        else Existing status ARCHIVED
                            app -> app: data = exactly scopeId from RETURNING; exclude caller/token/audit/definitions/grants
                            app -> infra: COMMIT
                            infra -> app: Return committed scope action
                            note over app, infra
                                Detailed revision remains in-review; no schema/backend implementation.
                                The comparison is exact and a value held by an INACTIVE, LOCKED or ARCHIVED scope is still taken (409,
                                E10003). The value of a DELETED scope can be used again.
                                Every field that is not optional is required in every request, including a delete and an archive.
                                INACTIVE, LOCKED and ARCHIVED are reversible: an update with `rowStatus` ACTIVE opens the scope again.
                                `rowStatus` DELETED is rejected with 400 (E10001) when the request inserts a scope. A scope that is not
                                ACTIVE is excluded from newly resolved login/refresh claims; an already-issued access token keeps its
                                previous claims until expiry (Q4/Q7).
                                INACTIVE and LOCKED are allowed, the rows that use it are not changed.
                                A valid non-admin claim returns 403 E10009 after optional target existence and before conflicts. No live
                                caller-assignment or request-flag fallback. Approved by the product owner (Q2/Q4/Q10/Q13); this supersedes
                                the earlier live-grant guard.
                                Duplicate scope exclusion is null-safe: omitted insert id binds typed SQL NULL, not a string or zero UUID.
                                The current row can keep its code. Scope-code uniqueness spans every non-DELETED master, including
                                INACTIVE/LOCKED/ARCHIVED; a DELETED master's code can be reused by a new id. Existing scope codes, including
                                seed codes, remain editable under the original contract; no reserved-code or immutability rule is added.
                                Labels/description remain editable and no permission definition or grant history is rewritten.
                                Check t_permission_scope usage only for an existing target requested DELETED/ARCHIVED. Any non-DELETED
                                definition, including INACTIVE/LOCKED/ARCHIVED, blocks with 409 E10006 Scope is used by permissions.,
                                regardless of its parent permission's lifecycle. No parent/master/grant JOIN or ACTIVE-only filter may hide
                                usage. INACTIVE/LOCKED or ordinary metadata/code updates retain links and are allowed; they affect newly
                                resolved claims only. Insert-ARCHIVED is allowed and returns 201 INSERT, with no target/in-use check.
                                Bind all values. INSERT explicitly sets created_at and must return exactly one scope_id UUID;
                                missing/malformed result is generic 500. UPDATE guards id and non-DELETED status; zero returned rows is 404
                                E10004 with whole-request rollback. The returned existing scope_id must equal the requested id. Preserve
                                created_by/created_at on UPDATE. Any SQL/result/mapping failure restores provisional
                                status/code/name/description/audit changes.
                                SQLSTATE 23505 from uq_m_scope_scope is the final concurrent uniqueness guard and maps to 409 E10003 Scope
                                scope already exists. after full rollback. Preserve this existing business message. Other SQL/result/mapping
                                errors roll back and return generic 500 without bizCode. Timeout before COMMIT rolls back and returns 408
                                E90001. No retry is promised for an unknown commit result.
                            end note
                            app -> api: HTTP 200 S10000 Archive Scope Success; exactly scopeId
                            api -> page: Show committed scope action
                            page -> user: Display the committed scope action
                        end
                    else Existing target requested ACTIVE, INACTIVE or LOCKED
                        app -> app: Keep all definition/grant rows; code/name/description remain editable; old JWT claims stay unchanged
                        app -> infra: UPDATE - Update or delete scope
                        infra -> m_scope: UPDATE - Update or delete scope
                        activate m_scope
                            note right of m_scope
                                UPDATE author.m_scope
                                SET
                                    updated_by = '<sequence.updatedBy>',
                                    updated_at = '<sequence.now>',
                                    row_status = '<sequence.rowStatus>',
                                    scope = '<sequence.scope>',
                                    name = '<sequence.name>',
                                    description = '<sequence.description>'
                                WHERE id = '<sequence.id>'
                                AND row_status <> 'DELETED'
                                RETURNING id as scope_id
                            end note
                            m_scope -> infra: Return guarded returned scope_id or no row
                        deactivate m_scope
                        infra -> app: Return guarded returned scope_id or no row
                        alt Guarded UPDATE returned zero rows
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 Scope not found.
                                api -> page: Show failure; no successful scope action
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                        app -> app: Require exactly one returned scope_id equal to requested id; missing/malformed/mismatched result is internal failure
                        app -> app: data = exactly scopeId from RETURNING; exclude caller/token/audit/definitions/grants
                        app -> infra: COMMIT
                        infra -> app: Return committed scope action
                        app -> api: HTTP 200 S10000 Update Scope Success; exactly scopeId
                        api -> page: Show committed scope action
                        page -> user: Display the committed scope action
                    end
                else Scope id omitted (INSERT including ARCHIVED)
                    app -> app: Authorize only exact case-sensitive PLATFORM_ADMIN in verified JWT roles; never reload live grants
                    alt No exact PLATFORM_ADMIN role claim
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 403 E10009 You do not have permission to manage scopes.
                            api -> page: Show failure; no successful scope action
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                    app -> infra: QUERY - Check duplicate scope
                    infra -> m_scope: QUERY - Check duplicate scope
                    activate m_scope
                        note right of m_scope
                            SELECT
                                s.id as scope_id
                            FROM author.m_scope s
                            WHERE s.scope = '<sequence.scope>'
                            AND s.row_status <> 'DELETED'
                            AND ('<sequence.id>' IS NULL OR s.id <> '<sequence.id>') -- omitted insert id is typed SQL NULL
                        end note
                        m_scope -> infra: Return non-DELETED same-code scope excluding optional target or no row
                    deactivate m_scope
                    infra -> app: Return non-DELETED same-code scope excluding optional target or no row
                    alt Another non-DELETED scope holds the code
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 409 E10003 Scope scope already exists.
                            api -> page: Show failure; no successful scope action
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                    app -> infra: INSERT - Create scope
                    infra -> m_scope: INSERT - Create scope
                    activate m_scope
                        note right of m_scope
                            INSERT INTO author.m_scope (
                                created_by,
                                created_at,
                                row_status,
                                scope,
                                name,
                                description
                            )
                            VALUES (
                                &#39;<sequence.createdBy>',
                                &#39;<sequence.now>',
                                &#39;<sequence.rowStatus>',
                                &#39;<sequence.scope>',
                                &#39;<sequence.name>',
                                &#39;<sequence.description>'
                            )
                            RETURNING id as scope_id
                        end note
                        m_scope -> infra: Return inserted scope_id
                    deactivate m_scope
                    infra -> app: Return inserted scope_id
                    app -> app: Require exactly one inserted scope_id UUID; missing or malformed result is internal failure
                    app -> app: data = exactly scopeId from RETURNING; exclude caller/token/audit/definitions/grants
                    app -> infra: COMMIT
                    infra -> app: Return committed scope action
                    app -> api: HTTP 201 S10000 Insert Scope Success; exactly scopeId
                    api -> page: Show committed scope action
                    page -> user: Display the committed scope action
                end
            else SQLSTATE 23505 from uq_m_scope_scope
                app -> infra: ROLLBACK
                app -> api: HTTP 409 E10003 Scope scope already exists.
                api -> page: Show failure; no successful scope action
                page -> user: Display failure; keep unsaved input
            else Timeout before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 408 E90001
                api -> page: Show failure; no successful scope action
                page -> user: Display failure; keep unsaved input
            else Unexpected SQL/result/mapping failure before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 500 Internal Server Error; omit bizCode
                api -> page: Show failure; no successful scope action
                page -> user: Display failure; keep unsaved input
            end
            deactivate infra
        deactivate app
    deactivate api
deactivate page
@enduml
