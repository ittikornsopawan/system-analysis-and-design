@startuml InquiryPermission Sequence

title Inquiry Permission API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Permission Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "m_permission" as m_permission
    database "t_permission_scope" as t_permission_scope
    database "m_scope" as m_scope
end box

user -> page: Request the permissions
activate page
    page -> api: GET v1/author/permission
    activate api
        api -> app: [**InquiryPermissionQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters: pageIndex and pageSize are greater than 0, pageSize at most 100, rowStatus is a valid status
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: Execute database operations
                    activate infra
                    alt Work completes
                        app -> infra: QUERY - Get the platform administrator role
                        infra -> m_role: QUERY - Get the platform administrator role
                        activate m_role
                            note right of m_role
                                SELECT
                                    r.id as role_id
                                FROM author.m_role r
                                WHERE r.name = 'PLATFORM_ADMIN'
                                AND r.row_status = 'ACTIVE'
                            end note
                            m_role -> infra: Return query result
                        deactivate m_role
                        infra -> app: Return the role id
                        app -> infra: QUERY - Check platform administrator
                        infra -> t_user_role: QUERY - Check platform administrator
                        activate t_user_role
                            note right of t_user_role
                                SELECT
                                    ur.id as user_role_id
                                FROM author.t_user_role ur
                                WHERE ur.user_id = '<sequence.userId>'
                                AND ur.role_id = '<sequence.roleId>'
                                AND ur.row_status = 'ACTIVE'
                            end note
                            t_user_role -> infra: Return query result
                        deactivate t_user_role
                        infra -> app: Return the assignment or no row
                        alt The caller is not a platform administrator
                            app -> api: HTTP 403 E10009 You do not have permission to read permissions.
                            api -> page: Forbidden
                            page -> user: Display no permission
                        end
                        app -> infra: QUERY - Get permissions
                        infra -> m_permission: QUERY - Get permissions
                        activate m_permission
                            note right of m_permission
                                SELECT
                                    p.id as permission_id,
                                    p.name,
                                    p.description,
                                    p.row_status
                                FROM author.m_permission p
                                WHERE p.row_status <> 'DELETED'
                                AND p.id = '<sequence.id>' -- only when id is specified
                                AND (p.name ILIKE '%<sequence.search>%' OR p.description ILIKE '%<sequence.search>%') -- only when search is specified
                                AND p.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                                ORDER BY p.name, p.id
                                LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                            end note
                            m_permission -> infra: Return query result
                        deactivate m_permission
                        infra -> app: Return the page of permissions
                        app -> infra: QUERY - Get total items
                        infra -> m_permission: QUERY - Get total items
                        activate m_permission
                            note right of m_permission
                                SELECT
                                    COUNT(p.id) as total_items
                                FROM author.m_permission p
                                WHERE p.row_status <> 'DELETED'
                                AND p.id = '<sequence.id>' -- only when id is specified
                                AND (p.name ILIKE '%<sequence.search>%' OR p.description ILIKE '%<sequence.search>%') -- only when search is specified
                                AND p.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                            end note
                            m_permission -> infra: Return query result
                        deactivate m_permission
                        infra -> app: Return total_items
                        alt No permission matches
                            app -> api: HTTP 200 S10000
                            api -> page: Return an empty list
                            page -> user: Display no permission
                        else Permissions found
                            app -> infra: QUERY - Get the scopes of the permissions
                            infra -> t_permission_scope: QUERY - Get the scopes of the permissions
                            activate t_permission_scope
                                note right of t_permission_scope
                                    SELECT
                                        ps.id as permission_scope_id,
                                        ps.permission_id,
                                        ps.scope_id,
                                        ps.row_status
                                    FROM author.t_permission_scope ps
                                    WHERE ps.permission_id IN ('<sequence.permissionIds>')
                                    AND ps.row_status <> 'DELETED'
                                end note
                                t_permission_scope -> infra: Return query result
                            deactivate t_permission_scope
                            infra -> app: Return the scopes of the permissions
                            app -> infra: QUERY - Get scope
                            infra -> m_scope: QUERY - Get scope
                            activate m_scope
                                note right of m_scope
                                    SELECT
                                        s.id as scope_id,
                                        s.scope,
                                        s.name
                                    FROM author.m_scope s
                                    WHERE s.id IN ('<sequence.scopeIds>')
                                    ORDER BY s.scope, s.id
                                end note
                                m_scope -> infra: Return query result
                            deactivate m_scope
                            infra -> app: Return the scopes
                            app -> api: HTTP 200 S10000
                            api -> page: Return the permissions
                            page -> user: Display the permissions
                        end
                    else Timeout
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
