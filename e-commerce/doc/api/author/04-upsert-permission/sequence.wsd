@startuml UpsertPermission

title Upsert Permission API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Permission Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "m_permission" as m_permission
    database "m_scope" as m_scope
    database "t_permission_scope" as t_permission_scope
    database "t_role_permission" as t_role_permission
    database "t_user_permission" as t_user_permission
    database "t_role_permission_scope" as t_role_permission_scope
end box

user -> page: Submit permission with optional scope-link changes
activate page
    page -> api: POST v1/author/permission/upsert (JSON, Bearer JWT, UTC timestamp)
    activate api
        api -> app: [**UpsertPermissionCommandHandler**] Process request
        activate app
            app -> app: Generate requestId; validate whole object/known unique keys/no query, UTC timestamp, required name/description/code, parent id/status/default ACTIVE and all scope items
            app -> app: scopes omitted or [] means no changes; reject null, child insert-DELETED, duplicate parsed child ids and duplicate non-DELETED scopeIds before SQL
            alt Invalid parent/child/header/input
                break Reject this request
                    app -> api: HTTP 400 E10001
                    api -> page: Reject the whole permission request; no partial success
                    page -> user: Display failure; keep unsaved input
                end break
            else Check passed
            end
            app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub and structured unique roleIds/name array
            alt Missing/invalid JWT or malformed roles
                break Reject this request
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Reject the whole permission request; no partial success
                    page -> user: Display failure; keep unsaved input
                end break
            else Check passed
            end
            app -> app: callerUserId = verified sub; accessTokenHash = SHA-256 exact JWT; createdBy/updatedBy = caller UUID string; omitted ids = typed SQL NULL
            app -> infra: BEGIN READ COMMITTED
            activate infra
            alt Work completes before commit
                note over app, infra
                    Any SQL/domain step may fail, including after parent or child writes.
                    All writes remain provisional until final Q22 validation and a successful COMMIT.
                end note
                app -> infra: QUERY - Lock the caller user
                infra -> m_user: QUERY - Lock the caller user
                activate m_user
                    note right of m_user
                        SELECT
                            u.id as user_id
                        FROM authen.m_user u
                        WHERE u.id = '<sequence.callerUserId>'
                        FOR UPDATE
                    end note
                    m_user -> infra: Return locked caller user or no row
                deactivate m_user
                infra -> app: Return locked caller user or no row
                alt Caller is missing
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Reject the whole permission request; no partial success
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                app -> app: Capture fresh server UTC now after caller lock; recheck JWT exp
                alt JWT expired while waiting for caller lock
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Reject the whole permission request; no partial success
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                app -> infra: QUERY - Check current credential and user
                infra -> t_user_access_token: QUERY - Check current credential and user
                activate t_user_access_token
                    note right of t_user_access_token
                        SELECT
                            at.id as access_token_id
                        FROM authen.t_user_access_token at
                        JOIN authen.m_user u ON u.id = at.user_id
                        WHERE at.token = '<sequence.accessTokenHash>'
                        AND at.user_id = '<sequence.callerUserId>'
                        AND at.row_status = 'ACTIVE'
                        AND at.expired_at > '<sequence.now>'
                        AND u.row_status = 'ACTIVE'
                    end note
                    t_user_access_token -> infra: Return ACTIVE matching unexpired token/user or no row
                deactivate t_user_access_token
                infra -> app: Return ACTIVE matching unexpired token/user or no row
                alt Current token/user missing/inactive/revoked/expired/mismatched
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Reject the whole permission request; no partial success
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                alt Parent id supplied
                    app -> infra: QUERY - Check existing permission
                    infra -> m_permission: QUERY - Check existing permission
                    activate m_permission
                        note right of m_permission
                            SELECT
                                p.id as permission_id
                            FROM author.m_permission p
                            WHERE p.id = '<sequence.id>'
                            AND p.row_status <> 'DELETED' -- the id of a DELETED permission counts as not found
                            FOR UPDATE
                        end note
                        m_permission -> infra: Return locked non-DELETED parent or no row
                    deactivate m_permission
                    infra -> app: Return locked non-DELETED parent or no row
                    alt Parent missing or DELETED
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 Permission not found.
                            api -> page: Reject the whole permission request; no partial success
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                    app -> app: permissionId = verified existing parent id
                else Parent id omitted
                    app -> app: permissionId = typed SQL NULL before insert
                end
                app -> app: Authorize only exact case-sensitive PLATFORM_ADMIN in verified JWT roles; never reload live caller grants
                alt No exact PLATFORM_ADMIN role claim
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 403 E10009 You do not have permission to manage permissions.
                        api -> page: Reject the whole permission request; no partial success
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                app -> app: activeScopeIds = only requested ACTIVE child scopeIds; permissionScopeIds = supplied child ids; bind typed UUID[] including empty arrays
                app -> infra: QUERY - Check scope
                infra -> m_scope: QUERY - Check scope
                activate m_scope
                    note right of m_scope
                        SELECT
                            s.id as scope_id
                        FROM author.m_scope s
                        WHERE s.id = ANY ('<sequence.activeScopeIds>'::UUID[])
                        AND s.row_status = 'ACTIVE'
                        ORDER BY s.id
                        FOR UPDATE
                    end note
                    m_scope -> infra: Return ACTIVE requested scope masters locked in ascending id order
                deactivate m_scope
                infra -> app: Return ACTIVE requested scope masters locked in ascending id order
                app -> infra: QUERY - Check existing permission scope
                infra -> t_permission_scope: QUERY - Check existing permission scope
                activate t_permission_scope
                    note right of t_permission_scope
                        SELECT
                            ps.id as permission_scope_id,
                            ps.scope_id
                        FROM author.t_permission_scope ps
                        WHERE ps.id = ANY ('<sequence.permissionScopeIds>'::UUID[])
                        AND ps.permission_id = '<sequence.permissionId>'
                        AND ps.row_status <> 'DELETED' -- supplied ids must belong to this permission
                        ORDER BY ps.id
                        FOR UPDATE
                    end note
                    t_permission_scope -> infra: Return owned non-DELETED requested definitions and immutable scopeIds, locked in ascending id order
                deactivate t_permission_scope
                infra -> app: Return owned non-DELETED requested definitions and immutable scopeIds, locked in ascending id order
                loop Validate every supplied scopes[i] in input order before any writes
                    alt Child rowStatus = ACTIVE
                        alt Requested master absent from ACTIVE master map
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10005 Scope not found.
                                api -> page: Reject the whole permission request; no partial success
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                    else Child rowStatus = DELETED
                        app -> app: Q23 skip master ACTIVE validation for removing an existing definition
                    end
                    alt Child id supplied
                        alt Child absent from owned non-DELETED definition map
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 Permission scope not found.
                                api -> page: Reject the whole permission request; no partial success
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                        alt Requested scopeId differs from stored immutable scopeId
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 400 E10001 Scope Id cannot be changed.
                                api -> page: Reject the whole permission request; no partial success
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                    else Child id omitted
                        app -> app: New ACTIVE child; request validation already rejected insert-DELETED
                    end
                end
                app -> infra: QUERY - Count permission scope definitions
                infra -> t_permission_scope: QUERY - Count permission scope definitions
                activate t_permission_scope
                    note right of t_permission_scope
                        SELECT
                            COUNT(ps.id) as definition_count
                        FROM author.t_permission_scope ps
                        WHERE ps.permission_id = '<sequence.permissionId>'
                        AND ps.row_status <> 'DELETED'
                    end note
                    t_permission_scope -> infra: Return definitionCount including every non-DELETED definition
                deactivate t_permission_scope
                infra -> app: Return definitionCount including every non-DELETED definition
                app -> app: beforeDefinitionCount = definitionCount; require valid nonnegative integer
                app -> infra: QUERY - Check duplicate name
                infra -> m_permission: QUERY - Check duplicate name
                activate m_permission
                    note right of m_permission
                        SELECT
                            p.id as permission_id
                        FROM author.m_permission p
                        WHERE p.name = '<sequence.name>'
                        AND p.row_status <> 'DELETED'
                        AND ('<sequence.id>' IS NULL OR p.id <> '<sequence.id>') -- omitted insert id is typed SQL NULL
                    end note
                    m_permission -> infra: Return non-DELETED same-name parent excluding optional target or no row
                deactivate m_permission
                infra -> app: Return non-DELETED same-name parent excluding optional target or no row
                alt Another non-DELETED permission holds this name
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 409 E10003 Permission name already exists.
                        api -> page: Reject the whole permission request; no partial success
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                alt Existing parent requested DELETED or ARCHIVED
                    app -> infra: QUERY - Check role permission in use
                    infra -> t_role_permission: QUERY - Check role permission in use
                    activate t_role_permission
                        note right of t_role_permission
                            SELECT
                                rp.id as role_permission_id
                            FROM author.t_role_permission rp
                            WHERE rp.permission_id = '<sequence.permissionId>' -- destructive parent check or final Q22 guard
                            AND rp.row_status <> 'DELETED'
                        end note
                        t_role_permission -> infra: Return non-DELETED role grants for this permission
                    deactivate t_role_permission
                    infra -> app: Return non-DELETED role grants for this permission
                    app -> infra: QUERY - Check user permission in use
                    infra -> t_user_permission: QUERY - Check user permission in use
                    activate t_user_permission
                        note right of t_user_permission
                            SELECT
                                up.id as user_permission_id
                            FROM author.t_user_permission up
                            WHERE up.permission_id = '<sequence.permissionId>' -- destructive parent check or final Q22 guard
                            AND up.row_status <> 'DELETED'
                        end note
                        t_user_permission -> infra: Return non-DELETED direct-user grants for this permission
                    deactivate t_user_permission
                    infra -> app: Return non-DELETED direct-user grants for this permission
                    alt Either non-DELETED parent grant exists
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 409 E10006 Permission is used by roles or users.
                            api -> page: Reject the whole permission request; no partial success
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                else Insert or reversible parent status
                end
                loop Precheck every supplied scopes[i] in input order before parent/child mutation
                    app -> infra: QUERY - Check duplicate permission scope
                    infra -> t_permission_scope: QUERY - Check duplicate permission scope
                    activate t_permission_scope
                        note right of t_permission_scope
                            SELECT
                                ps.id as permission_scope_id
                            FROM author.t_permission_scope ps
                            WHERE ps.permission_id = '<sequence.permissionId>'
                            AND ps.scope_id = '<sequence.scopes.scopeId>'
                            AND ps.row_status <> 'DELETED'
                            AND ('<sequence.scopes.id>' IS NULL OR ps.id <> '<sequence.scopes.id>') -- omitted child insert id is typed SQL NULL
                        end note
                        t_permission_scope -> infra: Return non-DELETED same scope pair excluding optional child id in pre-write state
                    deactivate t_permission_scope
                    infra -> app: Return non-DELETED same scope pair excluding optional child id in pre-write state
                    alt Another non-DELETED definition has this scope pair
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 409 E10003 Scope already exists in the permission.
                            api -> page: Reject the whole permission request; no partial success
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                    alt Child rowStatus = DELETED
                        app -> infra: QUERY - Check role permission scope in use
                        infra -> t_role_permission_scope: QUERY - Check role permission scope in use
                        activate t_role_permission_scope
                            note right of t_role_permission_scope
                                SELECT
                                    rps.id as role_permission_scope_id
                                FROM author.t_role_permission_scope rps
                                WHERE rps.permission_scope_id = '<sequence.scopes.id>' -- only when the scope item is deleted
                                AND rps.row_status <> 'DELETED'
                            end note
                            t_role_permission_scope -> infra: Return non-DELETED role-scope references to this definition
                        deactivate t_role_permission_scope
                        infra -> app: Return non-DELETED role-scope references to this definition
                        app -> infra: QUERY - Check user permission scope in use
                        infra -> t_user_permission: QUERY - Check user permission scope in use
                        activate t_user_permission
                            note right of t_user_permission
                                SELECT
                                    up.id as user_permission_id
                                FROM author.t_user_permission up
                                WHERE up.permission_scope_id = '<sequence.scopes.id>' -- only when the scope item is deleted
                                AND up.row_status <> 'DELETED'
                            end note
                            t_user_permission -> infra: Return non-DELETED direct-user references to this definition
                        deactivate t_user_permission
                        infra -> app: Return non-DELETED direct-user references to this definition
                        alt Either non-DELETED child reference exists
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10006 Scope is used by roles or users.
                                api -> page: Reject the whole permission request; no partial success
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                    else Child rowStatus = ACTIVE
                    end
                end
                alt Parent id omitted (INSERT, including ARCHIVED)
                    app -> infra: INSERT - Create permission
                    infra -> m_permission: INSERT - Create permission
                    activate m_permission
                        note right of m_permission
                            INSERT INTO author.m_permission (
                                created_by,
                                created_at,
                                row_status,
                                name,
                                description
                            )
                            VALUES (
                                &#39;<sequence.createdBy>',
                                &#39;<sequence.now>',
                                &#39;<sequence.rowStatus>',
                                &#39;<sequence.name>',
                                &#39;<sequence.description>'
                            )
                            RETURNING id as permission_id
                        end note
                        m_permission -> infra: Return inserted permission_id
                    deactivate m_permission
                    infra -> app: Return inserted permission_id
                    app -> app: Require exactly one inserted parent UUID; missing/malformed result is internal failure
                else Parent id supplied (UPDATE, DELETE or ARCHIVE)
                    app -> infra: UPDATE - Update or delete permission
                    infra -> m_permission: UPDATE - Update or delete permission
                    activate m_permission
                        note right of m_permission
                            UPDATE author.m_permission
                            SET
                                updated_by = '<sequence.updatedBy>',
                                updated_at = '<sequence.now>',
                                row_status = '<sequence.rowStatus>',
                                name = '<sequence.name>',
                                description = '<sequence.description>'
                            WHERE id = '<sequence.id>'
                            AND row_status <> 'DELETED'
                            RETURNING id as permission_id
                        end note
                        m_permission -> infra: Return guarded returned permission_id or no row
                    deactivate m_permission
                    infra -> app: Return guarded returned permission_id or no row
                    alt Parent UPDATE returned zero rows
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 Permission not found.
                            api -> page: Reject the whole permission request; no partial success
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                    app -> app: Require exactly one returned parent id equal to request id; mismatch is internal failure
                end
                app -> app: permissionId = actual parent RETURNING id; bind this server-derived id for all child writes and final queries
                loop Apply every supplied scopes[i] in input order atomically
                    alt Child id omitted
                        app -> infra: INSERT - Create permission scope
                        infra -> t_permission_scope: INSERT - Create permission scope
                        activate t_permission_scope
                            note right of t_permission_scope
                                INSERT INTO author.t_permission_scope (
                                    created_by,
                                    created_at,
                                    row_status,
                                    permission_id,
                                    scope_id
                                )
                                VALUES (
                                    &#39;<sequence.createdBy>',
                                    &#39;<sequence.now>',
                                    &#39;<sequence.scopes.rowStatus>',
                                    &#39;<sequence.permissionId>',
                                    &#39;<sequence.scopes.scopeId>'
                                )
                                RETURNING id as permission_scope_id
                            end note
                            t_permission_scope -> infra: Return inserted permission_scope_id
                        deactivate t_permission_scope
                        infra -> app: Return inserted permission_scope_id
                        app -> app: Require exactly one inserted child UUID; missing/malformed result is internal failure
                    else Child id supplied
                        app -> infra: UPDATE - Update or delete permission scope
                        infra -> t_permission_scope: UPDATE - Update or delete permission scope
                        activate t_permission_scope
                            note right of t_permission_scope
                                UPDATE author.t_permission_scope
                                SET
                                    updated_by = '<sequence.updatedBy>',
                                    updated_at = '<sequence.now>',
                                    row_status = '<sequence.scopes.rowStatus>'
                                WHERE id = '<sequence.scopes.id>'
                                AND permission_id = '<sequence.permissionId>'
                                AND scope_id = '<sequence.scopes.scopeId>'
                                AND row_status <> 'DELETED'
                                RETURNING id as permission_scope_id
                            end note
                            t_permission_scope -> infra: Return guarded returned permission_scope_id or no row
                        deactivate t_permission_scope
                        infra -> app: Return guarded returned permission_scope_id or no row
                        alt Child UPDATE returned zero rows
                            break Reject this request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 Permission scope not found.
                                api -> page: Reject the whole permission request; no partial success
                                page -> user: Display failure; keep unsaved input
                            end break
                        else Check passed
                        end
                        app -> app: Require exactly one returned child id equal to input id; mismatch is internal failure
                    end
                end
                app -> infra: QUERY - Count permission scope definitions
                infra -> t_permission_scope: QUERY - Count permission scope definitions
                activate t_permission_scope
                    note right of t_permission_scope
                        SELECT
                            COUNT(ps.id) as definition_count
                        FROM author.t_permission_scope ps
                        WHERE ps.permission_id = '<sequence.permissionId>'
                        AND ps.row_status <> 'DELETED'
                    end note
                    t_permission_scope -> infra: Return definitionCount including every non-DELETED definition
                deactivate t_permission_scope
                infra -> app: Return definitionCount including every non-DELETED definition
                app -> app: finalDefinitionCount = definitionCount; require valid nonnegative integer
                alt beforeDefinitionCount > 0 and finalDefinitionCount = 0 (Q22 transition)
                    app -> infra: QUERY - Check role permission in use
                    infra -> t_role_permission: QUERY - Check role permission in use
                    activate t_role_permission
                        note right of t_role_permission
                            SELECT
                                rp.id as role_permission_id
                            FROM author.t_role_permission rp
                            WHERE rp.permission_id = '<sequence.permissionId>' -- destructive parent check or final Q22 guard
                            AND rp.row_status <> 'DELETED'
                        end note
                        t_role_permission -> infra: Return non-DELETED role grants for this permission
                    deactivate t_role_permission
                    infra -> app: Return non-DELETED role grants for this permission
                    app -> infra: QUERY - Check user permission in use
                    infra -> t_user_permission: QUERY - Check user permission in use
                    activate t_user_permission
                        note right of t_user_permission
                            SELECT
                                up.id as user_permission_id
                            FROM author.t_user_permission up
                            WHERE up.permission_id = '<sequence.permissionId>' -- destructive parent check or final Q22 guard
                            AND up.row_status <> 'DELETED'
                        end note
                        t_user_permission -> infra: Return non-DELETED direct-user grants for this permission
                    deactivate t_user_permission
                    infra -> app: Return non-DELETED direct-user grants for this permission
                    alt Either fresh non-DELETED role/direct-user grant survives
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 409 E10006 Permission cannot become unscoped while assigned to roles or users.
                            api -> page: Reject the whole permission request; no partial success
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                else Permission remains scoped or was already unscoped
                    app -> app: Q22 does not prohibit existing unscoped grants
                end
                alt Parent id omitted
                    app -> app: data = exactly permissionId from parent RETURNING; no child ids or audit fields
                    app -> infra: COMMIT
                    infra -> app: Return committed parent and scope-link actions
                    app -> api: HTTP 201 S10000 Insert Permission Success; exactly permissionId
                    api -> page: Show completed permission action
                    page -> user: Display the committed action
                else Existing parent rowStatus = DELETED
                    app -> app: Suppress body/status/data for 204
                    app -> infra: COMMIT
                    infra -> app: Return committed parent and scope-link actions
                    app -> api: HTTP 204 No Content; no response body
                    api -> page: Show completed permission action
                    page -> user: Display the committed action
                else Existing parent rowStatus = ARCHIVED
                    app -> app: data = exactly permissionId from parent RETURNING; no child ids or audit fields
                    app -> infra: COMMIT
                    infra -> app: Return committed parent and scope-link actions
                    app -> api: HTTP 200 S10000 Archive Permission Success; exactly permissionId
                    api -> page: Show completed permission action
                    page -> user: Display the committed action
                else Existing parent rowStatus = ACTIVE, INACTIVE or LOCKED
                    app -> app: data = exactly permissionId from parent RETURNING; no child ids or audit fields
                    app -> infra: COMMIT
                    infra -> app: Return committed parent and scope-link actions
                    app -> api: HTTP 200 S10000 Update Permission Success; exactly permissionId
                    api -> page: Show completed permission action
                    page -> user: Display the committed action
                end
            else SQLSTATE 23505 from uq_m_permission_name
                app -> infra: ROLLBACK
                app -> api: HTTP 409 E10003 Permission name already exists.
                api -> page: Reject the whole permission request; no partial success
                page -> user: Display failure; keep unsaved input
            else SQLSTATE 23505 from uq_t_permission_scope_permission_id_scope_id
                app -> infra: ROLLBACK
                app -> api: HTTP 409 E10003 Scope already exists in the permission.
                api -> page: Reject the whole permission request; no partial success
                page -> user: Display failure; keep unsaved input
            else Timeout before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 408 E90001
                api -> page: Reject the whole permission request; no partial success
                page -> user: Display failure; keep unsaved input
            else Unexpected SQL/result/mapping failure before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 500 Internal Server Error; omit bizCode
                api -> page: Reject the whole permission request; no partial success
                page -> user: Display failure; keep unsaved input
            end
            deactivate infra
        deactivate app
    deactivate api
deactivate page
@enduml
