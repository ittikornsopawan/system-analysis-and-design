@startuml UpsertRoleBatch

title Upsert Role Batch API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Role Batch Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "t_role_permission" as t_role_permission
end box

user -> page: Submit the ordered role batch
activate page
    page -> api: POST v1/author/role/upsert/batch (JSON, Bearer JWT, UTC timestamp)
    activate api
        api -> app: [**UpsertRoleBatchCommandHandler**] Process request
        activate app
            app -> app: Generate requestId; validate whole JSON envelope/no query/known unique keys, UTC timestamp, roles array 1..100, every item type/required fields/code/status/defaults; reject insert-DELETED
            app -> app: Validate all items in input order; canonical duplicate ids and exact duplicate non-DELETED names are 400 before SQL
            alt Invalid envelope/header/item/count/duplicate ids or names
                break Reject this whole request
                    app -> api: HTTP 400 E10001 item errors use roles[i]; request-level errors have no invented position
                    api -> page: Reject the whole batch; no partial results
                    page -> user: Display failure; no role action is reported as successful
                end break
            else Check passed
            end
            app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub and structured unique roleIds/name array
            alt Missing/invalid JWT or malformed roles
                break Reject this whole request
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Reject the whole batch; no partial results
                    page -> user: Display failure; no role action is reported as successful
                end break
            else Check passed
            end
            app -> app: callerUserId = verified sub; accessTokenHash = SHA-256 exact JWT; createdBy/updatedBy = caller UUID string
            app -> app: targetRoleIds = typed UUID[] of supplied canonical ids, empty for all inserts; omitted per-item id = typed SQL NULL
            app -> infra: BEGIN READ COMMITTED
            activate infra
            alt Work completes before commit
                note over app, infra
                    Unique-index collision, timeout or unexpected failure may interrupt a SQL/domain step, including a later item.
                    All earlier writes are provisional until the one final COMMIT; any failure rolls back every item.
                end note
                app -> infra: QUERY - Lock the caller user
                infra -> m_user: QUERY - Lock the caller user
                activate m_user
                    note right of m_user
                        SELECT
                            u.id as user_id
                        FROM authen.m_user u
                        WHERE u.id = '<sequence.callerUserId>'
                        FOR UPDATE
                    end note
                    m_user -> infra: Return locked caller user or no row
                deactivate m_user
                infra -> app: Return locked caller user or no row
                alt Caller user is missing
                    break Reject this whole request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Reject the whole batch; no partial results
                        page -> user: Display failure; no role action is reported as successful
                    end break
                else Check passed
                end
                app -> app: Capture fresh server UTC now after caller lock; recheck JWT exp
                alt JWT expired while waiting for caller lock
                    break Reject this whole request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Reject the whole batch; no partial results
                        page -> user: Display failure; no role action is reported as successful
                    end break
                else Check passed
                end
                app -> infra: QUERY - Check current credential and user
                infra -> t_user_access_token: QUERY - Check current credential and user
                activate t_user_access_token
                    note right of t_user_access_token
                        SELECT
                            at.id as access_token_id
                        FROM authen.t_user_access_token at
                        JOIN authen.m_user u ON u.id = at.user_id
                        WHERE at.token = '<sequence.accessTokenHash>'
                        AND at.user_id = '<sequence.callerUserId>'
                        AND at.row_status = 'ACTIVE'
                        AND at.expired_at > '<sequence.now>'
                        AND u.row_status = 'ACTIVE'
                    end note
                    t_user_access_token -> infra: Return ACTIVE matching unexpired token/user or no row
                deactivate t_user_access_token
                infra -> app: Return ACTIVE matching unexpired token/user or no row
                alt Current token/user missing/inactive/revoked/expired/mismatched
                    break Reject this whole request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Reject the whole batch; no partial results
                        page -> user: Display failure; no role action is reported as successful
                    end break
                else Check passed
                end
                app -> infra: QUERY - Lock existing roles
                infra -> m_role: QUERY - Lock existing roles
                activate m_role
                    note right of m_role
                        SELECT
                            r.id as role_id,
                            r.name
                        FROM author.m_role r
                        WHERE r.id = ANY ('<sequence.targetRoleIds>'::UUID[])
                        AND r.row_status <> 'DELETED' -- the id of a DELETED role counts as not found
                        ORDER BY r.id
                        FOR UPDATE
                    end note
                    m_role -> infra: Return all non-DELETED target role_id/name rows locked in ascending id order
                deactivate m_role
                infra -> app: Return all non-DELETED target role_id/name rows locked in ascending id order
                app -> app: Map locked roles by id; check all supplied target ids in original input order; choose first missing index i (empty target set is valid)
                alt Any supplied target id missing or DELETED after lock wait
                    break Reject this whole request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 404 E10004 roles[i]: Role not found.
                        api -> page: Reject the whole batch; no partial results
                        page -> user: Display failure; no role action is reported as successful
                    end break
                else Check passed
                end
                app -> app: Authorize once using only exact case-sensitive PLATFORM_ADMIN in verified JWT roles; never reload live grants
                alt No exact PLATFORM_ADMIN role claim
                    break Reject this whole request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 403 E10009 You do not have permission to manage roles. (no item position)
                        api -> page: Reject the whole batch; no partial results
                        page -> user: Display failure; no role action is reported as successful
                    end break
                else Check passed
                end
                loop For every roles[i] in original request order; all writes remain provisional
                    app -> app: currentIndex = i; bind this item fields and server audit/now; prior item writes are visible
                    alt This item id omitted (INSERT, including ARCHIVED)
                        app -> infra: QUERY - Check duplicate name
                        infra -> m_role: QUERY - Check duplicate name
                        activate m_role
                            note right of m_role
                                SELECT
                                    r.id as role_id
                                FROM author.m_role r
                                WHERE r.name = '<sequence.roles.name>'
                                AND r.row_status <> 'DELETED'
                                AND ('<sequence.roles.id>' IS NULL OR r.id <> '<sequence.roles.id>') -- omitted insert id is typed SQL NULL
                            end note
                            m_role -> infra: Return same-name non-DELETED role after preceding item writes, excluding optional current id
                        deactivate m_role
                        infra -> app: Return same-name non-DELETED role after preceding item writes, excluding optional current id
                        alt Another non-DELETED role holds this name
                            break Reject this whole request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10003 roles[i]: Role name already exists.
                                api -> page: Reject the whole batch; no partial results
                                page -> user: Display failure; no role action is reported as successful
                            end break
                        else Check passed
                        end
                        app -> infra: INSERT - Create role
                        infra -> m_role: INSERT - Create role
                        activate m_role
                            note right of m_role
                                INSERT INTO author.m_role (
                                    created_by,
                                    created_at,
                                    row_status,
                                    name,
                                    description
                                )
                                VALUES (
                                    &#39;<sequence.createdBy>',
                                    &#39;<sequence.now>',
                                    &#39;<sequence.roles.rowStatus>',
                                    &#39;<sequence.roles.name>',
                                    &#39;<sequence.roles.description>'
                                )
                                RETURNING id as role_id
                            end note
                            m_role -> infra: Return inserted role_id
                        deactivate m_role
                        infra -> app: Return inserted role_id
                        app -> app: Require exactly one inserted role_id; missing/malformed result is internal failure; action = INSERT
                    else This item id supplied (UPDATE, DELETE or ARCHIVE)
                        app -> infra: QUERY - Check system role
                        infra -> m_role: QUERY - Check system role
                        activate m_role
                            note right of m_role
                                SELECT
                                    r.id as role_id
                                FROM author.m_role r
                                WHERE r.id = '<sequence.roles.id>'
                                AND r.name = 'PLATFORM_ADMIN' -- the request is rejected (409) when a row is found, only when id is specified
                            end note
                            m_role -> infra: Return stored system-role target or no row
                        deactivate m_role
                        infra -> app: Return stored system-role target or no row
                        alt Stored target is PLATFORM_ADMIN
                            break Reject this whole request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10006 roles[i]: System role cannot be changed.
                                api -> page: Reject the whole batch; no partial results
                                page -> user: Display failure; no role action is reported as successful
                            end break
                        else Check passed
                        end
                        app -> infra: QUERY - Check duplicate name
                        infra -> m_role: QUERY - Check duplicate name
                        activate m_role
                            note right of m_role
                                SELECT
                                    r.id as role_id
                                FROM author.m_role r
                                WHERE r.name = '<sequence.roles.name>'
                                AND r.row_status <> 'DELETED'
                                AND ('<sequence.roles.id>' IS NULL OR r.id <> '<sequence.roles.id>') -- omitted insert id is typed SQL NULL
                            end note
                            m_role -> infra: Return same-name non-DELETED role after preceding item writes, excluding optional current id
                        deactivate m_role
                        infra -> app: Return same-name non-DELETED role after preceding item writes, excluding optional current id
                        alt Another non-DELETED role holds this name
                            break Reject this whole request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 409 E10003 roles[i]: Role name already exists.
                                api -> page: Reject the whole batch; no partial results
                                page -> user: Display failure; no role action is reported as successful
                            end break
                        else Check passed
                        end
                        alt Requested item rowStatus is DELETED or ARCHIVED
                            app -> infra: QUERY - Check user in use
                            infra -> t_user_role: QUERY - Check user in use
                            activate t_user_role
                                note right of t_user_role
                                    SELECT
                                        ur.id as user_role_id
                                    FROM author.t_user_role ur
                                    WHERE ur.role_id = '<sequence.roles.id>' -- only when rowStatus is DELETED or ARCHIVED
                                    AND ur.row_status <> 'DELETED'
                                end note
                                t_user_role -> infra: Return non-DELETED user binding or no row
                            deactivate t_user_role
                            infra -> app: Return non-DELETED user binding or no row
                            app -> infra: QUERY - Check role permission in use
                            infra -> t_role_permission: QUERY - Check role permission in use
                            activate t_role_permission
                                note right of t_role_permission
                                    SELECT
                                        rp.id as role_permission_id
                                    FROM author.t_role_permission rp
                                    WHERE rp.role_id = '<sequence.roles.id>' -- only when rowStatus is DELETED or ARCHIVED
                                    AND rp.row_status <> 'DELETED'
                                end note
                                t_role_permission -> infra: Return non-DELETED permission binding or no row
                            deactivate t_role_permission
                            infra -> app: Return non-DELETED permission binding or no row
                            alt Either non-DELETED binding exists
                                break Reject this whole request
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10006 roles[i]: Role is assigned to users or has permissions.
                                    api -> page: Reject the whole batch; no partial results
                                    page -> user: Display failure; no role action is reported as successful
                                end break
                            else Check passed
                            end
                        else Requested item rowStatus is ACTIVE, INACTIVE or LOCKED
                            app -> app: Preserve existing bindings; no in-use rejection for this status
                        end
                        app -> infra: UPDATE - Update or delete role
                        infra -> m_role: UPDATE - Update or delete role
                        activate m_role
                            note right of m_role
                                UPDATE author.m_role
                                SET
                                    updated_by = '<sequence.updatedBy>',
                                    updated_at = '<sequence.now>',
                                    row_status = '<sequence.roles.rowStatus>',
                                    name = '<sequence.roles.name>',
                                    description = '<sequence.roles.description>'
                                WHERE id = '<sequence.roles.id>'
                                AND row_status <> 'DELETED'
                                AND name <> 'PLATFORM_ADMIN'
                                RETURNING id as role_id
                            end note
                            m_role -> infra: Return guarded returned role_id or no row
                        deactivate m_role
                        infra -> app: Return guarded returned role_id or no row
                        alt Guarded UPDATE returned zero rows
                            break Reject this whole request
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 roles[i]: Role not found.
                                api -> page: Reject the whole batch; no partial results
                                page -> user: Display failure; no role action is reported as successful
                            end break
                        else Check passed
                        end
                        app -> app: Require exactly one returned role_id equal to this input id; mismatch is internal failure
                        app -> app: action = DELETE for DELETED, ARCHIVE for ARCHIVED, otherwise UPDATE
                    end
                    app -> app: Append exactly index=i, roleId from RETURNING and action to ordered results; do not emit per-item HTTP
                end
                app -> app: Require results count equals input count, original index order and unique returned roleIds; data = exactly roles array of index/roleId/action; map all before COMMIT
                app -> infra: COMMIT
                infra -> app: Return committed whole batch
                app -> api: HTTP 200 S10000 Batch Upsert Role Success; all ordered roles results including DELETE
                api -> page: Show all committed indexed actions
                page -> user: Display the entire saved batch
            else SQLSTATE 23505 from uq_m_role_name at currentIndex (concurrent collision)
                app -> infra: ROLLBACK
                app -> api: HTTP 409 E10003 roles[i]: Role name already exists. (i = currentIndex)
                api -> page: Reject the whole batch; no partial results
                page -> user: Display failure; no role action is reported as successful
            else Timeout before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 408 E90001
                api -> page: Reject the whole batch; no partial results
                page -> user: Display failure; no role action is reported as successful
            else Unexpected SQL/result/mapping failure before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 500 Internal Server Error; omit bizCode
                api -> page: Reject the whole batch; no partial results
                page -> user: Display failure; no role action is reported as successful
            end
            deactivate infra
        deactivate app
    deactivate api
deactivate page
@enduml
