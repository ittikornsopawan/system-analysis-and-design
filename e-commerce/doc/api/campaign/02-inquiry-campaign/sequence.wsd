@startuml InquiryCampaign Sequence

title Inquiry Campaign API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Campaign Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_shop" as m_shop
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "t_shop_user" as t_shop_user
    database "m_campaign" as m_campaign
    database "m_campaign_budget" as m_campaign_budget
    database "t_campaign_discount" as t_campaign_discount
    database "t_campaign_shop" as t_campaign_shop
    database "t_campaign_product" as t_campaign_product
end box

user -> page: Request the campaigns
activate page
    page -> api: GET v1/campaign
    activate api
        api -> app: [**InquiryCampaignQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters: pageSize 1 to 100, shopId is a UUID, activeOnly is a boolean
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: Execute database operations
                    activate infra
                    alt Work completes
                        alt shopId is specified
                            app -> infra: QUERY - Check shop
                            infra -> m_shop: QUERY - Check shop
                            activate m_shop
                                note right of m_shop
                                    SELECT
                                        s.id as shop_id
                                    FROM shop.m_shop s
                                    WHERE s.id = '<sequence.shopId>'
                                    AND s.row_status <> 'DELETED'
                                end note
                                m_shop -> infra: Return query result
                            deactivate m_shop
                            infra -> app: Return the shop or no row
                            alt Shop not found or DELETED
                                app -> api: HTTP 404 E10005 Shop not found.
                                api -> page: Not found
                                page -> user: Display the shop is not found
                            end
                        end
                        app -> infra: QUERY - Get the platform administrator role
                        infra -> m_role: QUERY - Get the platform administrator role
                        activate m_role
                            note right of m_role
                                SELECT
                                    r.id as role_id
                                FROM author.m_role r
                                WHERE r.name = 'PLATFORM_ADMIN'
                                AND r.row_status = 'ACTIVE'
                            end note
                            m_role -> infra: Return query result
                        deactivate m_role
                        infra -> app: Return the role id
                        app -> infra: QUERY - Check platform administrator
                        infra -> t_user_role: QUERY - Check platform administrator
                        activate t_user_role
                            note right of t_user_role
                                SELECT
                                    ur.id as user_role_id
                                FROM author.t_user_role ur
                                WHERE ur.user_id = '<sequence.userId>'
                                AND ur.role_id = '<sequence.roleId>'
                                AND ur.row_status = 'ACTIVE'
                            end note
                            t_user_role -> infra: Return query result
                        deactivate t_user_role
                        infra -> app: Return the assignment or no row
                        alt The caller is not a platform administrator
                            alt shopId is not specified
                                app -> api: HTTP 403 E10009 Only a platform administrator or a member of the shop can read the campaigns.
                                api -> page: Forbidden
                                page -> user: Display no permission
                            end
                            app -> infra: QUERY - Check shop member
                            infra -> t_shop_user: QUERY - Check shop member
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.shop_id
                                    FROM shop.t_shop_user su
                                    WHERE su.shop_id = '<sequence.shopId>'
                                    AND su.user_id = '<sequence.userId>'
                                    AND su.role IN ('ADMIN', 'STAFF')
                                    AND su.row_status = 'ACTIVE'
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return the ACTIVE ADMIN or STAFF row of the caller or no row
                            alt The caller is not a member of the shop
                                app -> api: HTTP 403 E10009 Only a platform administrator or a member of the shop can read the campaigns.
                                api -> page: Forbidden
                                page -> user: Display no permission
                            end
                        end
                        app -> infra: QUERY - Get the campaigns
                        infra -> m_campaign: QUERY - Get the campaigns
                        activate m_campaign
                            note right of m_campaign
                                SELECT
                                    c.id as campaign_id,
                                    c.name,
                                    c.description,
                                    c.start_at,
                                    c.end_at,
                                    c.row_status
                                FROM campaign.m_campaign c
                                WHERE c.row_status <> 'DELETED'
                                AND c.id = '<sequence.id>' -- only when id is specified
                                AND c.row_status = '<sequence.status>' -- only when status is specified
                                AND c.row_status = 'ACTIVE' AND c.start_at <= NOW() AT TIME ZONE 'UTC' AND NOW() AT TIME ZONE 'UTC' < c.end_at -- only when activeOnly is true
                                AND c.name ILIKE '%<sequence.search>%' -- only when search is specified
                                AND (EXISTS (
                                        SELECT 1
                                        FROM campaign.t_campaign_shop cs
                                        WHERE cs.campaign_id = c.id
                                        AND cs.shop_id = '<sequence.shopId>'
                                        AND cs.row_status = 'ACTIVE'
                                    ) OR NOT EXISTS (
                                        SELECT 1
                                        FROM campaign.t_campaign_shop cs
                                        WHERE cs.campaign_id = c.id
                                        AND cs.row_status = 'ACTIVE'
                                    )) -- only when the caller is not a platform administrator
                                ORDER BY c.start_at DESC, c.id
                                LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                            end note
                            m_campaign -> infra: Return query result
                        deactivate m_campaign
                        infra -> app: Return the page of campaigns (all for an administrator, those that apply to the shop for a member)
                        app -> infra: QUERY - Count the campaigns
                        infra -> m_campaign: QUERY - Count the campaigns
                        activate m_campaign
                            note right of m_campaign
                                SELECT
                                    COUNT(c.id) as total_items
                                FROM campaign.m_campaign c
                                WHERE c.row_status <> 'DELETED'
                                AND c.id = '<sequence.id>' -- only when id is specified
                                AND c.row_status = '<sequence.status>' -- only when status is specified
                                AND c.row_status = 'ACTIVE' AND c.start_at <= NOW() AT TIME ZONE 'UTC' AND NOW() AT TIME ZONE 'UTC' < c.end_at -- only when activeOnly is true
                                AND c.name ILIKE '%<sequence.search>%' -- only when search is specified
                                AND (EXISTS (
                                        SELECT 1
                                        FROM campaign.t_campaign_shop cs
                                        WHERE cs.campaign_id = c.id
                                        AND cs.shop_id = '<sequence.shopId>'
                                        AND cs.row_status = 'ACTIVE'
                                    ) OR NOT EXISTS (
                                        SELECT 1
                                        FROM campaign.t_campaign_shop cs
                                        WHERE cs.campaign_id = c.id
                                        AND cs.row_status = 'ACTIVE'
                                    )) -- only when the caller is not a platform administrator
                            end note
                            m_campaign -> infra: Return query result
                        deactivate m_campaign
                        infra -> app: Return total_items
                        alt No campaign matches
                            app -> api: HTTP 200 S10000
                            api -> page: Return an empty list
                            page -> user: Display no campaign
                        else Campaigns found
                            app -> infra: QUERY - Get the budgets of the campaigns
                            infra -> m_campaign_budget: QUERY - Get the budgets of the campaigns
                            activate m_campaign_budget
                                note right of m_campaign_budget
                                    SELECT
                                        b.id as budget_id,
                                        b.campaign_id,
                                        b.budget,
                                        b.remaining,
                                        (b.budget - b.remaining) as used,
                                        b.row_status -- returned only to a platform administrator
                                    FROM campaign.m_campaign_budget b
                                    WHERE b.campaign_id IN ('<sequence.campaignIds>')
                                    AND b.row_status <> 'DELETED'
                                end note
                                m_campaign_budget -> infra: Return query result
                            deactivate m_campaign_budget
                            infra -> app: Return the budgets and what is left
                            app -> infra: QUERY - Get the discounts of the campaigns
                            infra -> t_campaign_discount: QUERY - Get the discounts of the campaigns
                            activate t_campaign_discount
                                note right of t_campaign_discount
                                    SELECT
                                        d.id as discount_id,
                                        d.campaign_id,
                                        d.discount_type,
                                        d.discount_value,
                                        d.row_status
                                    FROM campaign.t_campaign_discount d
                                    WHERE d.campaign_id IN ('<sequence.campaignIds>')
                                    AND d.row_status <> 'DELETED'
                                end note
                                t_campaign_discount -> infra: Return query result
                            deactivate t_campaign_discount
                            infra -> app: Return the discounts
                            app -> infra: QUERY - Get the shops of the campaigns
                            infra -> t_campaign_shop: QUERY - Get the shops of the campaigns
                            activate t_campaign_shop
                                note right of t_campaign_shop
                                    SELECT
                                        cs.id as campaign_shop_id,
                                        cs.campaign_id,
                                        cs.shop_id,
                                        cs.row_status -- returned only to a platform administrator
                                    FROM campaign.t_campaign_shop cs
                                    WHERE cs.campaign_id IN ('<sequence.campaignIds>')
                                    AND cs.row_status <> 'DELETED'
                                    ORDER BY cs.created_at, cs.id
                                end note
                                t_campaign_shop -> infra: Return query result
                            deactivate t_campaign_shop
                            infra -> app: Return the shops of the campaigns
                            app -> infra: QUERY - Get the products of the campaigns
                            infra -> t_campaign_product: QUERY - Get the products of the campaigns
                            activate t_campaign_product
                                note right of t_campaign_product
                                    SELECT
                                        cp.id as campaign_product_id,
                                        cp.campaign_id,
                                        cp.product_category_id,
                                        cp.product_id,
                                        cp.row_status
                                    FROM campaign.t_campaign_product cp
                                    WHERE cp.campaign_id IN ('<sequence.campaignIds>')
                                    AND cp.row_status <> 'DELETED'
                                    ORDER BY cp.created_at, cp.id
                                end note
                                t_campaign_product -> infra: Return query result
                            deactivate t_campaign_product
                            infra -> app: Return the products and categories of the campaigns
                            app -> domain: Build the campaigns: budget, remaining and the shop list only for a platform administrator (null for a member of a shop)
                            activate domain
                            domain -> app: Return the campaigns and the paging
                            deactivate domain
                            app -> api: HTTP 200 S10000
                            api -> page: Return the campaigns
                            page -> user: Display the campaigns
                        end
                    else Timeout
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
