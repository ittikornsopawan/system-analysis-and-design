@startuml InquiryCampaignLedger Sequence

title Inquiry Campaign Ledger API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Campaign Ledger Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_campaign" as m_campaign
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "m_campaign_budget_ledger" as m_campaign_budget_ledger
end box

user -> page: Request the ledger of a campaign
activate page
    page -> api: GET v1/campaign/ledger
    activate api
        api -> app: [**InquiryCampaignLedgerQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters: campaignId is a required UUID, pageSize 1 to 100
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    note over app, infra
                        - Execution order: validate the request (400) -> existence of the campaign (404) -> permission (403) -> read.
                    end note
                    app -> infra: Execute database operations
                    activate infra
                    alt Work completes
                        app -> infra: QUERY - Check campaign
                        infra -> m_campaign: QUERY - Check campaign
                        activate m_campaign
                            note right of m_campaign
                                SELECT
                                    c.id as campaign_id
                                FROM campaign.m_campaign c
                                WHERE c.id = '<sequence.campaignId>'
                                AND c.row_status <> 'DELETED'
                            end note
                            m_campaign -> infra: Return query result
                        deactivate m_campaign
                        infra -> app: Return the campaign or no row
                        alt Campaign not found or DELETED
                            app -> api: HTTP 404 E10004 Campaign not found.
                            api -> page: Not found
                            page -> user: Display the campaign is not found
                        else Campaign found
                            app -> infra: QUERY - Get the platform administrator role
                            infra -> m_role: QUERY - Get the platform administrator role
                            activate m_role
                                note right of m_role
                                    SELECT
                                        r.id as role_id
                                    FROM author.m_role r
                                    WHERE r.name = 'PLATFORM_ADMIN'
                                    AND r.row_status = 'ACTIVE'
                                end note
                                m_role -> infra: Return query result
                            deactivate m_role
                            infra -> app: Return the role id
                            app -> infra: QUERY - Check platform administrator
                            infra -> t_user_role: QUERY - Check platform administrator
                            activate t_user_role
                                note right of t_user_role
                                    SELECT
                                        ur.id as user_role_id
                                    FROM author.t_user_role ur
                                    WHERE ur.user_id = '<sequence.userId>'
                                    AND ur.role_id = '<sequence.roleId>'
                                    AND ur.row_status = 'ACTIVE'
                                end note
                                t_user_role -> infra: Return query result
                            deactivate t_user_role
                            infra -> app: Return the assignment or no row
                            alt The caller is not a platform administrator
                                app -> api: HTTP 403 E10009 Only a platform administrator can read the ledger of a campaign.
                                api -> page: Forbidden
                                page -> user: Display no permission
                            else The caller is a platform administrator
                                app -> infra: QUERY - Get the ledger entries
                                infra -> m_campaign_budget_ledger: QUERY - Get the ledger entries
                                activate m_campaign_budget_ledger
                                    note right of m_campaign_budget_ledger
                                        SELECT
                                            l.id as ledger_id,
                                            l.campaign_budget_id,
                                            l.campaign_id,
                                            l.order_id,
                                            l.entry_type,
                                            l.usage,
                                            l.remaining,
                                            l.reference,
                                            l.created_at
                                        FROM campaign.m_campaign_budget_ledger l
                                        WHERE l.campaign_id = '<sequence.campaignId>'
                                        AND l.entry_type = '<sequence.entryType>' -- only when entryType is specified
                                        AND l.order_id = '<sequence.orderId>' -- only when orderId is specified
                                        ORDER BY l.created_at DESC, l.id
                                        LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                                    end note
                                    m_campaign_budget_ledger -> infra: Return query result
                                deactivate m_campaign_budget_ledger
                                infra -> app: Return the page of ledger entries, newest first
                                app -> infra: QUERY - Count the ledger entries
                                infra -> m_campaign_budget_ledger: QUERY - Count the ledger entries
                                activate m_campaign_budget_ledger
                                    note right of m_campaign_budget_ledger
                                        SELECT
                                            COUNT(l.id) as total_items
                                        FROM campaign.m_campaign_budget_ledger l
                                        WHERE l.campaign_id = '<sequence.campaignId>'
                                        AND l.entry_type = '<sequence.entryType>' -- only when entryType is specified
                                        AND l.order_id = '<sequence.orderId>' -- only when orderId is specified
                                    end note
                                    m_campaign_budget_ledger -> infra: Return query result
                                deactivate m_campaign_budget_ledger
                                infra -> app: Return total_items
                                alt No ledger entry
                                    app -> api: HTTP 200 S10000
                                    api -> page: Return an empty list
                                    page -> user: Display no entry
                                else Entries found
                                    app -> api: HTTP 200 S10000
                                    api -> page: Return the ledger entries
                                    page -> user: Display the ledger
                                end
                            end
                        end
                    else Timeout
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
