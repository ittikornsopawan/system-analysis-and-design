@startuml InquiryProduct Sequence

title Inquiry Product API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Product Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_product" as m_product
    database "m_product_type" as m_product_type
    database "m_product_category" as m_product_category
    database "m_product_brand" as m_product_brand
    database "m_product_attribute" as m_product_attribute
    database "m_product_category_attribute" as m_product_category_attribute
    database "m_product_image" as m_product_image
    database "m_product_option" as m_product_option
    database "m_product_option_value" as m_product_option_value
    database "m_product_sku" as m_product_sku
    database "m_product_sku_option_value" as m_product_sku_option_value
end box

user -> page: Request Inquiry Product
activate page
    page -> api: GET v1/product
    activate api
        api -> app: [**InquiryProductQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify the access token (signature and expiry)
                alt Access token is missing, invalid or expired
                    app -> api: HTTP 401 E10002
                    api -> page: Unauthorized
                    page -> user: Display unauthorized error
                else Access token is valid
                    app -> infra: Execute database operations
                    activate infra
                        app -> infra: QUERY - Get products
                        infra -> m_product: QUERY - Get products
                        activate m_product
                            note right of m_product
                                SELECT
                                    p.id as product_id,
                                    p.type_id,
                                    p.category_id,
                                    p.brand_id,
                                    p.name,
                                    p.slug,
                                    p.description,
                                    p.body,
                                    p.row_status
                                FROM product.m_product p
                                WHERE p.row_status <> 'DELETED'
                                AND p.id = '<sequence.id>' -- only when id is specified
                                AND p.category_id = '<sequence.categoryId>' -- only when categoryId is specified
                                AND (p.name ILIKE '%<sequence.search>%' OR p.description ILIKE '%<sequence.search>%') -- only when search is specified
                                ORDER BY p.created_at DESC
                                LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                            end note
                            m_product -> infra: Return query result
                        deactivate m_product
                        infra -> app: Return result of Get products
                        app -> infra: QUERY - Get total items
                        infra -> m_product: QUERY - Get total items
                        activate m_product
                            note right of m_product
                                SELECT
                                    COUNT(p.id) as total_items
                                FROM product.m_product p
                                WHERE p.row_status <> 'DELETED'
                                AND p.id = '<sequence.id>' -- only when id is specified
                                AND p.category_id = '<sequence.categoryId>' -- only when categoryId is specified
                                AND (p.name ILIKE '%<sequence.search>%' OR p.description ILIKE '%<sequence.search>%') -- only when search is specified
                            end note
                            m_product -> infra: Return query result
                        deactivate m_product
                        infra -> app: Return result of Get total items
                    deactivate infra
                    alt No product matches the filters
                        app -> domain: Prepare the response with empty items
                        activate domain
                            domain -> app: Return response data
                        deactivate domain
                        app -> api: HTTP 200 S10000
                        api -> page: Return success response
                        page -> user: Display success result
                    else Products found
                        app -> infra: Execute database operations
                        activate infra
                            app -> infra: QUERY - Get product type
                            infra -> m_product_type: QUERY - Get product type
                            activate m_product_type
                                note right of m_product_type
                                    SELECT
                                        pt.id as type_id,
                                        pt.name as type_name
                                    FROM product.m_product_type pt
                                    WHERE pt.id IN ('<sequence.typeIds>')
                                end note
                                m_product_type -> infra: Return query result
                            deactivate m_product_type
                            infra -> app: Return result of Get product type
                            app -> infra: QUERY - Get product category
                            infra -> m_product_category: QUERY - Get product category
                            activate m_product_category
                                note right of m_product_category
                                    SELECT
                                        pc.id as category_id,
                                        pc.name as category_name
                                    FROM product.m_product_category pc
                                    WHERE pc.id IN ('<sequence.categoryIds>')
                                end note
                                m_product_category -> infra: Return query result
                            deactivate m_product_category
                            infra -> app: Return result of Get product category
                            app -> infra: QUERY - Get product brand
                            infra -> m_product_brand: QUERY - Get product brand
                            activate m_product_brand
                                note right of m_product_brand
                                    SELECT
                                        pb.id as brand_id,
                                        pb.name as brand_name
                                    FROM product.m_product_brand pb
                                    WHERE pb.id IN ('<sequence.brandIds>')
                                end note
                                m_product_brand -> infra: Return query result
                            deactivate m_product_brand
                            infra -> app: Return result of Get product brand
                            app -> infra: QUERY - Get product attributes
                            infra -> m_product_attribute: QUERY - Get product attributes
                            activate m_product_attribute
                                note right of m_product_attribute
                                    SELECT
                                        pa.product_id,
                                        pa.attribute_id,
                                        pa.value
                                    FROM product.m_product_attribute pa
                                    WHERE pa.product_id IN ('<sequence.productIds>')
                                    AND pa.row_status = 'ACTIVE'
                                    ORDER BY pa.created_at
                                end note
                                m_product_attribute -> infra: Return query result
                            deactivate m_product_attribute
                            infra -> app: Return result of Get product attributes
                            app -> infra: QUERY - Get product category attribute
                            infra -> m_product_category_attribute: QUERY - Get product category attribute
                            activate m_product_category_attribute
                                note right of m_product_category_attribute
                                    SELECT
                                        pca.id as attribute_id,
                                        pca.name as attribute_name
                                    FROM product.m_product_category_attribute pca
                                    WHERE pca.id IN ('<sequence.attributeIds>')
                                end note
                                m_product_category_attribute -> infra: Return query result
                            deactivate m_product_category_attribute
                            infra -> app: Return result of Get product category attribute
                            app -> infra: QUERY - Get product images
                            infra -> m_product_image: QUERY - Get product images
                            activate m_product_image
                                note right of m_product_image
                                    SELECT
                                        pi.id as image_id,
                                        pi.product_id,
                                        pi.image_path
                                    FROM product.m_product_image pi
                                    WHERE pi.product_id IN ('<sequence.productIds>')
                                    AND pi.option_value_id IS NULL
                                    AND pi.row_status = 'ACTIVE'
                                    ORDER BY pi.created_at
                                end note
                                m_product_image -> infra: Return query result
                            deactivate m_product_image
                            infra -> app: Return result of Get product images
                            app -> infra: QUERY - Get product options
                            infra -> m_product_option: QUERY - Get product options
                            activate m_product_option
                                note right of m_product_option
                                    SELECT
                                        po.id as option_id,
                                        po.product_id,
                                        po.name,
                                        po.level_no
                                    FROM product.m_product_option po
                                    WHERE po.product_id IN ('<sequence.productIds>')
                                    AND po.row_status = 'ACTIVE'
                                    ORDER BY po.level_no
                                end note
                                m_product_option -> infra: Return query result
                            deactivate m_product_option
                            infra -> app: Return result of Get product options
                            app -> infra: QUERY - Get product option values
                            infra -> m_product_option_value: QUERY - Get product option values
                            activate m_product_option_value
                                note right of m_product_option_value
                                    SELECT
                                        pov.id as value_id,
                                        pov.option_id,
                                        pov.value,
                                        pov.sort_order,
                                        pov.row_status
                                    FROM product.m_product_option_value pov
                                    WHERE pov.option_id IN ('<sequence.optionIds>')
                                    AND pov.row_status <> 'DELETED'
                                    ORDER BY pov.sort_order
                                end note
                                m_product_option_value -> infra: Return query result
                            deactivate m_product_option_value
                            infra -> app: Return result of Get product option values
                            app -> infra: QUERY - Get product option value images
                            infra -> m_product_image: QUERY - Get product option value images
                            activate m_product_image
                                note right of m_product_image
                                    SELECT
                                        pi.id as image_id,
                                        pi.option_value_id,
                                        pi.image_path
                                    FROM product.m_product_image pi
                                    WHERE pi.option_value_id IN ('<sequence.valueIds>')
                                    AND pi.row_status = 'ACTIVE'
                                    ORDER BY pi.created_at
                                end note
                                m_product_image -> infra: Return query result
                            deactivate m_product_image
                            infra -> app: Return result of Get product option value images
                            app -> infra: QUERY - Get product SKUs
                            infra -> m_product_sku: QUERY - Get product SKUs
                            activate m_product_sku
                                note right of m_product_sku
                                    SELECT
                                        ps.id as sku_id,
                                        ps.product_id,
                                        ps.name,
                                        ps.combination_key,
                                        ps.row_status
                                    FROM product.m_product_sku ps
                                    WHERE ps.product_id IN ('<sequence.productIds>')
                                    AND ps.row_status <> 'DELETED'
                                    ORDER BY ps.created_at, ps.combination_key
                                end note
                                m_product_sku -> infra: Return query result
                            deactivate m_product_sku
                            infra -> app: Return result of Get product SKUs
                            app -> infra: QUERY - Get product SKU option values
                            infra -> m_product_sku_option_value: QUERY - Get product SKU option values
                            activate m_product_sku_option_value
                                note right of m_product_sku_option_value
                                    SELECT
                                        psov.sku_id,
                                        psov.option_value_id
                                    FROM product.m_product_sku_option_value psov
                                    JOIN product.m_product_option_value pov ON pov.id = psov.option_value_id
                                    JOIN product.m_product_option po ON po.id = pov.option_id
                                    WHERE psov.sku_id IN ('<sequence.skuIds>')
                                    AND psov.row_status <> 'DELETED'
                                    ORDER BY psov.sku_id, po.level_no
                                end note
                                m_product_sku_option_value -> infra: Return query result
                            deactivate m_product_sku_option_value
                            infra -> app: Return result of Get product SKU option values
                        deactivate infra
                        alt Processing times out
                            app -> api: HTTP 408 E90001
                            api -> page: Request timeout
                            page -> user: Display timeout error
                        else Processing completes in time
                            app -> domain: Apply domain rules and prepare response
                            activate domain
                                domain -> app: Return response data
                            deactivate domain
                            app -> api: HTTP 200 S10000
                            api -> page: Return success response
                            page -> user: Display success result
                        end
                    end
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
