@startuml UpsertProductCategoryAttributeBatch Sequence

title Upsert Product Category Attribute Batch API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Product Category Attribute Batch Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_product_category" as m_product_category
    database "m_product_category_attribute" as m_product_category_attribute
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "m_product_attribute" as m_product_attribute
end box

user -> page: Submit Upsert Product Category Attribute Batch
activate page
    page -> api: POST v1/product-category-attribute/upsert/batch
    activate api
        api -> app: [**UpsertProductCategoryAttributeBatchCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature/issuer/audience/exp/UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Display authentication error
                else Verified JWT
                    app -> app: userId = verified sub
                    note over app, infra
                        Permission: the same as the single upsert, only a platform administrator (a user with an ACTIVE author.t_user_role row for the ACTIVE role PLATFORM_ADMIN) can call this API, any other caller gets 403 (E10009).
                        The check is made once for the request, after the existence checks of all items and before the duplicate, in-use and other conflict checks, so the 403 message has no item position.
                        Order of checks: validate the request (400) -> existence checks (404) -> permission (403, E10009) -> duplicate, in-use and other conflicts (409) -> write -> COMMIT.
                    end note
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                            app -> infra: QUERY - Check product categories
                            infra -> m_product_category: QUERY - Check product categories
                            activate m_product_category
                                note right of m_product_category
                                    SELECT
                                        pc.id as category_id
                                    FROM product.m_product_category pc
                                    WHERE pc.id IN ('<sequence.attributes.categoryIds>')
                                    AND pc.row_status = 'ACTIVE'
                                end note
                                m_product_category -> infra: Return query result
                            deactivate m_product_category
                            infra -> app: Return result of Check product categories
                            alt items[i]: product category not found or not ACTIVE
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10005 items[i]: Product category not found.
                                api -> page: Not found
                                page -> user: Display error message
                            end
                            app -> infra: QUERY - Check existing attributes
                            infra -> m_product_category_attribute: QUERY - Check existing attributes
                            activate m_product_category_attribute
                                note right of m_product_category_attribute
                                    SELECT
                                        pca.id as attribute_id,
                                        pca.category_id
                                    FROM product.m_product_category_attribute pca
                                    WHERE pca.id IN ('<sequence.attributes.ids>')
                                end note
                                m_product_category_attribute -> infra: Return query result
                            deactivate m_product_category_attribute
                            infra -> app: Return result of Check existing attributes
                            alt items[i]: attribute not found
                                app -> infra: ROLLBACK
                                app -> api: HTTP 404 E10004 items[i]: Product category attribute not found.
                                api -> page: Not found
                                page -> user: Display error message
                            end
                            app -> infra: QUERY - Get the platform administrator role
                            infra -> m_role: QUERY - Get the platform administrator role
                            activate m_role
                                note right of m_role
                                    SELECT
                                        r.id as role_id
                                    FROM author.m_role r
                                    WHERE r.name = 'PLATFORM_ADMIN'
                                    AND r.row_status = 'ACTIVE'
                                end note
                                m_role -> infra: Return query result
                            deactivate m_role
                            infra -> app: Return result of Get the platform administrator role
                            app -> infra: QUERY - Check platform administrator
                            infra -> t_user_role: QUERY - Check platform administrator
                            activate t_user_role
                                note right of t_user_role
                                    SELECT
                                        ur.id as user_role_id
                                    FROM author.t_user_role ur
                                    WHERE ur.user_id = '<sequence.userId>'
                                    AND ur.role_id = '<sequence.roleId>'
                                    AND ur.row_status = 'ACTIVE'
                                end note
                                t_user_role -> infra: Return query result
                            deactivate t_user_role
                            infra -> app: Return result of Check platform administrator
                            alt No ACTIVE PLATFORM_ADMIN role or the caller does not hold it
                                app -> infra: ROLLBACK
                                app -> api: HTTP 403 E10009 You do not have permission to manage product category attributes.
                                api -> page: Forbidden
                                page -> user: Display error message
                            end
                            loop For each item (request order, one transaction)
                                app -> infra: QUERY - Check duplicate name
                                infra -> m_product_category_attribute: QUERY - Check duplicate name
                                activate m_product_category_attribute
                                    note right of m_product_category_attribute
                                        SELECT
                                            pca.id as attribute_id
                                        FROM product.m_product_category_attribute pca
                                        WHERE pca.name = '<sequence.attributes.name>'
                                        AND pca.id <> '<sequence.attributes.id>' -- only when id is specified
                                    end note
                                    m_product_category_attribute -> infra: Return query result
                                deactivate m_product_category_attribute
                                infra -> app: Return result of Check duplicate name
                                alt items[i]: name is held by another attribute of the category
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10003 items[i]: Attribute name already exists.
                                    api -> page: Conflict
                                    page -> user: Display error message
                                end
                                alt rowStatus is DELETED or ARCHIVED
                                    app -> infra: QUERY - Check attributes in use
                                    infra -> m_product_attribute: QUERY - Check attributes in use
                                    activate m_product_attribute
                                        note right of m_product_attribute
                                            SELECT
                                                pa.id as product_attribute_id
                                            FROM product.m_product_attribute pa
                                            WHERE pa.attribute_id IN ('<sequence.attributes.ids>')
                                            AND pa.row_status <> 'DELETED'
                                        end note
                                        m_product_attribute -> infra: Return query result
                                    deactivate m_product_attribute
                                    infra -> app: Return result of Check attributes in use
                                    alt items[i]: a product uses the attribute
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10006 items[i]: Attribute is used by products.
                                        api -> page: Conflict
                                        page -> user: Display error message
                                    end
                                end
                                alt id is not specified (insert)
                                    app -> infra: INSERT - Create attribute
                                    infra -> m_product_category_attribute: INSERT - Create attribute
                                    activate m_product_category_attribute
                                        note right of m_product_category_attribute
                                            INSERT INTO product.m_product_category_attribute (
                                                created_by,
                                                row_status,
                                                category_id,
                                                name,
                                                description
                                            )
                                            VALUES (
                                                &#39;<sequence.createdBy>',
                                                &#39;<sequence.attributes.rowStatus>',
                                                &#39;<sequence.attributes.categoryId>',
                                                &#39;<sequence.attributes.name>',
                                                &#39;<sequence.attributes.description>'
                                            )
                                            RETURNING id as attribute_id
                                        end note
                                        m_product_category_attribute -> infra: Return inserted result
                                    deactivate m_product_category_attribute
                                    infra -> app: Return result of Create attribute
                                else id is specified (update, delete or archive)
                                    app -> infra: UPDATE - Update or delete attribute
                                    infra -> m_product_category_attribute: UPDATE - Update or delete attribute
                                    activate m_product_category_attribute
                                        note right of m_product_category_attribute
                                            UPDATE product.m_product_category_attribute
                                            SET
                                                updated_by = '<sequence.updatedBy>',
                                                updated_at = NOW() AT TIME ZONE 'UTC',
                                                row_status = '<sequence.attributes.rowStatus>',
                                                category_id = '<sequence.attributes.categoryId>',
                                                name = '<sequence.attributes.name>',
                                                description = '<sequence.attributes.description>'
                                            WHERE id = '<sequence.attributes.id>'
                                            RETURNING id as attribute_id
                                        end note
                                        m_product_category_attribute -> infra: Return updated result
                                    deactivate m_product_category_attribute
                                    infra -> app: Return result of Update or delete attribute
                                end
                            end
                            app -> infra: COMMIT
                            app -> api: HTTP 200 S10000 with the result of every item
                            api -> page: Return committed result
                            page -> user: Display success result
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
