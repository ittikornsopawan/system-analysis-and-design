@startuml InquiryProductType Sequence

title Inquiry Product Type API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Product Type Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_product_type" as m_product_type
end box

user -> page: Request Inquiry Product Type
activate page
    page -> api: GET v1/product-type
    activate api
        api -> app: [**InquiryProductTypeQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify the access token (signature and expiry)
                alt Access token is missing, invalid or expired
                    app -> api: HTTP 401 E10002
                    api -> page: Unauthorized
                    page -> user: Display unauthorized error
                else Access token is valid
                    app -> infra: Execute database operations
                    activate infra
                        app -> infra: QUERY - Get product types
                        infra -> m_product_type: QUERY - Get product types
                        activate m_product_type
                            note right of m_product_type
                                SELECT
                                    pt.id as product_type_id,
                                    pt.name,
                                    pt.description,
                                    pt.row_status
                                FROM product.m_product_type pt
                                WHERE pt.row_status <> 'DELETED'
                                AND pt.id = '<sequence.id>' -- only when id is specified
                                AND (pt.name ILIKE '%<sequence.search>%' OR pt.description ILIKE '%<sequence.search>%') -- only when search is specified
                                AND pt.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                                ORDER BY pt.created_at DESC, pt.id
                                LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                            end note
                            m_product_type -> infra: Return query result
                        deactivate m_product_type
                        infra -> app: Return result of Get product types
                        app -> infra: QUERY - Get total items
                        infra -> m_product_type: QUERY - Get total items
                        activate m_product_type
                            note right of m_product_type
                                SELECT
                                    COUNT(pt.id) as total_items
                                FROM product.m_product_type pt
                                WHERE pt.row_status <> 'DELETED'
                                AND pt.id = '<sequence.id>' -- only when id is specified
                                AND (pt.name ILIKE '%<sequence.search>%' OR pt.description ILIKE '%<sequence.search>%') -- only when search is specified
                                AND pt.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                            end note
                            m_product_type -> infra: Return query result
                        deactivate m_product_type
                        infra -> app: Return result of Get total items
                    deactivate infra
                    alt Processing times out
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Display timeout error
                    else Processing completes in time
                        app -> domain: Apply domain rules and prepare response
                        activate domain
                            domain -> app: Return response data
                        deactivate domain
                        app -> api: HTTP 200 S10000
                        api -> page: Return success response
                        page -> user: Display success result
                    end
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
