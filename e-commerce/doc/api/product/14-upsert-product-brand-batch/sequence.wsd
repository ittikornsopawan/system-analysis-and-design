@startuml UpsertProductBrandBatch Sequence

title Upsert Product Brand Batch API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Product Brand Batch Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_product_brand" as m_product_brand
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "m_product" as m_product
end box

user -> page: Submit Upsert Product Brand Batch
activate page
    page -> api: POST v1/product-brand/upsert/batch
    activate api
        api -> app: [**UpsertProductBrandBatchCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature/issuer/audience/exp/UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Display authentication error
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                            loop For each item that has an id (request order)
                                app -> infra: QUERY - Check existing product brand
                                infra -> m_product_brand: QUERY - Check existing product brand
                                activate m_product_brand
                                    note right of m_product_brand
                                        SELECT
                                            pb.id as product_brand_id
                                        FROM product.m_product_brand pb
                                        WHERE pb.id = '<sequence.productBrands.id>'
                                        AND pb.row_status <> 'DELETED' -- the id of a DELETED product brand counts as not found
                                    end note
                                    m_product_brand -> infra: Return query result
                                deactivate m_product_brand
                                infra -> app: Return result of Check existing product brand
                                alt items[i]: product brand not found or DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10004 items[i]: Product brand not found.
                                    api -> page: Not found
                                    page -> user: Display error message
                                end
                            end
                            app -> infra: QUERY - Get the platform administrator role
                            infra -> m_role: QUERY - Get the platform administrator role
                            activate m_role
                                note right of m_role
                                    SELECT
                                        r.id as role_id
                                    FROM author.m_role r
                                    WHERE r.name = 'PLATFORM_ADMIN'
                                    AND r.row_status = 'ACTIVE'
                                end note
                                m_role -> infra: Return query result
                            deactivate m_role
                            infra -> app: Return result of Get the platform administrator role
                            app -> infra: QUERY - Check platform administrator
                            infra -> t_user_role: QUERY - Check platform administrator
                            activate t_user_role
                                note right of t_user_role
                                    SELECT
                                        ur.id as user_role_id
                                    FROM author.t_user_role ur
                                    WHERE ur.user_id = '<sequence.userId>'
                                    AND ur.role_id = '<sequence.roleId>'
                                    AND ur.row_status = 'ACTIVE'
                                end note
                                t_user_role -> infra: Return query result
                            deactivate t_user_role
                            infra -> app: Return result of Check platform administrator
                            alt No ACTIVE PLATFORM_ADMIN role or the caller does not hold it
                                app -> infra: ROLLBACK
                                app -> api: HTTP 403 E10009 You do not have permission to manage product brands.
                                api -> page: Forbidden
                                page -> user: Display error message
                            end
                            loop For each item (request order, one transaction)
                                app -> infra: QUERY - Check duplicate name
                                infra -> m_product_brand: QUERY - Check duplicate name
                                activate m_product_brand
                                    note right of m_product_brand
                                        SELECT
                                            pb.id as product_brand_id
                                        FROM product.m_product_brand pb
                                        WHERE pb.name = '<sequence.productBrands.name>'
                                        AND pb.row_status <> 'DELETED'
                                        AND pb.id <> '<sequence.productBrands.id>' -- only when id is specified
                                    end note
                                    m_product_brand -> infra: Return query result
                                deactivate m_product_brand
                                infra -> app: Return result of Check duplicate name
                                alt items[i]: name is held by another product brand that is not DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10003 items[i]: Product brand name already exists.
                                    api -> page: Conflict
                                    page -> user: Display error message
                                end
                                alt rowStatus is DELETED or ARCHIVED
                                    app -> infra: QUERY - Check product in use
                                    infra -> m_product: QUERY - Check product in use
                                    activate m_product
                                        note right of m_product
                                            SELECT
                                                p.id as product_id
                                            FROM product.m_product p
                                            WHERE p.brand_id = '<sequence.productBrands.id>' -- only when rowStatus is DELETED or ARCHIVED
                                            AND p.row_status <> 'DELETED'
                                        end note
                                        m_product -> infra: Return query result
                                    deactivate m_product
                                    infra -> app: Return result of Check product in use
                                    alt items[i]: a product that is not DELETED uses the product brand
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10006 items[i]: Product brand is used by products.
                                        api -> page: Conflict
                                        page -> user: Display error message
                                    end
                                end
                                alt id is not specified (insert)
                                    app -> infra: INSERT - Create product brand
                                    infra -> m_product_brand: INSERT - Create product brand
                                    activate m_product_brand
                                        note right of m_product_brand
                                            INSERT INTO product.m_product_brand (
                                                created_by,
                                                row_status,
                                                name,
                                                description
                                            )
                                            VALUES (
                                                &#39;<sequence.createdBy>',
                                                &#39;<sequence.productBrands.rowStatus>',
                                                &#39;<sequence.productBrands.name>',
                                                &#39;<sequence.productBrands.description>'
                                            )
                                            RETURNING id as product_brand_id
                                        end note
                                        m_product_brand -> infra: Return inserted result
                                    deactivate m_product_brand
                                    infra -> app: Return result of Create product brand
                                else id is specified (update, delete or archive)
                                    app -> infra: UPDATE - Update or delete product brand
                                    infra -> m_product_brand: UPDATE - Update or delete product brand
                                    activate m_product_brand
                                        note right of m_product_brand
                                            UPDATE product.m_product_brand
                                            SET
                                                updated_by = '<sequence.updatedBy>',
                                                updated_at = NOW() AT TIME ZONE 'UTC',
                                                row_status = '<sequence.productBrands.rowStatus>',
                                                name = '<sequence.productBrands.name>',
                                                description = '<sequence.productBrands.description>'
                                            WHERE id = '<sequence.productBrands.id>'
                                            RETURNING id as product_brand_id
                                        end note
                                        m_product_brand -> infra: Return updated result
                                    deactivate m_product_brand
                                    infra -> app: Return result of Update or delete product brand
                                end
                            end
                            app -> infra: COMMIT
                            app -> api: HTTP 200 S10000 with the result of every item
                            api -> page: Return committed result
                            page -> user: Display success result
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
