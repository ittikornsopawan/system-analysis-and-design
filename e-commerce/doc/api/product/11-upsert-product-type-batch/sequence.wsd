@startuml UpsertProductTypeBatch Sequence

title Upsert Product Type Batch API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Product Type Batch Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "m_product_type" as m_product_type
    database "m_product" as m_product
end box

user -> page: Submit Upsert Product Type Batch
activate page
    page -> api: POST v1/product-type/upsert/batch
    activate api
        api -> app: [**UpsertProductTypeBatchCommandHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and body
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp, UUID sub and the roles claim (an array of role names)
                alt Missing, malformed or invalid JWT or roles claim
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Display authentication error
                else Verified JWT
                    app -> app: callerUserId = verified sub; accessTokenHash = SHA-256 of the exact JWT; isPlatformAdmin = roles contains PLATFORM_ADMIN (no database query)
                    note over app, infra
                        Order: validate the request (400) -> verify the JWT and its roles claim (401) -> BEGIN, lock the caller user (FOR UPDATE), fresh now, recheck of the JWT exp, current credential and user (401) -> existence checks (404) -> permission from the roles claim (403, E10009, once for the request) -> duplicate name and in-use checks (409) -> write -> COMMIT.
                        The permission is checked once for the request, after the existence checks of all items and before the duplicate, in-use and other conflict checks, so the 403 message has no item position.
                        The platform administrator is read only from the verified roles claim (an array of role names); the author tables are never queried.
                    end note
app -> infra: BEGIN READ COMMITTED
                    activate infra
                    alt Work completes before commit
                        app -> infra: QUERY - Lock the caller user
                        infra -> m_user: QUERY - Lock the caller user
                        activate m_user
                            note right of m_user
                                SELECT
                                    u.id as user_id
                                FROM authen.m_user u
                                WHERE u.id = '<sequence.callerUserId>'
                                FOR UPDATE
                            end note
                            m_user -> infra: Return query result
                        deactivate m_user
                        infra -> app: Return result of Lock the caller user
                        alt Caller user not found
                            app -> infra: ROLLBACK
                            app -> api: HTTP 401 E10002 Invalid or expired access token.
                            api -> page: Unauthorized
                            page -> user: Display authentication error
                        end
                        app -> app: Capture the fresh UTC now after the lock; recheck the JWT exp at now
                        app -> infra: QUERY - Check current credential and user
                        infra -> t_user_access_token: QUERY - Check current credential and user
                        activate t_user_access_token
                            note right of t_user_access_token
                                SELECT
                                    at.id as access_token_id
                                FROM authen.t_user_access_token at
                                JOIN authen.m_user u ON u.id = at.user_id
                                WHERE at.token = '<sequence.accessTokenHash>'
                                AND at.user_id = '<sequence.callerUserId>'
                                AND at.row_status = 'ACTIVE'
                                AND at.expired_at > '<sequence.now>'
                                AND u.row_status = 'ACTIVE'
                            end note
                            t_user_access_token -> infra: Return query result
                        deactivate t_user_access_token
                        infra -> app: Return result of Check current credential and user
                        alt Current credential or user is missing, inactive, revoked or expired
                            app -> infra: ROLLBACK
                            app -> api: HTTP 401 E10002 Invalid or expired access token.
                            api -> page: Unauthorized
                            page -> user: Display authentication error
                        end
                            loop For each item that has an id (request order)
                                app -> infra: QUERY - Check existing product type
                                infra -> m_product_type: QUERY - Check existing product type
                                activate m_product_type
                                    note right of m_product_type
                                        SELECT
                                            pt.id as product_type_id
                                        FROM product.m_product_type pt
                                        WHERE pt.id = '<sequence.productTypes.id>'
                                        AND pt.row_status <> 'DELETED' -- the id of a DELETED product type counts as not found
                                    end note
                                    m_product_type -> infra: Return query result
                                deactivate m_product_type
                                infra -> app: Return result of Check existing product type
                                alt items[i]: product type not found or DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 404 E10004 items[i]: Product type not found.
                                    api -> page: Not found
                                    page -> user: Display error message
                                end
                            end
                            alt The verified roles claim has no PLATFORM_ADMIN
                                app -> infra: ROLLBACK
                                app -> api: HTTP 403 E10009 You do not have permission to manage product types.
                                api -> page: Forbidden
                                page -> user: Display error message
                            end
                            loop For each item (request order, one transaction)
                                app -> infra: QUERY - Check duplicate name
                                infra -> m_product_type: QUERY - Check duplicate name
                                activate m_product_type
                                    note right of m_product_type
                                        SELECT
                                            pt.id as product_type_id
                                        FROM product.m_product_type pt
                                        WHERE pt.name = '<sequence.productTypes.name>'
                                        AND pt.row_status <> 'DELETED'
                                        AND pt.id <> '<sequence.productTypes.id>' -- only when id is specified
                                    end note
                                    m_product_type -> infra: Return query result
                                deactivate m_product_type
                                infra -> app: Return result of Check duplicate name
                                alt items[i]: name is held by another product type that is not DELETED
                                    app -> infra: ROLLBACK
                                    app -> api: HTTP 409 E10003 items[i]: Product type name already exists.
                                    api -> page: Conflict
                                    page -> user: Display error message
                                end
                                alt rowStatus is DELETED or ARCHIVED
                                    app -> infra: QUERY - Check product in use
                                    infra -> m_product: QUERY - Check product in use
                                    activate m_product
                                        note right of m_product
                                            SELECT
                                                p.id as product_id
                                            FROM product.m_product p
                                            WHERE p.type_id = '<sequence.productTypes.id>' -- only when rowStatus is DELETED or ARCHIVED
                                            AND p.row_status <> 'DELETED'
                                        end note
                                        m_product -> infra: Return query result
                                    deactivate m_product
                                    infra -> app: Return result of Check product in use
                                    alt items[i]: a product that is not DELETED uses the product type
                                        app -> infra: ROLLBACK
                                        app -> api: HTTP 409 E10006 items[i]: Product type is used by products.
                                        api -> page: Conflict
                                        page -> user: Display error message
                                    end
                                end
                                alt id is not specified (insert)
                                    app -> infra: INSERT - Create product type
                                    infra -> m_product_type: INSERT - Create product type
                                    activate m_product_type
                                        note right of m_product_type
                                            INSERT INTO product.m_product_type (
                                                created_by,
                                                row_status,
                                                name,
                                                description
                                            )
                                            VALUES (
                                                &#39;<sequence.createdBy>',
                                                &#39;<sequence.productTypes.rowStatus>',
                                                &#39;<sequence.productTypes.name>',
                                                &#39;<sequence.productTypes.description>'
                                            )
                                            RETURNING id as product_type_id
                                        end note
                                        m_product_type -> infra: Return inserted result
                                    deactivate m_product_type
                                    infra -> app: Return result of Create product type
                                else id is specified (update, delete or archive)
                                    app -> infra: UPDATE - Update or delete product type
                                    infra -> m_product_type: UPDATE - Update or delete product type
                                    activate m_product_type
                                        note right of m_product_type
                                            UPDATE product.m_product_type
                                            SET
                                                updated_by = '<sequence.updatedBy>',
                                                updated_at = NOW() AT TIME ZONE 'UTC',
                                                row_status = '<sequence.productTypes.rowStatus>',
                                                name = '<sequence.productTypes.name>',
                                                description = '<sequence.productTypes.description>'
                                            WHERE id = '<sequence.productTypes.id>'
                                            RETURNING id as product_type_id
                                        end note
                                        m_product_type -> infra: Return updated result
                                    deactivate m_product_type
                                    infra -> app: Return result of Update or delete product type
                                end
                            end
                            app -> infra: COMMIT
                            app -> api: HTTP 200 S10000 with the result of every item
                            api -> page: Return committed result
                            page -> user: Display success result
                    else Timeout before COMMIT
                        note over app, infra
                            A timeout can interrupt any preceding SQL or domain step.
                            No success response is sent without a successful COMMIT.
                        end note
                        app -> infra: ROLLBACK
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure before COMMIT
                        app -> infra: ROLLBACK
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
