@startuml InquiryShopOrder Sequence

title Inquiry Shop Order API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Shop Order Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_shop" as m_shop
    database "t_shop_user" as t_shop_user
    database "m_role" as m_role
    database "t_user_role" as t_user_role
    database "t_order" as t_order
    database "t_order_item" as t_order_item
    database "m_user" as m_user
    database "m_product_sku_option_value" as m_product_sku_option_value
end box

user -> page: Request the orders of the shop
activate page
    page -> api: GET v1/shop/order
    activate api
        api -> app: [**InquiryShopOrderQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters: shopId is a required UUID, pageSize 1 to 100, status is an order status
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: Execute database operations
                    activate infra
                    alt Work completes
                        app -> infra: QUERY - Check shop
                        infra -> m_shop: QUERY - Check shop
                        activate m_shop
                            note right of m_shop
                                SELECT
                                    s.id as shop_id
                                FROM shop.m_shop s
                                WHERE s.id = '<sequence.shopId>'
                                AND s.row_status <> 'DELETED'
                            end note
                            m_shop -> infra: Return query result
                        deactivate m_shop
                        infra -> app: Return the shop or no row
                        alt Shop not found or DELETED
                            app -> api: HTTP 404 E10005 Shop not found.
                            api -> page: Not found
                            page -> user: Display the shop is not found
                        else Shop found
                            app -> infra: QUERY - Check shop member
                            infra -> t_shop_user: QUERY - Check shop member
                            activate t_shop_user
                                note right of t_shop_user
                                    SELECT
                                        su.shop_id
                                    FROM shop.t_shop_user su
                                    WHERE su.shop_id = '<sequence.shopId>'
                                    AND su.user_id = '<sequence.userId>'
                                    AND su.role IN ('ADMIN', 'STAFF')
                                    AND su.row_status = 'ACTIVE'
                                end note
                                t_shop_user -> infra: Return query result
                            deactivate t_shop_user
                            infra -> app: Return the ACTIVE ADMIN or STAFF row of the caller or no row
                            app -> infra: QUERY - Get the platform administrator role
                            infra -> m_role: QUERY - Get the platform administrator role
                            activate m_role
                                note right of m_role
                                    SELECT
                                        r.id as role_id
                                    FROM author.m_role r
                                    WHERE r.name = 'PLATFORM_ADMIN'
                                    AND r.row_status = 'ACTIVE'
                                end note
                                m_role -> infra: Return query result
                            deactivate m_role
                            infra -> app: Return the role id
                            app -> infra: QUERY - Check platform administrator
                            infra -> t_user_role: QUERY - Check platform administrator
                            activate t_user_role
                                note right of t_user_role
                                    SELECT
                                        ur.id as user_role_id
                                    FROM author.t_user_role ur
                                    WHERE ur.user_id = '<sequence.userId>'
                                    AND ur.role_id = '<sequence.roleId>'
                                    AND ur.row_status = 'ACTIVE'
                                end note
                                t_user_role -> infra: Return query result
                            deactivate t_user_role
                            infra -> app: Return the assignment or no row
                            alt The caller is neither a member of the shop nor a platform administrator
                                app -> api: HTTP 403 E10009 You do not have permission to read the orders of this shop.
                                api -> page: Forbidden
                                page -> user: Display no permission
                            end
                            app -> infra: QUERY - Get the orders of the shop
                            infra -> t_order: QUERY - Get the orders of the shop
                            activate t_order
                                note right of t_order
                                    SELECT
                                        o.id as order_id,
                                        o.code,
                                        o.status,
                                        o.user_id,
                                        ui.display_name,
                                        o.ship_title,
                                        o.ship_address,
                                        o.ship_city,
                                        o.ship_state,
                                        o.ship_postal_code,
                                        o.ship_country,
                                        o.total_price,
                                        o.total_discount,
                                        o.total_tax,
                                        o.total_shipping,
                                        o.total_amount,
                                        o.expires_at,
                                        o.created_at
                                    FROM sales.t_order o
                                    INNER JOIN authen.m_user ui
                                        ON ui.id = o.user_id
                                    WHERE o.shop_id = '<sequence.shopId>'
                                    AND o.row_status <> 'DELETED'
                                    AND o.id = '<sequence.id>' -- only when id is specified
                                    AND o.status = '<sequence.status>' -- only when status is specified
                                    AND (o.code ILIKE '%<sequence.search>%' OR ui.display_name ILIKE '%<sequence.search>%') -- only when search is specified
                                    ORDER BY o.created_at DESC, o.id
                                    LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                                end note
                                t_order -> infra: Return query result
                            deactivate t_order
                            infra -> app: Return the page of orders of the shop
                            app -> infra: QUERY - Count the orders of the shop
                            infra -> t_order: QUERY - Count the orders of the shop
                            activate t_order
                                note right of t_order
                                    SELECT
                                        COUNT(o.id) as total_items
                                    FROM sales.t_order o
                                    INNER JOIN authen.m_user ui
                                        ON ui.id = o.user_id
                                    WHERE o.shop_id = '<sequence.shopId>'
                                    AND o.row_status <> 'DELETED'
                                    AND o.id = '<sequence.id>' -- only when id is specified
                                    AND o.status = '<sequence.status>' -- only when status is specified
                                    AND (o.code ILIKE '%<sequence.search>%' OR ui.display_name ILIKE '%<sequence.search>%') -- only when search is specified
                                end note
                                t_order -> infra: Return query result
                            deactivate t_order
                            infra -> app: Return total_items
                            alt No order matches
                                app -> api: HTTP 200 S10000
                                api -> page: Return an empty list
                                page -> user: Display no order
                            else Orders found
                                app -> infra: QUERY - Get the items of the orders
                                infra -> t_order_item: QUERY - Get the items of the orders
                                activate t_order_item
                                    note right of t_order_item
                                        SELECT
                                            oi.id as order_item_id,
                                            oi.order_id,
                                            oi.product_id,
                                            oi.sku_id,
                                            oi.lot_id,
                                            oi.quantity,
                                            oi.price,
                                            oi.discount,
                                            oi.total_price,
                                            oi.gross_profit,
                                            oi.shop_profit,
                                            oi.platform_profit -- returned only to a platform administrator, null for the members of the shop
                                        FROM sales.t_order_item oi
                                        WHERE oi.order_id IN ('<sequence.orderIds>')
                                        AND oi.row_status <> 'DELETED'
                                        ORDER BY oi.created_at, oi.id
                                    end note
                                    t_order_item -> infra: Return query result
                                deactivate t_order_item
                                infra -> app: Return the items with their lots
                                app -> infra: QUERY - Get the display name of the customer
                                infra -> m_user: QUERY - Get the display name of the customer
                                activate m_user
                                    note right of m_user
                                        SELECT
                                            u.id as user_id,
                                            u.display_name
                                        FROM authen.m_user u
                                        WHERE u.id IN ('<sequence.userIds>')
                                    end note
                                    m_user -> infra: Return query result
                                deactivate m_user
                                infra -> app: Return the display names of the customers
                                app -> infra: QUERY - Get the chosen option values of the SKUs
                                infra -> m_product_sku_option_value: QUERY - Get the chosen option values of the SKUs
                                activate m_product_sku_option_value
                                    note right of m_product_sku_option_value
                                        SELECT
                                            psov.sku_id,
                                            po.name as option_name,
                                            pov.value
                                        FROM product.m_product_sku_option_value psov
                                        INNER JOIN product.m_product_option_value pov
                                            ON pov.id = psov.option_value_id
                                        INNER JOIN product.m_product_option po
                                            ON po.id = pov.option_id
                                        WHERE psov.sku_id IN ('<sequence.skuIds>')
                                        ORDER BY psov.sku_id, po.level_no
                                    end note
                                    m_product_sku_option_value -> infra: Return query result
                                deactivate m_product_sku_option_value
                                infra -> app: Return the chosen option values
                                app -> domain: Build the orders: grossProfit and shopProfit for the members, platformProfit only for a platform administrator (null for a member), never the user name or the e-mail address
                                activate domain
                                domain -> app: Return the orders and the paging
                                deactivate domain
                                app -> api: HTTP 200 S10000
                                api -> page: Return the orders
                                page -> user: Display the orders
                            end
                        end
                    else Timeout
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
