@startuml InquiryCheckout Sequence

title Inquiry Checkout API Sequence

' Leading SQL apostrophes use &#39; so PlantUML preserves literals; parity compares decoded SQL.

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox

actor "User" as user
box "Frontend" #F8FAFC
    participant "Inquiry Checkout Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "t_cart" as t_cart
    database "t_user_address" as t_user_address
    database "t_shop_product_sku" as t_shop_product_sku
    database "m_campaign" as m_campaign
    database "t_campaign_product" as t_campaign_product
end box

user -> page: Request the checkout preview
activate page
    page -> api: GET v1/checkout
    activate api
        api -> app: [**InquiryCheckoutQueryHandler**] Process request
        activate app
            app -> app: Create request context; generate requestId when omitted
            app -> app: Validate headers and query parameters: addressId is a UUID, cartIds are UUIDs without duplicates and at most 100
            alt Invalid input
                app -> api: HTTP 400 E10001
                api -> page: Bad request
                page -> user: Display validation error
            else Valid input
                app -> app: Verify JWT signature, issuer, audience, exp and UUID sub
                alt Missing, malformed or invalid JWT
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Authentication error
                    page -> user: Ask the user to sign in again
                else Verified JWT
                    app -> app: userId = verified sub
                    app -> infra: Execute database operations
                    activate infra
                    alt Work completes
                        app -> infra: QUERY - Get the cart lines to order
                        infra -> t_cart: QUERY - Get the cart lines to order
                        activate t_cart
                            note right of t_cart
                                SELECT
                                    c.id as cart_id,
                                    c.shop_id,
                                    c.product_id,
                                    c.sku_id,
                                    c.quantity
                                FROM cart.t_cart c
                                WHERE c.user_id = '<sequence.userId>'
                                AND c.row_status = 'ACTIVE'
                                AND c.id IN ('<sequence.cartIds>') -- only when cartIds is specified, otherwise every ACTIVE line of the user
                                ORDER BY c.created_at
                            end note
                            t_cart -> infra: Return query result
                        deactivate t_cart
                        infra -> app: Return the lines of the user (the selected cartIds, or every ACTIVE line)
                        alt cartIds is specified and a line is not found (another user's line or a deleted line)
                            app -> api: HTTP 404 E10004 Cart item not found.
                            api -> page: Not found
                            page -> user: Display the cart item is not found
                        else cartIds is not specified and the cart has no line
                            app -> api: HTTP 400 E10001 The selection must not be empty.
                            api -> page: Bad request
                            page -> user: Display the cart is empty
                        else Lines found
                            app -> infra: QUERY - Check the address of the user
                            infra -> t_user_address: QUERY - Check the address of the user
                            activate t_user_address
                                note right of t_user_address
                                    SELECT
                                        ua.id as address_id,
                                        ua.title,
                                        ua.address,
                                        ua.city,
                                        ua.state,
                                        ua.postal_code,
                                        ua.country
                                    FROM authen.t_user_address ua
                                    WHERE ua.id = '<sequence.addressId>'
                                    AND ua.user_id = '<sequence.userId>'
                                    AND ua.row_status = 'ACTIVE'
                                end note
                                t_user_address -> infra: Return query result
                            deactivate t_user_address
                            infra -> app: Return the address or no row
                            alt Address not found for this user
                                app -> api: HTTP 404 E10005 Address not found.
                                api -> page: Not found
                                page -> user: Display the address is not found
                            else Address found
                                app -> infra: QUERY - Get the SKU of each line with the lot that is on sale
                                infra -> t_shop_product_sku: QUERY - Get the SKU of each line with the lot that is on sale
                                activate t_shop_product_sku
                                    note right of t_shop_product_sku
                                        SELECT
                                            ssk.id as shop_product_sku_id,
                                            sp.shop_id,
                                            sp.product_id,
                                            ssk.sku_id,
                                            s.name as shop_name,
                                            p.name as product_name,
                                            ps.name as sku_name,
                                            l.id as lot_id,
                                            l.selling_price,
                                            l.cost_price,
                                            l.gross_margin,
                                            l.share_margin,
                                            l.platform_margin,
                                            l.quantity as max_order_quantity
                                        FROM shop.t_shop_product_sku ssk
                                        INNER JOIN shop.t_shop_product sp
                                            ON sp.id = ssk.shop_product_id
                                            AND sp.row_status = 'ACTIVE'
                                        INNER JOIN shop.m_shop s
                                            ON s.id = sp.shop_id
                                            AND s.row_status = 'ACTIVE'
                                        INNER JOIN product.m_product p
                                            ON p.id = sp.product_id
                                            AND p.row_status = 'ACTIVE'
                                        INNER JOIN product.m_product_sku ps
                                            ON ps.id = ssk.sku_id
                                            AND ps.row_status = 'ACTIVE'
                                        LEFT JOIN shop.t_shop_product_sku_lot l
                                            ON l.shop_product_sku_id = ssk.id
                                            AND l.is_on_sale = TRUE
                                            AND l.row_status = 'ACTIVE'
                                        WHERE (sp.shop_id, sp.product_id, ssk.sku_id) IN (<sequence.lineKeys>)
                                        AND ssk.row_status = 'ACTIVE'
                                    end note
                                    t_shop_product_sku -> infra: Return query result
                                deactivate t_shop_product_sku
                                infra -> app: Return the SKU, the lot and its prices and max_order_quantity of every line
                                app -> domain: Decide the availability of every line: AVAILABLE lines go to shops, the others to problems with their reason
                                activate domain
                                domain -> app: Return shops and problems
                                deactivate domain
                                loop For every shop of the selected lines
                                    app -> infra: QUERY - Get the campaigns that apply to the shop
                                    infra -> m_campaign: QUERY - Get the campaigns that apply to the shop
                                    activate m_campaign
                                        note right of m_campaign
                                            SELECT
                                                c.id as campaign_id,
                                                c.name,
                                                d.discount_type,
                                                d.discount_value,
                                                b.id as budget_id,
                                                b.remaining
                                            FROM campaign.m_campaign c
                                            INNER JOIN campaign.t_campaign_discount d
                                                ON d.campaign_id = c.id
                                                AND d.row_status = 'ACTIVE'
                                            INNER JOIN campaign.m_campaign_budget b
                                                ON b.campaign_id = c.id
                                                AND b.row_status = 'ACTIVE'
                                            WHERE c.row_status = 'ACTIVE'
                                            AND c.start_at <= NOW() AT TIME ZONE 'UTC'
                                            AND NOW() AT TIME ZONE 'UTC' < c.end_at
                                            AND (EXISTS (
                                                    SELECT 1
                                                    FROM campaign.t_campaign_shop cs
                                                    WHERE cs.campaign_id = c.id
                                                    AND cs.shop_id = '<sequence.shopId>'
                                                    AND cs.row_status = 'ACTIVE'
                                                ) OR NOT EXISTS (
                                                    SELECT 1
                                                    FROM campaign.t_campaign_shop cs
                                                    WHERE cs.campaign_id = c.id
                                                    AND cs.row_status = 'ACTIVE'
                                                ))
                                            ORDER BY c.id
                                        end note
                                        m_campaign -> infra: Return query result
                                    deactivate m_campaign
                                    infra -> app: Return the campaigns with their discount and budget
                                    alt At least one campaign applies
                                        app -> infra: QUERY - Get the products and categories of the campaigns
                                        infra -> t_campaign_product: QUERY - Get the products and categories of the campaigns
                                        activate t_campaign_product
                                            note right of t_campaign_product
                                                SELECT
                                                    cp.campaign_id,
                                                    cp.product_id,
                                                    cp.product_category_id,
                                                    p.id as matched_product_id
                                                FROM campaign.t_campaign_product cp
                                                LEFT JOIN product.m_product p
                                                    ON p.id = cp.product_id
                                                    OR p.category_id = cp.product_category_id
                                                WHERE cp.campaign_id IN ('<sequence.campaignIds>')
                                                AND cp.row_status = 'ACTIVE'
                                                AND p.id IN ('<sequence.productIds>') -- a campaign without a live product row is for every product
                                            end note
                                            t_campaign_product -> infra: Return query result
                                        deactivate t_campaign_product
                                        infra -> app: Return the products and categories of the campaigns
                                    end
                                end
                                app -> domain: Calculate the discount of every item, the totals of every shop and, from the remaining budget, the lines whose campaign cannot cover a shop order (DISCOUNT_BUDGET_EXHAUSTED); nothing is reserved
                                activate domain
                                domain -> app: Return the preview and canCheckout
                                deactivate domain
                                alt problems is empty and shops is not empty (canCheckout)
                                    app -> api: HTTP 200 S10000
                                    api -> page: Return the preview
                                    page -> user: Display the checkout
                                else There are problems or no line can be ordered
                                    app -> api: HTTP 200 S10000 with problems
                                    api -> page: Return the preview with problems
                                    page -> user: Display the lines that cannot be ordered
                                end
                            end
                        end
                    else Timeout
                        app -> api: HTTP 408 E90001
                        api -> page: Request timeout
                        page -> user: Retry if needed
                    else Unexpected failure
                        app -> api: HTTP 500 generic error; no new bizCode
                        api -> page: Internal server error
                        page -> user: Display generic failure
                    end
                    deactivate infra
                end
            end
        deactivate app
    deactivate api
deactivate page

@enduml
