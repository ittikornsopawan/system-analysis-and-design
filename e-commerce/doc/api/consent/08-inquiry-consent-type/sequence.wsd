@startuml InquiryConsentType Sequence

title Inquiry Consent Type API Sequence

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox


actor "User" as user

box "Frontend" #F8FAFC
    participant "Inquiry Consent Type Page" as page
end box

box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box

box "Database" #F8FAFC
    database "m_consent_type" as m_consent_type
end box

user -> page: Request Inquiry Consent Type

activate page
    page -> api: Call GET v1/consent/type
    activate api
        api -> app: [**InquiryConsentTypeQueryHandler**] Process request
        activate app
            app -> app: Validate request parameters and business rules
            alt If request is invalid
                app -> api: Return error response
                api -> page: Return error response
                page -> user: Display error message
            else If request is valid
                app -> infra: Execute database operations
                activate infra
                    infra -> m_consent_type: QUERY - Get consent types
                    activate m_consent_type
                        note right of m_consent_type
                            SELECT
                                ct.id as consent_type_id,
                                ct.name,
                                ct.description,
                                ct.is_required,
                                ct.row_status
                            FROM consent.m_consent_type ct
                            WHERE ct.row_status <> 'DELETED'
                            AND ct.id = '<sequence.id>' -- only when id is specified
                            AND (ct.name ILIKE '%<sequence.search>%' OR ct.description ILIKE '%<sequence.search>%') -- only when search is specified
                            AND ct.is_required = '<sequence.isRequired>' -- only when isRequired is specified
                            AND ct.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                            ORDER BY ct.created_at DESC, ct.id
                            LIMIT <sequence.pageSize> OFFSET (<sequence.pageIndex> - 1) * <sequence.pageSize>
                        end note
                        m_consent_type -> infra: Return query result
                    deactivate m_consent_type

                    infra -> m_consent_type: QUERY - Get total items
                    activate m_consent_type
                        note right of m_consent_type
                            SELECT
                                COUNT(ct.id) as total_items
                            FROM consent.m_consent_type ct
                            WHERE ct.row_status <> 'DELETED'
                            AND ct.id = '<sequence.id>' -- only when id is specified
                            AND (ct.name ILIKE '%<sequence.search>%' OR ct.description ILIKE '%<sequence.search>%') -- only when search is specified
                            AND ct.is_required = '<sequence.isRequired>' -- only when isRequired is specified
                            AND ct.row_status = '<sequence.rowStatus>' -- only when rowStatus is specified
                        end note
                        m_consent_type -> infra: Return query result
                    deactivate m_consent_type

                    infra -> app: Return database result
                deactivate infra

                app -> domain: Apply domain rules and prepare response
                activate domain
                    domain -> app: Return response data
                deactivate domain

                app -> api: Return success response
                api -> page: Return success response
                page -> user: Display success result
            end alt
        note over app, infra
            Approved by the product owner (answered through the lead SA, 2026-11-06).
            Without the `rowStatus` filter every other status is returned.
            Sorted by `created_at` descending and then by `id`, so that the pages never repeat or skip a row.
            The `isRequired` of a consent decides whether that consent must be accepted (see the consent upsert).
        end note
        deactivate app
    deactivate api
deactivate page

@enduml
