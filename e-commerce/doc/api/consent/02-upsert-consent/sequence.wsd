@startuml UpsertConsent Sequence

title Upsert Consent API Sequence

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox


actor "User" as user

box "Frontend" #F8FAFC
    participant "Upsert Consent Page" as page
end box

box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box

box "Database" #F8FAFC
    database "m_consent_type" as m_consent_type
    database "t_consent" as t_consent
end box

user -> page: Submit Upsert Consent

activate page
    page -> api: Call POST v1/consent/upsert
    activate api
        api -> app: [**UpsertConsentCommandHandler**] Process request
        activate app
            app -> app: Validate request parameters and business rules
            alt If request is invalid
                app -> api: Return error response
                api -> page: Return error response
                page -> user: Display error message
            else If request is valid
                app -> infra: Execute database operations
                activate infra
                    infra -> m_consent_type: QUERY - Check consent type
                    activate m_consent_type
                        note right of m_consent_type
                            SELECT
                                ct.id as consent_type_id
                            FROM consent.m_consent_type ct
                            WHERE ct.id = '<sequence.consentTypeId>'
                            AND ct.row_status = 'ACTIVE'
                        end note
                        m_consent_type -> infra: Return query result
                    deactivate m_consent_type

                    infra -> t_consent: QUERY - Check existing consent
                    activate t_consent
                        note right of t_consent
                            SELECT
                                c.id as consent_id
                            FROM consent.t_consent c
                            WHERE c.id = '<sequence.id>'
                        end note
                        t_consent -> infra: Return query result
                    deactivate t_consent

                    infra -> t_consent: QUERY - Check duplicate code
                    activate t_consent
                        note right of t_consent
                            SELECT
                                c.id as consent_id
                            FROM consent.t_consent c
                            WHERE c.code = '<sequence.code>'
                            AND c.id <> '<sequence.id>'
                        end note
                        t_consent -> infra: Return query result
                    deactivate t_consent

                    infra -> t_consent: INSERT - Create consent
                    activate t_consent
                        note right of t_consent
                            INSERT INTO consent.t_consent (
                                created_by,
                                row_status,
                                code,
                                consent_type_id,
                                consent_version,
                                consent_name,
                                consent_description,
                                effective_at,
                                expired_at,
                                is_required,
                                body
                            )
                            VALUES (
                                '<sequence.createdBy>',
                                '<sequence.rowStatus>',
                                '<sequence.code>',
                                '<sequence.consentTypeId>',
                                '<sequence.consentVersion>',
                                '<sequence.consentName>',
                                '<sequence.consentDescription>',
                                '<sequence.effectiveAt>',
                                '<sequence.expiredAt>',
                                '<sequence.isRequired>',
                                '<sequence.body>'
                            )
                            RETURNING id as consent_id
                        end note
                        t_consent -> infra: Return inserted result
                    deactivate t_consent

                    infra -> t_consent: UPDATE - Update or delete consent
                    activate t_consent
                        note right of t_consent
                            UPDATE consent.t_consent
                            SET
                                updated_by = '<sequence.updatedBy>',
                                updated_at = NOW() AT TIME ZONE 'UTC',
                                row_status = '<sequence.rowStatus>',
                                code = '<sequence.code>',
                                consent_type_id = '<sequence.consentTypeId>',
                                consent_version = '<sequence.consentVersion>',
                                consent_name = '<sequence.consentName>',
                                consent_description = '<sequence.consentDescription>',
                                effective_at = '<sequence.effectiveAt>',
                                expired_at = '<sequence.expiredAt>',
                                is_required = '<sequence.isRequired>',
                                body = '<sequence.body>'
                            WHERE id = '<sequence.id>'
                            RETURNING id as consent_id
                        end note
                        t_consent -> infra: Return updated result
                    deactivate t_consent

                    infra -> app: Return database result
                deactivate infra

                app -> domain: Apply domain rules and prepare response
                activate domain
                    domain -> app: Return response data
                deactivate domain

                app -> api: Return success response
                api -> page: Return success response
                page -> user: Display success result
            end alt
        deactivate app
    deactivate api
deactivate page

@enduml
