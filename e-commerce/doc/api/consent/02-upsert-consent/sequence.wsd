@startuml UpsertConsent Sequence

title Upsert Consent API Sequence

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox


actor "User" as user
box "Frontend" #F8FAFC
    participant "Upsert Consent Page" as page
end box
box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box
box "Database" #F8FAFC
    database "m_user" as m_user
    database "t_user_access_token" as t_user_access_token
    database "m_consent_type" as m_consent_type
    database "t_consent" as t_consent
end box

user -> page: Submit the consent
activate page
    page -> api: POST v1/consent/upsert (JSON, Bearer JWT, UTC timestamp)
    activate api
        api -> app: [**UpsertConsentCommandHandler**] Process request
        activate app
            note over app, infra
                Order: validate (400) -> verify the JWT and its roles claim (401) -> BEGIN -> lock the caller user (FOR UPDATE) -> current credential (401) ->
                lock the consent type -> lock the target consent -> existence (404) -> permission from the roles claim (403, E10009) -> duplicate code (409) -> write -> COMMIT.
                The author tables are never queried. Lock order: caller user, consent type, consent.
            end note
            app -> app: Generate requestId; validate JSON object/known keys, UTC timestamp, optional UUID id, required code/consentTypeId/consentName/body, version at most 8 characters, expiredAt later than effectiveAt when both are given
            app -> app: Default status ACTIVE only when omitted; reject invalid status and insert-DELETED
            alt Invalid input/header
                break Reject this request
                    app -> api: HTTP 400 E10001
                    api -> page: Show failure; no successful consent action
                    page -> user: Display failure; keep unsaved input
                end break
            else Check passed
            end
            app -> app: Verify JWT signature/issuer/audience/expiry/UUID sub and the roles claim as unique non-empty strings
            alt Missing/invalid JWT or malformed roles
                break Reject this request
                    app -> api: HTTP 401 E10002 Invalid or expired access token.
                    api -> page: Show failure; no successful consent action
                    page -> user: Display failure; keep unsaved input
                end break
            else Check passed
            end
            app -> app: callerUserId = verified sub; accessTokenHash = SHA-256 exact JWT; createdBy/updatedBy = caller UUID string; omitted id = typed SQL NULL
            app -> infra: BEGIN READ COMMITTED
            activate infra
            alt Work completes before commit
                app -> infra: QUERY - Lock the caller user
                infra -> m_user: QUERY - Lock the caller user
                activate m_user
                    note right of m_user
                        SELECT
                            u.id as user_id
                        FROM authen.m_user u
                        WHERE u.id = '<sequence.callerUserId>'
                        FOR UPDATE
                    end note
                    m_user -> infra: Return locked caller user or no row
                deactivate m_user
                infra -> app: Return locked caller user or no row
                alt Caller user missing
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Show failure; no successful consent action
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                app -> app: Capture fresh server UTC now after the caller lock; recheck JWT exp
                alt JWT expired while waiting for the caller lock
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Show failure; no successful consent action
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                app -> infra: QUERY - Check current credential and user
                infra -> t_user_access_token: QUERY - Check current credential and user
                activate t_user_access_token
                    note right of t_user_access_token
                        SELECT
                            at.id as access_token_id
                        FROM authen.t_user_access_token at
                        JOIN authen.m_user u ON u.id = at.user_id
                        WHERE at.token = '<sequence.accessTokenHash>'
                        AND at.user_id = '<sequence.callerUserId>'
                        AND at.row_status = 'ACTIVE'
                        AND at.expired_at > '<sequence.now>'
                        AND u.row_status = 'ACTIVE'
                    end note
                    t_user_access_token -> infra: Return ACTIVE matching unexpired token/user or no row
                deactivate t_user_access_token
                infra -> app: Return ACTIVE matching unexpired token/user or no row
                alt Current token/user missing/inactive/revoked/expired/mismatched
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 401 E10002 Invalid or expired access token.
                        api -> page: Show failure; no successful consent action
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                app -> infra: QUERY - Lock the consent type
                infra -> m_consent_type: QUERY - Lock the consent type
                activate m_consent_type
                    note right of m_consent_type
                        SELECT
                            ct.id as consent_type_id,
                            ct.row_status
                        FROM consent.m_consent_type ct
                        WHERE ct.id = '<sequence.consentTypeId>'
                        FOR UPDATE
                    end note
                    m_consent_type -> infra: Return locked consent_type_id/row_status or no row
                deactivate m_consent_type
                infra -> app: Return locked consent_type_id/row_status or no row
                alt id is specified (update, delete or archive)
                    app -> infra: QUERY - Lock existing consent
                    infra -> t_consent: QUERY - Lock existing consent
                    activate t_consent
                        note right of t_consent
                            SELECT
                                c.id as consent_id,
                                c.consent_type_id,
                                c.consent_version,
                                c.row_status
                            FROM consent.t_consent c
                            WHERE c.id = '<sequence.id>'
                            AND c.row_status <> 'DELETED' -- the id of a DELETED consent counts as not found
                            FOR UPDATE
                        end note
                        t_consent -> infra: Return locked consent_id/consent_type_id/consent_version/row_status or no row
                    deactivate t_consent
                    infra -> app: Return locked consent_id/consent_type_id/consent_version/row_status or no row
                    alt Consent not found or DELETED (final)
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 Consent not found.
                            api -> page: Show failure; no successful consent action
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                else id omitted (insert)
                    app -> app: No consent row to lock
                end
                app -> app: The request gives the consent when it inserts, or sets ACTIVE on a locked consent that is not ACTIVE, or changes the consent type of an ACTIVE consent
                alt The consent type row is missing, or the request gives the consent and the type is not ACTIVE
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 404 E10005 Consent type not found or not ACTIVE.
                        api -> page: Show failure; no successful consent action
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed; delete, archive, deactivate or lock needs no ACTIVE type
                end
                app -> app: Authorize once using only exact case-sensitive PLATFORM_ADMIN in verified JWT roles; never reload live grants
                alt No exact PLATFORM_ADMIN role claim
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 403 E10009 You do not have permission to manage consents.
                        api -> page: Show failure; no successful consent action
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                app -> infra: QUERY - Check duplicate code
                infra -> t_consent: QUERY - Check duplicate code
                activate t_consent
                    note right of t_consent
                        SELECT
                            c.id as consent_id
                        FROM consent.t_consent c
                        WHERE c.code = '<sequence.code>'
                        AND ('<sequence.id>' IS NULL OR c.id <> '<sequence.id>') -- every status counts, a DELETED consent keeps its code
                    end note
                    t_consent -> infra: Return the consent that holds this code in any status, or no row
                deactivate t_consent
                infra -> app: Return the consent that holds this code in any status, or no row
                alt The code is held by another consent (a DELETED consent keeps its code)
                    break Reject this request
                        app -> infra: ROLLBACK
                        app -> api: HTTP 409 E10003 Consent code already exists.
                        api -> page: Show failure; no successful consent action
                        page -> user: Display failure; keep unsaved input
                    end break
                else Check passed
                end
                alt id is omitted (INSERT)
                    app -> infra: INSERT - Create consent
                    infra -> t_consent: INSERT - Create consent
                    activate t_consent
                        note right of t_consent
                            INSERT INTO consent.t_consent (
                                created_by,
                                created_at,
                                row_status,
                                code,
                                consent_type_id,
                                consent_version,
                                consent_name,
                                consent_description,
                                effective_at,
                                expired_at,
                                is_required,
                                body
                            )
                            VALUES (
                                &#39;<sequence.createdBy>',
                                &#39;<sequence.now>',
                                &#39;<sequence.rowStatus>',
                                &#39;<sequence.code>',
                                &#39;<sequence.consentTypeId>',
                                &#39;<sequence.consentVersion>',
                                &#39;<sequence.consentName>',
                                &#39;<sequence.consentDescription>',
                                &#39;<sequence.effectiveAt>',
                                &#39;<sequence.expiredAt>',
                                &#39;<sequence.isRequired>',
                                &#39;<sequence.body>'
                            )
                            RETURNING id as consent_id
                        end note
                        t_consent -> infra: Return inserted consent_id
                    deactivate t_consent
                    infra -> app: Return inserted consent_id
                    app -> app: Require exactly one inserted consent_id; missing/malformed result is internal failure
                else id is specified (UPDATE, DELETE or ARCHIVE)
                    app -> infra: UPDATE - Update or delete consent
                    infra -> t_consent: UPDATE - Update or delete consent
                    activate t_consent
                        note right of t_consent
                            UPDATE consent.t_consent
                            SET
                                updated_by = '<sequence.updatedBy>',
                                updated_at = '<sequence.now>',
                                row_status = '<sequence.rowStatus>',
                                code = '<sequence.code>',
                                consent_type_id = '<sequence.consentTypeId>',
                                consent_version = '<sequence.consentVersion>',
                                consent_name = '<sequence.consentName>',
                                consent_description = '<sequence.consentDescription>',
                                effective_at = '<sequence.effectiveAt>',
                                expired_at = '<sequence.expiredAt>',
                                is_required = '<sequence.isRequired>',
                                body = '<sequence.body>'
                            WHERE id = '<sequence.id>'
                            AND row_status <> 'DELETED'
                            RETURNING id as consent_id
                        end note
                        t_consent -> infra: Return guarded returned consent_id or no row
                    deactivate t_consent
                    infra -> app: Return guarded returned consent_id or no row
                    alt Guarded UPDATE returned zero rows
                        break Reject this request
                            app -> infra: ROLLBACK
                            app -> api: HTTP 404 E10004 Consent not found.
                            api -> page: Show failure; no successful consent action
                            page -> user: Display failure; keep unsaved input
                        end break
                    else Check passed
                    end
                    app -> app: Require exactly one returned consent_id equal to this input id; mismatch is internal failure
                end
                app -> app: Map data.consentId from RETURNING before COMMIT; a changed consentVersion makes the old answers pending again (Q8) and no user consent row is written; delete maps no body
                app -> infra: COMMIT
                infra -> app: Return committed consent
                alt Insert
                    app -> api: HTTP 201 S10000 Insert Consent Success
                    api -> page: Return the consent
                    page -> user: Display the outcome
                else rowStatus = DELETED (delete)
                    app -> api: HTTP 204 No Content; no response body
                    api -> page: No content
                    page -> user: Display the outcome
                else rowStatus = ARCHIVED (archive)
                    app -> api: HTTP 200 S10000 Archive Consent Success
                    api -> page: Return the consent
                    page -> user: Display the outcome
                else Update
                    app -> api: HTTP 200 S10000 Update Consent Success
                    api -> page: Return the consent
                    page -> user: Display the outcome
                end
            else SQLSTATE 23505 from the unique constraint on code (concurrent insert)
                app -> infra: ROLLBACK
                app -> api: HTTP 409 E10003 Consent code already exists.
                api -> page: Conflict
                page -> user: Display the outcome
            else Timeout before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 408 E90001
                api -> page: Request timeout
                page -> user: Display the outcome
            else Unexpected SQL/result/mapping failure before COMMIT
                app -> infra: ROLLBACK
                app -> api: HTTP 500 Internal Server Error; omit bizCode
                api -> page: Internal server error
                page -> user: Display the outcome
            end
            deactivate infra
        deactivate app
    deactivate api
deactivate page
@enduml
