@startuml InquiryPendingConsent Sequence

title Inquiry Pending Consent API Sequence

' Visual style
skinparam defaultFontName "Sarabun"
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam sequence {
    ArrowColor #475569
    ArrowFontColor #334155
    LifeLineBorderColor #CBD5E1
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #94A3B8
    ParticipantBackgroundColor #F1F5F9
    ParticipantFontColor #0F172A
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupFontColor #334155
}

' Do not show participant footers at the bottom of the diagram
hide footbox


actor "User" as user

box "Frontend" #F8FAFC
    participant "Inquiry Pending Consent Page" as page
end box

box "Web API" #F8FAFC
    participant "API" as api
    participant "Application" as app
    participant "Domain" as domain
    participant "Infrastructure" as infra
end box

box "Database" #F8FAFC
    database "t_consent" as t_consent
    database "t_user_consent" as t_user_consent
    database "m_consent_type" as m_consent_type
end box

user -> page: Request Inquiry Pending Consent

activate page
    page -> api: Call GET v1/consent/pending
    activate api
        api -> app: [**InquiryPendingConsentQueryHandler**] Process request
        activate app
            app -> app: Validate request parameters and business rules
            alt If request is invalid
                app -> api: Return error response
                api -> page: Return error response
                page -> user: Display error message
            else If request is valid
                app -> infra: Execute database operations
                activate infra
                    infra -> t_consent: QUERY - Get pending consents
                    activate t_consent
                        note right of t_consent
                            SELECT
                                c.id as consent_id,
                                c.code,
                                c.consent_type_id,
                                c.consent_version,
                                c.consent_name,
                                c.consent_description,
                                c.effective_at,
                                c.expired_at,
                                c.is_required,
                                c.body
                            FROM consent.t_consent c
                            WHERE c.row_status = 'ACTIVE'
                            AND c.effective_at <= NOW() AT TIME ZONE 'UTC'
                            AND (c.expired_at IS NULL OR c.expired_at > NOW() AT TIME ZONE 'UTC')
                            AND NOT EXISTS (
                                SELECT 1
                                FROM authen.t_user_consent uc
                                WHERE uc.user_id = '<sequence.userId>'
                                AND uc.consent_id = c.id
                                AND uc.consent_version = c.consent_version
                                AND uc.is_read = TRUE
                                AND uc.row_status = 'ACTIVE'
                            )
                            ORDER BY c.effective_at
                        end note
                        t_consent -> infra: Return query result
                    deactivate t_consent

                    infra -> t_user_consent: QUERY - Get latest submitted version
                    activate t_user_consent
                        note right of t_user_consent
                            SELECT DISTINCT ON (uc.consent_id)
                                uc.consent_id,
                                uc.consent_version as submitted_version
                            FROM authen.t_user_consent uc
                            WHERE uc.user_id = '<sequence.userId>'
                            AND uc.consent_id IN ('<sequence.consentIds>')
                            AND uc.row_status = 'ACTIVE'
                            ORDER BY uc.consent_id, uc.created_at DESC
                        end note
                        t_user_consent -> infra: Return query result
                    deactivate t_user_consent

                    infra -> m_consent_type: QUERY - Get consent type
                    activate m_consent_type
                        note right of m_consent_type
                            SELECT
                                ct.id as consent_type_id,
                                ct.name as consent_type_name
                            FROM consent.m_consent_type ct
                            WHERE ct.id IN ('<sequence.consentTypeIds>')
                            AND ct.row_status = 'ACTIVE'
                        end note
                        m_consent_type -> infra: Return query result
                    deactivate m_consent_type

                    infra -> app: Return database result
                deactivate infra

                app -> domain: Apply domain rules and prepare response
                activate domain
                    domain -> app: Return response data
                deactivate domain

                app -> api: Return success response
                api -> page: Return success response
                page -> user: Display success result
            end alt
        deactivate app
    deactivate api
deactivate page

@enduml
