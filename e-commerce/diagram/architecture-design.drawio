        <mxCell id="caller" value="&lt;div style=&quot;position:relative;box-sizing:border-box;width:224px;height:416px;text-align:left;color:#2d3142;&quot;&gt;&lt;div style=&quot;position:absolute;left:16px;top:12px;box-sizing:border-box;border:0.8px solid #5a6580;border-radius:2px;width:88px;height:12px;line-height:10px;padding-left:5px;font-size:8px;font-family:Geist Mono,Courier New,monospace;&quot;&gt;SPECIFIED ROLES&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:32px;font-family:Geist,Arial,sans-serif;font-size:12px;line-height:16px;font-weight:600;white-space:nowrap;&quot;&gt;Client touchpoints&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:54px;width:192px;border-top:0.8px solid #bfc0c0;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:58px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Customer&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:74px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Browse offers / manage cart&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:90px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Checkout / pay / receive&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:106px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Shop member&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:122px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Stock / prices / parcels&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:138px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Platform administrator&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:154px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Master data / roles /&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:170px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;campaigns&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:186px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Client UI is not implemented&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:202px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;in this backend repository.&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:218px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Card data stays with&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:234px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Stripe.js&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:250px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Commerce API gets no card&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:266px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;data&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;overflow=hidden;align=left;verticalAlign=top;spacing=0;fillColor=#e4e6e8;strokeColor=#5a6580;strokeWidth=1.2;" vertex="1" parent="1">
