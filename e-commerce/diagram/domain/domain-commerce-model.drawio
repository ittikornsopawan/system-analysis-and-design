        <mxCell id="note-9" value="Tax formula and rounding are not in DDL." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1088" y="899" width="268" height="16" />
        </mxCell>
        <mxCell id="note-10" value="13 tables. Selected 11 / 27 FK associations. Cart -&gt; order is a use-case conversion, not a persisted FK relation." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=11;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
