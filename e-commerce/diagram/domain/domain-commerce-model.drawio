        </mxCell>
        <mxCell id="note-1" value="Item total_price = price x quantity (before discount)." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="64" y="927" width="359" height="16" />
        </mxCell>
        <mxCell id="note-2" value="Payment history is 0..* per order." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="584" y="815" width="229" height="16" />
        </mxCell>
        <mxCell id="note-3" value="Only a live filtered subset is limited to one." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="584" y="839" width="307" height="16" />
        </mxCell>
        <mxCell id="note-4" value="Shipment allocation supports split quantities;" style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="584" y="887" width="307" height="16" />
        </mxCell>
        <mxCell id="note-5" value="the FK does not enforce shipment quantity sums." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
