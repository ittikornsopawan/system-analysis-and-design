        <mxCell id="note-0" value="Local TX A: current + revision + audit. Local TX B: event marker + conditional projection + related audit. No PostgreSQL/MongoDB TX." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=11;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
