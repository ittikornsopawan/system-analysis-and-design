        <mxCell id="event-rule" value="&lt;div style=&quot;position:relative;box-sizing:border-box;width:552px;height:72px;text-align:left;&quot;&gt;&lt;div style=&quot;position:absolute;left:12px;top:8px;font-size:12px;font-family:Geist,Arial,sans-serif;font-weight:600;line-height:18px;white-space:nowrap;&quot;&gt;Integrity&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:25px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Same ID / same hash: replay; conflict: quarantine&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:39px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Marker + effect + audit share one local transaction&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=hidden;fillColor=#efeff0;strokeColor=#5a6580;fontSize=12;fontFamily=Geist,Arial,sans-serif;dashed=1;dashPattern=5 4;" parent="events" vertex="1">
