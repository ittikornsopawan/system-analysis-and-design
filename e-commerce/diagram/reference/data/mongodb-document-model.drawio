        <mxCell id="projection-payload" value="&lt;div style=&quot;position:relative;box-sizing:border-box;width:688px;height:72px;text-align:left;&quot;&gt;&lt;div style=&quot;position:absolute;left:12px;top:8px;font-size:12px;font-family:Geist,Arial,sans-serif;font-weight:600;line-height:18px;white-space:nowrap;&quot;&gt;Payload&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:25px;font-size:9px;font-family:Geist Mono,Courier New,monospace;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;sourceVersion / schemaVersion / sourceOccurredAt / projectedAt&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:39px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Status + allowed references; restricted operational read&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=hidden;fillColor=#ffffff;strokeColor=#2d3142;fontSize=12;fontFamily=Geist,Arial,sans-serif;" parent="projection" vertex="1">
