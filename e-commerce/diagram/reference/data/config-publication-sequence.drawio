        <mxCell id="op-106" value="PROPOSED: rollback publishes a new revision. Ordinary config revision never resets Redis bucket epoch." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
