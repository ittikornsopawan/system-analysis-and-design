        </mxCell>
        <mxCell id="op-110" value="PROPOSED: a refund request accepted by Stripe is not always a completed full refund. Current specifications need reconciliation." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="977" width="852.8" height="16" />
        </mxCell>
        <mxCell id="op-111" value="Concurrent provider callbacks use the same durable identity and SQL guards; no double stock/budget release." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="997" width="714.2" height="16" />
        </mxCell>
        <mxCell id="op-112" value="Sources: linked spec.md + sequence.wsd, diagram-semantics.md and supporting research | Proposed coordination; exact SQL remains in API sequences." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=9;fontFamily=Geist Mono,Courier New,monospace;fontColor=#5a6580;" parent="1" vertex="1">
