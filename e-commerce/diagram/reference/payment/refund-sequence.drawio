        <mxCell id="op-109" value="Header nesting shows ownership. Each lifeline is one interaction boundary; child boxes are structural context, not extra timings." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
