        <mxCell id="identity" value="&lt;div style=&quot;position:relative;box-sizing:border-box;width:352px;height:80px;text-align:left;&quot;&gt;&lt;div style=&quot;position:absolute;left:12px;top:8px;font-size:12px;font-family:Geist,Arial,sans-serif;font-weight:600;line-height:18px;white-space:nowrap;&quot;&gt;IDENTITY&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:25px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Globally unique eventId&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:39px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Immutable payload fingerprint&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=hidden;fillColor=#ffffff;strokeColor=#2d3142;fontSize=12;fontFamily=Geist,Arial,sans-serif;" parent="envelope" vertex="1">
