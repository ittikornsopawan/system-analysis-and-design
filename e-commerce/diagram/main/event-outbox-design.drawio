        <mxCell id="retry-gate" value="&lt;div style=&quot;position:relative;box-sizing:border-box;width:288px;height:80px;text-align:left;&quot;&gt;&lt;div style=&quot;position:absolute;left:12px;top:8px;font-size:12px;font-family:Geist,Arial,sans-serif;font-weight:600;line-height:18px;white-space:nowrap;&quot;&gt;RECLAIM GATE&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:25px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Expired lease may be reclaimed&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:39px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Old owner cannot ACK the new claim&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=hidden;fillColor=#ffffff;strokeColor=#2d3142;fontSize=12;fontFamily=Geist,Arial,sans-serif;" parent="retry" vertex="1">
          <mxGeometry as="geometry" x="16" y="152" width="288" height="80" />
        </mxCell>
        <mxCell id="quarantine-data" value="&lt;div style=&quot;position:relative;box-sizing:border-box;width:288px;height:80px;text-align:left;&quot;&gt;&lt;div style=&quot;position:absolute;left:12px;top:8px;font-size:12px;font-family:Geist,Arial,sans-serif;font-weight:600;line-height:18px;white-space:nowrap;&quot;&gt;WHY HELD&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:25px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Unsupported schema / poison event&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:39px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Same ID with different hash&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=hidden;fillColor=#ffffff;strokeColor=#2d3142;fontSize=12;fontFamily=Geist,Arial,sans-serif;" parent="quarantine" vertex="1">
          <mxGeometry as="geometry" x="16" y="48" width="288" height="80" />
        </mxCell>
        <mxCell id="quarantine-action" value="&lt;div style=&quot;position:relative;box-sizing:border-box;width:288px;height:80px;text-align:left;&quot;&gt;&lt;div style=&quot;position:absolute;left:12px;top:8px;font-size:12px;font-family:Geist,Arial,sans-serif;font-weight:600;line-height:18px;white-space:nowrap;&quot;&gt;OPERATOR REVIEW REQUIRED&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:25px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Review + authorize; audit disposition&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:39px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Only then controlled replay&lt;/div&gt;&lt;div style=&quot;position:absolute;left:12px;top:53px;font-size:11px;font-family:Geist,Arial,sans-serif;line-height:14px;color:#4f5d75;white-space:nowrap;&quot;&gt;Same event ID / hash; no checkout&lt;/div&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=hidden;fillColor=#ffffff;strokeColor=#2d3142;fontSize=12;fontFamily=Geist,Arial,sans-serif;" parent="quarantine" vertex="1">
          <mxGeometry as="geometry" x="16" y="152" width="288" height="80" />
