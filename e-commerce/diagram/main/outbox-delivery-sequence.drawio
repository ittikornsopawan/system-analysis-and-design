        </mxCell>
        <mxCell id="op-86" value="Header nesting shows ownership. Each lifeline is one interaction boundary; child boxes are structural context, not extra timings." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="953" width="859.4" height="16" />
        </mxCell>
        <mxCell id="op-87" value="PROPOSED at-least-once delivery. MongoDB marker, projection and audit commit together; SQL ACK is a separate transaction." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="977" width="806.6" height="16" />
        </mxCell>
        <mxCell id="op-88" value="Same-ID/same-hash replay never repeats checkout or stock/budget work. Quarantine needs operator review before controlled replay." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=10;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="997" width="852.8" height="16" />
        </mxCell>
        <mxCell id="op-89" value="Sources: linked spec.md + sequence.wsd, diagram-semantics.md and supporting research | Proposed coordination; exact SQL remains in API sequences." style="text;html=0;spacing=0;align=left;verticalAlign=middle;fontSize=9;fontFamily=Geist Mono,Courier New,monospace;fontColor=#5a6580;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="40" y="1026" width="869.3" height="15" />
