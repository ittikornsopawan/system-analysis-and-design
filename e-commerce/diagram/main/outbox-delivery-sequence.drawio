        <mxCell id="op-85" value="Lease expiry: new token; stale ACK rejected" style="text;html=0;spacing=0;align=center;verticalAlign=middle;fontSize=9;fontFamily=Geist,Arial,sans-serif;fontColor=#4f5d75;" parent="group-alt" vertex="1">
