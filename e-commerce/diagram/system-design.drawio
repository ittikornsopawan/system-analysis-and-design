        <mxCell id="wait" value="&lt;div style=&quot;position:relative;box-sizing:border-box;width:288px;height:216px;text-align:left;color:#2d3142;&quot;&gt;&lt;div style=&quot;position:absolute;left:16px;top:12px;box-sizing:border-box;border:0.8px solid #2d3142;border-radius:2px;width:72px;height:12px;line-height:10px;padding-left:5px;font-size:8px;font-family:Geist Mono,Courier New,monospace;&quot;&gt;WAIT_PAYMENT&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:32px;font-family:Geist,Arial,sans-serif;font-size:12px;line-height:16px;font-weight:600;white-space:nowrap;&quot;&gt;Awaiting payment&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:54px;width:256px;border-top:0.8px solid #bfc0c0;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:58px;font-family:Geist Mono,Courier New,monospace;font-size:9px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;sales/02 · customer checkout&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:74px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;One order per selected shop&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:90px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Price, lot and address snapshotted&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:106px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Reserve stock + campaign budget&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:122px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;Configured payment window: 30 min&lt;/div&gt;&lt;div style=&quot;position:absolute;left:16px;top:138px;font-family:Geist,Arial,sans-serif;font-size:11px;line-height:16px;white-space:nowrap;color:#4f5d75;&quot;&gt;default&lt;/div&gt;&lt